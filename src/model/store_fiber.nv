// store_fiber.nv — the fiber that owns the snapshot and the subscriptions (T2.9, T2.13).
//
// `store.nv` is the state machine: a registry with a ring of events, a snapshot that
// merges account readings. It is pure and has been testable since it was written. What
// it never had is an OWNER -- something that holds the one copy and serialises every
// touch of it. That is this file, and its absence is why three conditions of T2.9 and
// three of T2.13 stood open with "there is no fiber" written beside them.
//
// WHY A FIBER AND NOT A LOCK, decided by spike T0.4 rather than by preference. The
// spike measured connection fibers running on ten OS threads and found NO race across
// 400 concurrent increments on unprotected state -- and still concluded the fiber is
// mandatory, because the property that would have to be relied on is written down
// nowhere. A measurement that comes out clean does not make a guarantee; it makes an
// observation about one run on one machine.
//
// REQUEST/REPLY, AND EVERY REQUEST CARRIES ITS OWN REPLY CHANNEL. The alternative --
// one shared reply channel -- delivers answers to whoever asks next, which is a bug
// that appears only under load and reads as data corruption rather than as a mistake in
// the plumbing.
//
// THE LOOP ENDS WHEN THE CHANNEL CLOSES, not on a `Stop` message. A sentinel message
// races with the messages behind it: the sender that closes has no way to know whether
// somebody queued a request first, and those requests then wait forever on a reply that
// will never come. Closing is the signal the channel itself provides.

module model.store_fiber

import std.concurrency.nvchan.{Chan, ChanTx, ChanRx}
import claude_limits.model.store.{Registry, Snapshot, AccountSlot, Event, subscribe, unsubscribe, publish, since, missed, merge}
import claude_limits.model.live.{nothing_yet}
import claude_limits.server.dto.{SnapshotView}
import claude_limits.config.{Config}
import claude_limits.storage.config_file.{Loaded}

/// The settings this process runs on, and the file they came from (01.2 §2.2).
///
/// HELD BY THE STORE, for the reason the snapshot is: connection fibers run beside
/// each other, and `PUT /api/config` changes what `GET /api/config` and the snapshot's
/// order read. One owner serialises the change; two copies would let a page read the
/// old order after a save that answered `200`.
///
/// `loaded` is kept beside `cfg` because the next save needs it: its `mtime_ns` is
/// what a hand edit since the last read is detected by, and its `text` is what goes
/// into `config_history` before the file is overwritten.
export type ConfNow value {
    ro cfg Config
    /// `tag_of(render(cfg))` -- what `If-Match` is compared against.
    ro tag str
    ro loaded Loaded
}

export fn ConfNow.new(cfg Config, tag str, loaded Loaded) -> ConfNow => { cfg, tag, loaded }

/// Before the binary hands the store its settings: the defaults, from no file. Never
/// seen by a request in the binary -- `--serve` sends the real one before it listens.
export fn ConfNow.none() -> ConfNow =>
    { cfg: Config.defaults(), tag: "", loaded: { cfg: Config.defaults(), mtime_ns: 0, text: "", errors: [], missing: true } }

/// One thing to ask of the store.
///
/// A sum, because the alternative is a record with a "kind" field and five optional
/// payloads -- which makes every unused combination representable and none of them
/// checked.
/// NOT `Request`: `http` declares `export type Request consume`, and with both in one
/// unit the checker judged `Envelope.req` against the OTHER one -- "field `req` has a
/// consume type" (registry 221.1 #154 class, measured 2026-09-30 when `server/feed.nv`
/// first put this module beside the HTTP client).
export type StoreAsk enum
    /// Give me the snapshot as it stands.
    | GetSnapshot(ChanTx[Snapshot])
    /// Fold one account's reading in. No reply: the sender has nothing to wait for,
    /// and making it wait would serialise the pollers behind each other.
    | Merge(AccountSlot)
    /// Register a subscriber; the reply is its id.
    | Subscribe(ChanTx[int])
    /// Drop a subscriber. No reply, for the same reason as `Merge`.
    | Unsubscribe(int)
    /// Publish an event to every subscriber; the reply is the event, so a caller that
    /// needs the assigned id can have it.
    | Publish(str, str, ChanTx[Event])
    /// Everything after `id`; the reply is the events, oldest first.
    | Since(int, ChanTx[Events])
    /// Has `id` fallen off the ring? The reply says so.
    | Missed(int, ChanTx[bool])
    /// Replace the body of `GET /api/snapshot`. The poller computes it AT THE MOMENT OF
    /// ITS POLL -- 01.3 §3.3 counts `seconds_left` and `elapsed_share` to `fetched_at` --
    /// so the store keeps it whole rather than recomputing it with a clock it has not
    /// got. No reply, like `Merge`.
    | SetView(SnapshotView)
    /// Give me that body.
    | GetView(ChanTx[SnapshotView])
    /// The settings as they stand.
    | GetConf(ChanTx[ConfNow])
    /// Replace them: a save went to disk. No reply, like `SetView`.
    | SetConf(ConfNow)
    /// Time for a poll round. Sent by a timer fiber; acted on by the loop that owns the
    /// poller, because the poll cannot run in a spawned fiber (D446 refuses the chain).
    | Tick

/// The envelope the request travels in. A WORKAROUND, not a form.
///
/// `Chan[StoreAsk]` does not compile: `Chan[T].new` emits `ChanPair[T]` and not the two
/// types its own fields are made of, when T is a user-defined sum. Four probes isolate
/// it in `probes/chan-of-user-sum/` -- `Chan[int]` and `Chan[<record>]` pass, a sum
/// fails, and a record CONTAINING the same sum passes. `nova check` says `ok:` to all
/// four.
///
/// The sum is kept: a record with a `kind` field and five optional payloads would make
/// every unused combination representable and none of them checked.
///
/// REMOVE THIS WHEN THE DEFECT IS FIXED. One line here, one unwrap in the loop.
/// [M-chan-envelope-workaround]
export type Envelope value {
    ro req StoreAsk
}

export fn Envelope.new(req StoreAsk) -> Envelope => { req }

/// A list of events, boxed for the same reason as `Envelope`: a channel cannot carry a
/// VECTOR either. The axis turned out to be pointer representation, not sums -- vectors
/// and sums both fail, scalars, `str` and value records pass.
/// [M-chan-envelope-workaround]
export type Events value {
    ro items []Event
}

export fn Events.new(items []Event) -> Events => { items }

/// The address of a running store. Cheap to copy; every holder talks to one fiber.
export type Store value {
    ro tx ChanTx[Envelope]
}

export fn Store.new(tx ChanTx[Envelope]) -> Store => { tx }

/// The loop. Runs until the request channel closes.
///
/// Takes the snapshot it starts from, so a restored one (01.2 §3.16) and an empty one
/// are the same code path -- the difference is a value the caller supplies, not a
/// branch here.
export fn run(rx ChanRx[Envelope], start Snapshot) -> () {
    // STARTS EMPTY AND REPLAYS, rather than copying `start`.
    //
    // `Snapshot` has no `clone`, and copying the record would share its `accounts`
    // vector -- the precise co-ownership this fiber exists to prevent: the caller's
    // value and the fiber's would be one storage, and every merge visible through both.
    //
    // Declaring the parameter `mut` compiles and is worse: `mut` is in-out, so the
    // caller would see each merge in its own value. That is harmless only because
    // today's caller hands the snapshot over and stops using it -- a property of the
    // call site, not of the type, and the first person to keep their copy inherits an
    // aliasing bug nobody wrote down.
    //
    // Replaying costs one pass at start-up, has no aliasing question, and runs a
    // restored snapshot through the SAME path a polled one takes -- so the two cannot
    // be subtly different.
    mut st = StoreState.new(start)
    mut going = true
    while going {
        match rx.recv() {
            None => { going = false }
            // Unwrap the envelope. [M-chan-envelope-workaround]
            Some(env) => step(st, env.req)
        }
    }
}

/// What the store holds. A record so that a loop other than `run` -- the one `--serve`
/// runs, which also polls -- can hold the same state and hand every request to the
/// same `step`: one home for what each request does.
export type StoreState {
    mut snap Snapshot
    mut reg Registry
    mut view SnapshotView
    mut conf ConfNow
}

/// The state a store starts in. See `run` for why the snapshot is replayed, not copied.
export fn StoreState.new(start Snapshot) -> StoreState {
    mut snap = Snapshot.empty()
    for slot in start.accounts { merge(snap, slot) }
    snap.fetched_at_ms = start.fetched_at_ms
    snap.restored = start.restored
    { snap, reg: Registry.new(), view: nothing_yet(), conf: ConfNow.none() }
}

/// Answer one request. `Tick` is not answered here: it asks for a poll round, which
/// only a loop that owns a poller can run (`server.feed.store_and_poll`); in a plain
/// store it is a no-op, never a failure.
export fn step(mut st StoreState, ask StoreAsk) -> () {
    match ask {
        // nova:allow W_RESULT_DISCARDED -- the asker is gone; there is nothing to do and nobody to tell
        StoreAsk.GetSnapshot(reply) => { ro _ = reply.send(st.snap) }
        StoreAsk.Merge(slot) => { merge(st.snap, slot) }
        // nova:allow W_RESULT_DISCARDED -- the asker is gone; there is nothing to do and nobody to tell
        StoreAsk.Subscribe(reply) => { ro _ = reply.send(subscribe(st.reg)) }
        StoreAsk.Unsubscribe(id) => { unsubscribe(st.reg, id) }
        StoreAsk.Publish(name, data, reply) => {
            // nova:allow W_RESULT_DISCARDED -- the asker is gone; there is nothing to do and nobody to tell
            ro _ = reply.send(publish(st.reg, name, data))
        }
        // nova:allow W_RESULT_DISCARDED -- the asker is gone; there is nothing to do and nobody to tell
        StoreAsk.Since(after, reply) => { ro _ = reply.send(Events.new(since(st.reg, after))) }
        // nova:allow W_RESULT_DISCARDED -- the asker is gone; there is nothing to do and nobody to tell
        StoreAsk.Missed(after, reply) => { ro _ = reply.send(missed(st.reg, after)) }
        StoreAsk.SetView(v) => { st.view = v }
        // nova:allow W_RESULT_DISCARDED -- the asker is gone; there is nothing to do and nobody to tell
        StoreAsk.GetView(reply) => { ro _ = reply.send(st.view) }
        // nova:allow W_RESULT_DISCARDED -- the asker is gone; there is nothing to do and nobody to tell
        StoreAsk.GetConf(reply) => { ro _ = reply.send(st.conf) }
        StoreAsk.SetConf(c) => { st.conf = c }
        StoreAsk.Tick => ()
    }
}

// ── the caller's side ────────────────────────────────────────────────────────
//
// Each of these makes its OWN reply channel, capacity 1. One shared reply channel
// would deliver answers to whoever asked next.

/// The snapshot as it stands.
export fn Store @snapshot() -> Snapshot {
    ro pair = Chan[Snapshot].new(1)
    // nova:allow W_RESULT_DISCARDED -- a closed channel surfaces as `None` from the `recv` below, which has its own answer
    ro _ = @tx.send(Envelope.new(StoreAsk.GetSnapshot(pair.tx)))
    // No reply means the fiber is gone. An empty snapshot is the honest answer: we
    // know nothing, which is exactly what an empty one says. Inventing a stale one
    // would be worse -- a page showing yesterday's numbers as today's.
    pair.rx.recv() ?? Snapshot.empty()
}

/// Fold one account's reading in. Waits for nothing, but SAYS whether it was
/// delivered: this door awaits no reply, so a closed channel would otherwise drop
/// a poller's measurement with nobody the wiser. `false` means the store is gone.
export fn Store @merge(slot AccountSlot) -> bool {
    @tx.send(Envelope.new(StoreAsk.Merge(slot)))
}

/// Register a subscriber, and get its id.
export fn Store @subscribe() -> int {
    ro pair = Chan[int].new(1)
    // nova:allow W_RESULT_DISCARDED -- a failed send surfaces as `None` below, and 0 is the documented answer for it
    ro _ = @tx.send(Envelope.new(StoreAsk.Subscribe(pair.tx)))
    // No reply gives ZERO, AND IT IS DISTINCT FROM -1 ON PURPOSE. `subscribe` answers
    // -1 when the registry is full -- the fiber replied and said no. Zero means nothing
    // replied at all, because the store is gone. A caller that conflates them retries a
    // full registry forever, or gives up on a store that is merely busy starting.
    pair.rx.recv() ?? 0
}

/// `false` means the store is gone, so the subscription died with it -- which is
/// the same outcome the caller wanted, but it should learn it rather than assume.
export fn Store @unsubscribe(id int) -> bool {
    @tx.send(Envelope.new(StoreAsk.Unsubscribe(id)))
}

/// Publish, and get the event with its assigned id.
export fn Store @publish(name str, data str) -> Option[Event] {
    ro pair = Chan[Event].new(1)
    // nova:allow W_RESULT_DISCARDED -- `recv` below returns `None` on a failed send, which is this door's whole answer
    ro _ = @tx.send(Envelope.new(StoreAsk.Publish(name, data, pair.tx)))
    pair.rx.recv()
}

/// Everything after `id`.
export fn Store @since(after int) -> []Event {
    ro pair = Chan[Events].new(1)
    // nova:allow W_RESULT_DISCARDED -- a failed send surfaces as `None` below, answered with an empty list
    ro _ = @tx.send(Envelope.new(StoreAsk.Since(after, pair.tx)))
    match pair.rx.recv() {
        Some(box) => box.items
        None => []
    }
}

/// Has `after` fallen off the ring?
export fn Store @missed(after int) -> bool {
    ro pair = Chan[bool].new(1)
    // nova:allow W_RESULT_DISCARDED -- a failed send surfaces as `None` below, answered with `true` on purpose
    ro _ = @tx.send(Envelope.new(StoreAsk.Missed(after, pair.tx)))
    // No reply is "unknown", answered `true` and not `false`: a caller that cannot
    // reach the store should resend the whole snapshot rather than assume its cursor
    // is still good.
    pair.rx.recv() ?? true
}

/// Replace the snapshot body. `false` means the store is gone.
export fn Store @set_view(v SnapshotView) -> bool {
    @tx.send(Envelope.new(StoreAsk.SetView(v)))
}

/// The snapshot body as it stands; before the first poll, and when the store is gone,
/// the empty one -- "we know nothing" is what it says, and it is true.
export fn Store @view() -> SnapshotView {
    ro pair = Chan[SnapshotView].new(1)
    // nova:allow W_RESULT_DISCARDED -- a failed send surfaces as `None` below, answered with the empty body
    ro _ = @tx.send(Envelope.new(StoreAsk.GetView(pair.tx)))
    pair.rx.recv() ?? nothing_yet()
}

/// Replace the settings. `false` means the store is gone.
export fn Store @set_conf(c ConfNow) -> bool {
    @tx.send(Envelope.new(StoreAsk.SetConf(c)))
}

/// The settings as they stand. With the store gone, `ConfNow.none()` -- an empty tag
/// that no `If-Match` equals, so a save cannot slip through on a store that is not
/// there to record it.
export fn Store @conf() -> ConfNow {
    ro pair = Chan[ConfNow].new(1)
    // nova:allow W_RESULT_DISCARDED -- a failed send surfaces as `None` below, answered with the empty settings
    ro _ = @tx.send(Envelope.new(StoreAsk.GetConf(pair.tx)))
    pair.rx.recv() ?? ConfNow.none()
}

/// Ask for a poll round. `false` means the store is gone -- the timer's cue to stop.
export fn Store @tick() -> bool {
    @tx.send(Envelope.new(StoreAsk.Tick))
}
