// live.nv -- what the process knows about its accounts, as the body of
// `GET /api/snapshot` (plan 01.5, T2.27 step B1).
//
//   ./nova.sh test src/model/ --filter live_test
//
// Source: 01.3 §3.3 (the body, the order of `limits[]`, which states carry rows),
// 01.1 §3.2 (states), §2.2 (severity from OUR thresholds).
//
// ── WHY THIS FILE EXISTS ────────────────────────────────────────────────────
//
// Every piece was already written -- `model.snapshot` has the states, severity,
// `at_100` and `locked`; `model.format` has the row labels and the reset caption;
// `server.dto` has the view records and the handler renders them -- and nothing
// joined them: the snapshot handler receives a `SnapshotView` "ready made" (its own
// words), and no code in the tree made one from a poll. This is that join, and it is
// PURE: the clock, the zone and the thresholds arrive as arguments.
//
// ── NOT HERE, AND NAMED ─────────────────────────────────────────────────────
//
// * `forecast` is `null` on every row: `model.forecast` needs a series of readings
//   over time, and the process keeps only the last one until the history is wired.
//   01.3 §3.3 allows `null` ("недоступен").
// * `server_severity` and `active` are empty/false: the reply parser (`usage.parse`)
//   does not keep the endpoint's own `severity` and `is_active` yet.
// * `tz` is the local UTC offset (`+03:00`), not an IANA name: std offers the zone
//   through an offset only (spike T0.3). The page draws its axes in the browser's
//   zone anyway (§0); `tz` is a caption.

module model.live

import std.time.civil.{TimeZone}
import claude_limits.window.{Window}
import claude_limits.model.snapshot.{AccountState, SeverityBounds, severity_of, at_100, locked}
import claude_limits.model.format.{row_label, reset_caption}
import claude_limits.server.dto.{SnapshotView, AccountView, LimitView, WorstView, DirView}
import claude_limits.usage.parse.{moment_iso}

const SESSION_SEC = 5 * 3600
const WEEK_SEC = 7 * 86400

/// One account as the process knows it right now.
export type Known value {
    ro id str
    ro email str
    ro org str
    ro dirs []DirView
    /// Of the LAST poll -- or `Stale` from the token, when no poll was made.
    ro state AccountState
    /// Ready text for the block header (01.1 §3.2), "" for none.
    ro message str
    /// Of the last SUCCESSFUL reading; 0 = there has not been one.
    ro polled_at_ms int
    /// 0 = nothing scheduled (a stale account is not polled).
    ro next_poll_ms int
    /// Of the last successful reading: an `unknown` account shows these, dimmed.
    ro windows []Window
}

export fn Known.new(id str, email str, org str, dirs []DirView, state AccountState, message str,
                    polled_at_ms int, next_poll_ms int, windows []Window) -> Known =>
    { id, email, org, dirs, state, message, polled_at_ms, next_poll_ms, windows }

fn iso_or_empty(ms int) -> str => if ms == 0 { "" } else { moment_iso(ms) }

/// The body before the first poll: no accounts, no rows, no times. What the page is
/// shown between the start and the first round, and what a store with nothing in it
/// answers.
export fn nothing_yet() -> SnapshotView => {
    fetched_at: "", next_poll_at: "", tz: "", restored: false, worst: None,
    accounts: [], limits: [],
}

/// Does this state carry rows? §3.3: `stale` and `error` have none; `unknown` shows the
/// last good reading.
fn has_rows(s AccountState) -> bool =>
    match s {
        AccountState.Ok => true
        AccountState.Unknown => true
        _ => false
    }

fn kind_rank(kind str) -> int {
    if kind == "session" { return 0 }
    if kind == "weekly_all" { return 1 }
    2
}

/// §3.3: inside an account, `session`, `weekly_all`, then `weekly_scoped` by model.
export fn in_row_order(windows []Window) -> []Window {
    // NOT `windows.collect()`, which the linter asks for: measured 2026-09-30, that form
    // followed by `sort_by` crashes the process (0xC0000005) where this loop does not
    // (probes/vec-collect-then-sort-crashes/).
    // nova:allow W_MANUAL_COLLECT -- the canon form crashes at run time, see the probe
    mut out []Window = []
    for w in windows { out.push(w) }
    out.sort_by(fn(a Window, b Window) -> int => {
        ro ka = kind_rank(a.kind)
        ro kb = kind_rank(b.kind)
        if ka != kb { return ka - kb }
        a.model.compare(b.model)
    })
    out
}

/// The length of a window of `kind`, in seconds: one home for it (the snapshot and the
/// database both need it -- `storage/tick.nv` derives a window's start from it).
export fn window_sec_of(kind str) -> int => if kind == "session" { SESSION_SEC } else { WEEK_SEC }

fn limit_of(account_id str, w Window, th SeverityBounds, now_ms int, zone TimeZone) -> LimitView {
    ro span = window_sec_of(w.kind)
    ro known_reset = w.resets_at_ms > 0
    ro left = if known_reset { ((w.resets_at_ms - now_ms) / 1000).max(0) } else { 0 }
    ro elapsed = if known_reset { ((span - left) * 100 / span).max(0).min(100) } else { 0 }
    ro caption = if known_reset { reset_caption(w.resets_at_ms.to_unix_millis(), now_ms.to_unix_millis(), zone) } else { "" }
    {
        account_id, kind: w.kind, model: w.model, label: row_label(w.kind, w.model),
        percent: w.percent, severity: severity_of(w, th).to_str(), server_severity: "",
        locked: w.locked_reason != "", locked_reason: w.locked_reason, active: false,
        resets_at: iso_or_empty(w.resets_at_ms), seconds_left: left, reset_label: caption,
        window_sec: span, elapsed_share_hundredths: elapsed, forecast: None,
    }
}

fn account_of(k Known) -> AccountView {
    ro rows = has_rows(k.state)
    {
        id: k.id, email: k.email, org: k.org, dirs: k.dirs, state: k.state.to_str(),
        message: k.message, polled_at: iso_or_empty(k.polled_at_ms),
        next_poll_at: iso_or_empty(k.next_poll_ms),
        locked: rows && locked(k.windows), at_100: rows && at_100(k.windows),
    }
}

fn sev_rank(s str) -> int {
    if s == "critical" { return 2 }
    if s == "warning" { return 1 }
    0
}

/// The worst row across all shown rows: highest severity, then highest percent; the
/// first such row wins a tie, so the answer does not flicker between two equal ones.
export fn worst_of(limits []LimitView) -> Option[WorstView] {
    mut best Option[WorstView] = None
    for l in limits {
        ro better = match best {
            None => true
            Some(b) => {
                ro rl = sev_rank(l.severity)
                ro rb = sev_rank(b.severity)
                rl > rb || (rl == rb && l.percent > b.percent)
            }
        }
        if better { best = Some(WorstView { account_id: l.account_id, kind: l.kind, percent: l.percent, severity: l.severity }) }
    }
    best
}

/// The body of `GET /api/snapshot` for these accounts, as of `now_ms`.
///
/// Accounts stay in the order given -- `ui.accounts_order` and the hiding are applied
/// by the handler (`snapshot.arrange`), the one place that knows the request.
export fn view_of(known []Known, th SeverityBounds, now_ms int, next_poll_ms int, tz str, zone TimeZone) -> SnapshotView {
    mut accounts []AccountView = []
    mut limits []LimitView = []
    for k in known {
        accounts.push(account_of(k))
        if has_rows(k.state) {
            for w in in_row_order(k.windows) { limits.push(limit_of(k.id, w, th, now_ms, zone)) }
        }
    }
    {
        fetched_at: iso_or_empty(now_ms), next_poll_at: iso_or_empty(next_poll_ms), tz,
        restored: false, worst: worst_of(limits), accounts, limits,
    }
}
