// Tests for forecast_join.nv -- plan 01.6, П1: the forecast against the REFERENCE.
//
//   ./nova.sh test src/model/forecast_join_test.nv
//
// THE NUMBERS BELOW ARE THE REFERENCE'S. `scripts/claude_limits.py` `forecast_of` was run
// on exactly these samples (2026-10-21, machine zone +03:00, the reference reads local
// time for working hours; re-run after the reset-based branch went live and the window
// start became the observed reset) and said:
//
//   session       at_reset=52.0000   runs_out=None                  rate_per_hour=12.0000  span_min=90
//   weekly_clock  at_reset=121.5352  runs_out=2026-10-05T06:18:00Z  rate_per_hour=0.4930   span_min=4320
//   weekly_work   at_reset=97.1667   runs_out=None                  rate_per_hour=1.1667   span_min=4320
//   monthly_drop  at_reset=199.2293  runs_out=2026-10-16T03:08:00Z  rate_per_hour=0.2654   span_min=4320
//
// The port is integral: percentages are whole, so 121.54 is 121 and 97.17 is 97, and the
// int walk to 100 % lands a few minutes off the reference's float walk (06:19 for 06:18,
// 03:12 for 03:08). The rate keeps hundredths: 0.4930 %/h is rate_per_hour_milli 490.

module model.forecast_join_test

import std.time.civil.{TimeZone}
import claude_limits.server.dto.{SnapshotView, AccountView, LimitView, ForecastView}
import claude_limits.storage.history_rows.{HistRows, HistAccount, HistWindow, HistSample}
import forecast_join.{ForecastRules, with_forecasts, forecast_of, paces_of}

// 2026-10-01 09:00:00 UTC, a Thursday: 12:00 at +03:00.
const NOW_MS = 1790845200000
const OFFSET_SEC = 10800
const MIN = 60000
const HOUR = 3600000

fn same(label str, want str, got str) -> bool {
    if want == got { return true }
    panic("${label}: want [${want}], got [${got}]")
}

fn rules(working_hours bool) -> ForecastRules =>
    ForecastRules.new(true, working_hours, ["mon", "tue", "wed", "thu", "fri"], "09:00", "19:00", 0, 3)

fn account() -> AccountView => {
    id: "a-1", email: "Main@Example.com", org: "Org", dirs: [], state: "ok", message: "",
    polled_at: "", next_poll_at: "", locked: false, display_name: "", provider: "claude", at_100: false, same_quota_as: "", extra_usage: None,
}

fn limit(kind str, percent int, seconds_left int, window_sec int) -> LimitView => {
    account_id: "a-1", kind, model: "", label: kind, percent, severity: "normal", server_severity: "",
    locked: false, locked_reason: "", active: false, resets_at: "2026-10-01T11:00:00Z",
    seconds_left, reset_label: "", window_sec, elapsed_share_hundredths: 0, forecast: None,
}

fn view(l LimitView) -> SnapshotView => {
    fetched_at: "2026-10-01T09:00:00Z", next_poll_at: "", tz: "+03:00", restored: false,
    worst: None, accounts: [account()], limits: [l],
}

fn sample(at_ms int, percent int) -> HistSample => { at_ms, percent, resets_at_ms: 0, locked: false }

fn rows(kind str, samples []HistSample) -> HistRows => {
    accounts: [HistAccount{ id: "db-1", email: "main@example.com", color_slot: 0, polls: [] }],
    windows: [HistWindow{ account_id: "db-1", kind, model: "", samples, locks: [], rollups: [] }],
}

/// Session: every 5 minutes over the last 90, 10 % rising to 28 % now.
fn session_samples() -> []HistSample {
    mut out []HistSample = []
    for k in 0..19 { out.push(sample(NOW_MS - 90 * MIN + 5 * MIN * k, 10 + k)) }
    out
}

/// Week: hourly over the last 72 hours, one point per two hours, 54 % now.
fn week_samples() -> []HistSample {
    mut out []HistSample = []
    mut h = 72
    while h >= 0 {
        out.push(sample(NOW_MS - h * HOUR, 54 - h / 2))
        h -= 1
    }
    out
}

fn one(l LimitView, r HistRows, working_hours bool) -> Option[ForecastView] =>
    forecast_of(view(l), l, r, rules(working_hours), NOW_MS, OFFSET_SEC, TimeZone.Utc)

test "session, as the reference: 52 % at reset, 12 %/h from the window's start" {
    // The rate spans from the window's start (90 observed minutes), not the last 60:
    // the reference's `rate_start` clamp is dead code since the reset-based fix.
    ro l = limit("session", 28, 2 * 3600, 5 * 3600)
    match one(l, rows("session", session_samples()), false) {
        None => panic("no forecast")
        Some(f) => {
            assert(f.percent_at_reset == 52)
            assert(same("runs out", "", f.runs_out_at))
            assert(f.rate_per_hour_milli == 12000)
            assert(f.sample_minutes == 90)
            assert(same("basis", "clock", f.basis))
            assert(same("label", "\u{2192} 52% at reset", f.label))
            assert(!f.warning)
            assert(same("severity", "normal", f.severity))
        }
    }
}

test "week by the clock, as the reference: 121 %, runs out 2026-10-05 06:19 UTC" {
    // The window began 31 hours ago, INSIDE the 3-day rate span, so the previous
    // week's tail (72h..32h ago, 18 % to 38 %) still counts: used is 20 points of
    // tail plus 15 of this window over 71 observed hours.
    ro l = limit("weekly_all", 54, (5 * 24 + 17) * 3600, 7 * 86400)
    match one(l, rows("weekly_all", week_samples()), false) {
        None => panic("no forecast")
        Some(f) => {
            assert(f.percent_at_reset == 121)
            assert(f.runs_out_at.starts_with("2026-10-05T06:19:00"))
            assert(f.sample_minutes == 4320)
            assert(f.warning)
            // The reference's line, whole: the percent, then where it runs out.
            assert(same("label", "\u{2192} 121% at reset, ends 2026-10-05 ~06:19 (3d 21h)", f.label))
            // 121 % at reset is past the ghost's 95: red, whatever the fill says now (54 %).
            assert(same("severity", "critical", f.severity))
        }
    }
}

test "week by working hours, as the reference: 97 % and it lasts" {
    ro l = limit("weekly_all", 54, (5 * 24 + 17) * 3600, 7 * 86400)
    match one(l, rows("weekly_all", week_samples()), true) {
        None => panic("no forecast")
        Some(f) => {
            assert(f.percent_at_reset == 97)
            assert(same("severity at 97", "critical", f.severity))
            assert(same("runs out", "", f.runs_out_at))
            assert(same("basis", "working_hours", f.basis))
        }
    }
}

test "under five minutes of history there is no forecast" {
    ro l = limit("session", 28, 2 * 3600, 5 * 3600)
    ro short = [sample(NOW_MS - 3 * MIN, 20), sample(NOW_MS, 28)]
    assert(one(l, rows("session", short), false).is_none())
}

test "weekly 1 percent below the five-minute floor keeps facts without a projection" {
    for seconds in [60, 120] {
        ro l = limit("weekly_all", 1, 7 * 86400 - seconds, 7 * 86400)
        ro r = rows("weekly_all", [sample(NOW_MS - seconds * 1000, 0), sample(NOW_MS, 1)])
        ro v = with_forecasts(view(l), r, rules(false), NOW_MS, OFFSET_SEC, TimeZone.Utc)
        assert(v.limits[0].forecast.is_none())
        assert(v.limits[0].percent == 1)
        assert(v.limits[0].severity == "normal")
        assert(v.limits[0].resets_at == l.resets_at)
        assert(paces_of(v, r).len() == 0)
    }
}

fn boundary(kind str, window_sec int, minimum_sec int, working bool) {
    ro l = limit(kind, 1, window_sec - minimum_sec, window_sec)
    ro short = rows(kind, [sample(NOW_MS - (minimum_sec - 1) * 1000, 0), sample(NOW_MS, 1)])
    assert(one(l, short, working).is_none())
    ro enough = rows(kind, [sample(NOW_MS - minimum_sec * 1000, 0), sample(NOW_MS, 1)])
    assert(one(l, enough, working).is_some())
}

test "the five-minute floor for every window class, in both forecast bases" {
    // Owner's word 2026-10-31 ("уменьши до 5 минут"): the old per-kind minimum
    // (window/20) is gone -- one floor for session, week and month alike.
    for working in [false, true] {
        boundary("session", 5 * 3600, 300, working)
        boundary("weekly_all", 7 * 86400, 300, working)
        boundary("monthly", 30 * 86400, 300, working)
    }
}

test "a window's own length no longer raises the floor" {
    boundary("monthly", 31 * 86400, 300, false)
    boundary("weekly_all", 604801, 300, false)
}

test "monthly with the reset observed as a drop forecasts, arithmetic alone would wait a day" {
    // The Kimi month of 2026-10-21: resets_at is 30d 8h ahead, so resets_at minus the
    // 30-day guess lands in the FUTURE and leaves no post-reset samples. The samples
    // show the real reset: 98 % -> 0 % twenty-four hours ago, with a 3-day tail before
    // it. As the reference: 199 % at reset, runs out 2026-10-16 ~03:12.
    ro month = [
        sample(NOW_MS - 3 * 86400000, 85), sample(NOW_MS - 90000000, 90),
        sample(NOW_MS - 88200000, 98), sample(NOW_MS - 86700000, 0),
        sample(NOW_MS - HOUR, 1), sample(NOW_MS, 6),
    ]
    ro l = limit("monthly", 6, 30 * 86400 + 8 * 3600, 30 * 86400)
    match one(l, rows("monthly", month), false) {
        None => panic("no forecast")
        Some(f) => {
            assert(f.percent_at_reset == 199)
            assert(f.runs_out_at.starts_with("2026-10-16T03:12:00"))
            assert(f.sample_minutes == 4320)
            assert(f.warning)
            assert(same("label", "\u{2192} 199% at reset, ends 2026-10-16 ~03:12 (14d 18h)", f.label))
        }
    }
    // The control: no drop visible, the arithmetic start in the future -- the forecast
    // honestly waits for observed span. One hour of samples IS enough span now
    // (the floor is five minutes), so the wait here is about the DROP, not the span.
    ro nodrop = rows("monthly", [sample(NOW_MS - HOUR, 5), sample(NOW_MS, 6)])
    assert(one(l, nodrop, false).is_none())
}

test "samples before the current window cannot replace the observed span" {
    // The spans here are above the five-minute floor, so what is being proved is
    // the SAMPLE SELECTION, not the floor: a limit whose window began a day ago
    // takes no samples from before that beginning (the pre-reset tail rule of
    // 01.1 §2.7, 2026-10-21), and samples older than the limit's own span do not
    // stretch the observed span.
    ro late = limit("weekly_all", 1, 6 * 86400, 7 * 86400)
    ro short = rows("weekly_all", [sample(NOW_MS - 3 * MIN, 0), sample(NOW_MS, 1)])
    assert(one(late, short, false).is_none())
    ro fresh = limit("weekly_all", 1, 7 * 86400 - 1800, 7 * 86400)
    // The in-window samples span two minutes -- below the floor -- so what the
    // assert proves is that the day-old sample cannot stretch that span.
    ro old = rows("weekly_all", [sample(NOW_MS - 24 * HOUR, 0), sample(NOW_MS - 2 * MIN, 0), sample(NOW_MS, 1)])
    assert(one(fresh, old, false).is_none())
}

test "missing reset no history and stale accounts stay unavailable" {
    mut l = limit("session", 28, 2 * 3600, 5 * 3600)
    ro r = rows("session", session_samples())
    l.resets_at = ""
    assert(one(l, r, false).is_none())
    l.resets_at = "2026-10-01T11:00:00Z"
    l.seconds_left = 0
    assert(one(l, r, false).is_none())
    l.seconds_left = 7200
    assert(one(l, rows("session", []), false).is_none())
    mut a = account()
    a.state = "stale"
    mut v = view(l)
    v.accounts = [a]
    assert(forecast_of(v, l, r, rules(false), NOW_MS, OFFSET_SEC, TimeZone.Utc).is_none())
}

test "a locked row, a stale account, or forecasting switched off: no forecast" {
    mut locked = limit("session", 100, 2 * 3600, 5 * 3600)
    locked.locked = true
    assert(one(locked, rows("session", session_samples()), false).is_none())
    ro off = ForecastRules.new(false, false, [], "09:00", "19:00", 0, 3)
    ro l = limit("session", 28, 2 * 3600, 5 * 3600)
    assert(forecast_of(view(l), l, rows("session", session_samples()), off, NOW_MS, OFFSET_SEC, TimeZone.Utc).is_none())
}

test "a Kimi row finds its history by the credentials file, not by an e-mail it has none of" {
    // The snapshot's Kimi account: no e-mail, its file stem as the name (feed.nv).
    mut a = account()
    a.email = ""
    a.provider = "kimi"
    a.display_name = "kimi-code-env-0e4f"
    ro l = limit("monthly", 54, 18 * 86400, 30 * 86400)
    ro v = SnapshotView{ fetched_at: "2026-10-01T09:00:00Z", next_poll_at: "", tz: "+03:00", restored: false,
        worst: None, accounts: [a], limits: [l] }
    ro r = HistRows{
        accounts: [HistAccount{ id: "db-k", email: "kimi:kimi-code-env-0e4f", color_slot: 0, polls: [] }],
        windows: [HistWindow{ account_id: "db-k", kind: "monthly", model: "", samples: week_samples(), locks: [], rollups: [] }],
    }
    assert(forecast_of(v, l, r, rules(false), NOW_MS, OFFSET_SEC, TimeZone.Utc).is_some())
    // The control: the same account under another file name has no history.
    a.display_name = "kimi-code-env-other"
    ro v2 = SnapshotView{ fetched_at: "2026-10-01T09:00:00Z", next_poll_at: "", tz: "+03:00", restored: false,
        worst: None, accounts: [a], limits: [l] }
    assert(forecast_of(v2, l, r, rules(false), NOW_MS, OFFSET_SEC, TimeZone.Utc).is_none())
}

test "a Codex row finds its history by codex:<lowered address>, not by the Claude account of that address" {
    mut a = account()
    a.email = ""
    a.provider = "codex"
    a.display_name = "Me@Example.com"
    ro l = limit("monthly", 54, 18 * 86400, 30 * 86400)
    ro v = SnapshotView{ fetched_at: "2026-10-01T09:00:00Z", next_poll_at: "", tz: "+03:00", restored: false,
        worst: None, accounts: [a], limits: [l] }
    ro r = HistRows{
        accounts: [HistAccount{ id: "db-c", email: "codex:me@example.com", color_slot: 0, polls: [] },
                   HistAccount{ id: "db-m", email: "me@example.com", color_slot: 1, polls: [] }],
        windows: [HistWindow{ account_id: "db-c", kind: "monthly", model: "", samples: week_samples(), locks: [], rollups: [] }],
    }
    assert(forecast_of(v, l, r, rules(false), NOW_MS, OFFSET_SEC, TimeZone.Utc).is_some())
}

test "with_forecasts fills the row in the snapshot it returns" {
    ro l = limit("session", 28, 2 * 3600, 5 * 3600)
    ro v = with_forecasts(view(l), rows("session", session_samples()), rules(false), NOW_MS, OFFSET_SEC, TimeZone.Utc)
    assert(v.limits.len() == 1)
    assert(v.limits[0].forecast.is_some())
}

/// A snapshot of one provider's account carrying a forecast on its monthly row.
fn paced(provider str, email str, name str) -> SnapshotView {
    mut a = account()
    a.email = email
    a.provider = provider
    a.display_name = name
    mut l = limit("monthly", 54, 18 * 86400, 30 * 86400)
    l.forecast = Some(ForecastView{ percent_at_reset: 120, runs_out_at: "2026-10-05T08:04:00Z", rate_per_hour_milli: 483,
        basis: "calendar", sample_minutes: 1860, label: "ends", warning: true, severity: "warn" })
    SnapshotView{ fetched_at: "2026-10-01T09:00:00Z", next_poll_at: "", tz: "+03:00", restored: false,
        worst: None, accounts: [a], limits: [l] }
}

test "a Kimi account's pace is found by kimi:<name>, a Codex one by codex:<lowered address>, a Claude one by e-mail" {
    ro r = HistRows{
        accounts: [HistAccount{ id: "db-k", email: "kimi:kimi-code-env-0e4f", color_slot: 0, polls: [] },
                   HistAccount{ id: "db-c", email: "codex:me@example.com", color_slot: 1, polls: [] },
                   HistAccount{ id: "db-m", email: "main@example.com", color_slot: 2, polls: [] }],
        windows: [],
    }
    ro k = paces_of(paced("kimi", "", "kimi-code-env-0e4f"), r)
    assert(k.len() == 1 && k[0].account_id == "db-k" && k[0].rate_per_hour_milli == 483)
    ro c = paces_of(paced("codex", "", "Me@Example.com"), r)
    assert(c.len() == 1 && c[0].account_id == "db-c")
    ro m = paces_of(paced("claude", "Main@Example.com", ""), r)
    assert(m.len() == 1 && m[0].account_id == "db-m")
}

test "no pace for an account the history does not know, nor for one with no name to key it by" {
    ro r = HistRows{ accounts: [HistAccount{ id: "db-k", email: "kimi:other", color_slot: 0, polls: [] }], windows: [] }
    assert(paces_of(paced("kimi", "", "kimi-code-env-0e4f"), r).len() == 0)
    assert(paces_of(paced("kimi", "", ""), r).len() == 0)
    assert(paces_of(paced("claude", "", ""), HistRows{ accounts: [HistAccount{ id: "x", email: "", color_slot: 0, polls: [] }], windows: [] }).len() == 0)
}
