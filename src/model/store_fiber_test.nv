// Tests for store_fiber.nv — the request/reply loop (T2.9, T2.13).
//
//   ./nova.sh test src/model/ --filter store_fiber
//
// These are the conditions that stood open with "there is no fiber" beside them.
// `store_test.nv` proves the state machine; this proves something answers.
//
// EVERY TEST RUNS THE FIBER FOR REAL, under `supervised`, and closes the channel to end
// it. A test that called `run` on the same fiber as the caller would deadlock on the
// first reply -- which is itself worth knowing, and is why the shape below is the shape.

module model.store_fiber_test

import std.concurrency.nvchan.{Chan}
import store_fiber.{Envelope, Store, ConfNow, Follower, Followed, STALE_BACKLOG, run}
import claude_limits.config.{Config}
import store.{Snapshot, AccountSlot, Event}
import claude_limits.server.dto.{SnapshotView}

// Boxes for the results that are LISTS. `Chan[[]T]` hits the same defect as
// `Chan[<sum>]`: a pointer-represented element gets no `ChanTx`/`ChanRx`
// instantiation. Same workaround, same marker, so both are removed together.
// [M-chan-envelope-workaround]
type Ids value { ro items []int }
type Evts value { ro items []Event }
type Flags value { ro items []bool }

// Constructors, because an anonymous record literal is refused by codegen -- the same
// reason `discover.nv` gives for `LoginDir.of` and `Folder.of`.
fn Ids.new(items []int) -> Ids => { items }
fn Evts.new(items []Event) -> Evts => { items }
fn Flags.new(items []bool) -> Flags => { items }

// Runs the store in its own fiber, hands `body` its address, then closes the channel so
// the loop ends and the supervised scope can finish.
fn with_store[T](start Snapshot, body fn(Store) -> T) -> T {
    ro pair = Chan[Envelope].new(16)
    ro back = Chan[T].new(1)

    // THE STORE RUNS HERE, NOT IN THE SPAWN, and the checker is why. `run` reaches a
    // `Vec.push` through `merge`, and D446 refuses an unguarded mutation reachable from
    // inside a `spawn`: the fiber may migrate across threads. The diagnostic names three
    // fixes and this is the third -- restructure so the call is not inside a spawn.
    //
    // It is also the shape the application wants: `main` owns the store loop and spawns
    // the server, because the loop is the one thing that must not be preempted between
    // reading a request and answering it.
    //
    // THE BODY'S RESULT COMES BACK BY CHANNEL, not by assigning an outer variable --
    // which would be the very unguarded write the checker refuses, and rightly: a value
    // written from a fiber and read after `supervised` is a race the type system cannot
    // see. Same discipline as the store itself.
    supervised {
        spawn {
            ro got = body(Store.new(pair.tx))
            // The harness's own result channel: if it is closed the test body has
            // already ended, and `run` below answers a missing value with its default.
            // nova:allow W_RESULT_DISCARDED -- see above
            ro _ = back.tx.send(got)
            // Closing ends the loop, which lets the supervised scope finish. Without it
            // `run` waits in `recv` forever -- a hang, not a failure.
            pair.tx.close()
        }
        run(pair.rx, start)
    }

    // The panic is unreachable while the body always sends: `supervised` has already
    // joined the fiber by here, so the value is either in the channel or the fiber
    // panicked -- and a panic would have surfaced before this line.
    back.rx.recv() ?? panic("the store body produced no result")
}

test "request/reply answers: an empty store gives an empty snapshot" {
    // The first of T2.9's two open conditions. Before the fiber there was nobody to
    // ask, and the condition was not "unproven" but unaskable.
    ro snap = with_store(Snapshot.empty(), fn(s Store) -> Snapshot => s.snapshot())
    assert(snap.accounts.len() == 0)
    assert(!snap.restored)
}

test "a merge is visible to the next reader, and only one row per account" {
    ro snap = with_store(Snapshot.empty(), fn(s Store) -> Snapshot {
        // Delivery is asserted, not assumed: `merge` awaits no reply, so a store
        // that had already gone would swallow both readings and every assertion
        // below would still pass on the snapshot this test built itself.
        assert(s.merge(AccountSlot.new("a@b.c", "ok", 1000, 3)))
        assert(s.merge(AccountSlot.new("a@b.c", "ok", 2000, 4)))
        s.snapshot()
    })
    // Two readings of ONE account are one row -- appending would grow the page by a
    // row per tick, which is the failure `merge` was written against.
    assert(snap.accounts.len() == 1)
    assert(snap.accounts[0].polled_at_ms == 2000)
    assert(snap.fetched_at_ms == 2000)
}

test "a restored snapshot arrives restored, and its accounts survive the replay" {
    // T2.9's second condition, the positive half. The negative half ("a fresh snapshot
    // is NOT marked restored") is the test above, and both are needed: a `restored`
    // that is always true would pass one and fail the other.
    mut start = Snapshot.empty()
    start.accounts.push(AccountSlot.new("kept@example.com", "ok", 500, 2))
    start.fetched_at_ms = 500
    start.restored = true

    ro snap = with_store(start, fn(s Store) -> Snapshot => s.snapshot())
    assert(snap.restored)
    assert(snap.accounts.len() == 1)
    assert(snap.accounts[0].email == "kept@example.com")
    assert(snap.fetched_at_ms == 500)
}

test "subscribers get monotonic ids from the fiber, and the 33rd is refused" {
    // The registry already pinned this; what is new is that it holds ACROSS the
    // boundary -- ids handed out by one fiber to callers that never touch the registry.
    ro box = with_store(Snapshot.empty(), fn(s Store) -> Ids {
        mut got = []int.new()
        mut i = 0
        while i < 33 {
            got.push(s.subscribe())
            i = i + 1
        }
        Ids.new(got)
    })
    ro ids = box.items
    assert(ids.len() == 33)
    assert(ids[0] > 0)
    assert(ids[1] > ids[0])
    // The 33rd is refused with -1, which is `subscribe`'s own signal for "full" --
    // NOT 0, which is what I assumed and what the test asserted until it failed.
    // The two are different answers and both matter: -1 means the fiber replied and
    // said no; 0 means nothing replied at all (see `Store @subscribe`).
    assert(ids[32] == 0 - 1)
    // And the 32nd is not -- the limit is not off by one.
    assert(ids[31] > 0)
}

test "publish assigns an id and `since` returns what came after it" {
    ro box = with_store(Snapshot.empty(), fn(s Store) -> Evts {
        ro _ = s.subscribe()
        ro first = s.publish("snapshot", "{}")
        assert(first.is_some())
        ro _ = s.publish("snapshot", "{\"n\":2}")
        ro _ = s.publish("snapshot", "{\"n\":3}")
        Evts.new(s.since(first!!.id))
    })
    ro evts = box.items
    // Everything AFTER the first, not including it.
    assert(evts.len() == 2)
    assert(evts[0].data.contains("2"))
    assert(evts[1].data.contains("3"))
}

test "a cursor that has fallen off the ring is reported as missed" {
    ro box = with_store(Snapshot.empty(), fn(s Store) -> Flags {
        ro _ = s.subscribe()
        ro e = s.publish("snapshot", "{}")
        mut out = []bool.new()
        // A live cursor has not missed anything...
        out.push(s.missed(e!!.id))
        // ...and one from before the ring began has.
        out.push(s.missed(0 - 500))
        Flags.new(out)
    })
    ro answers = box.items
    assert(!answers[0])
    assert(answers[1])
}

// -- the snapshot body (T2.27 step B2) ----------------------------------------

fn body_marked(at str) -> SnapshotView => {
    fetched_at: at, next_poll_at: "", tz: "", restored: false, worst: None,
    accounts: [], limits: [],
}

test "before the first poll the store answers the empty body, not a stale one" {
    ro at = with_store(Snapshot.empty(), fn(s Store) -> str => s.view().fetched_at)
    assert(at == "")
}

test "a body set by the poller is the body the next reader gets" {
    ro at = with_store(Snapshot.empty(), fn(s Store) -> str => {
        ro _ = s.set_view(body_marked("2026-09-30T09:00:00Z"))
        ro _ = s.set_view(body_marked("2026-09-30T09:05:00Z"))
        s.view().fetched_at
    })
    // The LATER one: a store that kept the first would show a page five minutes old.
    assert(at == "2026-09-30T09:05:00Z")
}

// -- the settings (T2.14: `PUT /api/config` changes what every reader sees) --

fn conf_with_interval(n int) -> ConfNow {
    mut c = Config.defaults()
    c.poll.interval_sec = n
    ConfNow.new(c, "\"t-${n}\"", ConfNow.none().loaded)
}

test "the settings start empty-tagged, and a set is what the next reader gets" {
    // The empty tag is the point of `none`: no `If-Match` equals it, so a save cannot
    // pass against a store that was never handed the real settings.
    ro first = with_store(Snapshot.empty(), fn(s Store) -> ConfNow => s.conf())
    assert(first.tag == "")
    ro got = with_store(Snapshot.empty(), fn(s Store) -> ConfNow {
        assert(s.set_conf(conf_with_interval(120)))
        s.conf()
    })
    assert(got.tag == "\"t-120\"")
    assert(got.cfg.poll.interval_sec == 120)
}

// -- live streams (T2.13): the store hands each stream its own channel --

fn stream_pair() -> Follower {
    ro p = Chan[Event].new(128)
    Follower.unregistered(p.tx, p.rx)
}

type Opened value { ro got Followed, ro first Event, ro snap_id_reused bool }
fn Opened.new(got Followed, first Event, snap_id_reused bool) -> Opened => { got, first, snap_id_reused }

test "a new stream opens fresh, its snapshot id is its own, and later events reach it" {
    ro o = with_store(Snapshot.empty(), fn(s Store) -> Opened {
        ro f = stream_pair()
        ro got = s.follow(-1, f)
        ro ev = s.publish("snapshot", "{\"n\":1}") ?? Event.new(0, "", "")
        Opened.new(got, f.rx.try_recv() ?? Event.new(0, "", ""), ev.id == got.snapshot_id)
    })
    assert(o.got.id > 0)
    assert(o.got.fresh)
    // An opening snapshot that shared its id with the next event would make a client
    // returning with that id skip the event.
    assert(!o.snap_id_reused)
    assert(o.first.name == "snapshot")
    assert(o.first.data == "{\"n\":1}")
}

test "a stream that comes back with Last-Event-ID is caught up from the ring, not refreshed" {
    ro o = with_store(Snapshot.empty(), fn(s Store) -> Opened {
        ro a = s.publish("snapshot", "1") ?? Event.new(0, "", "")
        ro _b = s.publish("config", "2")
        ro _c = s.publish("snapshot", "3")
        ro f = stream_pair()
        ro got = s.follow(a.id, f)
        Opened.new(got, f.rx.try_recv() ?? Event.new(0, "", ""), false)
    })
    assert(!o.got.fresh)
    assert(o.first.name == "config")
    assert(o.first.data == "2")
}

type Ids2 value { ro last int, ro after_reap int }
fn Ids2.new(last int, after_reap int) -> Ids2 => { last, after_reap }

test "the thirty-third stream is refused, and streams nobody reads are dropped by the pings" {
    // Polaris has no "client went away" hook. A closed tab stops reading; four pings
    // unread drop it. Without that, 32 closed tabs would lock the page out with 503.
    ro r = with_store(Snapshot.empty(), fn(s Store) -> Ids2 {
        mut i = 0
        while i < 32 {
            ro _ = s.follow(-1, stream_pair())
            i += 1
        }
        ro over = s.follow(-1, stream_pair())
        mut k = 0
        while k < STALE_BACKLOG + 1 {
            assert(s.ping("2026-10-02T00:00:00Z"))
            k += 1
        }
        ro again = s.follow(-1, stream_pair())
        Ids2.new(over.id, again.id)
    })
    assert(r.last == -1)
    assert(r.after_reap > 0)
}

test "a stream that reads is not dropped by the pings" {
    ro alive = with_store(Snapshot.empty(), fn(s Store) -> bool {
        ro f = stream_pair()
        ro _ = s.follow(-1, f)
        mut k = 0
        mut got_all = true
        while k < STALE_BACKLOG + 2 {
            assert(s.ping("2026-10-02T00:00:00Z"))
            // The store answers in order, so a reply to this request means the ping
            // before it has been delivered.
            ro _v = s.view()
            match f.rx.try_recv() {
                Some(e) => { if e.name != "ping" { got_all = false } }
                None => { got_all = false }
            }
            k += 1
        }
        got_all && !f.rx.is_closed()
    })
    assert(alive)
}

// -- the count `/api/health.sse_clients` reads, and the keep-alive at silence (task 7) --

type Counts value { ro open int, ro after_leave int }
// A list through the harness's channel: boxed. [M-chan-envelope-workaround]
type Names value { ro items []str }
fn Names.new(items []str) -> Names => { items }
fn Counts.new(open int, after_leave int) -> Counts => { open, after_leave }

test "the store counts the open streams, and a client that went away leaves the count" {
    // A closed tab stops reading (Polaris says nothing when a client leaves). Its
    // backlog then fills, and the pings take it off the count; the tab that keeps
    // reading stays counted.
    ro c = with_store(Snapshot.empty(), fn(s Store) -> Counts {
        ro reading = stream_pair()
        ro _a = s.follow(-1, reading)
        ro _b = s.follow(-1, stream_pair())
        ro open = s.clients()
        mut k = 0
        while k < STALE_BACKLOG + 1 {
            assert(s.ping("2026-10-08T00:00:00Z"))
            ro _v = s.view()
            // nova:allow W_RESULT_DISCARDED -- the reader only drains; what it read is the other test's
            ro _r = reading.rx.try_recv()
            k += 1
        }
        Counts.new(open, s.clients())
    })
    assert(c.open == 2)
    assert(c.after_leave == 1)
}

test "a refused stream is not counted, and a store with no streams counts zero" {
    ro c = with_store(Snapshot.empty(), fn(s Store) -> Counts {
        ro none = s.clients()
        mut i = 0
        while i < 33 {
            ro _ = s.follow(-1, stream_pair())
            i += 1
        }
        Counts.new(none, s.clients())
    })
    assert(c.open == 0)
    assert(c.after_leave == 32)
}

test "the keep-alive goes out at silence, and not right after an event" {
    // 01.3 section 3.4: `ping` every 30 s "при тишине". A round's snapshot is traffic:
    // the tick after it sends nothing, the tick after that -- silence -- pings.
    ro got = with_store(Snapshot.empty(), fn(s Store) -> Names {
        ro f = stream_pair()
        ro _ = s.follow(-1, f)
        assert(s.ping("2026-10-08T00:00:00Z"))
        ro _e = s.publish("snapshot", "{}")
        assert(s.ping("2026-10-08T00:00:30Z"))
        assert(s.ping("2026-10-08T00:01:00Z"))
        ro _v = s.view()
        mut out []str = []
        mut more = true
        while more {
            match f.rx.try_recv() {
                Some(e) => out.push("${e.name} ${e.data}")
                None => { more = false }
            }
        }
        Names.new(out)
    })
    ro names = got.items
    assert(names.len() == 3)
    assert(names[0] == "ping {\"at\":\"2026-10-08T00:00:00Z\"}")
    assert(names[1] == "snapshot {}")
    assert(names[2] == "ping {\"at\":\"2026-10-08T00:01:00Z\"}")
}
