// startup.nv — the database at the start of --serve: key, file, migrations, owner.
//
//   ./nova.sh test src/storage/ --filter startup_test
//
// Source: 01.2 §1 (key and instance), §3.1 (open with the key), §3.3 (`schema_meta`),
// §5 (a backup before every migration, one transaction per migration).
//
// WHY A FILE OF ITS OWN. `db.nv` answers "what is in there" and applies ONE migration;
// `backup.nv` copies a file. Nothing said, in order, "open, back up if there is
// something to lose, migrate, claim" -- plan 01.5 T2.2 left that out by its own
// boundary, and no card took it (a seam, found 2026-09-30 when --serve was to open
// the database). This is that order, and nothing else.

module storage.startup

import std.fs.{create_dir_all}
import duckdb.db_effect.{Db, ConnRef}
import duckdb.errors.{DbOptions, DuckError}
import claude_limits.storage.paths.{Paths, dir_of}
import claude_limits.storage.db.{Migration, Opened, OpenFail, pending, ensure_key, ensure_instance, open_and_read, apply_migration, claim, KNOWN_SCHEMA}
import claude_limits.storage.history_import.{read_reference, import_sql, FIRST_SQL, DROP_FIRST_SQL, STAGE_SQL, drop_stage_sql, stage_sql, rebuild_sql}
import claude_limits.storage.backup.{take_backup, list_names, weekly_due, write_copy, fresh_path, swap_in_fresh}
import claude_limits.storage.repo.{forget, Forgot}
import std.fs.{try_exists}
import claude_limits.storage.maintenance.{Policy, run_retention, zone_step, ZoneStep, set_zone_sql, zone_log_line}
import duckdb.types.{Value}
import claude_limits.storage.repo.{write_tick, config_history_sql}
import claude_limits.storage.tick.{tick_of, fresh_ids}
import claude_limits.usage.poller.{Reading}
import claude_limits.storage.history_read.{read_history, read_folder_history, read_history_days}
import claude_limits.storage.history_rows.{HistRows, HistFolderRows}
import claude_limits.storage.discovery_write.{Discovered, DiscoveryIds, record_discovery}
import std.identifiers.uuid.{Uuid}

/// The migration files, in the binary (01.2 §5: `embed_dir("migrations")`).
/// `../../`: the path is relative to THIS file (`src/storage/`).
export fn bundled() -> EmbeddedDir => embed_dir("../../migrations")

/// `0001_init.sql` -> 1. A name that does not start with digits and `_` is not a
/// migration and is skipped, not guessed at.
export fn version_of(name str) -> int {
    ro base = match name.rsplit_once("/") {
        Some(pair) => pair.1
        None => name
    }
    ro head = match base.split_once("_") {
        Some(pair) => pair.0
        None => return 0
    }
    if !base.ends_with(".sql") { return 0 }
    head.to_int() ?? 0
}

/// Every migration in `dir`, unsorted -- `db.pending` orders them by version.
export fn migrations_in(dir EmbeddedDir) -> []Migration {
    mut out []Migration = []
    for p in dir.paths() {
        ro v = version_of(p)
        if v <= 0 { continue }
        match dir.get(p) {
            Some(bytes) => out.push(Migration.new(v, bytes.to_str_lossy()))
            None => ()
        }
    }
    out
}

/// What the start did to the database.
export type Ready value {
    ro opened Opened
    /// How many migrations ran now.
    ro applied int
    /// The backup taken before them, or "" when there was nothing to lose.
    ro backup str
    /// What the start's upkeep did, for the log.
    ro upkeep Upkept
}

/// The settings a start's upkeep obeys: `[history]` and the machine's rollup zone
/// (`maintenance.machine_rollup_tz`).
export type Upkeep value {
    ro keep_days int
    ro rollup_keep_days int
    ro config_versions_keep int
    ro tz str
}

export fn Upkeep.new(keep_days int, rollup_keep_days int, config_versions_keep int, tz str) -> Upkeep =>
    { keep_days, rollup_keep_days, config_versions_keep, tz }

/// What it did. Every field "" is "nothing to say"; none of them stops the start.
export type Upkept value {
    /// The rollup zone written or moved (01.2 section 3.13), as a log line.
    ro zone str
    /// Why the retention pass did not run to its end.
    ro retention_fail str
    /// The weekly backup taken, by name.
    ro weekly str
    /// Why the weekly backup was not taken.
    ro weekly_fail str
}

fn upkept(zone str, retention_fail str, weekly str, weekly_fail str) -> Upkept =>
    { zone, retention_fail, weekly, weekly_fail }

/// Why the database is not ready. The key and the schema keep `OpenFail`'s own
/// exit codes and texts; a failed backup or migration is 5, as a refusal is.
export type StartFail enum
    | Open(OpenFail)
    | Backup(str)
    | Migrate(str)

export fn StartFail @exit_code() -> int =>
    match @ {
        Open(f) => f.exit_code()
        Backup(_) => 5
        Migrate(_) => 5
    }

export fn StartFail @message(key_path str) -> str =>
    match @ {
        Open(f) => f.message(key_path)
        // Nothing was migrated: the backup comes first, so a failed one stops here.
        Backup(m) => "the backup before the migration failed, nothing was changed: ${m}"
        Migrate(m) => "a migration failed and was rolled back: ${m}"
    }

/// Open the database for --serve.
///
/// THE BACKUP ONLY WHEN THERE IS SOMETHING TO LOSE: an existing database with
/// migrations pending. A first start has no data, and a current schema has nothing
/// to migrate.
///
/// After the migrations and the claim, the UPKEEP of 01.2 section 5 runs here, because
/// a start is the one moment the server is sure to have (found 2026-10-01: the
/// functions were written in T2.6 and nothing called them -- no rollup, no retention,
/// no weekly backup, ever). It never stops the start: a failed pass is a log line, and
/// the history it would have tidied is still there to read.
export fn open_for_serve(p Paths, all []Migration, now_ms int, keep int, windows bool, u Upkeep) Db Fs Random -> Result[Ready, StartFail] {
    ro key = ensure_key(p.key_file, dir_of(p.key_file, windows)).map_err(fn(f OpenFail) -> StartFail => StartFail.Open(f))?
    ro mine = ensure_instance(p.instance_file, dir_of(p.instance_file, windows))
    // DuckDB creates the file, not its directory.
    ro _ = create_dir_all(p.data_dir.to_path())
    ro opened = open_and_read(p.db_file, key, p.temp_dir, mine).map_err(fn(f OpenFail) -> StartFail => StartFail.Open(f))?
    ro todo = pending(opened.schema_version, all)

    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    opts.temp_dir = p.temp_dir
    ro db = Db.open(p.db_file, opts).map_err(fn(e DuckError) -> StartFail => StartFail.Open(OpenFail.DbRefused(e.message())))?
    ro conn = match Db.connect(db) {
        Ok(c) => c
        Err(e) => {
            Db.close_db(db)
            return Err(StartFail.Open(OpenFail.DbRefused(e.message())))
        }
    }
    ro r = migrate_and_claim(conn, opened, todo, p, now_ms, keep, windows, key, mine, u)
    Db.close_conn(conn)
    Db.close_db(db)
    r
}

/// Write one tick per reading into the database `open_for_serve` prepared, and answer
/// how many were written.
///
/// `emails`/`orgs` are parallel: the organisation is a property discovery found, not
/// something the endpoint says, so it comes from the caller. The key and the instance
/// are read from their files again rather than passed around: a key held in a value
/// the server carries is a key one log line away from the log.
export fn record_readings(p Paths, rs []Reading, emails []str, orgs []str, windows bool) Db Fs Random -> Result[int, StartFail] {
    ro key = ensure_key(p.key_file, dir_of(p.key_file, windows)).map_err(fn(f OpenFail) -> StartFail => StartFail.Open(f))?
    ro mine = ensure_instance(p.instance_file, dir_of(p.instance_file, windows))
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    opts.temp_dir = p.temp_dir
    ro db = Db.open(p.db_file, opts).map_err(fn(e DuckError) -> StartFail => StartFail.Open(OpenFail.DbRefused(e.message())))?
    ro conn = match Db.connect(db) {
        Ok(c) => c
        Err(e) => {
            Db.close_db(db)
            return Err(StartFail.Open(OpenFail.DbRefused(e.message())))
        }
    }
    mut written = 0
    mut failed = ""
    for r in rs {
        ro t = tick_of(r, org_for(r.email, emails, orgs), mine)
        match write_tick(conn, t, fresh_ids(t)) {
            Ok(_) => { written += 1 }
            Err(e) => { failed = "${r.email}: ${e.message()}" }
        }
    }
    Db.close_conn(conn)
    Db.close_db(db)
    if failed != "" { return Err(StartFail.Migrate("a tick was not written: ${failed}")) }
    Ok(written)
}

/// Write what the round's discovery found: folders, login directories, and who sits
/// in each (01.2 section 3.4-3.7). After `record_readings`, on purpose: an occupancy
/// row names its account, and the account row is written by the round's ticks.
/// The upkeep of a running server, once a local day (01.2 section 5: "once a day after
/// midnight"): the same pass a start runs, on the database the start already opened
/// and migrated -- so never as a first start, and the weekly backup only when due.
export fn upkeep_daily(p Paths, u Upkeep, now_ms int, keep int, windows bool) Db Fs Random -> Result[Upkept, StartFail] {
    ro key = ensure_key(p.key_file, dir_of(p.key_file, windows)).map_err(fn(f OpenFail) -> StartFail => StartFail.Open(f))?
    ro mine = ensure_instance(p.instance_file, dir_of(p.instance_file, windows))
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    opts.temp_dir = p.temp_dir
    ro db = Db.open(p.db_file, opts).map_err(fn(e DuckError) -> StartFail => StartFail.Open(OpenFail.DbRefused(e.message())))?
    ro conn = match Db.connect(db) {
        Ok(c) => c
        Err(e) => {
            Db.close_db(db)
            return Err(StartFail.Open(OpenFail.DbRefused(e.message())))
        }
    }
    ro done = upkeep_at_start(conn, false, p, u, now_ms, keep, windows, key, mine)
    Db.close_conn(conn)
    Db.close_db(db)
    Ok(done)
}

export fn record_found(p Paths, d Discovered, at_ms int, windows bool) Db Fs Random -> Result[int, StartFail] {
    ro key = ensure_key(p.key_file, dir_of(p.key_file, windows)).map_err(fn(f OpenFail) -> StartFail => StartFail.Open(f))?
    ro mine = ensure_instance(p.instance_file, dir_of(p.instance_file, windows))
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    opts.temp_dir = p.temp_dir
    ro db = Db.open(p.db_file, opts).map_err(fn(e DuckError) -> StartFail => StartFail.Open(OpenFail.DbRefused(e.message())))?
    ro conn = match Db.connect(db) {
        Ok(c) => c
        Err(e) => {
            Db.close_db(db)
            return Err(StartFail.Open(OpenFail.DbRefused(e.message())))
        }
    }
    mut folders []str = []
    for _ in d.folders { folders.push(Uuid.v7().to_str()) }
    mut dirs []str = []
    mut occupancy []str = []
    for _ in d.dirs {
        dirs.push(Uuid.v7().to_str())
        occupancy.push(Uuid.v7().to_str())
    }
    ro got = record_discovery(conn, mine, at_ms, d.folders, d.dirs, DiscoveryIds{ folders, dirs, occupancy })
    Db.close_conn(conn)
    Db.close_db(db)
    match got {
        Ok(_) => Ok(d.dirs.len())
        Err(e) => Err(StartFail.Migrate("the discovery was not written: ${e.message()}"))
    }
}

/// Keep one previous version of the settings file (01.2 §3.14), before a save
/// overwrites it. `toml` is already redacted -- `config_file.save` hands it over that
/// way, so no caller can keep a token by forgetting to.
///
/// Its own open and close, like every write here: the server's fiber calls it, and the
/// database is not held open across requests.
export fn record_config_version(p Paths, toml str, source str, at_ms int, windows bool) Db Fs Random -> Result[(), str] {
    ro key_file = p.key_file
    ro key = ensure_key(key_file, dir_of(key_file, windows)).map_err(fn(f OpenFail) -> str => f.message(key_file))?
    ro mine = ensure_instance(p.instance_file, dir_of(p.instance_file, windows))
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    opts.temp_dir = p.temp_dir
    ro db = Db.open(p.db_file, opts).map_err(fn(e DuckError) -> str => "the database did not open: ${e.message()}")?
    ro conn = match Db.connect(db) {
        Ok(c) => c
        Err(e) => {
            Db.close_db(db)
            return Err("the database refused a connection: ${e.message()}")
        }
    }
    ro got = Db.exec(conn, config_history_sql(Uuid.v7().to_str(), at_ms, mine, source, toml))
    Db.close_conn(conn)
    Db.close_db(db)
    match got {
        Ok(_) => Ok(())
        Err(e) => Err("the previous settings were not kept: ${e.message()}")
    }
}

/// What `forget` did, for the person who asked.
export type ForgetDone enum
    /// There is no database yet: nothing was ever written about anyone.
    | NoDatabase
    /// No account has this address; nothing was touched.
    | NoSuchAccount
    /// Gone. The backup taken right after, and how many OLDER backups still hold the
    /// address -- they are the owner's to delete; the command does not touch them.
    | Forgotten(str, int)

/// `claude-limits forget <email>` (01.2 section 3.15, task T2.7): the steps of
/// `repo.forget`, then a fresh backup, then the COMPACTION the section requires --
/// DuckDB frees deleted blocks without overwriting them, so the address stays in the
/// file's bytes until the live rows are written to a new file that takes its place.
///
/// The order is `forget_test`'s, which holds it: forget, back up (a backup copies live
/// rows only, so it is clean), copy, CLOSE, swap -- nothing may write after the copy.
/// The backup is the "last backup" 01.2 section 3.15 searches; older ones are named, not
/// deleted: removing a person's backups is not a decision a command makes on its own.
export fn forget_account(p Paths, email str, now_ms int, keep int, windows bool) Db Fs Random -> Result[ForgetDone, StartFail] {
    if !(try_exists(p.db_file.to_path()) ?? false) { return Ok(ForgetDone.NoDatabase) }
    ro key = ensure_key(p.key_file, dir_of(p.key_file, windows)).map_err(fn(f OpenFail) -> StartFail => StartFail.Open(f))?
    ro mine = ensure_instance(p.instance_file, dir_of(p.instance_file, windows))
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    opts.temp_dir = p.temp_dir
    ro db = Db.open(p.db_file, opts).map_err(fn(e DuckError) -> StartFail => StartFail.Open(OpenFail.DbRefused(e.message())))?
    ro conn = match Db.connect(db) {
        Ok(c) => c
        Err(e) => {
            Db.close_db(db)
            return Err(StartFail.Open(OpenFail.DbRefused(e.message())))
        }
    }
    ro older = list_names(p.backup_dir).len()
    ro got = forget(conn, email, mine, now_ms)
    mut backup = ""
    mut fail = ""
    match got {
        Ok(Forgot.Forgotten(_)) => {
            match take_backup(conn, p.backup_dir, now_ms, keep, windows, key) {
                Ok(name) => { backup = name }
                Err(e) => { fail = "the backup after forget failed: ${e.message()}" }
            }
            if fail == "" {
                match write_copy(conn, fresh_path(p.db_file), key) {
                    Ok(_) => ()
                    Err(e) => { fail = "the compacted copy failed: ${e.message()}" }
                }
            }
        }
        _ => ()
    }
    Db.close_conn(conn)
    Db.close_db(db)
    match got {
        Err(e) => return Err(StartFail.Migrate("forget stopped part-way, run it again to finish: ${e.message()}"))
        Ok(Forgot.NoSuchAccount) => return Ok(ForgetDone.NoSuchAccount)
        Ok(Forgot.Forgotten(_)) => ()
    }
    if fail != "" { return Err(StartFail.Migrate(fail)) }
    match swap_in_fresh(p.db_file) {
        Ok(_) => Ok(ForgetDone.Forgotten(backup, older))
        Err(e) => Err(StartFail.Migrate("the compacted file did not take the old one's place: ${e.message()}"))
    }
}

/// What `claude-limits import-history <file>` did.
export type Imported enum
    /// No database yet: nothing to import into (the points need its known cycles).
    | NoDatabase
    /// The database's schema is older than this build -- the start migrates it.
    | Older(int)
    /// Done: points read, points skipped by the file's own shape, points written, and
    /// the backup taken before the writes.
    | Done(int, int, int, str)

/// `claude-limits import-history <file>` (plan 01.6, question 1): the reference's
/// history into `sample`, under the rules of `history_import.nv`. A backup first; the
/// writes in one transaction, so a failure leaves the file as it was.
///
/// The server does not hold the file between rounds (`read_history_rows`), so this runs
/// beside it; a round that opens the file in that second waits for the next one.
export fn import_history(p Paths, body str, now_ms int, keep int, windows bool) Db Fs Random -> Result[Imported, str] {
    if !(try_exists(p.db_file.to_path()) ?? false) { return Ok(Imported.NoDatabase) }
    ro parsed = read_reference(body).map_err(fn(m str) -> str => "the file is ${m}")?
    ro key_file = p.key_file
    ro key = ensure_key(key_file, dir_of(key_file, windows)).map_err(fn(f OpenFail) -> str => f.message(key_file))?
    ro mine = ensure_instance(p.instance_file, dir_of(p.instance_file, windows))
    ro opened = open_and_read(p.db_file, key, p.temp_dir, mine).map_err(fn(f OpenFail) -> str => f.message(key_file))?
    if opened.schema_version < KNOWN_SCHEMA { return Ok(Imported.Older(opened.schema_version)) }
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    opts.temp_dir = p.temp_dir
    ro db = Db.open(p.db_file, opts).map_err(fn(e DuckError) -> str => "the database did not open: ${e.message()}")?
    ro conn = match Db.connect(db) {
        Ok(c) => c
        Err(e) => {
            Db.close_db(db)
            return Err("the database refused a connection: ${e.message()}")
        }
    }
    mut fail = ""
    mut backup = ""
    match take_backup(conn, p.backup_dir, now_ms, keep, windows, key) {
        Ok(name) => { backup = name }
        Err(e) => { fail = "the backup before the import failed, nothing was written: ${e.message()}" }
    }
    mut written = 0
    if fail == "" {
        ro inserts = import_sql(parsed.points, mine, now_ms)
        mut steps = ["BEGIN TRANSACTION", FIRST_SQL]
        for s in inserts { steps.push(s) }
        // Then what the known cycles could not take: accounts, windows and cycles built
        // from the file itself (history_import.nv, "the rest of the file").
        steps.push(STAGE_SQL)
        for s in stage_sql(parsed.points) { steps.push(s) }
        for s in rebuild_sql(mine, now_ms) { steps.push(s) }
        for s in drop_stage_sql() { steps.push(s) }
        steps.push(DROP_FIRST_SQL)
        steps.push("COMMIT")
        for s in steps {
            if fail == "" {
                match Db.exec(conn, s) {
                    Ok(n) => { if s.starts_with("INSERT INTO sample") { written += n } }
                    Err(e) => {
                        ro _ = Db.exec(conn, "ROLLBACK")
                        fail = "the import failed and was rolled back: ${e.message()}"
                    }
                }
            }
        }
        if fail == "" { ro _ = Db.exec(conn, "CHECKPOINT") }
    }
    Db.close_conn(conn)
    Db.close_db(db)
    if fail != "" { return Err(fail) }
    Ok(Imported.Done(parsed.points.len(), parsed.skipped, written, backup))
}

/// The rows of `/api/history` for `[from, to)`, or the reason they are not there.
///
/// Opened, read and closed per request, like `record_readings` per round: the file is
/// not held open by the server. The reason is a log line, never the answer's body
/// (01.3 §6: a 500 says `internal` and nothing about the inside).
///
/// `by_folder` reads the directories and their journal too, and the accounts' history
/// for the accounts the journal names (`read_folder_history`); otherwise `dirs` and
/// `occupancy` come back empty.
export fn read_history_rows(p Paths, from_ms int, to_ms int, accounts []str, dirs []str, by_folder bool, windows bool) Db Fs Random -> Result[HistFolderRows, str] {
    ro key_file = p.key_file
    ro key = ensure_key(key_file, dir_of(key_file, windows)).map_err(fn(f OpenFail) -> str => f.message(key_file))?
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    opts.temp_dir = p.temp_dir
    ro db = Db.open(p.db_file, opts).map_err(fn(e DuckError) -> str => "the database did not open: ${e.message()}")?
    ro conn = match Db.connect(db) {
        Ok(c) => c
        Err(e) => {
            Db.close_db(db)
            return Err("the database refused a connection: ${e.message()}")
        }
    }
    ro got = if by_folder {
        read_folder_history(conn, from_ms, to_ms, dirs)
    } else {
        read_history(conn, from_ms, to_ms, accounts).map(fn(r HistRows) -> HistFolderRows => accounts_only(r))
    }
    Db.close_conn(conn)
    Db.close_db(db)
    match got {
        Ok(rows) => Ok(rows)
        Err(e) => Err("the history was not read: ${e.message()}")
    }
}

/// How many calendar days the database holds readings for, for `/api/health`.
///
/// Opened, read and closed per call, like `read_history_rows`. A database that does
/// not answer is `Err`, and the caller reports 0 days (the log says why).
export fn read_history_days_in(p Paths, windows bool) Db Fs Random -> Result[int, str] {
    ro key_file = p.key_file
    ro key = ensure_key(key_file, dir_of(key_file, windows)).map_err(fn(f OpenFail) -> str => f.message(key_file))?
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    opts.temp_dir = p.temp_dir
    ro db = Db.open(p.db_file, opts).map_err(fn(e DuckError) -> str => "the database did not open: ${e.message()}")?
    ro conn = match Db.connect(db) {
        Ok(c) => c
        Err(e) => {
            Db.close_db(db)
            return Err("the database refused a connection: ${e.message()}")
        }
    }
    ro got = read_history_days(conn)
    Db.close_conn(conn)
    Db.close_db(db)
    match got {
        Ok(n) => Ok(n)
        Err(e) => Err("the history days were not counted: ${e.message()}")
    }
}

/// A `by=account` read in the shape both reads share. A named function: an anonymous
/// record literal inside the lambda is refused by codegen ("without spread not
/// supported"), and a typed one is refused by the checker as a redundant prefix --
/// no spelling compiles there (`probes/lambda-record-literal-no-spelling/`).
fn accounts_only(r HistRows) -> HistFolderRows => { dirs: [], occupancy: [], rows: r }

fn org_for(email str, emails []str, orgs []str) -> str {
    mut i = 0
    while i < emails.len() && i < orgs.len() {
        if emails[i] == email { return orgs[i] }
        i += 1
    }
    ""
}

fn migrate_and_claim(conn ConnRef, opened Opened, todo []Migration, p Paths, now_ms int, keep int, windows bool, key str, mine str, u Upkeep) Db Fs -> Result[Ready, StartFail] {
    mut backup = ""
    if !opened.first_start && todo.len() > 0 {
        match take_backup(conn, p.backup_dir, now_ms, keep, windows, key) {
            Ok(name) => { backup = name }
            Err(e) => return Err(StartFail.Backup(e.message()))
        }
    }
    for m in todo {
        match apply_migration(conn, m) {
            Ok(_) => ()
            Err(e) => return Err(StartFail.Migrate("${m.version}: ${e.message()}"))
        }
    }
    match claim(conn, mine) {
        Ok(_) => ()
        Err(e) => return Err(StartFail.Migrate("claim: ${e.message()}"))
    }
    ro done = upkeep_at_start(conn, opened.first_start, p, u, now_ms, keep, windows, key, mine)
    Ok({ opened, applied: todo.len(), backup, upkeep: done })
}

fn first_text(conn ConnRef, sql str) Db -> str {
    ro rows = Db.query(conn, sql) ?? return ""
    ro got = match Db.next(rows) {
        Ok(Some(cells)) => if cells.len() > 0 { match cells[0] { Value.Text(s) => s, _ => "" } } else { "" }
        _ => ""
    }
    Db.close_result(rows)
    got
}

/// The upkeep of 01.2 section 5 that a start can do: the rollup zone, one retention
/// pass, and the weekly backup when one is due.
///
/// The pass is IDEMPOTENT (maintenance_test: twice in a row changes nothing) and works
/// in whole days, so running it at every start rather than "once a day after midnight"
/// costs one transaction that finds nothing to do. When the rounds repeat, the daily
/// schedule is a timer around this same call.
fn upkeep_at_start(conn ConnRef, first bool, p Paths, u Upkeep, now_ms int, keep int, windows bool, key str, mine str) Db Fs -> Upkept {
    mut zone = ""
    ro stored = first_text(conn, "SELECT value FROM schema_meta WHERE key = 'rollup_tz'")
    match zone_step(stored, u.tz) {
        ZoneStep.Same => ()
        ZoneStep.Moved(from, to) => {
            match Db.exec(conn, set_zone_sql(to)) {
                Err(e) => { zone = "rollup zone NOT written (${to}): ${e.message()}" }
                Ok(_) => {
                    ro kept = first_text(conn, "SELECT count(*)::VARCHAR FROM daily_rollup").to_int() ?? 0
                    zone = if from == "" { "rollup zone set to ${to}" } else { zone_log_line(from, to, kept) }
                }
            }
        }
    }
    ro policy = Policy.new(u.keep_days, u.rollup_keep_days, u.config_versions_keep, u.tz)
    ro retention_fail = match run_retention(conn, policy, now_ms, mine) {
        Ok(_) => ""
        Err(e) => e.message()
    }
    mut weekly = ""
    mut weekly_fail = ""
    // Not on a first start: a backup of an empty file protects nothing.
    if !first && weekly_due(list_names(p.backup_dir), now_ms) {
        match take_backup(conn, p.backup_dir, now_ms, keep, windows, key) {
            Ok(name) => { weekly = name }
            Err(e) => { weekly_fail = e.message() }
        }
    }
    upkept(zone, retention_fail, weekly, weekly_fail)
}
