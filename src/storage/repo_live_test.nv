// repo.nv against a LIVE database -- the half repo_test cannot see.
//
//   ./nova.sh test src/storage/ --filter repo_live_test
//
// repo_test checks the SQL TEXT through a spy, which is right for order and
// rollback and blind to what DuckDB actually does with the text. Found 2026-09-30:
// DuckDB refuses to UPDATE a row that another table references ("key ... is still
// referenced by a foreign key in a different table"). Every tick UPDATEs its
// account on conflict, and `poll` and `limit_window` reference the account -- so the
// question "does the SECOND tick go through" is one only a live database can answer.

module storage.repo_live_test

import std.fs.{real_fs, read_text}
import duckdb.{Database, DbOptions}
import duckdb.types.{Value}
import claude_limits.storage.repo.{Tick, WindowRow, Ids, plan_sql}

const INST = "01900000-0000-7000-8000-000000000001"

fn migration() Io -> str =>
    with Fs = real_fs() {
        // The schema the binary writes: 0001 and every migration after it.
        ro m1 = read_text("migrations/0001_init.sql".to_path()) ?? ""
        ro m2 = read_text("migrations/0002_kimi_accounts.sql".to_path()) ?? ""
        "${m1}\n${m2}"
    }

fn run(setup []str, queries []str) Io -> []str {
    mut out = []str.new()
    ro schema = migration()
    mut last = "<nothing ran>"
    with Fail[DuckError] = |e| { panic("DuckDB refused [${last}]: ${e.message()}") } {
        consume db = Database.open_memory(DbOptions.defaults())!! {
            consume con = db.connect()!! {
                last = "migration"
                ro _ = con.exec(schema)!!
                for s in setup {
                    last = s
                    ro _ = con.exec(s)!!
                }
                for q in queries {
                    last = q
                    consume r = con.query(q)!! {
                        match r.value(0, 0)!! {
                            Value.Text(s) => out.push(s)
                            _ => out.push("<non-text>")
                        }
                    }
                }
            }
        }
    }
    out
}

fn win(kind str, percent int) -> WindowRow =>
    WindowRow.new(kind, "", percent, false, "", "", 1757340000000, 1757358000000)

fn tick(at_ms int) -> Tick => {
    instance: INST, at_ms, email: "work@example.org", org: "Tech Center",
    outcome: "ok", http_status: 200, retry_after_sec: 0, latency_ms: 120, error: "",
    windows: [win("session", 74), win("weekly_all", 41)],
}

/// Distinct UUIDs per tick, THE ACCOUNT'S INCLUDED: `n` is the tick's number.
///
/// The account id used to be one constant for both ticks, and that hid a defect: the
/// references pointed at the CANDIDATE ids, which exist only on the first tick. A
/// caller mints fresh ids every time (`storage/tick.nv`), so the test does too.
fn ids(n int) -> Ids {
    ro p = "01900000-0000-7000-8000-000000${n}"
    Ids.new("${p}a1", "${p}01", ["${p}11", "${p}12"], ["${p}21", "${p}22"], ["${p}31", "${p}32"], ["${p}41", "${p}42"])
}

fn two_ticks() -> []str {
    mut all = plan_sql(tick(1757347622000), ids(1000))
    for s in plan_sql(tick(1757347922000), ids(2000)) { all.push(s) }
    all
}

test "one tick writes its rows" {
    ro a = run(plan_sql(tick(1757347622000), ids(1000)), [
        "SELECT count(*)::VARCHAR FROM account",
        "SELECT count(*)::VARCHAR FROM sample",
    ])
    assert(a[0] == "1")
    assert(a[1] == "2")
}

test "THE SECOND TICK goes through: one account, two polls, four samples" {
    ro a = run(two_ticks(), [
        "SELECT count(*)::VARCHAR FROM account",
        "SELECT count(*)::VARCHAR FROM poll",
        "SELECT count(*)::VARCHAR FROM sample",
    ])
    assert(a[0] == "1")
    assert(a[1] == "2")
    assert(a[2] == "4")
}

test "two ticks of the same windows keep TWO windows and TWO cycles, not four" {
    // `model` is NULL for session and weekly_all, and UNIQUE treats NULLs as distinct:
    // an ON CONFLICT upsert never fired, and every tick added a window and a cycle
    // (measured 2026-09-30: four of each after two ticks).
    ro a = run(two_ticks(), [
        "SELECT count(*)::VARCHAR FROM limit_window",
        "SELECT count(*)::VARCHAR FROM window_cycle",
        "SELECT count(DISTINCT window_id)::VARCHAR FROM sample",
        "SELECT ((SELECT max(sampled_at) FROM sample) > (SELECT min(sampled_at) FROM sample))::VARCHAR",
    ])
    assert(a[0] == "2")
    assert(a[1] == "2")
    assert(a[2] == "2")
    // When a window was last seen is its newest sample -- and the second tick's is newer.
    assert(a[3] == "true")
}

test "every reference names a row that exists" {
    ro a = run(two_ticks(), [
        "SELECT count(*)::VARCHAR FROM limit_window w LEFT JOIN account x ON x.id = w.account_id WHERE x.id IS NULL",
        "SELECT count(*)::VARCHAR FROM sample s LEFT JOIN window_cycle c ON c.id = s.cycle_id WHERE c.id IS NULL",
        "SELECT count(*)::VARCHAR FROM poll p LEFT JOIN account x ON x.id = p.account_id WHERE x.id IS NULL",
    ])
    assert(a[0] == "0")
    assert(a[1] == "0")
    assert(a[2] == "0")
}

// ── lock periods, written by the tick itself ────────────────────────────────

fn tick_of_session(at_ms int, percent int) -> Tick => {
    instance: INST, at_ms, email: "work@example.org", org: "Tech Center",
    outcome: "ok", http_status: 200, retry_after_sec: 0, latency_ms: 120, error: "",
    windows: [win("session", percent), win("weekly_all", 41)],
}

/// 74, 100, 100, 40 five minutes apart -- with the second tick written TWICE.
fn lock_ticks() -> []str {
    mut all []str = []
    for s in plan_sql(tick_of_session(1757347622000, 74), ids(1000)) { all.push(s) }
    for s in plan_sql(tick_of_session(1757347922000, 100), ids(2000)) { all.push(s) }
    for s in plan_sql(tick_of_session(1757347922000, 100), ids(2100)) { all.push(s) }
    for s in plan_sql(tick_of_session(1757348222000, 100), ids(3000)) { all.push(s) }
    for s in plan_sql(tick_of_session(1757348522000, 40), ids(4000)) { all.push(s) }
    all
}

test "74, 100, 100, 40 writes ONE percent_100 period, opened at the first 100 and closed at the 40" {
    ro a = run(lock_ticks(), [
        "SELECT count(*)::VARCHAR FROM lock_period",
        "SELECT reason FROM lock_period",
        "SELECT (epoch_ms(started_at) = 1757347922000)::VARCHAR FROM lock_period",
        "SELECT (epoch_ms(ended_at) = 1757348522000)::VARCHAR FROM lock_period",
        "SELECT count(*)::VARCHAR FROM lock_period lp JOIN limit_window w ON w.id = lp.window_id WHERE w.kind = 'session'",
    ])
    assert(a[0] == "1")
    assert(a[1] == "percent_100")
    assert(a[2] == "true")
    assert(a[3] == "true")
    assert(a[4] == "1")
}

test "a reading still locked leaves the period open -- the control" {
    // Without it, the test above is equally true of a writer that closes every
    // period it opens on the next tick.
    mut all []str = []
    for s in plan_sql(tick_of_session(1757347622000, 100), ids(1000)) { all.push(s) }
    for s in plan_sql(tick_of_session(1757347922000, 100), ids(2000)) { all.push(s) }
    ro a = run(all, [
        "SELECT count(*)::VARCHAR FROM lock_period",
        "SELECT (ended_at IS NULL)::VARCHAR FROM lock_period",
    ])
    assert(a[0] == "1")
    assert(a[1] == "true")
}

fn kimi_tick(at_ms int) -> Tick => {
    instance: INST, at_ms, email: "kimi:kimi-code-env-0e4f", org: "",
    outcome: "ok", http_status: 200, retry_after_sec: 0, latency_ms: 90, error: "",
    windows: [win("session", 12),
              WindowRow.new("monthly", "", 30, false, "", "", 1757340000000, 1759932000000),
              WindowRow.new("monthly", "code", 18, false, "", "", 1757340000000, 1759932000000)],
}

/// Three windows, so three of everything a window owns.
fn kimi_ids(n int) -> Ids {
    ro p = "01900000-0000-7000-8000-000000${n}"
    Ids.new("${p}a1", "${p}01", ["${p}11", "${p}12", "${p}13"], ["${p}21", "${p}22", "${p}23"], ["${p}31", "${p}32", "${p}33"], ["${p}41", "${p}42", "${p}43"])
}

test "two Kimi ticks beside a Claude one: two accounts, one Kimi row, its monthly windows once" {
    mut all = plan_sql(tick(1757347622000), ids(1000))
    for s in plan_sql(kimi_tick(1757347622000), kimi_ids(3000)) { all.push(s) }
    for s in plan_sql(kimi_tick(1757347922000), kimi_ids(4000)) { all.push(s) }
    ro a = run(all, [
        "SELECT count(*)::VARCHAR FROM account",
        "SELECT provider || ' ' || cred_key || ' ' || coalesce(email, '-') FROM account WHERE provider = 'kimi'",
        "SELECT count(*)::VARCHAR FROM limit_window w JOIN account a ON a.id = w.account_id WHERE a.provider = 'kimi' AND w.kind = 'monthly'",
        "SELECT count(*)::VARCHAR FROM sample s JOIN limit_window w ON w.id = s.window_id JOIN account a ON a.id = w.account_id WHERE a.provider = 'kimi'",
    ])
    assert(a[0] == "2")
    assert(a[1] == "kimi kimi-code-env-0e4f -")
    assert(a[2] == "2")
    assert(a[3] == "6")
}
