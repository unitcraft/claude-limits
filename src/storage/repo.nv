// repo.nv — writing one tick (task T2.4).
//
//   ./nova.sh test src/storage/ --filter repo_test
//
// Source: 01.2 §3.1 «Запись» (idempotent upserts, the service set filled by THIS
// layer), §3.6–§3.11 (account, window, cycle, sample, the poll journal), §4 (one
// transaction), §8 п. 4 (including "twice in a row").
//
// ── ONE TICK IS ONE TRANSACTION ──────────────────────────────────────────────
//
// The acceptance line that shapes this file is «инъекция ошибки на переносе не
// оставляет `poll` без пары»: a poll row without its samples is a lie about what the
// endpoint said. So everything a tick writes goes inside `BEGIN`/`COMMIT`, and any
// failure rolls the whole thing back — the journal entry included.
//
// ── PARAMETERS: WHAT THE SPEC ASKS FOR AND WHAT THE EFFECT HAS ───────────────
//
// 01.2 §3.1 ends with «Все запросы — `sql`…`` с параметрами». The `Db` effect has
// `exec(conn, sql str)` and nothing else: no `prepare`, no `bind`. Those live on the
// package's FACADE, which the card forbids here for a reason that outweighs it — the
// error injection this file must survive is impossible against a live database.
//
// So the SQL is built as text, and the quoting is a named, tested function rather
// than an inline `'${x}'` at eleven call sites. `quote` doubles single quotes, which
// is the SQL standard's own escape; there is a test with a value that would otherwise
// close the literal and start a statement. When plan 286's boundary arrives with
// binding, `quote` is the one thing to delete.

module storage.repo

import duckdb.db_effect.{Db, ConnRef}
import duckdb.errors.{DuckError}
import claude_limits.accounts.login.{normalise_email}

/// One window's reading inside a tick.
export type WindowRow value {
    ro kind str          // session | weekly_all | weekly_scoped (01.2 §3.2)
    ro model str         // "" for the two that have no model
    ro percent int
    ro locked bool
    ro locked_reason str
    ro server_severity str
    ro starts_at_ms int
    ro resets_at_ms int
}

export fn WindowRow.new(kind str, model str, percent int, locked bool, locked_reason str,
                       server_severity str, starts_at_ms int, resets_at_ms int) -> WindowRow =>
    { kind, model, percent, locked, locked_reason, server_severity, starts_at_ms, resets_at_ms }

/// Everything one poll of one account produced.
export type Tick value {
    ro instance str      // the author of every row: `created_by` / `updated_by`
    ro at_ms int
    ro email str         // the account's key: an e-mail, or `kimi:<file stem>` (`kimi_key`)
    ro org str
    ro outcome str       // poll_outcome (01.2 §3.2)
    ro http_status int
    ro retry_after_sec int
    ro latency_ms int
    ro error str
    ro windows []WindowRow
}

// ── quoting ──────────────────────────────────────────────────────────────────

/// A SQL string literal, quoted the standard way: a single quote doubles itself.
///
/// NOT A CONVENIENCE. Every value in a tick comes from outside — an e-mail from a
/// credentials file, a `locked_reason` from the endpoint, an error text from the
/// network layer. One of them containing `'` would end the literal and start
/// whatever followed. There is a test with exactly that value.
///
/// It is also the thing to DELETE when the driver boundary of plan 286 brings real
/// parameter binding: a quoting function is a smaller lie than an unquoted literal,
/// not a solution.
/// Named so a probe can neutralise the loop without fighting three layers of quote
/// escaping: the mutation that matters here is "stop doubling", and its anchor must
/// not itself be a nest of apostrophes.
const EMPTY = ""

export fn quote(s str) -> str {
    mut out = "'"
    for ch in s.chars() {
        if ch == '\'' { out = "${out}''" } else { out = "${out}${ch}" }
    }
    "${out}'"
}

/// A moment as DuckDB reads it: microseconds since the epoch, as a TIMESTAMPTZ.
///
/// `make_timestamp` rather than a formatted string: formatting would put a timezone
/// and a locale between us and the number, and 01.2 §3.1 says the column is UTC
/// microseconds.
///
/// `AT TIME ZONE 'UTC'` IS THE FIX OF A MEASURED DEFECT (2026-09-30). `make_timestamp`
/// returns a zoneless TIMESTAMP, and DuckDB turns a zoneless value into a TIMESTAMPTZ
/// through the SESSION zone -- the machine's. On a Moscow machine
/// `epoch(make_timestamp(0)::TIMESTAMPTZ)` is -10800: every moment this file wrote
/// landed three hours early, by an amount that depends on where it ran. The tests
/// compared SQL text and could not see it. Declaring the zoneless value UTC keeps the
/// integer microseconds and removes the session from the answer; the maintenance live
/// test pins the property itself, in two session zones.
export fn moment(ms int) -> str => "(make_timestamp(${ms * 1000}) AT TIME ZONE 'UTC')"

/// A `NULL` or a quoted value — the difference between "not set" and "empty", which
/// 01.2 §0 treats as opposite answers.
///
/// NOT `opt`: `server.dto` declares an `opt` too, and once `--serve` linked both
/// the codegen could not tell them apart (registry 221.1 #1090, 2026-09-30).
export fn sql_opt(s str) -> str {
    if s == "" { return "NULL" }
    quote(s)
}

// ── the statements ───────────────────────────────────────────────────────────

/// The live model's key of a Kimi Code account starts with this (`server/feed.nv`,
/// `usage/poller.nv`: `kimi:<credentials file stem>`).
const KIMI_PREFIX = "kimi:"

/// The credentials file stem of a Kimi Code key; `None` for an e-mail.
///
/// A KIMI ACCOUNT HAS NO E-MAIL, and the database keys it by the stem (`cred_key`,
/// 01.2 §3.6, amendment 2026-10-02; migration 0002). The prefix cannot be an e-mail's:
/// an address has no `:` before its `@` in anything a credentials file holds.
export fn kimi_key(key str) -> Option[str] {
    if !key.starts_with(KIMI_PREFIX) { return None }
    Some(key[KIMI_PREFIX.byte_len()..])
}

/// The account's key in SQL, as the live model writes it: the e-mail, or `kimi:` and
/// the stem -- what a reader compares with `Reading.email` and `AccountView.email`.
export fn account_key_sql(a str) -> str =>
    "coalesce(${a}.email, CASE WHEN ${a}.provider = 'codex' THEN ${a}.cred_key ELSE '${KIMI_PREFIX}' || ${a}.cred_key END)"

const CODEX_PREFIX = "codex:"

/// Is this key a Codex (ChatGPT) login's? Its `cred_key` holds the WHOLE key, lowered
/// (migration 0003): the e-mail column is Claude's, and one address may hold both
/// logins.
export fn is_codex_key(key str) -> bool => key.starts_with(CODEX_PREFIX)

/// The condition naming the account of `key`, by the column that keys it.
fn account_match(key str) -> str {
    if is_codex_key(key) { return "cred_key = ${quote(key.to_ascii_lower())}" }
    match kimi_key(key) {
        Some(stem) => "cred_key = ${quote(stem)}"
        None => "email = ${quote(key.to_ascii_lower())}"
    }
}

/// Upsert the account, touching `last_seen_at` and the service set (01.2 §3.1).
///
/// THE E-MAIL IS LOWERED HERE, before the CHECK ever sees it: the column refuses
/// anything else, and a row refused at the database is a tick lost for a reason the
/// caller cannot fix. A Kimi key's stem is NOT lowered: it is a file name, and two
/// files differing in case are two logins.
export fn upsert_account_sql(t Tick, id str) -> str {
    ro at = moment(t.at_ms)
    ro (provider, email, stem, target) = if is_codex_key(t.email) {
        ("codex", "NULL", quote(t.email.to_ascii_lower()), "cred_key")
    } else {
        match kimi_key(t.email) {
            Some(s) => ("kimi", "NULL", quote(s), "cred_key")
            None => ("claude", quote(t.email.to_ascii_lower()), "NULL", "email")
        }
    }
    "INSERT INTO account (id, created_at, updated_at, created_by, updated_by, provider, email, cred_key, org_name, color_slot, first_seen_at, last_seen_at) VALUES (${quote(id)}, ${at}, ${at}, ${quote(t.instance)}, ${quote(t.instance)}, '${provider}', ${email}, ${stem}, ${sql_opt(t.org)}, 0, ${at}, ${at}) ON CONFLICT (${target}) DO UPDATE SET last_seen_at = excluded.last_seen_at, updated_at = excluded.updated_at, updated_by = excluded.updated_by"
}

// ── references BY NATURAL KEY, not by the ids the caller minted ──────────────
//
// CORRECTION 2026-09-30. The statements below used to reference the CANDIDATE ids of
// `Ids`: the window pointed at `ids.account`, the cycle at `ids.windows[i]`, and so on.
// An upsert that finds the row already there keeps the OLD id, so on every tick after
// the first the references named rows that did not exist. repo_live_test's "second
// tick" passed only because it handed both ticks the SAME account id. And the window
// upsert never met its conflict at all: `model` is NULL for `session`/`weekly_all`, and
// `UNIQUE (account_id, kind, model)` treats NULLs as distinct -- every tick created
// a new window and a new cycle (measured: two ticks, four windows). Found while
// writing `storage/tick.nv`, the first caller that mints fresh ids per tick.
//
// Now every reference is a subquery on the natural key. And `model` is `''`, not NULL,
// for the two windows that have none (0001: NOT NULL DEFAULT ''), so the UNIQUE key
// conflicts as meant and a repeat finds the window instead of adding one.
//
// THE WINDOW IS NOT TOUCHED ON A REPEAT (`DO NOTHING`), and that is DuckDB's call, not
// a choice (measured 2026-09-30 on 1.5.5): both a plain `UPDATE limit_window SET
// last_seen_at` and `INSERT ... ON CONFLICT DO UPDATE` on a window that cycles already
// reference are refused ("key window_id ... is still referenced by a foreign key"),
// while the SAME `DO UPDATE` on the account goes through. A HYPOTHESIS, not measured:
// the window's conflict key contains its own foreign-key column (`account_id`), the
// account's (`email`) does not. When a window was last seen is `max(sample.sampled_at)`
// of its samples; `limit_window.last_seen_at` stays its first sighting (01.2 says so).

fn account_ref(t Tick) -> str => "(SELECT id FROM account WHERE ${account_match(t.email)})"

fn window_ref(t Tick, w WindowRow) -> str =>
    "(SELECT id FROM limit_window WHERE account_id = ${account_ref(t)} AND kind = ${quote(w.kind)} AND model = ${quote(w.model)})"

fn cycle_ref(t Tick, w WindowRow) -> str =>
    "(SELECT id FROM window_cycle WHERE window_id = ${window_ref(t, w)} AND resets_at = ${moment(w.resets_at_ms)})"

/// Insert one limit window of an account, or leave the one already there.
export fn upsert_window_sql(t Tick, w WindowRow, id str) -> str {
    ro at = moment(t.at_ms)
    "INSERT INTO limit_window (id, created_at, updated_at, created_by, updated_by, account_id, kind, model, first_seen_at, last_seen_at) VALUES (${quote(id)}, ${at}, ${at}, ${quote(t.instance)}, ${quote(t.instance)}, ${account_ref(t)}, ${quote(w.kind)}, ${quote(w.model)}, ${at}, ${at}) ON CONFLICT (account_id, kind, model) DO NOTHING"
}

/// Upsert the cycle this reading belongs to (01.2 §3.10: one pass of a window).
export fn upsert_cycle_sql(t Tick, w WindowRow, id str) -> str {
    ro at = moment(t.at_ms)
    "INSERT INTO window_cycle (id, created_at, updated_at, created_by, updated_by, window_id, starts_at, resets_at) VALUES (${quote(id)}, ${at}, ${at}, ${quote(t.instance)}, ${quote(t.instance)}, ${window_ref(t, w)}, ${moment(w.starts_at_ms)}, ${moment(w.resets_at_ms)}) ON CONFLICT (window_id, resets_at) DO NOTHING"
}

/// The reading itself.
///
/// `DO NOTHING` on `(window_id, sampled_at)`: polling the same window twice in the
/// same instant is the same fact, and the acceptance line «повтор того же тика не
/// меняет счётчиков» rests on this clause rather than on the caller remembering.
export fn insert_sample_sql(t Tick, w WindowRow, id str) -> str {
    ro at = moment(t.at_ms)
    ro locked = if w.locked { "true" } else { "false" }
    "INSERT INTO sample (id, created_at, updated_at, created_by, updated_by, window_id, sampled_at, cycle_id, percent, locked, locked_reason, server_severity, active) VALUES (${quote(id)}, ${at}, ${at}, ${quote(t.instance)}, ${quote(t.instance)}, ${window_ref(t, w)}, ${at}, ${cycle_ref(t, w)}, ${w.percent}, ${locked}, ${sql_opt(w.locked_reason)}, ${sql_opt(w.server_severity)}, true) ON CONFLICT (window_id, sampled_at) DO NOTHING"
}

/// The journal entry: what the endpoint answered, whatever that was.
///
/// WRITTEN FOR EVERY OUTCOME, including the ones nobody wants to look at. A 429 that
/// is not in `poll` is a 429 nobody can explain the next morning.
export fn insert_poll_sql(t Tick, id str) -> str {
    ro at = moment(t.at_ms)
    "INSERT INTO poll (id, created_at, updated_at, created_by, updated_by, account_id, polled_at, outcome, http_status, retry_after_sec, latency_ms, error) VALUES (${quote(id)}, ${at}, ${at}, ${quote(t.instance)}, ${quote(t.instance)}, ${account_ref(t)}, ${at}, ${quote(t.outcome)}, ${t.http_status}, ${t.retry_after_sec}, ${t.latency_ms}, ${sql_opt(t.error)}) ON CONFLICT (account_id, polled_at) DO NOTHING"
}

/// One previous version of the settings file (01.2 §3.14), kept before a save
/// overwrites it. `toml` arrives already redacted (`config_file.redact`); `source` is
/// one of the four words of the table's `CHECK`, spelled by `config_file.Source`.
export fn config_history_sql(id str, at_ms int, instance str, source str, toml str) -> str {
    ro at = moment(at_ms)
    "INSERT INTO config_history (id, created_at, updated_at, created_by, updated_by, source, toml) VALUES (${quote(id)}, ${at}, ${at}, ${quote(instance)}, ${quote(instance)}, ${quote(source)}, ${quote(toml)})"
}

// ── the tick ─────────────────────────────────────────────────────────────────

/// Ids the caller supplies, so the write stays deterministic in a test.
///
/// UUID v7 IS CREATED BY THE APPLICATION (01.2 §3.1: no server-side DEFAULT), and a
/// function that minted them inside would make every assertion about a row depend on
/// a clock. The caller mints; this file writes.
export type Ids value {
    ro account str
    ro poll str
    ro windows []str
    ro cycles []str
    ro samples []str
    /// One per window: the id of the lock period the tick OPENS, if it opens one.
    /// Minted whether or not it is used -- the caller cannot know which window will
    /// open a period without reading the database, and an unused id costs nothing.
    ro locks []str
}

export fn Ids.new(account str, poll str, windows []str, cycles []str, samples []str, locks []str) -> Ids =>
    { account, poll, windows, cycles, samples, locks }

/// Write one tick, or write nothing at all.
///
/// THE ORDER IS FORCED BY THE FOREIGN KEYS: account, then its windows, then each
/// window's cycle, then the samples, and the journal entry last. The journal goes
/// LAST on purpose — if anything above it fails, the rollback takes the whole tick,
/// and `poll` never gains a row whose samples do not exist.
export fn write_tick(conn ConnRef, t Tick, ids Ids) Db -> Result[(), DuckError] {
    match Db.exec(conn, "BEGIN TRANSACTION") {
        Err(e) => return Err(e)
        Ok(_) => ()
    }

    ro steps = plan_sql(t, ids)
    mut i = 0
    while i < steps.len() {
        match Db.exec(conn, steps[i]) {
            Err(e) => {
                // Best effort: if the rollback itself fails the connection is gone,
                // and the original error is the one worth reporting.
                ro _ = Db.exec(conn, "ROLLBACK")
                return Err(e)
            }
            Ok(_) => ()
        }
        i += 1
    }

    match Db.exec(conn, "COMMIT") {
        Err(e) => {
            ro _ = Db.exec(conn, "ROLLBACK")
            Err(e)
        }
        Ok(_) => {
            // 01.2 §5: `CHECKPOINT` after every tick, so `.wal` merges into the file
            // and the database on disk is always whole and copyable.
            ro _ = Db.exec(conn, "CHECKPOINT")
            Ok(())
        }
    }
}

/// Every statement of a tick, in order — PURE, so the order itself can be asserted.
///
/// Separated from `write_tick` because the order is the part with a rule in it, and a
/// rule inside an effectful loop can only be checked by watching the effect.
export fn plan_sql(t Tick, ids Ids) -> []str {
    mut out = []str.new()
    out.push(upsert_account_sql(t, ids.account))
    mut i = 0
    while i < t.windows.len() {
        ro w = t.windows[i]
        ro wid = if i < ids.windows.len() { ids.windows[i] } else { "" }
        ro cid = if i < ids.cycles.len() { ids.cycles[i] } else { "" }
        ro sid = if i < ids.samples.len() { ids.samples[i] } else { "" }
        ro lid = if i < ids.locks.len() { ids.locks[i] } else { "" }
        out.push(upsert_window_sql(t, w, wid))
        out.push(upsert_cycle_sql(t, w, cid))
        out.push(insert_sample_sql(t, w, sid))
        out.push(lock_sql(t, w, lid))
        i += 1
    }
    out.push(insert_poll_sql(t, ids.poll))
    out
}

// ── occupancy: who sat in a directory, and when (01.2 §3.7) ──────────────────
//
// THE RULE IS A COMPARISON, not a timer. At every discovery the directory's e-mail
// and token state are read; if the PAIR differs from the open row, that row is closed
// and a new one opened. `ok -> expired` counts, which is what draws the grey tail on
// the occupancy bar (01.1 §7.3) — a person who walked away from a login sees where it
// went stale rather than a gap.

/// What a discovery found for one directory.
export type Seen value {
    ro login_dir_id str
    ro account_id str        // "" when there is no login, or the account was forgotten
    ro token_state str       // the DATABASE's vocabulary — see `db_token_state`
}

export fn Seen.new(login_dir_id str, account_id str, token_state str) -> Seen =>
    { login_dir_id, account_id, token_state }

/// The row currently open for that directory, if there is one.
export type OpenRow value {
    ro id str
    ro account_id str
    ro token_state str
}

export fn OpenRow.new(id str, account_id str, token_state str) -> OpenRow =>
    { id, account_id, token_state }

/// What to do about it.
export type OccupancyStep enum
    | Unchanged
    | OpenFirst
    | CloseAndOpen(str)      // the id of the row to close

export fn OccupancyStep @to_str() -> str =>
    match @ {
        Unchanged => "unchanged"
        OpenFirst => "open-first"
        CloseAndOpen(_) => "close-and-open"
    }

/// 01.2 §3.7: «если пара `(account_id, token_state)` отличается от открытой записи —
/// открытая закрывается, открывается новая».
///
/// BOTH HALVES OF THE PAIR MATTER, and the spec names the second explicitly because
/// it is the one people forget: the account can stay the same while the token goes
/// stale, and that IS a new period.
export fn occupancy_step(open Option[OpenRow], seen Seen) -> OccupancyStep {
    match open {
        None => OpenFirst
        Some(row) => {
            if row.account_id == seen.account_id && row.token_state == seen.token_state {
                Unchanged
            } else {
                CloseAndOpen(row.id)
            }
        }
    }
}

/// The two statements of a transition, in order: close, then open.
///
/// ONE TRANSACTION IS THE CALLER'S JOB and the invariant depends on it — 01.2 §3.7
/// says «закрытие и открытие — в одной транзакции», because between them there are
/// either two open rows or none, and both break the query the acceptance runs.
export fn occupancy_sql(t Tick, seen Seen, new_id str, close_id str) -> []str {
    ro at = moment(t.at_ms)
    mut out = []str.new()
    if close_id != "" {
        out.push("UPDATE occupancy SET ended_at = ${at}, updated_at = ${at}, updated_by = ${quote(t.instance)} WHERE id = ${quote(close_id)}")
    }
    out.push("INSERT INTO occupancy (id, created_at, updated_at, created_by, updated_by, login_dir_id, account_id, token_state, started_at, ended_at) VALUES (${quote(new_id)}, ${at}, ${at}, ${quote(t.instance)}, ${quote(t.instance)}, ${quote(seen.login_dir_id)}, ${sql_opt(seen.account_id)}, ${quote(seen.token_state)}, ${at}, NULL)")
    out
}

/// The query the acceptance runs: it must come back EMPTY.
///
/// Kept here rather than typed into a test, because the invariant belongs to this
/// layer and a test that spells its own query can drift from what the code promises.
export fn two_open_sql() -> str =>
    "SELECT login_dir_id FROM occupancy WHERE ended_at IS NULL GROUP BY 1 HAVING count(*) > 1"

// ── the two vocabularies of `token_state` (open question 5) ──────────────────

/// The code's `TokenState` in the database's words.
///
/// THEY ARE TWO VOCABULARIES FOR TWO MOMENTS, and this function is the whole of my
/// reading — the owner has not ruled, and question 5 of 01.5 stays open.
///
///   `login.TokenState` answers "what does the credentials file say", computed with
///   no request at all: `ok`, `stale`, `no_token`.
///   `occupancy.token_state` records what was true of the directory: `ok`, `expired`,
///   `rejected`, `none`.
///
/// `rejected` has no counterpart here ON PURPOSE: it means the endpoint answered 401
/// to a live-looking token, which the FILE cannot know. It is written by whoever
/// polls, not by whoever reads the directory — so a mapping that invented a value for
/// it would be claiming knowledge the caller does not have.
export fn db_token_state(file_state str) -> str {
    if file_state == "ok" { return "ok" }
    if file_state == "stale" { return "expired" }
    if file_state == "no_token" { return "none" }
    // An unknown word is NOT silently passed through: the column's CHECK would refuse
    // it and the whole tick would roll back, which is a large price for a typo. `none`
    // is the honest answer to "we cannot say".
    "none"
}

// ── lock periods (01.2 §3.12) ────────────────────────────────────────────────

/// Why a window is locked, or that it is not.
export type LockStep enum
    | NoChange
    | OpenLock(str)          // the reason: `server` or `percent_100`
    | CloseLock

export fn LockStep @to_str() -> str =>
    match @ {
        NoChange => "no-change"
        OpenLock(_) => "open"
        CloseLock => "close"
    }

/// 01.2 §3.12: a period opens on the server's `locked_reason` (`server`) or on
/// `percent = 100` with no reason (`percent_100`), and closes at the first reading
/// without a lock.
///
/// THE SERVER'S WORD WINS when both are true: a 100 % that the endpoint also
/// explained is the endpoint's fact, and `sample.locked_reason` keeps its text. The
/// design treats a bare 100 % as a red plate of its own, which is why the second
/// reason exists at all.
export fn lock_step(period_open bool, percent int, locked bool, locked_reason str) -> LockStep {
    ro should_be_locked = locked || percent >= 100
    if should_be_locked {
        if period_open { return NoChange }
        if locked_reason != "" { return OpenLock("server") }
        return OpenLock("percent_100")
    }
    if period_open { return CloseLock }
    NoChange
}

/// The lock-period statement of one window of a tick (01.2 section 3.12): open a
/// period if the reading is locked and none is open, close the open one if it is not.
///
/// THE REASON is `lock_step`'s, asked as if no period were open -- the same rule the
/// T2.5 tests hold. WHETHER one is open is the database's, asked INSIDE the tick's
/// transaction (`NOT EXISTS`, `ended_at IS NULL`): reading it before the tick would
/// be a second, unlocked read of a fact the tick itself changes.
///
/// Both statements are no-ops when there is nothing to do, so a repeated tick writes
/// nothing new -- the "twice in a row" line of T2.4 holds for locks too. A close never
/// lands before its own start (`started_at <= at`): a late tick does not end a period
/// that began after it.
export fn lock_sql(t Tick, w WindowRow, id str) -> str {
    ro at = moment(t.at_ms)
    ro inst = quote(t.instance)
    match lock_step(false, w.percent, w.locked, w.locked_reason) {
        LockStep.OpenLock(reason) =>
            "INSERT INTO lock_period (id, created_at, updated_at, created_by, updated_by, window_id, cycle_id, started_at, ended_at, reason) SELECT ${quote(id)}, ${at}, ${at}, ${inst}, ${inst}, ${window_ref(t, w)}, ${cycle_ref(t, w)}, ${at}, NULL, ${quote(reason)} WHERE NOT EXISTS (SELECT 1 FROM lock_period lp WHERE lp.window_id = ${window_ref(t, w)} AND lp.ended_at IS NULL)"
        _ =>
            "UPDATE lock_period SET ended_at = ${at}, updated_at = ${at}, updated_by = ${inst} WHERE window_id = ${window_ref(t, w)} AND ended_at IS NULL AND started_at <= ${at}"
    }
}

export fn lock_open_sql(t Tick, id str, window_id str, cycle_id str, reason str) -> str {
    ro at = moment(t.at_ms)
    "INSERT INTO lock_period (id, created_at, updated_at, created_by, updated_by, window_id, cycle_id, started_at, ended_at, reason) VALUES (${quote(id)}, ${at}, ${at}, ${quote(t.instance)}, ${quote(t.instance)}, ${quote(window_id)}, ${quote(cycle_id)}, ${at}, NULL, ${quote(reason)})"
}

export fn lock_close_sql(t Tick, id str) -> str {
    ro at = moment(t.at_ms)
    "UPDATE lock_period SET ended_at = ${at}, updated_at = ${at}, updated_by = ${quote(t.instance)} WHERE id = ${quote(id)}"
}

// ── forget (task T2.7, 01.2 §3.15) ──────────────────────────────────────────

fn regex_special(ch char) -> bool =>
    ch == '\\' || ch == '.' || ch == '^' || ch == '$' || ch == '|' || ch == '?' ||
    ch == '*' || ch == '+' || ch == '(' || ch == ')' || ch == '[' || ch == ']' ||
    ch == '{' || ch == '}'

/// A regular expression that matches `s` literally: `a+b@x.org` is an ordinary
/// address, and unescaped its `+` and `.` would match other text -- or miss this one.
export fn regex_literal(s str) -> str {
    mut out = ""
    for ch in s.chars() {
        if regex_special(ch) { out = "${out}\\${ch}" } else { out = "${out}${ch}" }
    }
    out
}

/// The TRANSACTIONS of `forget`, each a list of statements, in order (01.2 §3.15).
///
/// NOT ONE TRANSACTION, and the engine decides that, not taste. Measured 2026-09-30 on
/// DuckDB 1.5.5: a row cannot be deleted while the rows that referenced it were deleted
/// IN THE SAME TRANSACTION -- "is still referenced by a foreign key", the limitation its
/// documentation names. §3.15 as first written (every DELETE between one BEGIN and one
/// COMMIT) failed on the first cycle it reached. So:
///
///   1. the account is MARKED -- `deleted_at` (the column exists for exactly this, per
///      its comment in the schema), the folder history unlinked, the settings history
///      cleaned. From here on the account is gone for every reader that honours
///      `deleted_at`, and the part a person reads -- the address in the history -- is
///      gone for everyone;
///   2..5. one level of references per transaction, children before parents, the
///      account itself last.
///
/// Interrupted anywhere, the account row is still there under the same address, so
/// running `forget` again finds it and finishes: every step is idempotent.
///
/// The history is rewritten CASE-INSENSITIVELY. The table holds the address lowered,
/// but `config_history.toml` is the text of a file a person may have edited by hand,
/// and a variant spelled `Work@Example.org` that survives is personal data left behind
/// by the one command whose whole job is to leave none.
export fn forget_steps(account_id str, email str, instance str, now_ms int) -> [][]str {
    ro id = quote(account_id)
    ro now = moment(now_ms)
    ro by = quote(instance)
    ro of_windows = "window_id IN (SELECT id FROM limit_window WHERE account_id = ${id})"
    ro pattern = quote(regex_literal(normalise_email(email)))
    [
        [
            "UPDATE account SET deleted_at = ${now}, updated_at = ${now}, updated_by = ${by} WHERE id = ${id} AND deleted_at IS NULL",
            // The folder's history stays; it just no longer says whose it was.
            "UPDATE occupancy SET account_id = NULL, updated_at = ${now}, updated_by = ${by} WHERE account_id = ${id}",
            "UPDATE config_history SET toml = regexp_replace(toml, ${pattern}, '***', 'gi'), updated_at = ${now}, updated_by = ${by} WHERE regexp_matches(toml, ${pattern}, 'i')",
        ],
        [
            "DELETE FROM daily_rollup WHERE ${of_windows}",
            "DELETE FROM lock_period WHERE ${of_windows}",
            "DELETE FROM sample WHERE ${of_windows}",
        ],
        ["DELETE FROM window_cycle WHERE ${of_windows}"],
        [
            "DELETE FROM limit_window WHERE account_id = ${id}",
            "DELETE FROM poll WHERE account_id = ${id}",
        ],
        ["DELETE FROM account WHERE id = ${id}"],
    ]
}

/// What `forget` did.
export type Forgot enum
    /// The account with this id is gone, with everything that named it.
    | Forgotten(str)
    /// No account has this address; nothing was touched.
    | NoSuchAccount

/// Forget one account: the transactions of `forget_steps`, then `CHECKPOINT`
/// (01.2 §3.15, §5). A failed step rolls back ITSELF; the steps before it stay, and a
/// second run finishes the job (see `forget_steps`).
export fn forget(conn ConnRef, email str, instance str, now_ms int) Db -> Result[Forgot, DuckError] {
    ro rows = Db.query(conn, "SELECT id::VARCHAR FROM account WHERE email = ${quote(normalise_email(email))}")?
    ro first = Db.next(rows)
    Db.close_result(rows)
    ro id = match first? {
        Some(cells) => match cells[0] {
            Value.Text(s) => s
            _ => return Err(DuckError.Type("account.id did not come back as text"))
        }
        None => return Ok(Forgot.NoSuchAccount)
    }

    for step in forget_steps(id, email, instance, now_ms) {
        Db.exec(conn, "BEGIN TRANSACTION")?
        for stmt in step {
            match Db.exec(conn, stmt) {
                Ok(_) => ()
                Err(e) => {
                    ro _ = Db.exec(conn, "ROLLBACK")
                    return Err(e)
                }
            }
        }
        match Db.exec(conn, "COMMIT") {
            Ok(_) => ()
            Err(e) => {
                ro _ = Db.exec(conn, "ROLLBACK")
                return Err(e)
            }
        }
    }
    // Deleted rows leave the file only when their blocks are rewritten.
    ro _ = Db.exec(conn, "CHECKPOINT")
    Ok(Forgot.Forgotten(id))
}
