// Tests for startup.nv -- the database at the start of --serve.
//
//   ./nova.sh test src/storage/ --filter startup_test
//
// The names of migration files are pure; the cycle runs against REAL files in the
// system temp (a mock would answer whatever `open_and_read` asks -- db_live_test.nv
// says why that is not enough). `Random` is seeded: the key file is created here.

module storage.startup_test

import std.fs.{real_fs, try_exists, create_dir_all, remove_dir_all, read_text, read, remove_file, write_text, read_dir}
import std.encoding.base64.{Base64}
import std.os.{real_os, temp_dir}
import std.testing.handlers.{seeded}
import duckdb.db_real.{with_real_db}
import claude_limits.storage.paths.{Paths}
import claude_limits.storage.db.{Migration, KNOWN_SCHEMA}
import startup.{version_of, migrations_in, bundled, open_for_serve, record_readings, Ready, StartFail, Upkeep, Upkept, forget_account, ForgetDone, upkeep_daily, record_config_version, read_history_rows, read_history_days_in, record_found, import_history, Imported}
import claude_limits.storage.history_rows.{HistFolderRows}
import claude_limits.storage.discovery_write.{Discovered}
import claude_limits.storage.backup.{backup_name}
import duckdb.{Database, DbOptions}
import duckdb.types.{Value}
import claude_limits.usage.poller.{Reading}
import claude_limits.usage.outcome.{Outcome}
import claude_limits.usage.parse.{Usage, PollOutcome}
import claude_limits.model.snapshot.{AccountState}
import claude_limits.window.{Window}

fn same(label str, want str, got str) -> bool {
    if want == got { return true }
    panic("${label}: want [${want}], got [${got}]")
}

// -- names ---------------------------------------------------------------------

test "a migration's version is the number before the first underscore" {
    assert(version_of("0001_init.sql") == 1)
    assert(version_of("migrations/0003_add_notification.sql") == 3)
}

test "a file that is not a migration is skipped, not guessed at" {
    assert(version_of("README.md") == 0)
    assert(version_of("init.sql") == 0)
    assert(version_of("draft_0002.sql") == 0)
    assert(version_of("0002_draft.txt") == 0)
}

test "the binary carries 0001, and it creates schema_meta" {
    ro all = migrations_in(bundled())
    mut found = false
    for m in all {
        if m.version == 1 {
            found = true
            assert(m.sql.contains("CREATE TABLE schema_meta"))
        }
    }
    assert(found)
}

// -- the cycle, on real files --------------------------------------------------

fn place(name str) Io -> Paths {
    ro base = with Os = real_os() { temp_dir().display().replace("\\", "/") }
    ro d = "${base}/claude-limits-startup-${name}"
    with Fs = real_fs() {
        ro _ = remove_dir_all(d.to_path())
        ro _ = create_dir_all(d.to_path())
    }
    {
        encrypted: true,
        config_dir: "${d}/cfg", data_dir: "${d}/data", log_dir: "${d}/log",
        config_file: "${d}/cfg/claude-limits.toml", db_file: "${d}/data/claude-limits.duckdb",
        wal_file: "${d}/data/claude-limits.duckdb.wal", temp_dir: "${d}/data/tmp",
        backup_dir: "${d}/data/backup", log_file: "${d}/log/claude-limits.log",
        key_file: "${d}/cfg/claude-limits.key", instance_file: "${d}/cfg/claude-limits.instance",
        portable: false,
    }
}

// 2026-09-30 09:00:00 UTC.
const T0 = 1790758800000

fn start(p Paths, all []Migration, seed int) Io -> str {
    match start_at(p, all, seed, T0, "Etc/GMT-3") {
        Ok(ready) => "first=${ready.opened.first_start} schema=${ready.opened.schema_version} applied=${ready.applied} backup=${ready.backup != ""}"
        Err(f) => "FAIL ${f.message(p.key_file)}"
    }
}

fn start_at(p Paths, all []Migration, seed int, at_ms int, tz str) Io -> Result[Ready, StartFail] {
    ro now = at_ms
    ro care = Upkeep.new(30, 400, 20, tz)
    with Fs = real_fs(), Random = seeded(seed as u64) {
        with_real_db(fn() Db Fs Random -> Result[Ready, StartFail] => open_for_serve(p, all, now, 5, true, care))
    }
}

/// What the upkeep of one start did, flattened.
fn upkeep_line(p Paths, all []Migration, seed int, at_ms int, tz str) Io -> str {
    match start_at(p, all, seed, at_ms, tz) {
        Ok(r) => "zone=[${r.upkeep.zone}] retention=[${r.upkeep.retention_fail}] weekly=${r.upkeep.weekly != ""} weekly_fail=[${r.upkeep.weekly_fail}]"
        Err(f) => "FAIL ${f.message(p.key_file)}"
    }
}

const WEEK int = 7 * 86400000

fn is_on_disk(path str) Io -> bool => with Fs = real_fs() { try_exists(path.to_path()) ?? false }

test "a first start creates the key, the file and the schema, and backs up nothing" {
    ro p = place("first")
    ro all = migrations_in(bundled())
    assert(same("first", "first=true schema=0 applied=3 backup=false", start(p, all, 7)))
    assert(is_on_disk(p.key_file))
    assert(is_on_disk(p.db_file))
}

test "the second start finds schema 3, applies nothing and backs up nothing" {
    ro p = place("second")
    ro all = migrations_in(bundled())
    ro _ = start(p, all, 7)
    assert(same("second", "first=false schema=3 applied=0 backup=false", start(p, all, 8)))
}

test "a database a 0001 build wrote is taken to the current schema, backed up first" {
    // The owner's file as it is today: schema 1. The next start must migrate it, and
    // only after the backup (01.2 §5) -- 0002 and 0003 rebuild eight tables each.
    ro p = place("from-one")
    mut only_one []Migration = []
    for m in migrations_in(bundled()) { if m.version == 1 { only_one.push(m) } }
    assert(same("one", "first=true schema=0 applied=1 backup=false", start(p, only_one, 7)))
    assert(same("two", "first=false schema=1 applied=2 backup=true", start(p, migrations_in(bundled()), 8)))
}

test "a new migration on an existing file is preceded by a backup" {
    ro p = place("upgrade")
    mut all = migrations_in(bundled())
    ro _ = start(p, all, 7)
    all.push(Migration.new(4, "CREATE TABLE startup_probe (x INTEGER)"))
    assert(same("upgrade", "first=false schema=3 applied=1 backup=true", start(p, all, 8)))
    // Schema 4 is beyond what THIS build knows (KNOWN_SCHEMA = 3), so the next start
    // refuses -- the rule of 01.2 §5, shown on the file the upgrade just wrote.
    assert(start(p, all, 9).starts_with("FAIL the database was written by a newer version (schema 4"))
}

test "KNOWN_SCHEMA is the highest migration the binary carries" {
    // Two numbers that must move together: a migration added without the constant
    // would be applied and then refused on the next start.
    mut top = 0
    for m in migrations_in(bundled()) {
        if m.version > top { top = m.version }
    }
    assert(top == KNOWN_SCHEMA)
}

test "a migration that fails is rolled back and says which" {
    ro p = place("broken")
    mut all = migrations_in(bundled())
    ro _ = start(p, all, 7)
    all.push(Migration.new(4, "CREATE TABLE schema_meta (x INTEGER)"))
    ro got = start(p, all, 8)
    assert(got.starts_with("FAIL a migration failed and was rolled back: 4:"))
    // Rolled back: the schema is still 3, and the next start tries again.
    ro fixed = migrations_in(bundled())
    assert(same("still 3", "first=false schema=3 applied=0 backup=false", start(p, fixed, 9)))
}

// -- the round's readings, written as ticks -----------------------------------------

// Named functions, not literals inside lambdas (registry 221.1 #1392).
fn usage_two() -> Usage => {
    windows: [Window.new("session", "", 24, T0 + 16200000, ""), Window.new("weekly_all", "", 21, T0 + 302400000, "")],
    outcome: PollOutcome.Parsed, from_fallback: false, extra: None,
}

fn a_reading(at int) -> Reading =>
    { email: "work@example.org", outcome: Outcome.new(AccountState.Ok, "", 0, true, 200), usage: usage_two(), at_ms: at }

fn record(p Paths, rs []Reading, seed int) Io -> str {
    ro r = with Fs = real_fs(), Random = seeded(seed as u64) {
        with_real_db(fn() Db Fs Random -> Result[int, StartFail] => record_readings(p, rs, ["work@example.org"], ["Example Inc"], true))
    }
    match r {
        Ok(n) => "written=${n}"
        Err(f) => "FAIL ${f.message(p.key_file)}"
    }
}

/// Rows in the ENCRYPTED file, opened with the key the start created.
fn rows(p Paths) Io -> str {
    ro key = with Fs = real_fs() { (read_text(p.key_file.to_path()) ?? "").trim_ascii() }
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    mut out = "<none>"
    with Fail[DuckError] = |e| { out = "REFUSED ${e.message()}" } {
        consume db = Database.open(p.db_file, opts)!! {
            consume con = db.connect()!! {
                consume r = con.query("SELECT (SELECT count(*) FROM account)::VARCHAR || '/' || (SELECT org_name FROM account) || '/' || (SELECT count(*) FROM limit_window)::VARCHAR || '/' || (SELECT count(*) FROM sample)::VARCHAR || '/' || (SELECT count(*) FROM poll)::VARCHAR")!! {
                    match r.value(0, 0)!! {
                        Value.Text(t) => { out = t }
                        _ => ()
                    }
                }
            }
        }
    }
    out
}

test "the round's readings become ticks in the encrypted file, twice over" {
    ro p = place("record")
    ro _ = start(p, migrations_in(bundled()), 7)
    assert(same("first", "written=1", record(p, [a_reading(T0)], 8)))
    assert(same("second", "written=1", record(p, [a_reading(T0 + 300000)], 9)))
    // One account (with the organisation discovery found), two windows, four samples,
    // two journal entries -- the second start's round does not add windows.
    assert(same("rows", "1/Example Inc/2/4/2", rows(p)))
}

// ── the upkeep of a start (01.2 section 5) ──────────────────────────────────
//
// Written in T2.6 and called by nothing until 2026-10-01: no rollup zone, no retention
// pass, no weekly backup ever ran. A start now does all three; the pass itself is
// proven in maintenance_test, this holds that a START runs it and says what it did.

test "a first start writes the rollup zone, passes the retention and takes no weekly backup" {
    ro p = place("upkeep-first")
    assert(same("first", "zone=[rollup zone set to Etc/GMT-3] retention=[] weekly=false weekly_fail=[]",
                upkeep_line(p, migrations_in(bundled()), 7, T0, "Etc/GMT-3")))
}

test "the next start takes the weekly backup, a start in the same week does not, a week later does" {
    ro p = place("upkeep-weekly")
    ro all = migrations_in(bundled())
    ro _ = upkeep_line(p, all, 7, T0, "Etc/GMT-3")
    assert(same("second", "zone=[] retention=[] weekly=true weekly_fail=[]", upkeep_line(p, all, 8, T0 + 60000, "Etc/GMT-3")))
    assert(same("same week", "zone=[] retention=[] weekly=false weekly_fail=[]", upkeep_line(p, all, 9, T0 + 3 * 86400000, "Etc/GMT-3")))
    assert(same("a week on", "zone=[] retention=[] weekly=true weekly_fail=[]", upkeep_line(p, all, 10, T0 + WEEK + 120000, "Etc/GMT-3")))
}

test "a machine that moved its zone moves the rollup zone, and the log says how many rollups stay" {
    ro p = place("upkeep-zone")
    ro all = migrations_in(bundled())
    ro _ = upkeep_line(p, all, 7, T0, "Etc/GMT-3")
    ro got = upkeep_line(p, all, 8, T0 + 60000, "Etc/GMT+5")
    assert(got.starts_with("zone=[rollup zone moved from Etc/GMT-3 to Etc/GMT+5; 0 stored daily rollup(s) stay in Etc/GMT-3]"))
}

// ── forget EMAIL, end to end (01.2 section 3.15, task T2.7) ─────────────────
//
// `repo.forget` and the compaction are proven in forget_test on an UNENCRYPTED file,
// where the bytes can be searched. Here the file is the encrypted one a start makes:
// its bytes are ciphertext and hold no address before forget either, so the byte
// question cannot be asked of it -- this holds the COMMAND: rows, backup, swap.

fn forget_line(p Paths, email str, at_ms int, seed int) Io -> str {
    ro now = at_ms
    ro who = email
    ro r = with Fs = real_fs(), Random = seeded(seed as u64) {
        with_real_db(fn() Db Fs Random -> Result[ForgetDone, StartFail] => forget_account(p, who, now, 5, true))
    }
    match r {
        Ok(ForgetDone.NoDatabase) => "no-database"
        Ok(ForgetDone.NoSuchAccount) => "no-such-account"
        Ok(ForgetDone.Forgotten(backup, older)) => "forgotten backup=${backup != ""} older=${older}"
        Err(f) => "FAIL ${f.message(p.key_file)}"
    }
}

/// Accounts, samples and polls left, through the key.
fn counts(p Paths) Io -> str {
    ro key = with Fs = real_fs() { (read_text(p.key_file.to_path()) ?? "").trim_ascii() }
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    mut out = "<none>"
    with Fail[DuckError] = |e| { out = "REFUSED ${e.message()}" } {
        consume db = Database.open(p.db_file, opts)!! {
            consume con = db.connect()!! {
                consume r = con.query("SELECT (SELECT count(*) FROM account)::VARCHAR || '/' || (SELECT count(*) FROM sample)::VARCHAR || '/' || (SELECT count(*) FROM poll)::VARCHAR")!! {
                    match r.value(0, 0)!! {
                        Value.Text(s) => { out = s }
                        _ => ()
                    }
                }
            }
        }
    }
    out
}

test "forget with no database says so and creates nothing" {
    ro p = place("forget-none")
    assert(same("none", "no-database", forget_line(p, "work@example.org", T0, 7)))
    assert(!is_on_disk(p.db_file))
    assert(!is_on_disk(p.key_file))
}

test "forget of an address nobody has changes nothing" {
    ro p = place("forget-nobody")
    ro _ = start(p, migrations_in(bundled()), 7)
    assert(same("written", "written=1", record(p, [a_reading(T0)], 8)))
    assert(same("nobody", "no-such-account", forget_line(p, "someone@example.org", T0 + 60000, 9)))
    assert(same("kept", "1/2/1", counts(p)))
}

test "forget deletes the account, backs up after, compacts, and counts the older backups" {
    ro p = place("forget-work")
    ro all = migrations_in(bundled())
    ro _ = start(p, all, 7)
    assert(same("written", "written=1", record(p, [a_reading(T0)], 8)))
    // The second start takes the weekly backup: an OLDER backup that still holds the
    // address, which the command must name and must not delete.
    ro _ = upkeep_line(p, all, 9, T0 + 60000, "Etc/GMT-3")
    // The address in another spelling: forget normalises it, as discovery does.
    assert(same("forgot", "forgotten backup=true older=1", forget_line(p, "  Work@Example.ORG ", T0 + 120000, 10)))
    assert(same("gone", "0/0/0", counts(p)))
    // The compacted copy took the old file's place: nothing is left beside it.
    assert(!is_on_disk("${p.db_file}.fresh"))
    // And a second run finds nobody, rather than failing on a half-done state.
    assert(same("again", "no-such-account", forget_line(p, "work@example.org", T0 + 180000, 11)))
}

// ── the daily upkeep of a running server ────────────────────────────────────

fn daily_line(p Paths, at_ms int, seed int) Io -> str {
    ro now = at_ms
    ro care = Upkeep.new(30, 400, 20, "Etc/GMT-3")
    ro r = with Fs = real_fs(), Random = seeded(seed as u64) {
        with_real_db(fn() Db Fs Random -> Result[Upkept, StartFail] => upkeep_daily(p, care, now, 5, true))
    }
    match r {
        Ok(d) => "zone=[${d.zone}] retention=[${d.retention_fail}] weekly=${d.weekly != ""} weekly_fail=[${d.weekly_fail}]"
        Err(f) => "FAIL ${f.message(p.key_file)}"
    }
}

test "the daily upkeep runs the start's pass on the open database, weekly backup when due" {
    ro p = place("daily")
    ro _ = upkeep_line(p, migrations_in(bundled()), 7, T0, "Etc/GMT-3")
    // A day later, the server still up: the zone is already written, the pass runs, and
    // the first weekly backup is due -- the start took none (a first start never does).
    assert(same("day 2", "zone=[] retention=[] weekly=true weekly_fail=[]", daily_line(p, T0 + 86400000, 8)))
    // The next day the backup is not due again.
    assert(same("day 3", "zone=[] retention=[] weekly=false weekly_fail=[]", daily_line(p, T0 + 2 * 86400000, 9)))
}

// -- the previous settings, kept before a save (01.2 section 3.14, task T2.14) --

fn keep_version(p Paths, toml str, at_ms int, seed int) Io -> str {
    ro text = toml
    ro at = at_ms
    ro r = with Fs = real_fs(), Random = seeded(seed as u64) {
        with_real_db(fn() Db Fs Random -> Result[(), str] => record_config_version(p, text, "ui", at, true))
    }
    match r {
        Ok(_) => "kept"
        Err(e) => "FAIL ${e}"
    }
}

/// Every kept version, oldest first: `source|toml` joined by ` ; `.
fn versions(p Paths) Io -> str {
    ro key = with Fs = real_fs() { (read_text(p.key_file.to_path()) ?? "").trim_ascii() }
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    mut out = "<none>"
    with Fail[DuckError] = |e| { out = "REFUSED ${e.message()}" } {
        consume db = Database.open(p.db_file, opts)!! {
            consume con = db.connect()!! {
                consume r = con.query("SELECT coalesce(string_agg(source || '|' || toml, ' ; ' ORDER BY created_at), '') FROM config_history")!! {
                    match r.value(0, 0)!! {
                        Value.Text(s) => { out = s }
                        _ => ()
                    }
                }
            }
        }
    }
    out
}

test "a kept version lands in config_history with its source, as it was handed over" {
    ro p = place("config-version")
    ro _ = start(p, migrations_in(bundled()), 7)
    assert(same("first", "kept", keep_version(p, "schema = 1\naccess_token = \"***\"", T0, 8)))
    assert(same("second", "kept", keep_version(p, "schema = 1", T0 + 60000, 9)))
    assert(same("rows", "ui|schema = 1\naccess_token = \"***\" ; ui|schema = 1", versions(p)))
}

test "keeping a version with no database refuses, and says why" {
    // A per-call write must not create a key, even without a database.
    ro p = place("config-version-none")
    assert(keep_version(p, "schema = 1", T0, 8).starts_with("FAIL "))
}

fn file_bytes(path str) Io -> str => with Fs = real_fs() { Base64.encode_url(read(path.to_path())!!) }

fn history_ok(p Paths) Io -> bool => with Fs = real_fs(), Random = seeded(7) {
    with_real_db(fn() Db Fs Random -> Result[HistFolderRows, str] => read_history_rows(p, T0 - 1, T0 + 60000, [], [], false, true)).is_ok()
}

fn days_ok(p Paths) Io -> bool => with Fs = real_fs(), Random = seeded(7) {
    with_real_db(fn() Db Fs Random -> Result[int, str] => read_history_days_in(p, true)).is_ok()
}

fn no_discovery() -> Discovered => { folders: [], dirs: [] }

fn discovery_ok(p Paths) Io -> bool => with Fs = real_fs(), Random = seeded(7) {
    with_real_db(fn() Db Fs Random -> Result[int, StartFail] => record_found(p, no_discovery(), T0, true)).is_ok()
}

fn import_ok(p Paths) Io -> bool => with Fs = real_fs(), Random = seeded(7) {
    with_real_db(fn() Db Fs Random -> Result[Imported, str] => import_history(p, "{}", T0 + 120000, 5, true)).is_ok()
}

fn can_open(path str, key str) Io -> bool {
    mut opts = DbOptions.defaults()
    opts.encryption_key = key
    mut ok = false
    with Fail[DuckError] = |e| { ok = false } {
        consume db = Database.open(path, opts)!! {
            consume con = db.connect()!! {
                consume r = con.query("SELECT count(*) FROM schema_meta")!! { ok = true }
            }
        }
    }
    ok
}

test "plain startup writes reads imports backs up and compacts without a key" {
    ro p = place("plain-lifecycle").with_encryption(false)
    assert(start_at(p, migrations_in(bundled()), 7, T0, "UTC").is_ok())
    assert(!is_on_disk(p.key_file))
    assert(same("plain tick", "written=1", record(p, [a_reading(T0)], 8)))
    assert(same("plain rows", "1/Example Inc/2/2/1", rows(p)))
    assert(history_ok(p))
    assert(days_ok(p))
    assert(discovery_ok(p))
    assert(same("config", "kept", keep_version(p, "schema = 1", T0, 8)))
    assert(same("config rows", "ui|schema = 1", versions(p)))
    assert(import_ok(p))
    assert(!daily_line(p, T0 + 86400000, 8).starts_with("FAIL"))
    assert(can_open("${p.backup_dir}/${backup_name(T0 + 120000)}", ""))
    assert(forget_line(p, "work@example.org", T0 + 180000, 9).starts_with("forgotten backup=true"))
    assert(same("plain compacted", "0/0/0", counts(p)))
    assert(can_open(p.db_file, ""))
    assert(!is_on_disk(p.key_file))
}

fn all_refuse(p Paths) Io -> () {
    assert(start(p, migrations_in(bundled()), 9).starts_with("FAIL "))
    assert(record(p, [a_reading(T0)], 9).starts_with("FAIL "))
    assert(keep_version(p, "schema = 1", T0, 9).starts_with("FAIL "))
    assert(forget_line(p, "work@example.org", T0, 9).starts_with("FAIL "))
    assert(daily_line(p, T0, 9).starts_with("FAIL "))
    assert(!history_ok(p))
    assert(!days_ok(p))
    assert(!discovery_ok(p))
    assert(!import_ok(p))
}

test "encrypted database and backup require original key and all missing-key paths preserve bytes" {
    ro p = place("lost-key")
    assert(start_at(p, migrations_in(bundled()), 7, T0, "UTC").is_ok())
    assert(same("tick", "written=1", record(p, [a_reading(T0)], 8)))
    assert(import_ok(p))
    ro key = with Fs = real_fs() { read_text(p.key_file.to_path())!! }
    ro backup = "${p.backup_dir}/${backup_name(T0 + 120000)}"
    assert(can_open(p.db_file, key))
    assert(can_open(backup, key))
    assert(!can_open(p.db_file, ""))
    assert(!can_open(backup, ""))
    ro before = file_bytes(p.db_file)
    with Fs = real_fs() { remove_file(p.key_file.to_path())!! }
    ro entries = with Fs = real_fs() { read_dir(p.config_dir.to_path())!!.len() }
    all_refuse(p)
    assert(!is_on_disk(p.key_file))
    assert(file_bytes(p.db_file) == before)
    assert(with Fs = real_fs() { read_dir(p.config_dir.to_path())!!.len() } == entries)
    all_refuse(p.with_encryption(false))
    assert(!is_on_disk(p.key_file))
    assert(file_bytes(p.db_file) == before)
    for bad in [" \n", "incorrect-key"] {
        with Fs = real_fs() { write_text(p.key_file.to_path(), bad)!! }
        all_refuse(p)
        assert(file_bytes(p.db_file) == before)
        assert(with Fs = real_fs() { read_text(p.key_file.to_path())!! } == bad)
    }
    // A directory in place of the file is present but unreadable as a key.
    with Fs = real_fs() {
        remove_file(p.key_file.to_path())!!
        create_dir_all(p.key_file.to_path())!!
    }
    all_refuse(p)
    assert(file_bytes(p.db_file) == before)
    assert(with Fs = real_fs() { read_dir(p.key_file.to_path())!!.len() } == 0)
    with Fs = real_fs() { remove_dir_all(p.key_file.to_path())!! }
    with Fs = real_fs() { write_text(p.key_file.to_path(), key)!! }
    assert(history_ok(p))
    assert(days_ok(p))
}
