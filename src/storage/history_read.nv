// history_read.nv — the rows behind `GET /api/history` (task T2.15).
//
//   ./nova.sh test src/storage/history_read_live_test.nv
//
// Source: 01.2 §4 (the queries of `/api/history?by=account`), §3.16 (gaps come from
// `poll`, not from a missing sample).
//
// ── Its own module, not a section of `repo.nv` ──────────────────────────────
//
// The card names `storage/repo.nv` as the home of these selections. `repo.nv` is the
// WRITE side -- one tick, one transaction, a spy that checks statement order -- and
// nothing in it reads. These types are what the history handler is built from, so
// the handler imports this module; putting them in `repo.nv` would make the server
// import the writer to read.
//
// ── One query per window, on purpose ───────────────────────────────────────
//
// A machine has a handful of accounts and three windows each (01.2 §3.7), so the
// answer is a dozen small queries. One query over every sample, regrouped by window
// id in the caller, saves those round-trips at the price of a merge that has to
// agree with SQL about how UUIDs sort -- a second ordering rule to keep true. The
// queries are in-process; the round-trips cost microseconds.

module storage.history_read

import duckdb.db_effect.{Db, ConnRef}
import duckdb.errors.{DuckError}
import duckdb.types.{Value}
import claude_limits.storage.repo.{quote, moment, account_key_sql}
import claude_limits.storage.history_rows.{HistSample, HistLock, HistPoll, HistWindow, HistAccount, HistRows, HistRollup, HistDir, HistOcc, HistFolderRows}

// ── the SQL ──────────────────────────────────────────────────────────────────

/// ` AND <col> IN ('a', 'b')`, or "" for no filter. An empty list is NO filter --
/// the caller decides "every account" by passing nothing, never by passing a list
/// that happens to be empty after a lookup.
export fn history_in_sql(col str, ids []str) -> str {
    if ids.len() == 0 { return "" }
    mut list = ""
    for id in ids {
        if list != "" { list = "${list}, " }
        list = "${list}${quote(id)}"
    }
    " AND ${col}::VARCHAR IN (${list})"
}

fn span_sql(col str, from_ms int, to_ms int) -> str =>
    "${col} >= ${moment(from_ms)} AND ${col} < ${moment(to_ms)}"

/// The calendar days `[from, to)` touches, as DATE bounds. Wide by a day on each side
/// on purpose: `day_on` is a date in the rollup's zone, the range is in UTC, and the
/// caller keeps only the days whose noon falls inside the range.
fn days_sql(col str, from_ms int, to_ms int) -> str =>
    "${col} >= (${moment(from_ms)})::DATE - 1 AND ${col} <= (${moment(to_ms)})::DATE + 1"

/// The windows with at least one sample in `[from, to)`, in id order.
export fn history_windows_sql(from_ms int, to_ms int, accounts []str) -> str =>
    "SELECT w.id::VARCHAR, w.account_id::VARCHAR, w.kind, w.model FROM limit_window w WHERE w.account_id IN (SELECT x.id FROM account x WHERE x.deleted_at IS NULL) AND (EXISTS (SELECT 1 FROM sample s WHERE s.window_id = w.id AND ${span_sql("s.sampled_at", from_ms, to_ms)}) OR EXISTS (SELECT 1 FROM daily_rollup r WHERE r.window_id = w.id AND ${days_sql("r.day_on", from_ms, to_ms)}))${history_in_sql("w.account_id", accounts)} ORDER BY w.id::VARCHAR"

/// The samples of one window in `[from, to)`, with their cycle's reset moment.
export fn history_samples_sql(window_id str, from_ms int, to_ms int) -> str =>
    "SELECT epoch_ms(s.sampled_at), s.percent::BIGINT, epoch_ms(c.resets_at), s.locked FROM sample s JOIN window_cycle c ON c.id = s.cycle_id WHERE s.window_id = ${quote(window_id)} AND ${span_sql("s.sampled_at", from_ms, to_ms)} ORDER BY s.sampled_at"

/// The lock periods of one window that OVERLAP `[from, to)` -- a lock that began
/// before the range and is still on is part of the picture.
export fn history_locks_sql(window_id str, from_ms int, to_ms int) -> str =>
    "SELECT epoch_ms(lp.started_at), coalesce(epoch_ms(lp.ended_at), 0), lp.reason, coalesce((SELECT s.locked_reason FROM sample s WHERE s.window_id = lp.window_id AND s.sampled_at >= lp.started_at AND s.locked AND s.locked_reason IS NOT NULL ORDER BY s.sampled_at LIMIT 1), '') FROM lock_period lp WHERE lp.window_id = ${quote(window_id)} AND lp.started_at < ${moment(to_ms)} AND (lp.ended_at IS NULL OR lp.ended_at > ${moment(from_ms)}) ORDER BY lp.started_at"

/// The accounts that own a window of the list, in id order.
export fn history_accounts_sql(from_ms int, to_ms int, accounts []str) -> str =>
    "SELECT a.id::VARCHAR, ${account_key_sql("a")}, a.color_slot::BIGINT FROM account a WHERE a.deleted_at IS NULL AND (EXISTS (SELECT 1 FROM limit_window w JOIN sample s ON s.window_id = w.id WHERE w.account_id = a.id AND ${span_sql("s.sampled_at", from_ms, to_ms)}) OR EXISTS (SELECT 1 FROM limit_window w JOIN daily_rollup r ON r.window_id = w.id WHERE w.account_id = a.id AND ${days_sql("r.day_on", from_ms, to_ms)}))${history_in_sql("a.id", accounts)} ORDER BY a.id::VARCHAR"

/// The rollup rows of one window on the days `[from, to)` touches.
export fn history_rollups_sql(window_id str, from_ms int, to_ms int) -> str =>
    "SELECT (r.day_on - DATE '1970-01-01')::BIGINT, r.peak_percent::BIGINT, (r.avg_percent * 100)::BIGINT, r.locked_sec::BIGINT FROM daily_rollup r WHERE r.window_id = ${quote(window_id)} AND ${days_sql("r.day_on", from_ms, to_ms)} ORDER BY r.day_on"

/// The polls of one account in `[from, to)`.
export fn history_polls_sql(account_id str, from_ms int, to_ms int) -> str =>
    "SELECT epoch_ms(polled_at), outcome FROM poll WHERE account_id = ${quote(account_id)} AND ${span_sql("polled_at", from_ms, to_ms)} ORDER BY polled_at"

// ── reading ──────────────────────────────────────────────────────────────────

fn cells_of(conn ConnRef, sql str) Db -> Result[[][]Value, DuckError] {
    ro rows = Db.query(conn, sql)?
    mut out [][]Value = []
    mut going = true
    while going {
        match Db.next(rows) {
            Ok(Some(cells)) => out.push(cells)
            Ok(None) => { going = false }
            Err(e) => {
                Db.close_result(rows)
                return Err(e)
            }
        }
    }
    Db.close_result(rows)
    Ok(out)
}

fn int_of(v Value) -> int =>
    match v {
        Value.Int(n) => n as int
        Value.UInt(n) => n as int
        _ => 0
    }

fn text_of(v Value) -> str =>
    match v {
        Value.Text(s) => s
        _ => ""
    }

fn bool_of(v Value) -> bool =>
    match v {
        Value.Bool(b) => b
        _ => false
    }

/// Everything `by=account` draws for `[from, to)`. `accounts` empty is every account.
export fn read_history(conn ConnRef, from_ms int, to_ms int, accounts []str) Db -> Result[HistRows, DuckError] {
    mut windows []HistWindow = []
    for w in cells_of(conn, history_windows_sql(from_ms, to_ms, accounts))? {
        ro id = text_of(w[0])
        mut samples []HistSample = []
        for s in cells_of(conn, history_samples_sql(id, from_ms, to_ms))? {
            samples.push(HistSample{ at_ms: int_of(s[0]), percent: int_of(s[1]), resets_at_ms: int_of(s[2]), locked: bool_of(s[3]) })
        }
        mut locks []HistLock = []
        for l in cells_of(conn, history_locks_sql(id, from_ms, to_ms))? {
            locks.push(HistLock{ from_ms: int_of(l[0]), to_ms: int_of(l[1]), reason: text_of(l[2]), server_reason: text_of(l[3]) })
        }
        mut rollups []HistRollup = []
        for r in cells_of(conn, history_rollups_sql(id, from_ms, to_ms))? {
            rollups.push(HistRollup{ day: int_of(r[0]), peak: int_of(r[1]), avg_hundredths: int_of(r[2]), locked_sec: int_of(r[3]) })
        }
        windows.push(HistWindow{ account_id: text_of(w[1]), kind: text_of(w[2]), model: text_of(w[3]), samples, locks, rollups })
    }
    mut out_accounts []HistAccount = []
    for a in cells_of(conn, history_accounts_sql(from_ms, to_ms, accounts))? {
        ro id = text_of(a[0])
        mut polls []HistPoll = []
        for p in cells_of(conn, history_polls_sql(id, from_ms, to_ms))? {
            polls.push(HistPoll{ at_ms: int_of(p[0]), outcome: text_of(p[1]) })
        }
        out_accounts.push(HistAccount{ id, email: text_of(a[1]), color_slot: int_of(a[2]), polls })
    }
    Ok(HistRows{ accounts: out_accounts, windows })
}

// ── `by=folder` ─────────────────────────────────────────────────────────────

/// The login directories `by=folder` shows: every live one, and a removed one whose
/// journal still reaches into the range -- its history did not stop being true.
export fn history_dirs_sql(from_ms int, to_ms int, dirs []str) -> str =>
    "SELECT l.id::VARCHAR, l.path, l.name FROM login_dir l WHERE (l.deleted_at IS NULL OR EXISTS (SELECT 1 FROM occupancy o WHERE o.login_dir_id = l.id AND o.started_at < ${moment(to_ms)} AND (o.ended_at IS NULL OR o.ended_at > ${moment(from_ms)})))${history_in_sql("l.id", dirs)} ORDER BY l.name, l.id::VARCHAR"

/// The journal rows overlapping `[from, to)`, with the e-mail of who sat there.
export fn history_occupancy_sql(from_ms int, to_ms int, dirs []str) -> str =>
    "SELECT o.login_dir_id::VARCHAR, coalesce(o.account_id::VARCHAR, ''), coalesce(${account_key_sql("a")}, ''), o.token_state, epoch_ms(o.started_at), coalesce(epoch_ms(o.ended_at), 0) FROM occupancy o LEFT JOIN account a ON a.id = o.account_id WHERE o.started_at < ${moment(to_ms)} AND (o.ended_at IS NULL OR o.ended_at > ${moment(from_ms)})${history_in_sql("o.login_dir_id", dirs)} ORDER BY o.login_dir_id::VARCHAR, o.started_at"

/// Everything `by=folder` draws for `[from, to)`. `dirs` empty is every directory.
///
/// The accounts' history is read through `read_history` with the accounts the
/// journal NAMES -- and with none named, it is not read at all: an empty filter there
/// means "every account", which is the opposite of what an empty journal says.
export fn read_folder_history(conn ConnRef, from_ms int, to_ms int, dirs []str) Db -> Result[HistFolderRows, DuckError] {
    mut out_dirs []HistDir = []
    for d in cells_of(conn, history_dirs_sql(from_ms, to_ms, dirs))? {
        out_dirs.push(HistDir{ id: text_of(d[0]), path: text_of(d[1]), name: text_of(d[2]) })
    }
    mut occ []HistOcc = []
    mut named []str = []
    for o in cells_of(conn, history_occupancy_sql(from_ms, to_ms, dirs))? {
        ro acc = text_of(o[1])
        occ.push(HistOcc{ login_dir_id: text_of(o[0]), account_id: acc, email: text_of(o[2]), token_state: text_of(o[3]),
                          from_ms: int_of(o[4]), to_ms: int_of(o[5]) })
        if acc != "" {
            mut seen = false
            for n in named { if n == acc { seen = true } }
            if !seen { named.push(acc) }
        }
    }
    ro rows = if named.len() == 0 { HistRows{ accounts: [], windows: [] } } else { read_history(conn, from_ms, to_ms, named)? }
    Ok(HistFolderRows{ dirs: out_dirs, occupancy: occ, rows })
}
