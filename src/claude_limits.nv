const USAGE = "usage: claude-limits [--once | --serve] [--config PATH] [--offline DIR] [--parent DIR] [--color auto|always|never] [DIR ...]"
const USAGE_AUTOSTART = "       claude-limits --install-autostart | --uninstall-autostart"
const USAGE_FORGET = "       claude-limits forget EMAIL [--config PATH]   delete everything stored about one account\n       claude-limits import-history FILE [--config PATH]   the reference's claude-limits-history.json into the history"

/// One folder's worth of output, as lines, computed with the disk available.
///
/// Returns lines rather than printing them: printing is the caller's job because of
/// #1017, and returning them is also what makes the shape of this function reviewable
/// -- a function that printed as it went would hide how many lines it decided on.
/// The accounts in one configured folder, grouped, with the display name already
/// substituted. Returns them rather than printing: what to print depends on the usage
/// reply, which is fetched per account afterwards.
/// Every login in one configured folder, with the display name already substituted.
///
/// Returns LOGINS, not accounts, and that is the whole point: grouping happens once
/// over all the configured directories, because one account may live in several of
/// them. Grouping per directory turns one account into two, each showing its own
/// percentage, with nothing to say they are the same.
fn logins_in(path str) Dirs Creds -> []Login {
    ro folder = scan(path)
    // `folder.problem` is DELIBERATELY not swallowed here -- see `folder_problem`.
    mut logins []Login = []
    for d in folder.logins {
        // `short_name` is applied HERE, at the only place that still has both the path
        // and the name. `group` keeps whatever name it is given and the header prints
        // it, so a bare `.claude` -- which every default login is called -- would
        // identify nothing. The reference substitutes at the same point (:136).
        logins.push(read_login(d.path, short_name(d.path, d.name), d.identity,
                               d.credentials))
    }
    return logins
}

/// Logins that `group` will drop, because they carry no e-mail.
///
/// `group` drops them deliberately -- merging every nameless directory into one
/// phantom account would be worse -- and its comment says they are "reported by the
/// discovery layer, which knows the path". This is that reporting, and its absence is
/// what made `--once` answer "no Claude Code logins found in:" for a directory holding
/// `.credentials.json` and nothing else.
///
/// The reference keeps them too, keyed by path and labelled `unknown account`
/// (claude_limits.py:132 and :142). One line each: two nameless directories are two
/// accounts, not one.
fn nameless_in(path str) Dirs Creds -> []str {
    ro folder = scan(path)
    mut out []str = []
    for d in folder.logins {
        ro l = read_login(d.path, short_name(d.path, d.name), d.identity, d.credentials)
        if l.email == "" { out.push(short_name(d.path, d.name)) }
    }
    return out
}

/// Why a folder yielded nothing, in the folder's own words -- "" when it held logins.
///
/// Without this, three different states print the same line: the path does not exist,
/// the path is not a directory, and the directory holds no login. `scan` distinguishes
/// them and says so in `folder.problem`; discarding that and printing "no logins found"
/// for all three is how I spent an hour unable to tell which of them I was looking at.
fn folder_problem(path str) Dirs -> str {
    ro folder = scan(path)
    if folder.logins.len() > 0 { return "" }
    return folder.problem
}

/// The recorded reply for one account: `<dir>/<email>.json`, else `<dir>/normal.json`
/// -- the reference's rule (`offline_usage`, :317).
///
/// An absent file yields "" and `parse` then reports its own outcome, rather than this
/// function inventing one. The reference raises instead; here the difference surfaces
/// as a row that disagrees, which is what the differential is for.
fn recorded_reply(offline str, email str) Creds -> str {
    if offline == "" { return "" }
    if email != "" {
        ro named = "${offline}/${email}.json"
        ro body = Creds.read(named)
        if body != "" { return body }
    }
    return Creds.read("${offline}/normal.json")
}

/// The home directory as a plain string, or "" when the system will not say.
///
/// Only the Linux record uses it; on Windows `entry_for` ignores it entirely. It is
/// read here rather than inside the handler so that the MESSAGE printed to the person
/// names the same location the handler wrote to -- two independent reads could differ,
/// and then the program would tell them to look somewhere it had not written.
fn home_str() Os -> str =>
    match home_dir() {
        Some(p) => p.to_str() ?? ""
        None => ""
    }

/// What `health` says about the database this start opened. A named function, not a
/// literal in the `match`: a record literal there did not become the arm's value.
/// The readings of one round, gathered by the `PollLog` handler.
type Collected {
    mut items []Reading
}

/// Kimi renewals that FAILED, and when -- the cooldown (the reference's KimiRefresher).
/// In memory only, as there: a restart retries a hopeless login once, which is the
/// cheaper mistake than a state file that suppresses a renewal that was needed.
/// One renewal attempt that counts against the cooldown: which file, and when.
type LoginTry value {
    ro path str
    ro at_ms int
}

fn login_try(path str, at_ms int) -> LoginTry => { path, at_ms }

/// The cooldown of renewals (the reference's KimiRefresher and Refresher). In memory
/// only, as there: a restart retries a hopeless login once, which is the cheaper
/// mistake than a state file that suppresses a renewal that was needed.
type LoginTries {
    mut items []LoginTry
}

fn LoginTries.new() -> LoginTries => { items: [] }

fn LoginTries @cooling(path str, now_ms int, cooldown_ms int) -> bool {
    for x in @items {
        if x.path == path { return now_ms - x.at_ms < cooldown_ms }
    }
    false
}

/// Everything but `path`.
fn LoginTries @without(path str) -> []LoginTry {
    mut keep []LoginTry = []
    for x in @items { if x.path != path { keep.push(x) } }
    keep
}

fn LoginTries mut @tried(path str, now_ms int) -> () {
    mut keep = @without(path)
    keep.push(login_try(path, now_ms))
    @items = keep
}

/// A Kimi success clears the cooldown: a login that renewed once is renewable, and its
/// next expiry (fifteen minutes on) must get a fresh try at once.
fn LoginTries mut @cleared(path str) -> () { @items = @without(path) }

/// One Kimi renewal attempt, logged as the reference logs it.
fn renew_one(mut tries LoginTries, path str, name str, cooldown_sec int) Http Time -> bool {
    ro now = Time.now().unix_millis() as int
    if tries.cooling(path, now, cooldown_sec * 1000) { return false }
    ro r = with Fs = real_fs() { renew_kimi(path, now / 1000) }
    match r {
        Renewed.Fresh => {
            tries.cleared(path)
            println("claude-limits: auto-refresh ${name}: refreshed")
            true
        }
        Renewed.Rotated => {
            tries.cleared(path)
            println("claude-limits: auto-refresh ${name}: token rotated by another Kimi tool; using its file")
            true
        }
        Renewed.Failed(why) => {
            tries.tried(path, now)
            println("claude-limits: auto-refresh ${name}: failed -- ${why}")
            false
        }
    }
}

/// The credentials file's mtime in milliseconds, 0 when there is none -- the only
/// thing ever read from that file on this path (`claude_refresh.nv`): a directory
/// without one was never logged in, and there is nothing to renew.
fn creds_mtime_ms(dir str) -> int {
    ro f = under(dir, ".credentials.json")
    with Fs = real_fs() {
        match metadata(f.to_path()) {
            Ok(m) => m.mtime_ns / 1000000
            Err(_) => 0
        }
    }
}

/// One Claude renewal: LAUNCH Claude Code under the directory and do not wait.
///
/// The round runs in the store's fiber and every reader waits for it; waiting for
/// `claude` held the page for as long as it took (CI's smoke, 2026-10-02). The launcher
/// returns at once, the hidden PowerShell bounds and waits, and the next round reads
/// the file. `false`: nothing changed on disk yet, so nothing is worth reading again.
fn renew_claude(mut tries LoginTries, path str, name str, model str, timeout_sec int, cooldown_sec int) Time -> bool {
    ro now = Time.now().unix_millis() as int
    if tries.cooling(path, now, cooldown_sec * 1000) { return false }
    // Counted from the ATTEMPT, as the reference's Refresher counts it: a run that
    // answered "unchanged" also spent a request.
    tries.tried(path, now)
    ro home = with Os = real_os() {
        match home_dir() {
            Some(p) => p.display()
            None => ""
        }
    }
    ro dir = expand_home(path, home)
    if creds_mtime_ms(dir) == 0 {
        println("claude-limits: auto-refresh ${name}: no .credentials.json, never logged in here")
        return false
    }
    ro run = refresh_run(dir, model, timeout_sec)
    mut c = Command.new(run.program)
    c.args(run.args)
    ro code = with Os = real_os() {
        match c.run() {
            Ok(st) => st.code()
            Err(_) => -1
        }
    }
    if code == 0 {
        println("claude-limits: auto-refresh ${name}: started; Claude Code renews the file, the next round reads it")
    } else {
        println("claude-limits: auto-refresh ${name}: could not be started (exit ${code})")
    }
    false
}

fn Collected.new() -> Collected => { items: [] }

/// A round's body and the readings behind it.
type Round {
    view SnapshotView
    readings []Reading
    /// The folders and directories the round scanned, for the database.
    found Discovered
}

fn round_of(view SnapshotView, readings []Reading, found Discovered) -> Round => { view, readings, found }

/// One round, and the readings behind it.
///
/// A NAMED FUNCTION, not a block inside the lambda that calls it: a local captured by
/// the `PollLog` handler inside a lambda did not reach the C -- `got` undeclared, first
/// when the local was the caller's, and on nova main 04e9fe2d1 even when it was the
/// lambda's own (nova-integ 8900d9a61 built the latter). In a function body the same
/// capture is the shape `feed_test` has always used.
fn collect_round(rounds Rounds) Http Dirs Creds Time -> Round {
    mut got = Collected.new()
    mut tries = LoginTries.new()
    ro view = with Renew = effect Renew {
        kimi(path str, name str, cooldown_sec int) -> bool { renew_one(tries, path, name, cooldown_sec) }
        claude(path str, name str, model str, timeout_sec int, cooldown_sec int) -> bool {
            renew_claude(tries, path, name, model, timeout_sec, cooldown_sec)
        }
    }, PollLog = effect PollLog {
        // Not logged: a log line would carry the e-mail, which 01.2 section 10 keeps
        // out of logs. The journal is `poll`, written from the readings.
        record(email str, state str, message str, at_ms int) -> () {}
        reading(r Reading) -> () { got.items.push(r) }
    } {
        one_round(rounds)
    }
    // A second scan rather than a field threaded out of `one_round`: the round reads
    // discovery to ASK, this reads it to RECORD, and the two can differ by a file that
    // appeared in between -- the record should say what is there when it is written.
    round_of(view, got.items, discovered(rounds.folders, Time.now().unix_millis()))
}

/// The rounds, with the real disk, network and database: `--serve`'s main fiber.
fn run_rounds(rx ChanRx[Envelope], rounds Rounds, paths Paths, win bool, care Upkeep, keep int) Io Net Time -> () {
    with_real_disk(fn() Dirs Creds -> () {
        with Http = real_http() { rounds_recorded(rx, rounds, paths, win, care, keep) }
    })
}

/// The loop, with a `PollLog` that gathers each round's readings and a `RoundLog` that
/// writes them once the round is over. A NAMED FUNCTION for the reason `collect_round`
/// is one: a handler capturing a local inside a lambda lost it (registry 221.1 #1453).
fn rounds_recorded(rx ChanRx[Envelope], rounds Rounds, paths Paths, win bool, care Upkeep, keep int) Http Dirs Creds Time Io -> () {
    mut got = Collected.new()
    // The local day of the last upkeep: the start ran one, so today is done.
    mut upkept_on = local_day(Time.now().unix_millis())
    ro how = care
    ro backups = keep
    // LOCALS, not the parameters themselves: a handler literal capturing a PARAMETER
    // emits a `_box_<name>` the C never declares (measured 2026-10-01 on nova main).
    ro where = paths
    ro on_windows = win
    ro folders = rounds.folders
    mut tries = LoginTries.new()
    with Renew = effect Renew {
        kimi(path str, name str, cooldown_sec int) -> bool { renew_one(tries, path, name, cooldown_sec) }
        claude(path str, name str, model str, timeout_sec int, cooldown_sec int) -> bool {
            renew_claude(tries, path, name, model, timeout_sec, cooldown_sec)
        }
    }, PollLog = effect PollLog {
        // Not logged: a log line would carry the e-mail, which 01.2 section 10 keeps
        // out of logs. The journal is `poll`, written from the readings.
        record(email str, state str, message str, at_ms int) -> () {}
        reading(r Reading) -> () { got.items.push(r) }
    }, RoundLog = effect RoundLog {
        settings(held ConfNow, view SnapshotView) -> Settled {
            match settings_if_moved(where, held) {
                Some(next) => Settled.new(next, render_state(config_now(next, where, view)))
                None => Settled.new(held, "")
            }
        }
        done(view SnapshotView, conf ConfNow) -> SnapshotView {
            // The folders AS THEY STAND: a folder saved since the start is discovered
            // and written like the others.
            ro now_folders = if conf.tag == "" { folders } else { conf.cfg.folders }
            record_round(where, on_windows, view, got.items, now_folders)
            got.items = []
            ro today = local_day(Time.now().unix_millis())
            if today != upkept_on {
                upkeep_round(where, on_windows, how, backups)
                upkept_on = today
            }
            forecast_round(where, on_windows, view, conf)
        }
    } {
        store_and_poll(rx, rounds)
    }
}

/// The machine's calendar day of a moment, `YYYY-MM-DD`: the day the upkeep counts in.
fn local_day(ms int) -> str => ms.to_unix_millis().to_zoned(TimeZone.Fixed(Offset.local())).datetime().date().to_iso()

/// Once a local day, after a round: the upkeep of 01.2 section 5 on the running server.
/// The start runs it too; between starts, this is what makes "once a day" true.
fn upkeep_round(at Paths, windows bool, u Upkeep, keep int) Io Time -> () {
    ro paths = at
    ro win = windows
    ro how = u
    ro backups = keep
    ro now = Time.now().unix_millis()
    ro r = with Fs = real_fs(), Random = real_random() {
        with_real_db(fn() Db Fs Random -> Result[Upkept, StartFail] => upkeep_daily(paths, how, now, backups, win))
    }
    match r {
        Err(f) => println("claude-limits: the daily upkeep did not run: ${f.message(paths.key_file)}")
        Ok(d) => {
            if d.zone != "" { println("claude-limits: ${d.zone}") }
            if d.retention_fail != "" { println("claude-limits: the retention pass did not run: ${d.retention_fail}") }
            if d.weekly != "" { println("claude-limits: weekly backup ${d.weekly}") }
            if d.weekly_fail != "" { println("claude-limits: the weekly backup was not taken: ${d.weekly_fail}") }
        }
    }
}

/// Write one round: its readings as ticks, then what discovery found (an occupancy row
/// names its account, and the ticks create the account rows). Neither stops the server:
/// a failure is a log line, and the next round tries again.
fn record_round(at Paths, windows bool, view SnapshotView, readings []Reading, folders []str) Io Dirs Creds Time -> () {
    // LOCALS for the lambdas below: two lambdas capturing one PARAMETER emitted a
    // `_box_<name>` the C never declared (measured 2026-10-01 on nova main); a local
    // captured the same way is the shape `serve_mode` already has, and it builds
    // (registry 221.1 #1559, `probes/record-param-two-with-lambdas/`).
    ro paths = at
    ro win = windows
    ro emails = emails_of(view)
    ro orgs = orgs_of(view)
    // Kimi Code readings are written as well since migration 0002 (01.2 §3.6, amendment
    // 2026-10-02): the account is keyed by its credentials file, `monthly` is a kind.
    ro rs = readings
    ro recorded = with Fs = real_fs(), Random = real_random() {
        with_real_db(fn() Db Fs Random -> Result[int, StartFail] => record_readings(paths, rs, emails, orgs, win))
    }
    match recorded {
        Ok(_) => ()
        Err(f) => println("claude-limits: the history was not written: ${f.message(paths.key_file)}")
    }
    ro found_at = Time.now().unix_millis()
    ro found = discovered(folders, found_at)
    ro noted = with Fs = real_fs(), Random = real_random() {
        with_real_db(fn() Db Fs Random -> Result[int, StartFail] => record_found(paths, found, found_at, win))
    }
    match noted {
        Ok(_) => ()
        Err(f) => println("claude-limits: the folders were not written: ${f.message(paths.key_file)}")
    }
}

/// E-mails and organisations of the accounts discovery found, as the two parallel
/// lists `record_readings` takes: the organisation is not something the endpoint says.
fn emails_of(v SnapshotView) -> []str {
    mut out []str = []
    for a in v.accounts { out.push(a.email) }
    out
}

fn orgs_of(v SnapshotView) -> []str {
    mut out []str = []
    for a in v.accounts { out.push(a.org) }
    out
}

/// The live forecasts of the round, keyed by the HISTORY's account ids.
///
/// The snapshot and the database name an account differently -- the snapshot by its
/// discovery id, the database by the row's UUID -- and both by the same e-mail, which
/// the database stores lower-cased (01.2 section 3.6). So the join is by e-mail.
fn paces_of(view SnapshotView, rows HistRows) -> []HistPace {
    mut out []HistPace = []
    for l in view.limits {
        match l.forecast {
            None => ()
            Some(f) => {
                mut email = ""
                for a in view.accounts { if a.id == l.account_id { email = a.email.to_ascii_lower() } }
                for a in rows.accounts {
                    if email != "" && a.email == email {
                        out.push(HistPace{ account_id: a.id, kind: l.kind, model: l.model,
                                           rate_per_hour_milli: f.rate_per_hour_milli,
                                           runs_out_at: f.runs_out_at, label: f.label })
                    }
                }
            }
        }
    }
    out
}

/// `/api/history`'s source: the database, opened for the request and closed after.
///
/// A NAMED FUNCTION the route's lambda only calls: a handler installed inside a
/// lambda body lost the lambda's locals on nova main (registry 221.1 #1453, fixed in
/// 1d71ba01c; the CI compiler predates the fix).
fn history_from_db(paths Paths, windows bool, view SnapshotView, a HistoryAsk) -> HistoryLoad {
    ro got = with Fs = real_fs(), Random = real_random() {
        with_real_db(fn() Db Fs Random -> Result[HistFolderRows, str] => read_history_rows(paths, a.from_ms, a.to_ms, a.accounts, a.login_dirs, a.by_folder, windows))
    }
    match got {
        // Loopback: LAN is refused until Phase 6 brings TLS, so every caller here is
        // the machine itself.
        Ok(f) => HistoryLoad.Loaded({ rows: f.rows, paces: paces_of(view, f.rows), zone: TimeZone.Fixed(Offset.local()),
                                      dirs: f.dirs, occupancy: f.occupancy, disclosure: Disclosure.Loopback })
        Err(why) => HistoryLoad.Failed(why)
    }
}

/// `config_history` in the database, for `config_file.save` (01.2 §3.14).
///
/// A ROW THAT CANNOT BE WRITTEN DOES NOT STOP THE SAVE, and the log says so. The two
/// failures are not equal: a refused save loses what the person just chose, while a
/// missing history row loses one older version that is still a backup copy away. The
/// person asked for the first; nobody is waiting on the second.
fn history_in_db(paths Paths, windows bool, at_ms int) -> Effect[ConfigHistory] {
    // Locals, not the parameters, inside the handler (registry 221.1 #1559).
    ro p = paths
    ro win = windows
    ro at = at_ms
    effect ConfigHistory {
        save(toml str, source str) -> () { keep_version(p, win, toml, source, at) }
    }
}

fn keep_version(paths Paths, windows bool, toml str, source str, at_ms int) -> () {
    ro got = with Fs = real_fs(), Random = real_random() {
        with_real_db(fn() Db Fs Random -> Result[(), str] => record_config_version(paths, toml, source, at_ms, windows))
    }
    match got {
        Ok(_) => ()
        Err(e) => println("claude-limits: the previous settings were saved without a history row: ${e}")
    }
}

/// `PUT /api/config`'s commit: write the file, keep the old text, hand the store the
/// new settings, and say whether they are in force now.
///
/// LIVE WHEN ONLY `ui` AND `folders` CHANGED (`applies_live`). The order and hidden
/// accounts are read per request from the store, the folders by every round -- and a
/// new folder list starts a round at once. Everything else -- the poll interval, the
/// listener -- was taken at the start and is not re-taken yet, so the reply says
/// `restart_required` instead of claiming otherwise.
///
/// THE FILE IS READ BACK after the write: its `mtime_ns` is what the next save
/// compares, and a stored one from before the write would call our own save a hand
/// edit and refuse the next change with `412`.
fn commit_settings(paths Paths, windows bool, store Store, after Config) Time -> Committed {
    ro was = store.conf()
    ro at = Time.now().unix_millis() as int
    ro saved = with Fs = real_fs(), ConfigHistory = history_in_db(paths, windows, at) {
        save(paths.config_file, was.loaded, after, FromUi)
    }
    if saved.ok() {
        ro reread = with Fs = real_fs() { load(paths.config_file) }
        ro now_conf = conf_at_start(after, reread)
        // nova:allow W_RESULT_DISCARDED -- a store that is gone cannot be told; the file is written either way
        ro _ = store.set_conf(now_conf)
        // Every open page hears it (01.3 §3.4 `config`): another tab's panel and order
        // would otherwise keep showing the settings this save replaced.
        // nova:allow W_RESULT_DISCARDED -- a store that is gone has no streams to tell
        ro _e = store.publish("config", render_state(config_now(now_conf, paths, store.view())))
        // A new folder list is looked at NOW (§3.8), not at the next tick minutes away.
        if folders_changed(was.cfg, after) {
            // nova:allow W_RESULT_DISCARDED -- a store that is gone runs no rounds anyway
            ro _t = store.tick()
        }
    }
    match saved {
        Saved.Conflict => {
            // nova:allow W_RESULT_DISCARDED -- a store that is gone cannot be told; the reply is a 412 either way
            ro _ = store.set_conf(taken_from_disk(paths, was))
        }
        _ => ()
    }
    { saved, live: applies_live(was.cfg, after) }
}

/// Between rounds: re-read the settings file if it moved (01.2 §2.2).
///
/// Before the start has handed the store its settings (`tag` empty) there is nothing to
/// compare against, and the start's own read is about to arrive -- so nothing is done.
///
/// `None` for "keep what you hold", and the handler hands `held` back itself: returning
/// the `ro` parameter from here would be refused (E_READONLY_COERCE, D246), and a record
/// has no `clone`.
fn settings_if_moved(paths Paths, held ConfNow) -> Option[ConfNow] {
    if held.tag == "" { return None }
    ro moved = with Fs = real_fs() { on_disk_changed(paths.config_file, held.loaded) }
    if !moved { return None }
    println("claude-limits: the settings file changed on disk and was read again")
    Some(taken_from_disk(paths, held))
}

/// The settings after a hand edit: the file as it is now, judged as a start judges it.
///
/// WITHOUT THIS A HAND EDIT LOCKS THE PANEL OUT. The store would keep the old read, the
/// `412` would carry its old tag as `current`, the page would re-read that same tag, and
/// every save would conflict again until a restart -- found by the live check that
/// edited the file between two saves.
///
/// A file that a start would refuse keeps the running values (01.2 §2.2: "продолжаем с
/// предыдущими значениями") but takes the new read, so the next save is judged against
/// the file as it is and may overwrite it -- its text goes into the history first.
fn taken_from_disk(paths Paths, was ConfNow) -> ConfNow {
    ro reread = with Fs = real_fs() { load(paths.config_file) }
    match decide_start(reread) {
        Start.Go(cfg, _) => conf_at_start(cfg, reread)
        Start.Refuse(lines) => {
            println("claude-limits: the settings file has errors; the previous values stay in force:")
            for l in lines { println("  ${l}") }
            conf_at_start(was.cfg, reread)
        }
    }
}

/// `POST /api/folders/probe` on the real disk: `Dirs` and `Creds` installed here,
/// for the request, because the connection fiber has none of its own.
fn probe_on_disk(st ProbeState, p str) -> str {
    ro s = st
    ro path = p
    with_real_disk(fn() Dirs Creds -> str => probe_body(s, path))
}

/// `/api/events`' live stream: a channel of its own, handed to the store.
///
/// 128 deep: a client coming back with `Last-Event-ID` may be owed the whole ring of
/// a hundred, and the store never waits on a reader -- a stream whose channel refuses
/// is dropped, so the depth decides who survives a burst.
fn open_live(store Store, after int) -> Live {
    ro p = Chan[Event].new(128)
    ro got = store.follow(after, Follower.unregistered(p.tx, p.rx))
    Live.new(got.id, got.fresh, got.snapshot_id, p.rx)
}

/// `[forecast]` as the forecast join takes it (its own record: see `ForecastRules`).
fn rules_of(c Config) -> ForecastRules {
    ro ghost = c.forecast.ghost_thresholds()
    ForecastRules.new(c.forecast.enabled, c.forecast.working_hours, c.forecast.work_days,
                      c.forecast.work_from, c.forecast.work_to, c.forecast.off_hours_rate,
                      c.forecast.rate_window_days).with_ghost(ghost.warning, ghost.critical)
}

/// The round's snapshot with its forecasts (plan 01.6, П1), from the history the round
/// has just written. A database that does not answer leaves the forecasts `null`, with
/// a log line: the snapshot itself is still good.
fn forecast_round(paths Paths, windows bool, view SnapshotView, conf ConfNow) Time -> SnapshotView {
    ro now = Time.now().unix_millis() as int
    // A week back covers both rate windows (60 minutes, `rate_window_days` up to 7).
    ro from = now - (conf.cfg.forecast.rate_window_days.max(7) + 1) * 86400000
    ro got = with Fs = real_fs(), Random = real_random() {
        with_real_db(fn() Db Fs Random -> Result[HistFolderRows, str] => read_history_rows(paths, from, now, [], [], false, windows))
    }
    match got {
        Ok(r) => with_forecasts(view, r.rows, rules_of(conf.cfg), now, Offset.local().seconds() as int, TimeZone.Fixed(Offset.local()))
        Err(why) => {
            println("claude-limits: no forecast this round, the history did not read: ${why}")
            view
        }
    }
}

fn db_seen(r Ready, size int) -> DbAtStart =>
    { schema_version: r.opened.schema_version + r.applied, encrypted: true, size_bytes: size }

/// Say what the start did to the database, and answer the file's size for `health`.
///
/// ONE CALL IN THE `match` ARM, on purpose: with the lines and the size written out
/// in the arm, the arm's value came out as `()` (measured 2026-09-30).
fn announced(r Ready, db_file str) Io -> int {
    if r.opened.first_start {
        println("claude-limits: new database ${db_file}, encrypted")
    } else if r.applied > 0 {
        println("claude-limits: database migrated to schema ${r.opened.schema_version + r.applied} (backup ${r.backup})")
    }
    if r.upkeep.zone != "" { println("claude-limits: ${r.upkeep.zone}") }
    if r.upkeep.retention_fail != "" { println("claude-limits: the retention pass did not run: ${r.upkeep.retention_fail}") }
    if r.upkeep.weekly != "" { println("claude-limits: weekly backup ${r.upkeep.weekly}") }
    if r.upkeep.weekly_fail != "" { println("claude-limits: the weekly backup was not taken: ${r.upkeep.weekly_fail}") }
    if owner_changed(r.opened.previous_owner, r.opened.instance_id) {
        println("claude-limits: ${owner_line(r.opened.previous_owner, r.opened.instance_id)}")
    }
    with Fs = real_fs() {
        match metadata(db_file.to_path()) {
            Ok(m) => m.len()
            Err(_) => 0
        }
    }
}

/// `import-history FILE` (plan 01.6, question 1): the reference's history into the
/// database, where it joins a cycle the database already knows (`history_import.nv`).
fn import_mode(exe str, config_override str, file str) Io Time -> int {
    ro input = with Os = real_os(), Fs = real_fs() { real_paths_input(exe, config_override) }
    ro paths = resolve(input)
    ro loaded = with Fs = real_fs() { load(paths.config_file) }
    ro keep = loaded.cfg.storage.backups_keep
    ro now = Time.now().unix_millis() as int
    ro win = input.windows
    ro body = with Fs = real_fs() {
        match read_text(file.to_path()) {
            Ok(t) => t
            Err(e) => {
                println("claude-limits: cannot read ${file}: ${e}")
                return EXIT_CONFIG
            }
        }
    }
    ro done = with Fs = real_fs(), Random = real_random() {
        with_real_db(fn() Db Fs Random -> Result[Imported, str] => import_history(paths, body, now, keep, win))
    }
    match done {
        Ok(Imported.NoDatabase) => {
            println("claude-limits: no database at ${paths.db_file} yet; start the server once, then import")
            EXIT_OK
        }
        Ok(Imported.Older(v)) => {
            println("claude-limits: the database is at schema ${v}, older than this build; start the server once (it migrates), then import")
            EXIT_DB
        }
        Ok(Imported.Done(read, skipped, written, backup)) => {
            println("claude-limits: ${written} of ${read} readings written; the rest fall outside a cycle the database knows, or after its own first reading of that window")
            if skipped > 0 { println("claude-limits: ${skipped} entries of the file were not readings the port keeps (unknown kind or moment)") }
            println("claude-limits: backup before the import ${backup}")
            EXIT_OK
        }
        Err(why) => {
            println("claude-limits: ${why}")
            EXIT_DB
        }
    }
}

/// `forget EMAIL` (task T2.7): delete everything stored about one account.
///
/// The address is NOT printed back: the command exists to remove it, and echoing it
/// into a terminal scroll-back or a redirected log is one more copy.
fn forget_mode(exe str, config_override str, email str) Io Time -> int {
    ro input = with Os = real_os(), Fs = real_fs() { real_paths_input(exe, config_override) }
    ro paths = resolve(input)
    ro loaded = with Fs = real_fs() { load(paths.config_file) }
    ro keep = loaded.cfg.storage.backups_keep
    ro now = Time.now().unix_millis()
    ro win = input.windows
    ro who = email
    ro done = with Fs = real_fs(), Random = real_random() {
        with_real_db(fn() Db Fs Random -> Result[ForgetDone, StartFail] => forget_account(paths, who, now, keep, win))
    }
    match done {
        Ok(ForgetDone.NoDatabase) => {
            println("claude-limits: no database at ${paths.db_file}; nothing is stored about anyone")
            EXIT_OK
        }
        Ok(ForgetDone.NoSuchAccount) => {
            println("claude-limits: no account with that address in ${paths.db_file}; nothing was changed")
            EXIT_OK
        }
        Ok(ForgetDone.Forgotten(backup, older)) => {
            println("claude-limits: the account is forgotten: its readings, windows, polls and the address in the settings history are deleted, and the file is compacted")
            println("claude-limits: fresh backup ${backup}")
            if older > 0 {
                println("claude-limits: ${older} older backup(s) in ${paths.backup_dir} were taken before this and still hold the address; delete them if they must go too")
            }
            EXIT_OK
        }
        Err(f) => {
            println("claude-limits: ${f.message(paths.key_file)}")
            f.exit_code()
        }
    }
}

/// `--serve` (task T2.27): read the settings, refuse or go, listen, give the page.
///
/// Every decision is in `server.start` and tested there; this is the printing and the
/// socket, which no test can reach. Returns the exit code for the cases that end.
///
/// THE LISTENER IS BOUND BEFORE "listening" IS PRINTED. `serve_addr` would bind and
/// serve in one call, and then the only place to say "listening" is before the bind --
/// a line that is false on a busy port, printed right above the refusal.
fn serve_mode(exe str, config_override str) Io Net Time Detach -> int {
    ro input = with Os = real_os(), Fs = real_fs() { real_paths_input(exe, config_override) }
    ro paths = resolve(input)
    ro loaded = with Fs = real_fs() { load(paths.config_file) }
    match decide_start(loaded) {
        Start.Refuse(lines) => {
            println("claude-limits: the settings in ${paths.config_file} do not allow a start:")
            for l in lines { println("  ${l}") }
            return EXIT_CONFIG
        }
        Start.Go(cfg, repairs) => {
            for r in repairs { println("claude-limits: ${r}") }
            ro addr = listen_addr(cfg)
            match TcpListener.bind(addr) {
                Err(e) => {
                    println("claude-limits: cannot listen on ${addr}: ${e}")
                    println("claude-limits: is another copy already running? The port is [server] port in ${paths.config_file}")
                    return EXIT_OTHER
                }
                Ok(consume listener) => {
                    // ONE ROUND, AFTER THE BIND: a second copy on a busy port must not
                    // ask the endpoint at all. The rounds do not repeat yet -- see
                    // `feed.one_round` for the two runtime defects that stop them.
                    ro now = Time.now().unix_millis()
                    // THE DATABASE, AFTER THE BIND and before the round: a second copy on
                    // a busy port must not touch the file either. `Random` is given
                    // EXPLICITLY: the default handler lives only in a thread-local slot
                    // that the GC does not see (registry 221.1 #1420), and the key is
                    // generated here on a first start.
                    ro all = migrations_in(bundled())
                    ro keep = cfg.storage.backups_keep
                    ro win = input.windows
                    ro h = cfg.history
                    ro care = Upkeep.new(h.keep_days, h.rollup_keep_days, h.config_versions_keep, machine_rollup_tz(Offset.local().to_iso()))
                    ro opened = with Fs = real_fs(), Random = real_random() {
                        with_real_db(fn() Db Fs Random -> Result[Ready, StartFail] => open_for_serve(paths, all, now, keep, win, care))
                    }
                    // NOT `db`: a module of that name is in the unit, and the name resolved to it (registry 221.1 #1400).
                    ro db_state = match opened {
                        Ok(r) => db_seen(r, announced(r, paths.db_file))
                        Err(f) => {
                            println("claude-limits: ${f.message(paths.key_file)}")
                            return f.exit_code()
                        }
                    }
                    ro bounds = SeverityBounds.new(cfg.thresholds.warning, cfg.thresholds.critical)
                    ro rounds = Rounds.new(cfg.folders, cfg.poll.interval_sec, bounds, TimeZone.Fixed(Offset.local()), Offset.local().to_iso())
                    if loaded.missing {
                        println("claude-limits: no settings file yet, running on the defaults (${paths.config_file})")
                    } else {
                        println("claude-limits: settings ${paths.config_file}")
                    }
                    // Where the TLS roots came from (nova-tls 0.2: the OS store, a system
                    // bundle, or the embedded list). The first thing to read when a poll
                    // fails with a certificate error -- plan 01.5 question 9 was exactly that.
                    match system_roots() {
                        Ok(r) => println("claude-limits: TLS roots: ${r.source} (${r.detail}), ${r.count}")
                        Err(e) => println("claude-limits: TLS roots could not be loaded: ${e}")
                    }
                    // THE ROUNDS REPEAT (T2.27, 2026-10-01). The store with its poller runs
                    // in THIS fiber (`feed.store_and_poll`: D446 refuses the poll in a
                    // `spawn`); the server and the timer run beside it. Every reader asks
                    // the store, so the page shows the latest round, and every round is
                    // written to the database by `RoundLog`. The two runtime defects that
                    // kept this to one round at the start -- a channel wake lost while a
                    // fiber sits in Net (registry 221.1 #1406) and the default handler
                    // freed by the GC (#1420) -- are fixed in the compiler this builds with.
                    ro pair = Chan[Envelope].new(64)
                    ro store = Store.new(pair.tx)
                    // The settings go in FIRST: the channel is a queue, so this is the
                    // first thing the store loop takes, before any request can ask.
                    // nova:allow W_RESULT_DISCARDED -- the store loop has not started; the channel is fresh and has room
                    ro _ = store.set_conf(conf_at_start(cfg, loaded))
                    // `!!`: the table is static, and `app_test` builds the same one -- a
                    // refusal here is a programming error, not a condition of this run.
                    ro router = api_router(sources_at_start(cfg, paths, moment_iso(now), now, db_state, fn() -> SnapshotView => store.view(),
                        fn(a HistoryAsk) -> HistoryLoad => history_from_db(paths, win, store.view(), a),
                        fn() -> ConfNow => store.conf(),
                        fn(c Config) -> Committed => commit_settings(paths, win, store, c),
                        fn(a int) -> Option[Live] => Some(open_live(store, a)),
                        fn(st ProbeState, p str) -> str => probe_on_disk(st, p),
                        fn() -> bool => store.tick()))!!
                    println("claude-limits: listening on ${base_url(cfg)}/  (Ctrl+C to stop)")
                    ro every = cfg.poll.interval_sec
                    ro rx = pair.rx
                    supervised {
                        spawn consume listener { serve_router(listener, router, ServerPolicy.new()) }
                        spawn { tick_every(store, every) }
                        spawn { ping_every(store, 30) }
                        run_rounds(rx, rounds, paths, win, care, keep)
                    }
                    return EXIT_OK
                }
            }
        }
    }
}

fn main() Io Net Time Detach {
    // `args()[0]` is the program name. `cli.args.parse` takes the vector WITHOUT
    // it -- accepting it would make `claude-limits` a positional directory argument on
    // every run, and the failure would look like a missing fixture rather than a bug
    // here.
    ro all = with Os = real_os() { args() }
    // A view, not a copy (D262). An empty vector has no program name to drop.
    // THE `[]str` IS LOAD-BEARING. This file imports TWO functions named `parse`
    // (cli.args and usage.parse), and for an argument it holds no C-type for, the
    // codegen types the call's result by the WRONG one -- here a for-in then fails;
    // with C-compatible return types the value is silently corrupted. Registry 221.1
    // #1390 (K1), probe in probes/unannotated-let-breaks-far-for-in; keep the
    // annotation until #1390 is fixed.
    ro argv []str = if all.len() == 0 { all } else { all[1..] }

    match cli_args.parse_args(argv) {
        Err(c) => {
            println(c.message)
            exit(c.code, "")
        }
        Ok(a) => {
            match a.mode {
                Mode.Version => println(version_line())
                Mode.Help => {
                    println(version_line())
                    println(USAGE)
                    println(USAGE_AUTOSTART)
                    println(USAGE_FORGET)
                }
                // THE PATH THE RECORD WILL START IS `all[0]`, the program name as the
                // system handed it to us -- which is exactly what the system will hand
                // back at login. Resolving it to a canonical absolute path would be
                // tidier and WRONG in the one case that matters: a program launched
                // through a symlink or a shim should be restarted the same way it was
                // started, not through whatever the link points at today.
                //
                // It can be empty in principle (a parent that spawns with no argv[0]).
                // The record is then still written, with an empty command, and the
                // person is told the location -- which is better than a silent refusal
                // they cannot see the cause of.
                Mode.InstallAutostart => {
                    ro exe = if all.len() > 0 { all[0] } else { "" }
                    ro e = with Os = real_os() { entry_for(host(), exe, home_str()) }
                    ro got = with_real_autostart(exe, fn() Autostart -> Change => install(e))
                    println(message(got, e))
                    if !got.ok() { exit(EXIT_CONFIG, "") }
                }
                Mode.UninstallAutostart => {
                    ro exe = if all.len() > 0 { all[0] } else { "" }
                    ro e = with Os = real_os() { entry_for(host(), exe, home_str()) }
                    ro got = with_real_autostart(exe, fn() Autostart -> Change => uninstall())
                    println(message(got, e))
                    if !got.ok() { exit(EXIT_CONFIG, "") }
                }
                Mode.Serve => {
                    ro exe = if all.len() > 0 { all[0] } else { "" }
                    ro code = serve_mode(exe, a.config)
                    if code != EXIT_OK { exit(code, "") }
                }
                Mode.Forget => {
                    ro exe = if all.len() > 0 { all[0] } else { "" }
                    ro code = forget_mode(exe, a.config, a.email)
                    if code != EXIT_OK { exit(code, "") }
                }
                Mode.ImportHistory => {
                    ro exe = if all.len() > 0 { all[0] } else { "" }
                    ro code = import_mode(exe, a.config, a.file)
                    if code != EXIT_OK { exit(code, "") }
                }
                Mode.Once => {
                    // A BARE INVOCATION IS NOT AN ERROR. `nova test` runs every unit
                    // with a `fn main` and no arguments, and it is right to: a program
                    // called with nothing is being asked what it does, not misused.
                    // Asking for a table over no directories, on the other hand, IS a
                    // misuse -- but only once something was actually asked for.
                    if argv.len() == 0 {
                        println(version_line())
                        println(USAGE)
                        exit(EXIT_OK, "")
                    }
                    if a.dirs.len() == 0 && a.parent == "" {
                        println("nothing to read: name a directory, or pass --parent DIR")
                        exit(EXIT_CONFIG, "")
                    }
                    // THE CLOCK IS AMBIENT. `Time` is declared in the prelude with a
                    // `#default_handler`, so `Time.now()` needs no `with` and no
                    // import -- which is why three greps for "export fn now" in
                    // std/src found nothing and I nearly recorded "this package has no
                    // clock" as a finding. It is read ONCE, here, and passed down:
                    // `state_of` takes the moment as a parameter so that nothing below
                    // can read a clock of its own, and a function that reads one cannot
                    // be asked about any moment but this one -- including the one a
                    // test needs.
                    ro now_ms = Time.now().unix_millis()
                    ro lines = with_real_disk(fn() Dirs Creds -> []str {
                        mut all []str = []

                        // EVERY directory first, then ONE grouping. An account may
                        // live in several configured directories, and grouping inside
                        // each would report it once per directory.
                        mut logins []Login = []
                        for d in a.dirs {
                            for l in logins_in(d) { logins.push(l) }
                        }

                        // The nameless ones are reported here, in discovery order:
                        // `group` drops a login with no e-mail on purpose, and says
                        // its own comment that the discovery layer must report them.
                        // When it did not, an account holding only credentials
                        // vanished and `--once` claimed the directory was empty.
                        mut named = 0
                        for l in logins {
                            if l.email == "" {
                                all.push(account_header("", "", l.name))
                            } else {
                                named += 1
                            }
                        }

                        if logins.len() == 0 {
                            for d in a.dirs {
                                ro why = folder_problem(d)
                                if why == "" {
                                    all.push(no_logins(d))
                                } else {
                                    all.push("${no_logins(d)} (${why})")
                                }
                            }
                            return all
                        }

                        if named == 0 { return all }

                        for acc in group(logins, now_ms) {
                            mut names = ""
                            mut first = true
                            for n in acc.dirs {
                                if first { names = n } else { names = "${names}, ${n}" }
                                first = false
                            }
                            all.push(account_header(acc.email, acc.org, names))

                            // No live token: the reference prints the note and makes
                            // no request at all (:344). A dead token earns a 401 and
                            // then a 429 for the whole machine, which is not
                            // hypothetical on this project.
                            if acc.state != TokenState.Ok {
                                all.push(expired_note())
                                continue
                            }

                            ro body = recorded_reply(a.offline, acc.email)
                            ro usage = usage_parse.parse(body)
                            for w in usage.windows {
                                all.push(row(cli_label(w.kind, w.model), w.percent,
                                             true, "normal",
                                             reference_moment(w.resets_at_ms)))
                            }
                        }
                        all
                    })
                    for l in lines { println(l) }
                }
            }
        }
    }
}
