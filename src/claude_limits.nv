// bin/claude_limits.nv — entry point of the claude-limits binary.
//
// T0.0 filled this with a version line only. T1.7 adds `--once`: read the configured
// directories, group the logins into accounts, and print the table.
//
// `println` is called HERE and nowhere else, and that is a compiler constraint rather
// than a matter of taste: registry defect №1017 (К1, tag blocker) — the two prelude
// variadics `print` and `println` type-check in a non-entry module and then fail
// codegen in every unit that imports it. The rest of the prelude is unaffected:
// `panic`, `assert`, `Option`/`Result` work in library modules, so only formatting
// output travels out as a value. Repro and the spec citation that makes this a defect
// rather than a rule: docs/reports/T0.0.md.
//
// That constraint is what shaped this file. Everything that decides anything lives in
// a peer module that a test can import -- `cli.args` parses the command line,
// `cli.table` formats a row, `accounts.*` finds and groups logins -- and what is left
// here is the part no test can reach anyway: reading the real disk and printing.
//
// A consequence worth keeping: no test imports this file. It would pull `main` -- and
// its `println` -- into the test's own compilation unit, which is how the defect above
// first showed up.
//
// Module path mirrors the file path from the SOURCE ROOT: a file in a subdirectory
// carries no package prefix (`bin.claude_limits`), while a file directly in the root
// does (`claude_limits.version`). Learned from E_D78_MODULE_PATH_MISMATCH on T0.0;
// sibling packages look different only because they set `[lib] src = "src"`.

module claude_limits.claude_limits

import claude_limits.version.{version_line}
import std.os.{args, real_os}
import claude_limits.cli.args.{parse, EXIT_OK, EXIT_CONFIG}
import claude_limits.cli.table.{account_header, short_name, no_logins, expired_note}
import claude_limits.accounts.real_dirs.{with_real_disk}
import claude_limits.accounts.discover.{scan}
import claude_limits.accounts.login.{read_login, TokenState}
import claude_limits.accounts.group.{group}
import claude_limits.accounts.login.{Login, GroupedAccount}
import claude_limits.usage.parse.{parse}
import claude_limits.cli.table.{row, cli_label, reference_moment}

const USAGE = "usage: claude-limits [--once] [--config PATH] [--offline DIR] [--parent DIR] [--color auto|always|never] [DIR ...]"

/// One folder's worth of output, as lines, computed with the disk available.
///
/// Returns lines rather than printing them: printing is the caller's job because of
/// #1017, and returning them is also what makes the shape of this function reviewable
/// -- a function that printed as it went would hide how many lines it decided on.
/// The accounts in one configured folder, grouped, with the display name already
/// substituted. Returns them rather than printing: what to print depends on the usage
/// reply, which is fetched per account afterwards.
fn accounts_in(path str, now_ms int) Dirs Creds -> []GroupedAccount {
    ro folder = scan(path)
    mut logins []Login = []
    for d in folder.logins {
        // `short_name` is applied HERE, at the only place that still has both the path
        // and the name. `group` keeps whatever name it is given and the header prints
        // it, so a bare `.claude` -- which every default login is called -- would
        // identify nothing. The reference substitutes at the same point (:136).
        logins.push(read_login(d.path, short_name(d.path, d.name), d.identity,
                               d.credentials))
    }
    return group(logins, now_ms)
}

/// The recorded reply for one account: `<dir>/<email>.json`, else `<dir>/normal.json`
/// -- the reference's rule (`offline_usage`, :317).
///
/// An absent file yields "" and `parse` then reports its own outcome, rather than this
/// function inventing one. The reference raises instead; here the difference surfaces
/// as a row that disagrees, which is what the differential is for.
fn recorded_reply(offline str, email str) Creds -> str {
    if offline == "" { return "" }
    if email != "" {
        ro named = "${offline}/${email}.json"
        ro body = Creds.read(named)
        if body != "" { return body }
    }
    return Creds.read("${offline}/normal.json")
}

fn main() Io {
    // `args()[0]` is the program name. `cli.args.parse` takes the vector WITHOUT
    // it -- accepting it would make `claude-limits` a positional directory argument on
    // every run, and the failure would look like a missing fixture rather than a bug
    // here.
    ro all = with Os = real_os() { args() }
    mut argv []str = []
    mut i = 1
    while i < all.len() {
        argv.push(all[i])
        i = i + 1
    }

    match parse(argv) {
        Err(c) => {
            println(c.message)
            exit(c.code, "")
        }
        Ok(a) => {
            match a.mode {
                Mode.Version => println(version_line())
                Mode.Help => {
                    println(version_line())
                    println(USAGE)
                }
                Mode.Once => {
                    // A BARE INVOCATION IS NOT AN ERROR. `nova test` runs every unit
                    // with a `fn main` and no arguments, and it is right to: a program
                    // called with nothing is being asked what it does, not misused.
                    // Asking for a table over no directories, on the other hand, IS a
                    // misuse -- but only once something was actually asked for.
                    if argv.len() == 0 {
                        println(version_line())
                        println(USAGE)
                        exit(EXIT_OK, "")
                    }
                    if a.dirs.len() == 0 && a.parent == "" {
                        println("nothing to read: name a directory, or pass --parent DIR")
                        exit(EXIT_CONFIG, "")
                    }
                    // THE CLOCK IS AMBIENT. `Time` is declared in the prelude with a
                    // `#default_handler`, so `Time.now()` needs no `with` and no
                    // import -- which is why three greps for "export fn now" in
                    // std/src found nothing and I nearly recorded "this package has no
                    // clock" as a finding. It is read ONCE, here, and passed down:
                    // `state_of` takes the moment as a parameter so that nothing below
                    // can read a clock of its own, and a function that reads one cannot
                    // be asked about any moment but this one -- including the one a
                    // test needs.
                    ro now_ms = Time.now().unix_millis()
                    ro lines = with_real_disk(fn() Dirs Creds -> []str {
                        mut all []str = []
                        for d in a.dirs {
                            ro accs = accounts_in(d, now_ms)
                            if accs.len() == 0 {
                                all.push(no_logins(d))
                                continue
                            }
                            for acc in accs {
                                mut names = ""
                                mut first = true
                                for n in acc.dirs {
                                    if first { names = n } else { names = "${names}, ${n}" }
                                    first = false
                                }
                                all.push(account_header(acc.email, acc.org, names))

                                // No live token: the reference prints the note and
                                // makes no request at all (:344). A dead token earns a
                                // 401 and then a 429 for the whole machine, which is
                                // not hypothetical on this project.
                                if acc.state != TokenState.Ok {
                                    all.push(expired_note())
                                    continue
                                }

                                ro body = recorded_reply(a.offline, acc.email)
                                ro usage = parse(body)
                                for w in usage.windows {
                                    all.push(row(cli_label(w.kind, w.model),
                                                 w.percent, true, "normal",
                                                 reference_moment(w.resets_at_ms)))
                                }
                            }
                        }
                        all
                    })
                    for l in lines { println(l) }
                }
            }
        }
    }
}
