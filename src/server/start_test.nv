// Tests for server/start.nv -- the decisions `--serve` makes before it listens.
//
//   ./nova.sh test src/server/ --filter start_test
//
// Helper names avoid every module name in the unit (registry 221.1 #1400: a function
// named like a module resolves as that module).

module server.start_test

import claude_limits.config.{Config, ConfigError}
import claude_limits.server.handlers.history.{HistoryAsk, HistoryLoad}
import claude_limits.storage.config_file.{Loaded}
import claude_limits.storage.paths.{Paths}
import start.{Start, decide_start, health_at, sources_at_start, conf_at_start, folders_seen, accounts_seen, DbAtStart}
import claude_limits.server.dto.{AccountView, DirView}
import claude_limits.model.store_fiber.{ConfNow}
import claude_limits.server.handlers.config.{Committed}
import claude_limits.server.handlers.events.{Live}
import claude_limits.storage.config_file.{Saved}
import claude_limits.server.app.{api_router}
import claude_limits.server.handlers.config.{tag_of, base_url}
import claude_limits.config.{render, listen_addr}
import polaris.{serve_once}
import claude_limits.server.dto.{SnapshotView}
import claude_limits.model.live.{nothing_yet}

fn same(label str, want str, got str) -> bool {
    if want == got { return true }
    panic("${label}: want ${want}, got ${got}")
}

fn found(cfg Config) -> Loaded => { cfg, mtime_ns: 1, text: "x", errors: [], missing: false }

fn went(s Start) -> bool => match s { Start.Go(_, _) => true, Start.Refuse(_) => false }

fn refusal(s Start) -> str =>
    match s {
        Start.Refuse(lines) => lines.join(" | ")
        Start.Go(_, _) => "<went>"
    }

test "no file at all is a first start, on the defaults" {
    ro l Loaded = { cfg: Config.defaults(), mtime_ns: 0, text: "", errors: [], missing: true }
    assert(went(decide_start(l)))
}

test "a file that does not parse refuses, and says why" {
    ro e = ConfigError { field: "", code: "parse", message: "line 3: expected '='" }
    ro l Loaded = { cfg: Config.defaults(), mtime_ns: 1, text: "junk", errors: [e], missing: false }
    assert(same("refusal", "line 3: expected '='", refusal(decide_start(l))))
}

test "01.3 §1: asking for the LAN refuses the start instead of listening on it" {
    // The card's own reverse probe: `allow_lan = true` without token and certificate
    // must not become a plain-HTTP listener on the network.
    mut c = Config.defaults()
    c.server.allow_lan = true
    ro r = refusal(decide_start(found(c)))
    assert(r.contains("server.allow_lan"))
}

test "a bind that is not loopback refuses too -- the door reached by editing a file" {
    mut c = Config.defaults()
    c.server.bind = "0.0.0.0"
    ro r = refusal(decide_start(found(c)))
    assert(r.contains("server.bind"))
}

test "the control: the defaults as found in a file go" {
    // Without it every refusal above is equally true of a start that refuses always.
    assert(went(decide_start(found(Config.defaults()))))
}

test "an interval under the floor is repaired, and the repair is said" {
    mut c = Config.defaults()
    c.poll.interval_sec = 1
    match decide_start(found(c)) {
        Start.Go(cfg, lines) => {
            assert(cfg.poll.interval_sec == cfg.poll.min_interval_sec)
            assert(lines.len() == 1)
            assert(lines[0].contains("poll.interval_sec 1 raised to"))
        }
        Start.Refuse(lines) => panic("refused: ${lines.join(" | ")}")
    }
}

test "the address: IPv4 as is, IPv6 in brackets" {
    mut c = Config.defaults()
    assert(same("v4", "127.0.0.1:7391", listen_addr(c)))
    assert(same("url", "http://127.0.0.1:7391", base_url(c)))
    c.server.bind = "::1"
    assert(same("v6", "[::1]:7391", listen_addr(c)))
    // The reconnect URL of PUT /api/config goes through the same spelling.
    assert(same("v6 url", "http://[::1]:7391", base_url(c)))
}

fn some_paths() -> Paths => {
    config_dir: "C:/cfg", data_dir: "C:/data", log_dir: "C:/log",
    config_file: "C:/cfg/claude-limits.toml", db_file: "C:/data/claude-limits.duckdb",
    wal_file: "C:/data/claude-limits.duckdb.wal", temp_dir: "C:/data/tmp",
    backup_dir: "C:/data/backup", log_file: "C:/log/claude-limits.log",
    key_file: "C:/cfg/claude-limits.key", instance_file: "C:/cfg/claude-limits.instance",
    portable: false,
}

test "health at start says what is true of this process" {
    ro h = health_at(Config.defaults(), some_paths(), "2026-09-30T09:00:00Z", DbAtStart.none())
    assert(same("started", "2026-09-30T09:00:00Z", h.started_at))
    assert(same("config", "C:/cfg/claude-limits.toml", h.config_path))
    assert(h.port == 7391)
    // No database is open in this process yet: saying otherwise would be a claim.
    assert(!h.encrypted)
    assert(h.history_days == 0)
}

// -- the production composition, through the router --------------------------

fn wire_text(wire []u8) -> str => unsafe { wire.to_str_unchecked() }

/// The history source of a process whose database did not answer.
fn no_database(a HistoryAsk) -> HistoryLoad => HistoryLoad.Failed("no database in this test")

/// No test here saves: the commit says the disk refused, which no assertion below
/// reaches.
fn never_written() -> Committed => { saved: Saved.WriteFailed, live: false }

fn defaults_now() -> ConfNow => conf_at_start(Config.defaults(), found(Config.defaults()))

/// No store in these tests: the events handler streams its finite opening.
fn no_stream(after int) -> Option[Live] => None

fn ask(path str) Time Random -> str => ask_with(path, fn() -> SnapshotView => nothing_yet())

fn ask_with(path str, current fn() -> SnapshotView) Time Random -> str =>
    ask_conf(path, current, fn() -> ConfNow => defaults_now())

fn ask_conf(path str, current fn() -> SnapshotView, conf fn() -> ConfNow) Time Random -> str {
    ro r = api_router(sources_at_start(Config.defaults(), some_paths(), "2026-09-30T09:00:00Z", 1790758800000, DbAtStart.none(), current,
        fn(a HistoryAsk) -> HistoryLoad => no_database(a), conf, fn(c Config) -> Committed => never_written(),
        fn(a int) -> Option[Live] => no_stream(a)))!!
    wire_text(serve_once(r, "GET ${path} HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n"))
}

/// The settings after a saved `ui` change: another order, and a new tag.
fn reordered() -> ConfNow {
    mut c = Config.defaults()
    c.ui.accounts_order = ["work@example.org"]
    conf_at_start(c, found(c))
}

test "the settings a start serves are read per request, not frozen at the start" {
    // `PUT /api/config` replaces what the store holds; a router that captured the
    // start's settings would answer the old tag forever, and every next save would be
    // a 412.
    ro w = ask_conf("/api/config", fn() -> SnapshotView => nothing_yet(), fn() -> ConfNow => reordered())
    assert(w.starts_with("HTTP/1.1 200"))
    assert(w.contains("work@example.org"))
    assert(w.contains(reordered().tag))
    assert(!w.contains(tag_of(render(Config.defaults()))))
}

// -- the folders and accounts GET /api/config reports (01.3 section 3.7) --

fn dir(path str, name str) -> DirView => { id: "d-${name}", path, name }

fn account(email str, dirs []DirView) -> AccountView => {
    id: "a-${email}", email, org: "Org", dirs, state: "ok", message: "", polled_at: "",
    next_poll_at: "", locked: false, at_100: false,
}

fn seen_view(accounts []AccountView) -> SnapshotView => {
    fetched_at: "2026-10-02T01:00:00Z", next_poll_at: "", tz: "+03:00", restored: false,
    worst: None, accounts, limits: [],
}

fn three_folders() -> Config {
    mut c = Config.defaults()
    c.folders = ["C:/accounts", "C:/Users/me/.claude", "D:/old"]
    c.ui.hidden_accounts = ["Work@Example.org"]
    c
}

fn round_view() -> SnapshotView => seen_view([
    account("main@example.com", [dir("C:\\accounts\\nv-lang", "nv-lang"), dir("C:/Users/me/.claude", ".claude")]),
    account("work@example.org", [dir("C:/accounts/dev", "dev")]),
])

test "every configured folder is reported, with what the last round found in it" {
    // The binary reported NO folders until 2026-10-02, and the page then offered an
    // empty list whose first save replaced every configured folder.
    ro fs = folders_seen(three_folders(), round_view())
    assert(fs.len() == 3)
    assert(same("parent", "parent", fs[0].kind))
    assert(fs[0].login_dirs.len() == 2)
    assert(same("single", "single", fs[1].kind))
    assert(same("single dir", ".claude", fs[1].login_dirs[0].name))
    assert(same("empty", "empty", fs[2].kind))
    assert(same("problem", "no .credentials.json here", fs[2].problem))
    // The page refers to a folder by path when there is no id -- the form PUT accepts.
    assert(same("id", "", fs[0].id))
    assert(same("path kept as configured", "C:/accounts", fs[0].path))
}

test "before the first round no folder is called empty" {
    ro fs = folders_seen(three_folders(), nothing_yet())
    assert(fs.len() == 3)
    assert(same("no claim", "", fs[2].problem))
}

test "accounts_found lists every account, the hidden one marked whatever its case" {
    ro found = accounts_seen(three_folders(), round_view())
    assert(found.len() == 2)
    assert(!found[0].hidden)
    assert(found[1].hidden)
    assert(found[0].dirs.len() == 2)
}

test "the settings a start serves carry the folders inside config, as the contract has them" {
    ro c = three_folders()
    ro w = ask_conf("/api/config", fn() -> SnapshotView => round_view(), fn() -> ConfNow => conf_at_start(c, found(c)))
    assert(w.contains("\"config\":{\"folders\":[{"))
    assert(w.contains("C:/Users/me/.claude"))
}

test "the event stream opens with the snapshot the page would GET, not an empty object" {
    // It opened with `{}`, and the page rendered that as "no logins found" on every
    // open of the stream.
    ro w = ask_with("/api/events", fn() -> SnapshotView => polled_body())
    assert(w.contains("event: snapshot"))
    assert(w.contains("2026-09-30T09:00:00Z"))
    assert(!w.contains("data: {}"))
}

test "while health keeps what this process started on" {
    // A new port saved is in force from the next start; health describes the listener
    // that exists.
    ro w = ask_conf("/api/health", fn() -> SnapshotView => nothing_yet(), fn() -> ConfNow => reordered())
    assert(w.contains("\"port\":7391"))
}

test "the router a start builds answers health with this process's paths" {
    // The SAME composition `--serve` listens with, not a test's own stand-in: what
    // passes here is what a browser gets.
    ro w = ask("/api/health")
    assert(w.starts_with("HTTP/1.1 200"))
    assert(w.contains("claude-limits.toml"))
}

test "and the settings, tagged as GET /api/config tags them" {
    ro w = ask("/api/config")
    assert(w.starts_with("HTTP/1.1 200"))
    assert(w.contains(tag_of(render(Config.defaults()))))
}

// A named function, not a literal inside the lambda (registry 221.1 #1392).
fn polled_body() -> SnapshotView => {
    fetched_at: "2026-09-30T09:00:00Z", next_poll_at: "", tz: "+03:00", restored: false,
    worst: None, accounts: [], limits: [],
}

test "the snapshot the page gets is the body the source hands over, at request time" {
    // In the binary the source is the store, filled by the poller; this is the seam
    // between them, and a start that served a body of its own would pass every other
    // test here.
    ro w = ask_with("/api/snapshot", fn() -> SnapshotView => polled_body())
    assert(w.starts_with("HTTP/1.1 200"))
    assert(w.contains("2026-09-30T09:00:00Z"))
    assert(w.contains("+03:00"))
}

test "the history a start builds says 500 when the database does not answer" {
    // `internal` and nothing about the inside (01.3 section 6): the reason is a log
    // line, and a path or a DuckDB message on the wire would be a leak.
    ro w = ask("/api/history?range=24h")
    assert(w.starts_with("HTTP/1.1 500"))
    assert(w.contains("internal"))
    assert(!w.contains("no database in this test"))
}

test "the history a start builds refuses an account id in the URL before reading" {
    ro w = ask("/api/history?account_id=0192a7f0-0000-7000-8000-000000000001")
    assert(w.starts_with("HTTP/1.1 400"))
}
