// Tests for feed.nv -- the Qoder homes `--serve` finds, and one round of asking
// (task 035).
//
//   ./nova.sh test src/server/ --filter feed_qoder_test
//
// Everything the round touches is a handler here: a folder tree in memory, one
// Qoder home (the open status file, the machine id, the encrypted `.auth/user`
// built by a round trip through the project's own cipher), and an endpoint that
// answers the quota request with the quota and the plan request with the plan.
// Helper names avoid the module names of the unit (registry 221.1 #1400).

module server.feed_qoder_test

import std.time.civil.{TimeZone}
import http.{Http, HttpError}
import claude_limits.accounts.discover.{Dirs}
import claude_limits.accounts.login.{Creds, TokenState}
import claude_limits.usage.poller.{PollLog, Reading}
import claude_limits.model.live.{Known}
import feed.{Found, found_in, poll_round, renew_expired, Renew}
import claude_limits.config.{Refresh}
import claude_limits.usage.qoder_cipher.{qoder_encrypt}

const NOW_MS = 1790758800000
const MID = "0192f3a4-0000-7000-8000-0000000000c1"
const EOL = "\r\n"

fn creds_json() -> str => "{\"uid\":\"u-1\",\"login_method\":\"browser\",\"access_token\":\"qoder-fixture-access\",\"security_oauth_token\":\"qoder-fixture-bearer\",\"expire_time\":1793000000000,\"login_timestamp\":1792900000000}"

fn auth_blob(under str) -> str {
    ro m = under
    match qoder_encrypt(creds_json(), m) {
        Err(_) => panic("test encrypt failed")
        Ok(b) => b
    }
}

fn status_text(logged bool) -> str => "{\"logged_in\":${logged},\"name\":\"Fixture User\",\"email\":\"Me@Example.COM\",\"version\":\"1.1.86\"}"

fn qd_text(path str) -> str {
    if path == "/qd/home/.qoder-app-status.json" { return status_text(true) }
    if path == "/qd/home/.auth/machine_id" { return MID }
    if path == "/qd/home/.auth/user" { return auth_blob(MID) }
    if path == "/qd/out/.qoder-app-status.json" { return status_text(false) }
    if path == "/qd/out/.auth/machine_id" { return MID }
    if path == "/qd/bad/.qoder-app-status.json" { return status_text(true) }
    if path == "/qd/bad/.auth/machine_id" { return MID }
    if path == "/qd/bad/.auth/user" { return "not-a-blob" }
    ""
}

fn qd_disk[T](body fn() Dirs Creds -> T) -> T =>
    with Dirs = effect Dirs {
        list(path) -> []str { [] }
        exists(path) -> bool { qd_text(path) != "" }
        is_dir(path) -> bool { path.starts_with("/qd") }
    } {
        with Creds = effect Creds {
            read(path) -> str { qd_text(path) }
        } {
            body()
        }
    }

type Asked {
    mut n int
}

fn Asked.new() -> Asked => { n: 0 }

fn quota_reply() -> str =>
    // The live wire's shape (measured 2026-11-12): flat camelCase, the percent a
    // FRACTION 0..1, the reset in epoch ms.
    "HTTP/1.1 200 OK${EOL}Content-Type: application/json${EOL}${EOL}{\"userId\":\"0192f3a4-0000-7000-8000-0000000000c1\",\"userType\":\"personal_professional_trial\",\"usageType\":\"credits\",\"totalUsagePercentage\":0.42,\"isQuotaExceeded\":false,\"expiresAt\":1793462400000}"

fn plan_reply() -> str =>
    // The live wire's shape (measured 2026-11-12): flat snake_case, dates in ms.
    "HTTP/1.1 200 OK${EOL}Content-Type: application/json${EOL}${EOL}{\"user_type\":\"personal_professional_trial\",\"plan_tier_name\":\"QODER TEST PLAN\",\"is_personal_version\":true,\"is_paid_plan\":false,\"end_date\":1793462400000}"

fn qd_endpoint[T](mut a Asked, raw str, body fn() Http PollLog Creds -> T) -> T =>
    with Http = effect Http {
        send(host, port, secure, request) -> Result[str, HttpError] {
            a.n += 1
            // The plan request is answered with the plan, the quota one with the quota.
            Ok(if request.contains("/api/v2/user/plan") { plan_reply() } else { raw })
        }
    } {
        with PollLog = effect PollLog {
            record(email str, state str, message str, at_ms int) -> () {}
            reading(r Reading) -> () {}
        } {
            with Creds = effect Creds {
                read(path) -> str { qd_text(path) }
            } {
                body()
            }
        }
    }

fn qd_found(folder str) -> []Found {
    ro now = NOW_MS
    ro f = folder
    qd_disk(fn() Dirs Creds -> []Found => found_in([f], now, ""))
}

fn same(label str, want str, got str) -> bool {
    if want == got { return true }
    panic("${label}: want ${want}, got ${got}")
}

fn refresh_cfg(enabled bool) -> Refresh =>
    { enabled, all_expired: false, claude_model: "m", timeout_sec: 120, cooldown_sec: 3600 }

// ── the folders ──────────────────────────────────────────────────────────────

test "a Qoder home is an account keyed qoder:<e-mail>, named by the address, which is not an e-mail field" {
    ro f = qd_found("/qd/home")
    assert(f.len() == 1)
    assert(same("key", "qoder:me@example.com", f[0].email))
    assert(same("name", "me@example.com", f[0].display_name))
    assert(f[0].qoder && !f[0].zcode && !f[0].codex && !f[0].kimi)
    assert(same("state", "ok", if f[0].state == TokenState.Ok { "ok" } else { "other" }))
}

test "a logged-out Qoder home is a login with the reason, not a missing account" {
    ro f = qd_found("/qd/out")
    assert(f.len() == 1)
    assert(f[0].broken.contains("logged out"))
    assert(f[0].state == TokenState.NoToken)
}

test "a store that will not decrypt is a broken login, not a missing account" {
    ro f = qd_found("/qd/bad")
    assert(f.len() == 1)
    assert(f[0].broken.contains("did not decrypt"))
    assert(f[0].state == TokenState.NoToken)
}

// ── one round ────────────────────────────────────────────────────────────────

test "a live Qoder login is asked TWICE -- the quota, then the plan; the month row and the plan line arrive" {
    mut a = Asked.new()
    ro f = qd_found("/qd/home")
    ro now = NOW_MS
    ro k = qd_endpoint(a, quota_reply(), fn() Http PollLog Creds -> []Known => poll_round(f, [], now, now + 300000, TimeZone.Utc))
    // TWO requests: the quota, then the plan (best-effort after a parsed quota).
    assert(a.n == 2)
    assert(same("state", "ok", k[0].state.to_str()))
    assert(k[0].windows.len() == 1)
    assert(same("kind", "monthly", k[0].windows[0].kind))
    assert(same("pct", "42", k[0].windows[0].percent.to_str()))
    assert(same("reset", "1793462400000", k[0].windows[0].resets_at_ms.to_str()))
    assert(same("provider", "qoder", k[0].provider))
    assert(same("email", "", k[0].email))
    assert(same("name", "me@example.com", k[0].display_name))
    ro plan = k[0].plan ?? panic("no plan on the qoder card")
    assert(plan.name == "QODER TEST PLAN")
    assert(plan.ends_at_ms == 1793462400000)
    assert(k[0].org == "")
}

test "a Qoder quota that fails is unknown and costs ONE request: no plan after a failed quota" {
    mut a = Asked.new()
    ro f = qd_found("/qd/home")
    ro now = NOW_MS
    ro rate = "HTTP/1.1 429 Too Many Requests${EOL}Retry-After: 90${EOL}Content-Type: application/json${EOL}${EOL}{}"
    ro k = qd_endpoint(a, rate, fn() Http PollLog Creds -> []Known => poll_round(f, [], now, now + 300000, TimeZone.Utc))
    assert(a.n == 1)
    assert(same("state", "unknown", k[0].state.to_str()))
}

test "a broken Qoder store is NOT asked and is NOT renewed" {
    mut a = Asked.new()
    ro f = qd_found("/qd/bad")
    ro now = NOW_MS
    ro k = qd_endpoint(a, "", fn() Http PollLog Creds -> []Known => poll_round(f, [], now, now + 300000, TimeZone.Utc))
    assert(a.n == 0)
    assert(same("state", "stale", k[0].state.to_str()))
    assert(k[0].message.contains("did not decrypt"))
    mut renewals = 0
    ro refresh = refresh_cfg(true)
    ro renewed = with Renew = effect Renew {
        kimi(path str, name str, cooldown_sec int) -> bool {
            renewals += 1
            false
        }
        claude(path str, name str, model str, timeout_sec int, cooldown_sec int) -> bool {
            renewals += 1
            false
        }
    } {
        renew_expired(f, refresh)
    }
    assert(!renewed)
    assert(renewals == 0)
}
