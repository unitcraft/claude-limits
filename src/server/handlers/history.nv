// handlers/history.nv — `GET /api/history`, `POST /api/history/search` (task T2.15).
//
// Source: 01.3 §3.6 (the closed parameter list, the defaults, the refusals), §8 п. 6;
// 01.2 §4 (what the database answers it with).
//
// Imports are PACKAGE-PREFIXED and every exported name carries the module's word
// (`history_`): two handler modules with one private name collapse into one C symbol
// (registry 221.1 #1097).
//
// ── This file is the ASK, not the answer ────────────────────────────────────
//
// What is parsed here is everything the caller can get wrong, and every refusal of
// §3.6 is decided before the database is touched: an unknown parameter, `range`
// together with `from`/`to`, a span longer than `history.keep_days`, a step outside
// the four, and a request that would come back with more than 50 000 points. The
// database is asked only a question that is already known to be answerable.
//
// ── The point limit counts ONE SERIES, and that is a decision ──────────────
//
// §3.6 says "> 50 000 points -> 400 range_too_large, raise `step`". A whole answer's
// size is series x points, and the number of series is not known until the database
// has said how many windows there are -- refusing on it would mean doing the work and
// then throwing it away. Per series, the count is `span / step`, known from the ask
// alone, and it is the number `step` actually changes: the advice in the refusal is
// right for it. With the shipped `keep_days` (30) and the finest step (300) a series
// has 8 640 points, so the limit bites only a `from`/`to` under a raised `keep_days`.
module handlers.history

import claude_limits.server.errors.{ApiError}
import claude_limits.usage.parse.{moment_ms, moment_iso}
import std.identifiers.uuid.{Uuid}
import claude_limits.storage.history_rows.{HistSample, HistPoll, HistLock, HistWindow, HistAccount, HistRows, HistRollup}
import claude_limits.server.errors.{FieldError}
import polaris.{ServerRequest, ServerResponse}
import claude_limits.server.routes.{Ctx, ApiHandler, problem}
import claude_limits.server.dto.{opt}
import std.encoding.serde.{json_encode, Serialize}
import std.time.civil.{TimeZone}
import std.encoding.json.{Json, JsonValue}

export const HISTORY_MAX_POINTS int = 50000

const DAY_MS int = 86400000

/// What the caller asked for, every default already applied.
export type HistoryAsk value {
    from_ms int
    to_ms int
    /// 300, 900 or 3600; 0 is `day` -- one `daily_rollup` row per day.
    step_sec int
    by_folder bool
    /// Empty is every directory.
    login_dirs []str
    /// Empty is every account. Only `search` fills it: an account id never travels
    /// in a URL (01.2 §10).
    accounts []str
}

export type HistoryAskOr enum
    | Asked(HistoryAsk)
    | Refused(ApiError)

/// Points one series of this ask carries: the grid of `step` over `[from, to)`.
export fn history_points(a HistoryAsk) -> int {
    ro span = a.to_ms - a.from_ms
    ro step_ms = if a.step_sec == 0 { DAY_MS } else { a.step_sec * 1000 }
    (span + step_ms - 1) / step_ms
}

// ── the closed parameter list ────────────────────────────────────────────────

fn history_pairs(target str) -> [](str, str) {
    ro q = match target.find("?") {
        Some(i) => target[i + 1..]
        None    => ""
    }
    mut out = [](str, str).new()
    if q == "" { return out }
    for part in q.split("&") {
        if part == "" { continue }
        match part.find("=") {
            Some(i) => out.push((part[..i], part[i + 1..]))
            None    => out.push((part, ""))
        }
    }
    out
}

fn history_hex_val(b u8) -> int {
    ro c = b as int
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 65 && c <= 70 { return c - 55 }
    if c >= 97 && c <= 102 { return c - 87 }
    -1
}

/// `%XX` -> the byte, `+` -> space; `None` for a broken escape or a result that is
/// not UTF-8.
///
/// HAND-WRITTEN, and not `Url.decode_query`: std's `Url` clashes with nova-http's
/// own `Url` in one compilation unit (E_METHOD_REDEFINITION on `Url.to_str`), and
/// importing nova-http's drags Polaris's `Query[T]` instantiations into this module,
/// one of them built from a type in Polaris's own doc samples -- a CC-FAIL in code
/// this package never wrote (registry 221.1 #1527's class, measured 2026-10-01).
export fn history_pct_decode(s str) -> Option[str] {
    ro bytes = s.bytes()
    mut out []u8 = []
    mut i = 0
    while i < bytes.len() {
        ro b = bytes[i]
        if b == 37 {
            if i + 2 >= bytes.len() { return None }
            ro hi = history_hex_val(bytes[i + 1])
            ro lo = history_hex_val(bytes[i + 2])
            if hi < 0 || lo < 0 { return None }
            out.push((hi * 16 + lo) as u8)
            i += 3
        } else if b == 43 {
            out.push(32)
            i += 1
        } else {
            out.push(b)
            i += 1
        }
    }
    match out.to_str() {
        Ok(t) => Some(t)
        Err(_) => None
    }
}

fn history_known(k str) -> bool {
    if k == "range" { return true }
    if k == "from" { return true }
    if k == "to" { return true }
    if k == "by" { return true }
    if k == "step" { return true }
    k == "login_dir_id"
}

fn bad(detail str) -> HistoryAskOr => HistoryAskOr.Refused(ApiError.invalid_parameter(detail))

/// `24h` / `7d` / `30d` -> milliseconds, 0 for anything else.
fn range_ms(v str) -> int {
    if v == "24h" { return DAY_MS }
    if v == "7d" { return 7 * DAY_MS }
    if v == "30d" { return 30 * DAY_MS }
    0
}

/// `300` / `900` / `3600` / `day` -> seconds (0 for `day`), -1 for anything else.
fn step_of(v str) -> int {
    if v == "300" { return 300 }
    if v == "900" { return 900 }
    if v == "3600" { return 3600 }
    if v == "day" { return 0 }
    -1
}

/// A moment of §3.6: ISO 8601 that ENDS IN `Z`. An offset is refused rather than
/// converted -- the page always sends UTC, and a second spelling of one moment is a
/// second thing to test.
fn moment_of(v str) -> int {
    if !v.ends_with("Z") { return 0 }
    moment_ms(v)
}

/// Read the query of §3.6 for `GET /api/history`.
///
/// `now_ms` ends a `range`; `keep_days` bounds a `from`/`to`. `login_dir_id` MAY
/// repeat, nothing else may. `account_id` and `email` are refused as unknown, and
/// that refusal is what keeps a person's identifier out of the URL.
export fn parse_history_query(target str, now_ms int, keep_days int) -> HistoryAskOr {
    mut range = ""
    mut from = ""
    mut to = ""
    mut by = ""
    mut step = ""
    mut dirs []str = []
    for (k, raw) in history_pairs(target) {
        if !history_known(k) { return bad("unknown query parameter '${k}'") }
        ro v = match history_pct_decode(raw) {
            Some(s) => s
            None => return bad("parameter '${k}' is not percent-encoded correctly")
        }
        if k == "login_dir_id" {
            if v.to_uuid().is_err() { return bad("login_dir_id must be a UUID") }
            dirs.push(v)
            continue
        }
        ro seen = if k == "range" { range } else if k == "from" { from } else if k == "to" { to } else if k == "by" { by } else { step }
        if seen != "" { return bad("parameter '${k}' may not repeat") }
        if v == "" { return bad("parameter '${k}' is empty") }
        if k == "range" { range = v } else if k == "from" { from = v } else if k == "to" { to = v } else if k == "by" { by = v } else { step = v }
    }
    history_ask_of(range, from, to, by, step, dirs, [], now_ms, keep_days)
}

/// The rules of §3.6 over values already read -- shared by the query and by the
/// `search` body, which carries the same fields.
export fn history_ask_of(range str, from str, to str, by str, step str, dirs []str, accounts []str, now_ms int, keep_days int) -> HistoryAskOr {
    if range != "" && (from != "" || to != "") {
        return bad("range cannot be combined with from/to")
    }
    if (from == "") != (to == "") { return bad("from and to come together") }
    mut from_ms = 0
    mut to_ms = 0
    mut long = false
    if from != "" {
        from_ms = moment_of(from)
        to_ms = moment_of(to)
        if from_ms == 0 { return bad("from must be an ISO 8601 moment in UTC (…Z)") }
        if to_ms == 0 { return bad("to must be an ISO 8601 moment in UTC (…Z)") }
        if from_ms >= to_ms { return bad("from must be before to") }
        if to_ms - from_ms > keep_days * DAY_MS {
            return bad("from..to is longer than history.keep_days (${keep_days} days)")
        }
        long = to_ms - from_ms > 7 * DAY_MS
    } else {
        ro r = if range == "" { "7d" } else { range }
        ro span = range_ms(r)
        if span == 0 { return bad("range must be 24h, 7d or 30d") }
        to_ms = now_ms
        from_ms = now_ms - span
        long = r == "30d"
    }
    mut by_folder = false
    if by == "folder" {
        by_folder = true
    } else if by != "" && by != "account" {
        return bad("by must be account or folder")
    }
    mut step_sec = if long { 900 } else { 300 }
    if step != "" {
        step_sec = step_of(step)
        if step_sec < 0 { return bad("step must be 300, 900, 3600 or day") }
    }
    ro ask = HistoryAsk{ from_ms, to_ms, step_sec, by_folder, login_dirs: dirs, accounts }
    ro n = history_points(ask)
    if n > HISTORY_MAX_POINTS {
        return HistoryAskOr.Refused(ApiError.range_too_large(
            "${n} points per series, the limit is ${HISTORY_MAX_POINTS}: raise step"))
    }
    HistoryAskOr.Asked(ask)
}

/// The range echoed in the answer (`range` of §3.6): `step_sec` is 86400 for `day`.
export fn history_range_echo(a HistoryAsk) -> (str, str, int) =>
    (moment_iso(a.from_ms), moment_iso(a.to_ms), if a.step_sec == 0 { 86400 } else { a.step_sec })

// ── the series, from rows the database already selected ─────────────────────
//
// Everything below is pure: the source (the database, in production; a list, in a
// test) hands over the rows of the range, and the shape of §3.6 is built here. The
// thinning is done HERE and not by `time_bucket` in SQL, because "the sample nearest
// to the grid" is a rule about distances, and `time_bucket` + `last()` answers a
// different question (the LAST sample of a bucket), which drifts a point by up to a
// whole step.

/// The sample nearest to each grid node `from + k*step` inside `[from, to)`.
///
/// A node takes a sample from `[node - step/2, node + step - step/2)` -- half-open,
/// so a sample exactly between two nodes belongs to ONE of them and is never drawn
/// twice. A node with no sample in its cell has no point: the line breaks, and the
/// page shows a break, not a straight line across an outage.
export fn history_thin(samples []HistSample, from_ms int, to_ms int, step_ms int) -> []HistSample {
    mut out []HistSample = []
    ro n = samples.len()
    ro half = step_ms / 2
    mut i = 0
    mut node = from_ms
    while node < to_ms {
        ro lo = node - half
        ro hi = node + step_ms - half
        while i < n && samples[i].at_ms < lo { i += 1 }
        mut best = -1
        mut best_d = 0
        mut j = i
        while j < n && samples[j].at_ms < hi {
            ro d = (samples[j].at_ms - node).abs()
            if best < 0 || d < best_d {
                best = j
                best_d = d
            }
            j += 1
        }
        if best >= 0 { out.push(samples[best]) }
        node += step_ms
    }
    out
}

/// Reset moments inside `[from, to]`, each once, in order.
///
/// A sample's `resets_at` is a FUTURE moment while its cycle runs; it becomes a reset
/// that happened only once the range has passed it. So the current cycle's moment,
/// past `to`, is not drawn.
export fn history_resets(samples []HistSample, from_ms int, to_ms int) -> []int {
    mut out []int = []
    for s in samples {
        ro r = s.resets_at_ms
        if r == 0 || r < from_ms || r > to_ms { continue }
        if out.len() > 0 && out[out.len() - 1] == r { continue }
        out.push(r)
    }
    out
}

/// A run of polls that brought no data.
export type HistGap value {
    from_ms int
    /// 0 while the run has not ended.
    to_ms int
    /// The outcome of the FIRST poll of the run: what started the outage.
    cause str
}

/// Gaps of an account: a run of non-`ok` polls starts at its first poll and ends at
/// the next `ok` one. The cause is the first poll's outcome -- a 401 that turns into
/// `skipped_expired` is one outage that began with a 401.
export fn history_gaps(polls []HistPoll) -> []HistGap {
    mut out []HistGap = []
    mut open = false
    mut start = 0
    mut cause = ""
    for p in polls {
        if p.outcome == "ok" {
            if open {
                out.push(HistGap{ from_ms: start, to_ms: p.at_ms, cause })
                open = false
            }
        } else if !open {
            open = true
            start = p.at_ms
            cause = p.outcome
        }
    }
    if open { out.push(HistGap{ from_ms: start, to_ms: 0, cause }) }
    out
}

// ── `step=day` ──────────────────────────────────────────────────────────────
//
// One point a day, drawn at the day's NOON (the page's fixture does the same): a
// point at midnight sits on the boundary between two days and reads as either. The
// day is the MACHINE's calendar day -- the zone of the state -- because that is the
// day a person means by "Tuesday".
//
// A day is built from its samples when retention has kept them, and from its
// `daily_rollup` row when it has not. The two never mix for one day: a day with any
// sample left is a sample day, because the rollup of a day still inside `keep_days`
// does not exist yet (01.2 section 5: the rollup is written as a day LEAVES the window).

/// One day of one window.
export type HistDay value {
    /// The instant of the day's local midnight.
    start_ms int
    peak int
    avg_hundredths int
    locked_sec int
    /// The last sample's reset moment, 0 for a rollup day.
    resets_at_ms int
    /// The last sample's lock, false for a rollup day.
    locked bool
}

/// The instant of local midnight of the day holding `ms`.
export fn history_local_midnight(ms int, zone TimeZone) -> int {
    ro t = ms.to_unix_millis().to_zoned(zone).datetime().time()
    ro into_ms = (t.hour() * 3600 + t.minute() * 60 + t.second()) * 1000 + ms % 1000
    ms - into_ms
}

fn sample_day(start int, peak int, sum int, n int, last HistSample, locks []HistLock, from_ms int, to_ms int) -> HistDay {
    ro lo = if start < from_ms { from_ms } else { start }
    ro end = start + DAY_MS
    ro hi = if end > to_ms { to_ms } else { end }
    {
        start_ms: start,
        peak,
        avg_hundredths: (sum * 200 + n) / (n * 2),
        locked_sec: history_locked_sec(locks, lo, hi),
        resets_at_ms: last.resets_at_ms,
        locked: last.locked,
    }
}

/// The days of a window inside `[from, to)`, in order: a day belongs to the range
/// when its noon does.
export fn history_days(w HistWindow, from_ms int, to_ms int, zone TimeZone) -> []HistDay {
    mut by_samples []HistDay = []
    mut cur = -1
    mut peak = 0
    mut sum = 0
    mut n = 0
    mut last = HistSample{ at_ms: 0, percent: 0, resets_at_ms: 0, locked: false }
    for s in w.samples {
        if s.at_ms < from_ms || s.at_ms >= to_ms { continue }
        ro d = history_local_midnight(s.at_ms, zone)
        if d != cur {
            if n > 0 && cur + DAY_MS / 2 >= from_ms && cur + DAY_MS / 2 < to_ms {
                by_samples.push(sample_day(cur, peak, sum, n, last, w.locks, from_ms, to_ms))
            }
            cur = d
            peak = 0
            sum = 0
            n = 0
        }
        if s.percent > peak { peak = s.percent }
        sum += s.percent
        n += 1
        last = s
    }
    if n > 0 && cur + DAY_MS / 2 >= from_ms && cur + DAY_MS / 2 < to_ms {
        by_samples.push(sample_day(cur, peak, sum, n, last, w.locks, from_ms, to_ms))
    }

    // Rollup days that no sample day covers, merged in order.
    mut out []HistDay = []
    mut i = 0
    for r in w.rollups {
        ro start = history_local_midnight(r.day * DAY_MS + DAY_MS / 2, zone)
        ro noon = start + DAY_MS / 2
        if noon < from_ms || noon >= to_ms { continue }
        while i < by_samples.len() && by_samples[i].start_ms < start {
            out.push(by_samples[i])
            i += 1
        }
        if i < by_samples.len() && by_samples[i].start_ms == start { continue }
        out.push(HistDay{ start_ms: start, peak: r.peak, avg_hundredths: r.avg_hundredths,
                          locked_sec: r.locked_sec, resets_at_ms: 0, locked: false })
    }
    while i < by_samples.len() {
        out.push(by_samples[i])
        i += 1
    }
    out
}

// ── the answer of `by=account` ──────────────────────────────────────────────

/// The live forecast of one window, as the snapshot holds it.
///
/// The pace is NOT recomputed from history: `model/forecast.nv` already turns the
/// current cycle into a rate for the snapshot, under the working-hours schedule, and
/// a second computation here would be a second answer to one question.
export type HistPace value {
    account_id str
    kind str
    /// "" for the windows that are not per-model.
    model str
    rate_per_hour_milli int
    /// "" when the window is not projected to run out before it resets.
    runs_out_at str
    label str
}

/// Everything the answer is built from.
export type HistoryState value {
    rows HistRows
    paces []HistPace
    /// The zone of the `when` labels: "Tue 14:20–16:00" is a wall-clock phrase.
    zone TimeZone
}

/// What the source could give.
export type HistoryLoad enum
    | Loaded(HistoryState)
    /// The database is not open, or a read failed: `500 internal`, the reason in the
    /// log and not on the wire (01.3 §6).
    | Failed(str)

export type HistorySource fn(HistoryAsk) -> HistoryLoad

#impl(Serialize)
type HistWirePoint value {
    ro at str
    ro percent int
    // The three fields of a `step=day` point (01.3 section 3.6), ABSENT from every
    // other point rather than `null`: a sample has no peak of its own.
    #serde(skip_serializing_if = "is_none")
    ro peak Option[int]
    #serde(skip_serializing_if = "is_none")
    ro avg Option[int]
    #serde(skip_serializing_if = "is_none")
    ro locked_sec Option[int]
    ro resets_at Option[str]
    ro locked bool
}

#impl(Serialize)
type HistWireLock value {
    #serde(rename = "from")
    ro from_at str
    #serde(rename = "to")
    ro to_at Option[str]
    ro reason str
    ro server_reason Option[str]
}

#impl(Serialize)
type HistWireGap value {
    #serde(rename = "from")
    ro from_at str
    #serde(rename = "to")
    ro to_at Option[str]
    ro cause str
}

#impl(Serialize)
type HistWireSeries value {
    ro account_id str
    ro kind str
    ro model Option[str]
    ro points []HistWirePoint
    ro resets []str
    ro locks []HistWireLock
    ro gaps []HistWireGap
}

#impl(Serialize)
type HistWireSummary value {
    ro peak_session int
    ro avg_session f64
    ro locked_sec int
    ro pace_per_hour Option[f64]
    ro runs_out_at Option[str]
}

#impl(Serialize)
type HistWireAccount value {
    ro id str
    ro email str
    ro color_slot int
    ro summary HistWireSummary
}

#impl(Serialize)
type HistWireRange value {
    #serde(rename = "from")
    ro from_at str
    #serde(rename = "to")
    ro to_at str
    ro step_sec int
}

#impl(Serialize)
type HistWireLockedTile value {
    ro seconds int
    ro account_id Option[str]
    ro email Option[str]
    ro when []str
}

#impl(Serialize)
type HistWirePeakTile value {
    ro percent int
    ro account_id Option[str]
    ro email Option[str]
    ro times int
}

#impl(Serialize)
type HistWireAvgTile value {
    ro percent int
    ro accounts int
}

#impl(Serialize)
type HistWirePaceTile value {
    ro rate_per_hour f64
    ro account_id str
    ro email str
    ro model Option[str]
    ro runs_out_at Option[str]
    ro label str
}

#impl(Serialize)
type HistWireTiles value {
    ro locked HistWireLockedTile
    ro peak_session HistWirePeakTile
    ro avg_session HistWireAvgTile
    ro pace Option[HistWirePaceTile]
}

#impl(Serialize)
type HistWireByAccount value {
    ro range HistWireRange
    ro accounts []HistWireAccount
    ro series []HistWireSeries
    ro tiles HistWireTiles
}

fn iso_opt(ms int) -> Option[str] => if ms == 0 { None } else { Some(moment_iso(ms)) }

fn two_digits(n int) -> str => if n < 10 { "0${n}" } else { "${n}" }

fn clock_of(ms int, zone TimeZone) -> str {
    ro t = ms.to_unix_millis().to_zoned(zone).datetime().time()
    "${two_digits(t.hour())}:${two_digits(t.minute())}"
}

/// `Tue 14:20–16:00`, `Fri 19:00–now` (§3.6 `tiles.locked.when`).
export fn history_lock_label(l HistLock, zone TimeZone) -> str {
    ro day = l.from_ms.to_unix_millis().to_zoned(zone).datetime().weekday()
    ro end = if l.to_ms == 0 { "now" } else { clock_of(l.to_ms, zone) }
    "${day} ${clock_of(l.from_ms, zone)}–${end}"
}

/// Seconds a lock covers inside `[from, to]`; an open lock runs to `to`.
export fn history_locked_sec(locks []HistLock, from_ms int, to_ms int) -> int {
    mut total = 0
    for l in locks {
        ro a = if l.from_ms < from_ms { from_ms } else { l.from_ms }
        ro raw_b = if l.to_ms == 0 { to_ms } else { l.to_ms }
        ro b = if raw_b > to_ms { to_ms } else { raw_b }
        if b > a { total += (b - a) / 1000 }
    }
    total
}

/// How many SEPARATE times the series sat at 100 %, not how many points did.
export fn history_runs_at_full(points []HistSample) -> int {
    mut runs = 0
    mut was = false
    for p in points {
        ro full = p.percent >= 100
        if full && !was { runs += 1 }
        was = full
    }
    runs
}

/// The average of the points to one decimal, as the fixture states it (`31.5`).
fn avg_tenths(points []HistSample) -> int {
    if points.len() == 0 { return 0 }
    mut sum = 0
    for p in points { sum += p.percent }
    (sum * 20 + points.len()) / (points.len() * 2)
}

/// The points a summary reads: the thinned samples, or one per day carrying the
/// day's PEAK -- so the peak and the runs at 100 % are the same questions either way.
fn summary_points(w HistWindow, a HistoryAsk, zone TimeZone, step_ms int) -> []HistSample {
    if a.step_sec != 0 { return history_thin(w.samples, a.from_ms, a.to_ms, step_ms) }
    mut out []HistSample = []
    for d in history_days(w, a.from_ms, a.to_ms, zone) {
        out.push(HistSample{ at_ms: d.start_ms, percent: d.peak, resets_at_ms: d.resets_at_ms, locked: d.locked })
    }
    out
}

/// The mean of the days' averages, to one decimal.
fn day_avg_tenths(days []HistDay) -> int {
    if days.len() == 0 { return 0 }
    mut sum = 0
    for d in days { sum += d.avg_hundredths }
    (sum * 2 + days.len() * 10) / (days.len() * 20)
}

fn peak_of(points []HistSample) -> int {
    mut peak = 0
    for p in points { if p.percent > peak { peak = p.percent } }
    peak
}

fn session_of(rows HistRows, account_id str) -> Option[HistWindow] {
    for w in rows.windows {
        if w.account_id == account_id && w.kind == "session" { return Some(w) }
    }
    None
}

fn polls_of(rows HistRows, account_id str) -> []HistPoll {
    for a in rows.accounts {
        if a.id == account_id { return a.polls }
    }
    []
}

fn email_of(rows HistRows, account_id str) -> str {
    for a in rows.accounts {
        if a.id == account_id { return a.email }
    }
    ""
}

/// The fastest window of an account, or none.
fn pace_of(paces []HistPace, account_id str) -> Option[HistPace] {
    mut best Option[HistPace] = None
    for p in paces {
        if p.account_id != account_id { continue }
        match best {
            Some(b) => if p.rate_per_hour_milli > b.rate_per_hour_milli { best = Some(p) }
            None => { best = Some(p) }
        }
    }
    best
}

fn rate_of(milli int) -> f64 => (milli as f64) / 1000.0

/// The whole answer of `by=account` as JSON.
export fn history_by_account(a HistoryAsk, st HistoryState) -> str {
    ro step_ms = if a.step_sec == 0 { DAY_MS } else { a.step_sec * 1000 }
    ro (from_iso, to_iso, step_sec) = history_range_echo(a)

    mut series []HistWireSeries = []
    for w in st.rows.windows {
        mut points []HistWirePoint = []
        if a.step_sec == 0 {
            for d in history_days(w, a.from_ms, a.to_ms, st.zone) {
                points.push({ at: moment_iso(d.start_ms + DAY_MS / 2), percent: d.peak, peak: Some(d.peak),
                              avg: Some((d.avg_hundredths + 50) / 100), locked_sec: Some(d.locked_sec),
                              resets_at: iso_opt(d.resets_at_ms), locked: d.locked })
            }
        } else {
            for s in history_thin(w.samples, a.from_ms, a.to_ms, step_ms) {
                points.push({ at: moment_iso(s.at_ms), percent: s.percent, peak: None, avg: None, locked_sec: None,
                              resets_at: iso_opt(s.resets_at_ms), locked: s.locked })
            }
        }
        mut resets []str = []
        for r in history_resets(w.samples, a.from_ms, a.to_ms) { resets.push(moment_iso(r)) }
        mut locks []HistWireLock = []
        for l in w.locks {
            locks.push({ from_at: moment_iso(l.from_ms), to_at: iso_opt(l.to_ms), reason: l.reason, server_reason: opt(l.server_reason) })
        }
        mut gaps []HistWireGap = []
        for g in history_gaps(polls_of(st.rows, w.account_id)) {
            gaps.push({ from_at: moment_iso(g.from_ms), to_at: iso_opt(g.to_ms), cause: g.cause })
        }
        series.push({ account_id: w.account_id, kind: w.kind, model: opt(w.model), points, resets, locks, gaps })
    }

    mut accounts []HistWireAccount = []
    mut locked_total = 0
    mut locked_most = -1
    mut locked_who = ""
    mut locked_when []str = []
    mut peak_all = -1
    mut peak_who = ""
    mut peak_times = 0
    mut avg_sum = 0
    mut avg_n = 0
    for acc in st.rows.accounts {
        mut peak = 0
        mut tenths = 0
        mut locked = 0
        match session_of(st.rows, acc.id) {
            Some(w) => {
                ro pts = summary_points(w, a, st.zone, step_ms)
                peak = peak_of(pts)
                tenths = if a.step_sec == 0 { day_avg_tenths(history_days(w, a.from_ms, a.to_ms, st.zone)) } else { avg_tenths(pts) }
                locked = history_locked_sec(w.locks, a.from_ms, a.to_ms)
                if pts.len() > 0 {
                    avg_sum += tenths
                    avg_n += 1
                }
                if peak > peak_all {
                    peak_all = peak
                    peak_who = acc.id
                    peak_times = history_runs_at_full(pts)
                }
                if locked > locked_most {
                    locked_most = locked
                    locked_who = acc.id
                    locked_when = []
                    for l in w.locks { locked_when.push(history_lock_label(l, st.zone)) }
                }
            }
            None => ()
        }
        locked_total += locked
        ro pace = pace_of(st.paces, acc.id)
        ro summary = match pace {
            Some(p) => HistWireSummary{ peak_session: peak, avg_session: (tenths as f64) / 10.0, locked_sec: locked,
                                    pace_per_hour: Some(rate_of(p.rate_per_hour_milli)), runs_out_at: opt(p.runs_out_at) }
            None => HistWireSummary{ peak_session: peak, avg_session: (tenths as f64) / 10.0, locked_sec: locked,
                                 pace_per_hour: None, runs_out_at: None }
        }
        accounts.push({ id: acc.id, email: acc.email, color_slot: acc.color_slot, summary })
    }

    // The fastest window of the accounts IN THE ANSWER, for the pace tile. The paces
    // come from the live snapshot and cover every account; a `search` for one
    // account must not name another in its tiles.
    mut fastest Option[HistPace] = None
    for p in st.paces {
        if email_of(st.rows, p.account_id) == "" { continue }
        match fastest {
            Some(b) => if p.rate_per_hour_milli > b.rate_per_hour_milli { fastest = Some(p) }
            None => { fastest = Some(p) }
        }
    }
    ro pace_tile = match fastest {
        Some(p) => Some(HistWirePaceTile{ rate_per_hour: rate_of(p.rate_per_hour_milli), account_id: p.account_id,
                                      email: email_of(st.rows, p.account_id), model: opt(p.model),
                                      runs_out_at: opt(p.runs_out_at), label: p.label })
        None => None
    }
    // A tile with nobody in it names nobody: no locks is `account_id: null`, not the
    // first account with zero seconds.
    ro locked_tile = if locked_total > 0 {
        HistWireLockedTile{ seconds: locked_total, account_id: Some(locked_who), email: opt(email_of(st.rows, locked_who)), when: locked_when }
    } else {
        HistWireLockedTile{ seconds: 0, account_id: None, email: None, when: [] }
    }
    ro peak_tile = if peak_all >= 0 {
        HistWirePeakTile{ percent: peak_all, account_id: Some(peak_who), email: opt(email_of(st.rows, peak_who)), times: peak_times }
    } else {
        HistWirePeakTile{ percent: 0, account_id: None, email: None, times: 0 }
    }
    ro avg_pct = if avg_n == 0 { 0 } else { (avg_sum * 2 + avg_n * 10) / (avg_n * 20) }
    ro body = HistWireByAccount{
        range: { from_at: from_iso, to_at: to_iso, step_sec },
        accounts,
        series,
        tiles: { locked: locked_tile, peak_session: peak_tile, avg_session: { percent: avg_pct, accounts: avg_n }, pace: pace_tile },
    }
    json_encode(body) ?? "{}"
}

// ── `POST /api/history/search` ───────────────────────────────────────────────
//
// The same fields as the query, plus `account_id`, and the two id fields are ARRAYS:
// a string where an array belongs is `422`, not "an array of one" -- a caller who
// sends a string has a different shape in mind, and guessing which is how a filter
// silently selects nothing.

fn search_field_known(k str) -> bool {
    if k == "account_id" { return true }
    history_known(k)
}

/// A scalar field as text: strings as they are, `step` may also be a number.
fn scalar_of(k str, v JsonValue) -> Option[str] {
    match v.str() {
        Some(s) => return Some(s)
        None => ()
    }
    if k == "step" {
        match v.num() {
            Some(n) => return Some("${n as int}")
            None => ()
        }
    }
    None
}

fn ids_of(k str, v JsonValue, mut errs []FieldError) -> []str {
    mut out []str = []
    match v.array() {
        None => {
            errs.push(FieldError.new(k, "not_an_array", "${k} must be an array of UUID strings"))
        }
        Some(items) => {
            for it in items {
                match it.str() {
                    Some(s) => {
                        if s.to_uuid().is_err() {
                            errs.push(FieldError.new(k, "not_a_uuid", "${k} holds a value that is not a UUID"))
                            return out
                        }
                        out.push(s)
                    }
                    None => {
                        errs.push(FieldError.new(k, "not_a_string", "${k} must hold strings"))
                        return out
                    }
                }
            }
        }
    }
    out
}

/// Read the body of §3.6 `search`.
export fn parse_history_search(raw str, now_ms int, keep_days int) -> HistoryAskOr {
    ro text = raw.trim_ascii()
    if text == "" { return HistoryAskOr.Refused(ApiError.invalid_body("body must be a JSON object")) }
    ro root = match Json.parse(text) {
        Ok(v) => v
        Err(_) => return HistoryAskOr.Refused(ApiError.invalid_body("body is not JSON"))
    }
    ro obj = match root.object() {
        Some(o) => o
        None => return HistoryAskOr.Refused(ApiError.invalid_body("body must be a JSON object"))
    }
    mut extra []FieldError = []
    mut errs []FieldError = []
    mut range = ""
    mut from = ""
    mut to = ""
    mut by = ""
    mut step = ""
    mut dirs []str = []
    mut accounts []str = []
    mut it = obj.iter()
    loop {
        match it.next() {
            None => break
            Some((k, v)) => {
                if !search_field_known(k) {
                    extra.push(FieldError.new(k, "unknown_field", "unknown field '${k}'"))
                } else if k == "account_id" {
                    accounts = ids_of(k, v, errs)
                } else if k == "login_dir_id" {
                    dirs = ids_of(k, v, errs)
                } else {
                    match scalar_of(k, v) {
                        None => errs.push(FieldError.new(k, "not_a_string", "${k} must be a string"))
                        Some(s) => {
                            if k == "range" { range = s } else if k == "from" { from = s } else if k == "to" { to = s } else if k == "by" { by = s } else { step = s }
                        }
                    }
                }
            }
        }
    }
    if extra.len() > 0 { return HistoryAskOr.Refused(ApiError.extra_forbidden(extra)) }
    if errs.len() > 0 { return HistoryAskOr.Refused(ApiError.invalid_request(errs)) }
    history_ask_of(range, from, to, by, step, dirs, accounts, now_ms, keep_days)
}

// ── the handlers ─────────────────────────────────────────────────────────────

/// What the ask is judged against: the clock that ends a `range`, and the
/// `history.keep_days` that bounds a `from`/`to`.
export type HistoryEnv value {
    now_ms int
    keep_days int
}

export type HistoryEnvSource fn() -> HistoryEnv

fn history_json(body str) -> ServerResponse =>
    ServerResponse.bytes(200, "application/json; charset=utf-8", body.bytes())

fn history_answer(src HistorySource, ask HistoryAskOr, ctx Ctx) -> ServerResponse {
    match ask {
        HistoryAskOr.Refused(e) => problem(e, ctx.request_id, ctx.instance)
        HistoryAskOr.Asked(a) => {
            if a.by_folder {
                // Part 3 of T2.15 (01.5): occupancy segments. Refused by name rather
                // than answered with the account shape under the folder's label.
                return problem(ApiError.invalid_parameter("by=folder is not served yet"), ctx.request_id, ctx.instance)
            }
            match src(a) {
                HistoryLoad.Failed(_) => problem(ApiError.internal(), ctx.request_id, ctx.instance)
                HistoryLoad.Loaded(st) => history_json(history_by_account(a, st))
            }
        }
    }
}

// Hoisted and param-captured for the [M-16] reason named in `routes.nv`.
fn history_get(clock HistoryEnvSource, src HistorySource, ctx Ctx) -> ServerResponse {
    ro e = clock()
    history_answer(src, parse_history_query(ctx.req.target(), e.now_ms, e.keep_days), ctx)
}

fn history_post(clock HistoryEnvSource, src HistorySource, ctx Ctx) -> ServerResponse {
    ro e = clock()
    ro raw = unsafe { ctx.req.body_bytes().to_str_unchecked() }
    history_answer(src, parse_history_search(raw, e.now_ms, e.keep_days), ctx)
}

/// `GET /api/history`.
export fn history_handler(clock HistoryEnvSource, src HistorySource) -> ApiHandler {
    ro e = clock
    ro s = src
    fn(ctx Ctx) -> ServerResponse => history_get(e, s, ctx)
}

/// `POST /api/history/search`.
export fn history_search_handler(clock HistoryEnvSource, src HistorySource) -> ApiHandler {
    ro e = clock
    ro s = src
    fn(ctx Ctx) -> ServerResponse => history_post(e, s, ctx)
}
