fn merge_storage(mut c Config, obj JsonObject, mut errs []FieldError) -> () {
    mut it = obj.iter()
    loop {
        match it.next() {
            None => break
            Some((k, v)) => {
                if k == "data_dir" {
                    c.storage.data_dir = read_str(v, "storage.data_dir", errs, c.storage.data_dir)
                } else if k == "encrypted" {
                    c.storage.encrypted = read_bool(v, "storage.encrypted", errs, c.storage.encrypted)
                } else if k == "backups_keep" {
                    c.storage.backups_keep = read_int(v, "storage.backups_keep", errs, c.storage.backups_keep)
                } else if k == "memory_limit" {
