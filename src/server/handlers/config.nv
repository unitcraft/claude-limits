// handlers/config.nv — `GET` and `PUT /api/config` (task T2.14).
//
// Source: 01.3 §3.7 (the body and its metadata), §3.8 (the partial tree, `If-Match`,
// every response), §8 п. 7; 01.2 §2.2 (canonical file); 01.1 §5 (the texts).
//
// Imports are PACKAGE-PREFIXED; the factory is `config_handler`, not `handler` —
// both for reasons measured in `probes/` and named in `handlers/snapshot.nv` and
// `handlers/health.nv`.
//
// ── What the merge is, and what it refuses ───────────────────────────────────
//
// `PUT` takes a PARTIAL tree: only the branches being changed. The server merges it
// key by key onto the current settings, lists replacing whole (§3.8). Anything the
// tree does not know is `422 extra_forbidden` with the field in dotted notation —
// not ignored. A settings panel that silently drops a key is a panel that lies
// about having saved.
//
// ALL FAULTS TRAVEL IN ONE RESPONSE. §3.8: "все ошибки в одном ответе". A panel that
// reports the first fault makes a person press Save four times to learn four things.
//
// ── Not here ─────────────────────────────────────────────────────────────────
//
//   * Writing the file. This handler decides WHAT the settings become; the caller's
//     `ConfigCommit` writes them (`config_file.save`: the previous text into
//     `config_history`, then the atomic write) and says what it managed. A handler
//     that wrote files itself could not be tested without a disk.
//   * Reopening the listener. The response says `listener_reopened` only when the
//     commit says the change is LIVE -- a reply claiming a reopen nobody performed
//     sends the page to reconnect to a port nothing listens on.
//   * `folders[]` by `id`. An id comes from the database (01.2 §3.1) and there is
//     no database; a folder given by `path` works, which is the half §3.8 calls
//     "новая".

module handlers.config

import claude_limits.server.routes.{Ctx, ApiHandler, problem}
import claude_limits.server.errors.{ApiError, FieldError, to_json, field_errors_of}
import claude_limits.server.etag.{etag_of}
import claude_limits.server.dto.{Disclosure, opt, shown_path}
import std.encoding.serde.{json_encode, Serialize}
import claude_limits.config.{Config, validate, render, render_file, listen_addr}
import claude_limits.storage.config_file.{Saved}
import polaris.{ServerRequest, ServerResponse}
import std.encoding.json.{Json, JsonValue}

// ── the view ─────────────────────────────────────────────────────────────────

/// One login directory inside a folder (§3.7). Computed, not stored.
export type LoginDirView value { id str, name str }

/// One folder as the panel sees it: the configured path plus what discovery found.
export type FolderView value {
    id str
    path str
    /// `parent | single | empty`.
    kind str
    /// `config | auto`.
    source str
    login_dirs []LoginDirView
    /// "" for `null`.
    problem str
}

/// One account discovery found (§3.7).
export type AccountFound value {
    id str
    email str
    org str
    dirs []LoginDirView
    hidden bool
}

/// Everything `GET /api/config` reports, read fresh on every request.
export type ConfigState value {
    cfg Config
    /// Hash of the FILE TEXT (§3.7), which is what `If-Match` compares against.
    etag str
    path str
    portable bool
    folders []FolderView
    accounts_found []AccountFound
    disclosure Disclosure
}

export type ConfigSource fn() -> ConfigState

/// What saving a change did (§3.8: "пишет файл атомарно и применяет").
export type Committed value {
    ro saved Saved
    /// The change is in force in this process now. `false` on a written save means
    /// it takes effect at the next start -- the reply says `restart_required` rather
    /// than pretending.
    ro live bool
}

/// Write the settings the merge produced, and say what happened. The binary's writes
/// the file and the history row; a test's answers whatever the test needs.
export type ConfigCommit fn(Config) -> Committed

/// `c` with `ui` and `folders` taken from `from`. A named function: a record literal
/// inside a closure is typed as the enclosing literal's type (registry 221.1 #1392).
fn with_live_from(c Config, from Config) -> Config => {
    schema: c.schema, folders: from.folders, poll: c.poll, thresholds: c.thresholds,
    forecast: c.forecast, server: c.server, ui: from.ui, widget: c.widget, history: c.history,
    storage: c.storage, refresh: c.refresh,
}

/// Is the change in force at once? `ui.*` is read per request; `folders` is read by
/// every round from the settings the store holds, and a folder change starts a round
/// at once (§3.8: "Смена `folders` запускает обнаружение немедленно"). Anything else
/// waits for a restart.
///
/// COMPARED THROUGH THE FILE TEXT, not field by field: a field added to `Config`
/// tomorrow is covered the day it is rendered, and a hand-written comparison would
/// silently call a change to it "ui only". The FILE text and not `render`, because
/// `render` leaves the access token out -- and a new token is exactly a change that
/// moves the listener.
export fn applies_live(before Config, after Config) -> bool =>
    render_file(with_live_from(after, before)) == render_file(before)

/// Did the folder list change? The commit starts a round when it did.
export fn folders_changed(before Config, after Config) -> bool => before.folders != after.folders

/// The tag of a settings text. One function, so `GET`, `If-Match` and the tag of a
/// freshly written file cannot be computed three different ways.
export fn tag_of(text str) -> str => etag_of([text])

// ── rendering ────────────────────────────────────────────────────────────────

// The body is a set of wire records serde writes (T2.29), prefixed `Conf` because a
// private type shares its C name with a same-named private type of another module
// once both land in one compilation unit, and `health.nv` already has a `WirePoll`.
//
// `access_token` NEVER appears -- only `access_token_set`; `tls_key` is reported as
// presence, not content. Both rules are section 3.7's, and they are why the wire is
// its OWN set of records rather than `#impl(Serialize)` on `Config`: a serialiser
// over `Config` would put the token on the wire the day someone adds a field. A
// wire record is a whitelist -- a field reaches the wire only by being written here.

#impl(Serialize)
type ConfDir value {
    ro id str
    ro name str
}

#impl(Serialize)
type ConfFolder value {
    ro id str
    ro path Option[str]
    ro kind str
    ro source str
    ro login_dirs []ConfDir
    ro problem Option[str]
}

#impl(Serialize)
type ConfAccount value {
    ro id str
    ro email str
    ro org str
    ro dirs []ConfDir
    ro hidden bool
}

#impl(Serialize)
type ConfPoll value {
    ro interval_sec int
    ro min_interval_sec int
    ro request_timeout_sec int
}

#impl(Serialize)
type ConfThresholds value {
    ro warning int
    ro critical int
}

#impl(Serialize)
type ConfForecast value {
    ro enabled bool
    ro working_hours bool
    ro work_days []str
    ro work_from str
    ro work_to str
    ro off_hours_rate int
    ro rate_window_days int
    ro warning int
    ro critical int
}

#impl(Serialize)
type ConfServer value {
    ro bind str
    ro port int
    ro allow_lan bool
    ro access_token_set bool
    ro tls_cert Option[str]
    ro tls_key_set bool
}

#impl(Serialize)
type ConfUi value {
    ro accounts_order []str
    ro hidden_accounts []str
    ro hide_stale bool
    ro time_bar bool
}

#impl(Serialize)
type ConfWidget value {
    ro enabled bool
    ro always_on_top bool
    ro x int
    ro y int
    ro visible bool
}

#impl(Serialize)
type ConfHistory value {
    ro keep_days int
    ro rollup_keep_days int
    ro config_versions_keep int
}

#impl(Serialize)
type ConfStorage value {
    ro encrypted bool
    ro data_dir Option[str]
    ro backups_keep int
    ro memory_limit str
    ro threads int
}

#impl(Serialize)
type ConfTree value {
    // INSIDE the tree, first, as 01.3 §3.7 draws it. It sat beside `config` until
    // 2026-10-02: the page reads `config.folders` (and so does the contract's
    // fixture), found nothing, and showed an empty list -- after which adding one
    // folder sent a list of one, and the save replaced every configured folder with it.
    ro folders []ConfFolder
    ro poll ConfPoll
    ro thresholds ConfThresholds
    ro forecast ConfForecast
    ro server ConfServer
    ro ui ConfUi
    ro widget ConfWidget
    ro history ConfHistory
    ro storage ConfStorage
}

#impl(Serialize)
type ConfState value {
    ro etag str
    ro path Option[str]
    ro portable bool
    ro config ConfTree
    ro accounts_found []ConfAccount
}

#impl(Serialize)
type ConfApplied value {
    ro restart_required bool
    ro listener_reopened bool
    ro new_base_url Option[str]
}

fn conf_dirs(ds []LoginDirView) -> []ConfDir {
    mut out []ConfDir = []
    for d in ds { out.push({ id: d.id, name: d.name }) }
    out
}

fn conf_folder(d Disclosure, f FolderView) -> ConfFolder => {
    id: f.id,
    path: shown_path(d, f.path),
    kind: f.kind,
    source: f.source,
    login_dirs: conf_dirs(f.login_dirs),
    problem: opt(f.problem),
}

fn conf_account(a AccountFound) -> ConfAccount =>
    { id: a.id, email: a.email, org: a.org, dirs: conf_dirs(a.dirs), hidden: a.hidden }

/// The settings tree itself (section 3.7).
fn conf_tree(c Config, folders []ConfFolder) -> ConfTree => {
    folders,
    poll: { interval_sec: c.poll.interval_sec, min_interval_sec: c.poll.min_interval_sec,
            request_timeout_sec: c.poll.request_timeout_sec },
    thresholds: { warning: c.thresholds.warning, critical: c.thresholds.critical },
    forecast: {
        enabled: c.forecast.enabled,
        working_hours: c.forecast.working_hours,
        work_days: c.forecast.work_days,
        work_from: c.forecast.work_from,
        work_to: c.forecast.work_to,
        off_hours_rate: c.forecast.off_hours_rate,
        rate_window_days: c.forecast.rate_window_days,
        warning: c.forecast.warning,
        critical: c.forecast.critical,
    },
    server: {
        bind: c.server.bind,
        port: c.server.port,
        allow_lan: c.server.allow_lan,
        access_token_set: c.server.access_token != "",
        tls_cert: opt(c.server.tls_cert),
        tls_key_set: c.server.tls_key != "",
    },
    ui: { accounts_order: c.ui.accounts_order, hidden_accounts: c.ui.hidden_accounts,
          hide_stale: c.ui.hide_stale, time_bar: c.ui.time_bar },
    widget: { enabled: c.widget.enabled, always_on_top: c.widget.always_on_top,
              x: c.widget.x, y: c.widget.y, visible: c.widget.visible },
    history: { keep_days: c.history.keep_days, rollup_keep_days: c.history.rollup_keep_days,
               config_versions_keep: c.history.config_versions_keep },
    storage: { encrypted: c.storage.encrypted, data_dir: opt(c.storage.data_dir), backups_keep: c.storage.backups_keep,
               memory_limit: c.storage.memory_limit, threads: c.storage.threads },
}

fn conf_state(st ConfigState) -> ConfState {
    mut folders []ConfFolder = []
    for f in st.folders { folders.push(conf_folder(st.disclosure, f)) }
    mut found []ConfAccount = []
    for a in st.accounts_found { found.push(conf_account(a)) }
    {
        etag: st.etag,
        path: shown_path(st.disclosure, st.path),
        portable: st.portable,
        config: conf_tree(st.cfg, folders),
        accounts_found: found,
    }
}

/// The whole body of `GET /api/config`.
export fn render_state(st ConfigState) -> str =>
    // serde refuses only integers past 2^53 and non-finite floats: none here.
    json_encode(conf_state(st)) ?? "{}"

/// One more member appended to a body serde already wrote: `{...}` + `,"key":value`.
/// The key is a literal of this file and the value is serde's, so nothing here
/// escapes anything -- the splice exists only because `#serde(flatten)` is gated
/// ([M-180-serde-flatten]) and the contract puts `current`/`applied` BESIDE the
/// other members rather than nested under a wrapper.
fn with_member(body str, key str, value str) -> str =>
    "${body[..body.byte_len() - 1]},\"${key}\":${value}}"

// ── the merge ────────────────────────────────────────────────────────────────

const CODE_UNKNOWN = "unknown_field"

fn unknown(path str) -> FieldError => FieldError.new(path, CODE_UNKNOWN, "unknown setting '${path}'")

fn wrong_type(path str, want str) -> FieldError =>
    FieldError.new(path, "wrong_type", "'${path}' must be ${want}")

/// The envelope for a list of field errors, chosen by their CAUSES.
///
/// THE CONTRACT SPLITS THESE, 01.3 section 3.8: `422 extra_forbidden` is "a key that
/// is not in the settings tree", `422 invalid_config` is "a value outside the rules".
/// Two codes for two different mistakes, and the client is expected to act
/// differently on each.
///
/// Until 2026-09-09 everything `apply` collected went out as `extra_forbidden`,
/// because that is the STAGE it was collected at -- and `apply` collects both kinds.
/// So `{"poll": {"interval_sec": "abc"}}` was answered "unknown field": a client
/// following that answer DELETES a key that exists, instead of fixing a value that
/// does not parse. The envelope named the stage, not the reason.
///
/// MIXED LISTS choose `invalid_config`, and that is a decision rather than a reading:
/// the contract says both codes and also "all errors in one response", so with both
/// kinds present one of them has to describe the whole. `extra_forbidden` is the more
/// specific claim -- "this key does not exist" -- and making it about a body that
/// also contains legitimate keys with bad values would be false about part of it.
/// `invalid_config` is true of the whole list in every case. Each `errors[]` entry
/// still carries its own precise code, so nothing is lost.
fn envelope_for(fields []FieldError) -> ApiError {
    mut all_unknown = true
    for f in fields {
        if f.code != CODE_UNKNOWN { all_unknown = false }
    }
    if all_unknown { return ApiError.extra_forbidden(fields) }
    ApiError.invalid_config(fields)
}

/// The result of merging a partial tree onto the current settings.
export type Merge value {
    cfg Config
    errors []FieldError
}

fn read_int(v JsonValue, path str, mut errs []FieldError, current int) -> int {
    match v.num() {
        Some(n) => n as int
        None => {
            errs.push(wrong_type(path, "a number"))
            current
        }
    }
}

fn read_bool(v JsonValue, path str, mut errs []FieldError, current bool) -> bool {
    v.bool() ?? {
        errs.push(wrong_type(path, "true or false"))
        current
    }
}

fn read_str(v JsonValue, path str, mut errs []FieldError, current str) -> str {
    v.str() ?? {
        errs.push(wrong_type(path, "a string"))
        current
    }
}

fn read_str_list(v JsonValue, path str, mut errs []FieldError, current []str) -> []str {
    match v.array() {
        None => {
            errs.push(wrong_type(path, "a list"))
            current
        }
        Some(items) => {
            mut out = []str.new()
            mut bad = false
            mut i = 0
            for it in items {
                match it.str() {
                    Some(s) => out.push(s)
                    None => {
                        errs.push(wrong_type("${path}[${i}]", "a string"))
                        bad = true
                    }
                }
                i += 1
            }
            if bad { current } else { out }
        }
    }
}

fn merge_poll(mut c Config, obj JsonObject, mut errs []FieldError) -> () {
    mut it = obj.iter()
    loop {
        match it.next() {
            None => break
            Some((k, v)) => {
                if k == "interval_sec" {
                    c.poll.interval_sec = read_int(v, "poll.interval_sec", errs, c.poll.interval_sec)
                } else if k == "min_interval_sec" {
                    c.poll.min_interval_sec = read_int(v, "poll.min_interval_sec", errs, c.poll.min_interval_sec)
                } else if k == "request_timeout_sec" {
                    c.poll.request_timeout_sec = read_int(v, "poll.request_timeout_sec", errs, c.poll.request_timeout_sec)
                } else {
                    errs.push(unknown("poll.${k}"))
                }
            }
        }
    }
}

fn merge_thresholds(mut c Config, obj JsonObject, mut errs []FieldError) -> () {
    mut it = obj.iter()
    loop {
        match it.next() {
            None => break
            Some((k, v)) => {
                if k == "warning" {
                    c.thresholds.warning = read_int(v, "thresholds.warning", errs, c.thresholds.warning)
                } else if k == "critical" {
                    c.thresholds.critical = read_int(v, "thresholds.critical", errs, c.thresholds.critical)
                } else {
                    errs.push(unknown("thresholds.${k}"))
                }
            }
        }
    }
}

fn merge_forecast(mut c Config, obj JsonObject, mut errs []FieldError) -> () {
    mut it = obj.iter()
    loop {
        match it.next() {
            None => break
            Some((k, v)) => {
                if k == "enabled" {
                    c.forecast.enabled = read_bool(v, "forecast.enabled", errs, c.forecast.enabled)
                } else if k == "work_days" {
                    c.forecast.work_days = read_str_list(v, "forecast.work_days", errs, c.forecast.work_days)
                } else if k == "work_from" {
                    c.forecast.work_from = read_str(v, "forecast.work_from", errs, c.forecast.work_from)
                } else if k == "work_to" {
                    c.forecast.work_to = read_str(v, "forecast.work_to", errs, c.forecast.work_to)
                } else if k == "off_hours_rate" {
                    c.forecast.off_hours_rate = read_int(v, "forecast.off_hours_rate", errs, c.forecast.off_hours_rate)
                } else if k == "rate_window_days" {
                    c.forecast.rate_window_days = read_int(v, "forecast.rate_window_days", errs, c.forecast.rate_window_days)
                } else if k == "working_hours" {
                    c.forecast.working_hours = read_bool(v, "forecast.working_hours", errs, c.forecast.working_hours)
                } else if k == "warning" {
                    c.forecast.warning = read_int(v, "forecast.warning", errs, c.forecast.warning)
                } else if k == "critical" {
                    c.forecast.critical = read_int(v, "forecast.critical", errs, c.forecast.critical)
                } else {
                    errs.push(unknown("forecast.${k}"))
                }
            }
        }
    }
}

fn merge_server(mut c Config, obj JsonObject, mut errs []FieldError) -> () {
    mut it = obj.iter()
    loop {
        match it.next() {
            None => break
            Some((k, v)) => {
                if k == "bind" {
                    c.server.bind = read_str(v, "server.bind", errs, c.server.bind)
                } else if k == "port" {
                    c.server.port = read_int(v, "server.port", errs, c.server.port)
                } else if k == "allow_lan" {
                    c.server.allow_lan = read_bool(v, "server.allow_lan", errs, c.server.allow_lan)
                } else if k == "access_token" {
                    // Writable but never readable back (§3.7 gives only
                    // `access_token_set`). Accepting it here is what lets a person
                    // set one; nothing in this file ever renders it.
                    c.server.access_token = read_str(v, "server.access_token", errs, c.server.access_token)
                } else if k == "tls_cert" {
                    c.server.tls_cert = read_str(v, "server.tls_cert", errs, c.server.tls_cert)
                } else if k == "tls_key" {
                    c.server.tls_key = read_str(v, "server.tls_key", errs, c.server.tls_key)
                } else {
                    errs.push(unknown("server.${k}"))
                }
            }
        }
    }
}

fn merge_ui(mut c Config, obj JsonObject, mut errs []FieldError) -> () {
    mut it = obj.iter()
    loop {
        match it.next() {
            None => break
            Some((k, v)) => {
                if k == "accounts_order" {
                    c.ui.accounts_order = read_str_list(v, "ui.accounts_order", errs, c.ui.accounts_order)
                } else if k == "hidden_accounts" {
                    c.ui.hidden_accounts = read_str_list(v, "ui.hidden_accounts", errs, c.ui.hidden_accounts)
                } else if k == "hide_stale" {
                    c.ui.hide_stale = read_bool(v, "ui.hide_stale", errs, c.ui.hide_stale)
                } else if k == "time_bar" {
                    c.ui.time_bar = read_bool(v, "ui.time_bar", errs, c.ui.time_bar)
                } else {
                    errs.push(unknown("ui.${k}"))
                }
            }
        }
    }
}

fn merge_widget(mut c Config, obj JsonObject, mut errs []FieldError) -> () {
    mut it = obj.iter()
    loop {
        match it.next() {
            None => break
            Some((k, v)) => {
                if k == "enabled" {
                    c.widget.enabled = read_bool(v, "widget.enabled", errs, c.widget.enabled)
                } else if k == "always_on_top" {
                    c.widget.always_on_top = read_bool(v, "widget.always_on_top", errs, c.widget.always_on_top)
                } else if k == "x" {
                    c.widget.x = read_int(v, "widget.x", errs, c.widget.x)
                } else if k == "y" {
