}

fn merge_storage(mut c Config, obj JsonObject, mut errs []FieldError) -> () {
    mut it = obj.iter()
    loop {
        match it.next() {
            None => break
            Some((k, v)) => {
                if k == "data_dir" {
                    c.storage.data_dir = as_str(v, "storage.data_dir", errs, c.storage.data_dir)
                } else if k == "backups_keep" {
                    c.storage.backups_keep = as_int(v, "storage.backups_keep", errs, c.storage.backups_keep)
                } else if k == "memory_limit" {
                    c.storage.memory_limit = as_str(v, "storage.memory_limit", errs, c.storage.memory_limit)
                } else if k == "threads" {
                    c.storage.threads = as_int(v, "storage.threads", errs, c.storage.threads)
                } else {
                    errs.push(unknown("storage.${k}"))
                }
            }
        }
    }
}

/// `folders[]` — a whole replacement, as §3.8 says lists are.
///
/// An element is `{ "path": "…" }` (a new folder) or `{ "id": "…" }` (one that
/// already exists). Only the first works today: an id comes from the database and
/// there is no database, so an element naming one is refused rather than silently
/// dropped — which would delete the folder, since a folder absent from the list is
/// deleted.
fn merge_folders(mut c Config, v JsonValue, mut errs []FieldError) -> () {
    match v.array() {
        None => errs.push(wrong_type("folders", "a list"))
        Some(items) => {
            mut out = []str.new()
            mut bad = false
            mut i = 0
            for it in items {
                match it.object() {
                    None => {
                        errs.push(wrong_type("folders[${i}]", "an object with 'path' or 'id'"))
                        bad = true
                    }
                    Some(o) => {
                        match o.get("path") {
                            Some(p) => match p.str() {
                                Some(s) => out.push(s)
                                None => {
                                    errs.push(wrong_type("folders[${i}].path", "a string"))
                                    bad = true
                                }
                            }
                            None => {
                                if o.contains("id") {
                                    errs.push(FieldError.of("folders[${i}].id", "not_supported", "a folder by id needs the database, which is not built yet -- name it by path"))
                                } else {
                                    errs.push(wrong_type("folders[${i}]", "an object with 'path' or 'id'"))
                                }
                                bad = true
                            }
                        }
                    }
                }
                i += 1
            }
            if !bad { c.folders = out }
        }
    }
}

/// Merge a partial settings tree onto `current` (§3.8).
///
/// Errors accumulate rather than short-circuit: §3.8 wants every fault in one
/// response, and a person fixing settings should learn all of them at once.
export fn apply(current Config, body JsonObject) -> Merge {
    // Rebuilt field by field, NOT `mut c = current` and not `current.clone()`.
    // The first is refused (`E_READONLY_COERCE`: writing through the new binding
    // would be visible to the caller), and the second is what the diagnostic
    // suggests but `Config` is a value record with no `clone` method -- measured
    // 2026-09-08, `E7320 no field or method 'clone' on type 'Config'`.
    // An independent copy is what is wanted here: a merge that fails validation
    // must leave the running settings untouched.
    mut c = Config{
        schema: current.schema,
        folders: current.folders,
        poll: current.poll,
        thresholds: current.thresholds,
        forecast: current.forecast,
        server: current.server,
        ui: current.ui,
        widget: current.widget,
        history: current.history,
        storage: current.storage,
    }
    mut errs = []FieldError.new()
    mut it = body.iter()
    loop {
        match it.next() {
            None => break
            Some((k, v)) => {
                if k == "folders" {
                    merge_folders(c, v, errs)
                } else {
                    match v.object() {
                        None => errs.push(wrong_type(k, "an object"))
                        Some(o) => {
                            if k == "poll" { merge_poll(c, o, errs) }
                            else if k == "thresholds" { merge_thresholds(c, o, errs) }
                            else if k == "forecast" { merge_forecast(c, o, errs) }
                            else if k == "server" { merge_server(c, o, errs) }
                            else if k == "ui" { merge_ui(c, o, errs) }
                            else if k == "widget" { merge_widget(c, o, errs) }
                            else if k == "history" { merge_history(c, o, errs) }
                            else if k == "storage" { merge_storage(c, o, errs) }
                            else { errs.push(unknown(k)) }
                        }
                    }
                }
            }
        }
    }
    { cfg: c, errors: errs }
}

/// Validation errors as `errors[]` entries.
export fn as_field_errors(errs []ConfigError) -> []FieldError {
    mut out = []FieldError.new()
    for e in errs { out.push(FieldError.of(e.field, e.code, e.message)) }
    out
}

// ── what changed ─────────────────────────────────────────────────────────────

/// Does this change need the listener reopened (§3.8)?
export fn listener_moved(before Config, after Config) -> bool {
    if before.server.bind != after.server.bind { return true }
    if before.server.port != after.server.port { return true }
    if before.server.access_token != after.server.access_token { return true }
    if before.server.tls_cert != after.server.tls_cert { return true }
    before.server.tls_key != after.server.tls_key
}

export fn base_url(c Config) -> str {
    ro scheme = if c.server.tls_cert != "" { "https" } else { "http" }
    "${scheme}://${c.server.bind}:${c.server.port}"
}

// ── the handlers ─────────────────────────────────────────────────────────────

fn header_of(ctx Ctx, name str) -> str {
    match ctx.req.header(name) {
        Some(v) => v
        None    => ""
    }
}

fn json_ok(status int, body str, tag str) -> ServerResponse {
    mut r = ServerResponse.bytes(status, "application/json; charset=utf-8", body.bytes())
    r.header("ETag", tag)
    r
}

fn run_get(src ConfigSource, ctx Ctx) -> ServerResponse {
    ro st = src()
    if header_of(ctx, "if-none-match") == st.etag {
        mut nm = ServerResponse.empty(304)
        nm.header("ETag", st.etag)
        nm
    } else {
        json_ok(200, render_state(st), st.etag)
    }
}

export fn config_get_handler(src ConfigSource) -> ApiHandler {
    ro inner = src
    fn(ctx Ctx) -> ServerResponse => run_get(inner, ctx)
}

fn body_str(req ServerRequest) -> str => unsafe { req.body_bytes().to_str_unchecked() }

/// A `412`, carrying the settings as they actually are (§3.8: "тело ошибки содержит
/// поле `current`"). The panel offers to re-read rather than making a person guess
/// what changed.
fn stale(ctx Ctx, st ConfigState) -> ServerResponse {
    ro e = ApiError.precondition_failed()
    ro body = problem_with_current(e, ctx.request_id, ctx.instance, render_state(st))
    mut r = ServerResponse.bytes(412, "application/problem+json; charset=utf-8", body.bytes())
    r.header("ETag", st.etag)
    r
}

/// A problem body with the contract's `current` extension spliced in (§0 declares
/// it, §3.8 requires it on a 412).
fn problem_with_current(e ApiError, request_id str, instance str, current str) -> str {
    // A qualified call (`claude_limits.server.errors.to_json(...)`) is not a form
    // the compiler accepts -- it reaches codegen as an unknown identifier. Imported
    // by name instead.
    ro base = to_json(e, request_id, instance)
    // The base body always ends in `}`; the extension goes before it rather than
    // through a second serialiser, so there is one spelling of a problem body.
    "${base[0..base.byte_len() - 1]},${field_raw("current", current)}}"
}

fn run_put(src ConfigSource, ctx Ctx) -> ServerResponse {
    ro st = src()
    ro if_match = header_of(ctx, "if-match")
    if if_match == "" { return problem(ApiError.precondition_required(), ctx.request_id, ctx.instance) }
    if if_match != st.etag { return stale(ctx, st) }

    match Json.parse(body_str(ctx.req).trim_ascii()) {
        Err(_) => problem(ApiError.invalid_body("body is not JSON"), ctx.request_id, ctx.instance)
        Ok(v) => match v.object() {
            None => problem(ApiError.invalid_body("body must be a JSON object"), ctx.request_id, ctx.instance)
            Some(obj) => {
                ro merged = apply(st.cfg, obj)
                if merged.errors.len() > 0 {
                    return problem(ApiError.extra_forbidden(merged.errors), ctx.request_id, ctx.instance)
                }
                ro bad = validate(merged.cfg)
                if bad.len() > 0 {
                    return problem(ApiError.invalid_config(as_field_errors(bad)), ctx.request_id, ctx.instance)
                }
                accepted(st, merged.cfg)
            }
        }
    }
}

/// `200` with the body of `GET` at the new tag, plus `applied` (§3.8).
///
/// The new tag is the tag of the CANONICAL TEXT (`config.render`), not of the
/// request body: two different partial trees can mean the same settings, and a tag
/// that depended on how a client spelled its request would make an unchanged
/// resource look changed.
fn accepted(before ConfigState, after Config) -> ServerResponse {
    ro text = render(after)
    ro tag = tag_of(text)
    // Built rather than copied-and-patched, for the same reason as in `apply`:
    // the caller's state describes what is on disk NOW, and this is the view of
    // what it would become.
    ro next = ConfigState{
        cfg: after,
        etag: tag,
        path: before.path,
        portable: before.portable,
        folders: before.folders,
        accounts_found: before.accounts_found,
        disclosure: before.disclosure,
    }
    ro moved = listener_moved(before.cfg, after)
    ro base = render_state(next)
    ro applied = object([
        field_bool("restart_required", false),
        field_bool("listener_reopened", moved),
        field_str_or_null("new_base_url", if moved { base_url(after) } else { "" }),
    ])
    ro body = "${base[0..base.byte_len() - 1]},${field_raw("applied", applied)}}"
    json_ok(200, body, tag)
}

export fn config_put_handler(src ConfigSource) -> ApiHandler {
    ro inner = src
    fn(ctx Ctx) -> ServerResponse => run_put(inner, ctx)
}
