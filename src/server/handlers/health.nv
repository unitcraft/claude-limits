// handlers/health.nv — `GET /api/health` (task T2.12).
//
// Source: 01.3 §3.2 (the body and the THREE disclosure levels), §5 (`api_version`
// is what a script checks), §8 п. 8 ("`/api/health` из LAN — без путей и версии").
//
// Imports are PACKAGE-PREFIXED; see `handlers/snapshot.nv` for the measurement.
//
// The factory is `health_handler`, not `handler`: an exported fn whose name equals
// a record FIELD name in scope (`Endpoint.handler`, `server/routes.nv`) is
// mis-resolved into an indirect call with no C symbol. Isolated in
// `probes/exported-fn-named-handler/`.

module handlers.health

import claude_limits.server.routes.{Ctx, ApiHandler, API_VERSION}
import claude_limits.server.dto.{Disclosure, opt, shown_path}
import std.encoding.serde.{json_encode, Serialize}
import polaris.{ServerResponse}

/// Everything `/api/health` reports, read fresh on every request.
export type HealthState value {
    app_version str
    started_at str
    uptime_sec int
    bind str
    port int
    allow_lan bool
    tls bool
    poll_interval_sec int
    poll_last_at str
    poll_next_at str
    sse_clients int
    accounts_total int
    accounts_ok int
    accounts_stale int
    accounts_unknown int
    accounts_error int
    accounts_hidden int
    login_dirs int
    config_path str
    db_path str
    db_size_bytes int
    schema_version int
    history_days int
    encrypted bool
    key_store str
    widget_enabled bool
    widget_running bool
    /// Text of the last settings-file read error, or "" for `null` (01.2 §2.2).
    config_error str
    disclosure Disclosure
}

export type HealthSource fn() -> HealthState

/// The body of §3.2 at this client's level.
///
/// THREE LEVELS, not two, and the shortest one is a different SHAPE rather than the
/// same shape with nulls: an unauthenticated caller is told only that the server is
/// up and which contract it speaks, because everything else — how many accounts
/// exist, whether a widget runs, how big the database is — is a description of the
/// machine to someone who has not proved they may have it.
///
/// The LAN level IS the same shape with nulls, and that is the difference that
/// matters: a client who may see the body must be able to tell "hidden from you"
/// from "not set", which is what §0 means by an absent value being `null`.
export fn render_health(st HealthState) -> str {
    // serde refuses only integers past 2^53 and non-finite floats; this body holds
    // neither. `{}` is still a body a probe can parse.
    match st.disclosure {
        Disclosure.Anonymous => json_encode(HealthShort{ ok: true, api_version: API_VERSION }) ?? "{}"
        _ => json_encode(full_body(st)) ?? "{}"
    }
}

// ── the wire (T2.29), in wire order ───────────────────────────────────────────

#impl(Serialize)
type HealthShort value {
    ro ok bool
    ro api_version int
}

#impl(Serialize)
type WireListen value {
    ro bind str
    ro port int
    ro allow_lan bool
    ro tls bool
}

#impl(Serialize)
type WirePoll value {
    ro interval_sec int
    ro last_at Option[str]
    ro next_at Option[str]
}

#impl(Serialize)
type WireCounts value {
    ro total int
    ro ok int
    ro stale int
    ro unknown int
    ro error int
    ro hidden int
}

#impl(Serialize)
type WireStorage value {
    ro config_path Option[str]
    ro db_path Option[str]
    ro db_size_bytes int
    ro schema_version int
    ro history_days int
    ro encrypted bool
    ro key_store str
}

#impl(Serialize)
type WireWidget value {
    ro enabled bool
    ro running bool
}

#impl(Serialize)
type HealthFull value {
    ro ok bool
    ro api_version int
    ro app_version Option[str]
    ro started_at str
    ro uptime_sec int
    ro listen WireListen
    ro poll WirePoll
    ro sse_clients int
    ro accounts WireCounts
    ro login_dirs int
    ro storage WireStorage
    ro widget WireWidget
    ro config_error Option[str]
}

fn full_body(st HealthState) -> HealthFull {
    ro lan = match st.disclosure {
        Disclosure.Lan => true
        _ => false
    }
    {
        ok: true,
        api_version: API_VERSION,
        // The build version is withheld from LAN by section 3.2 in the same breath
        // as the paths: it tells a stranger which published defects this binary
        // still has. On loopback it is written even when empty -- it was never a
        // null-if-empty field. `Some` first: probes/serde-two-option-types.
        app_version: if !lan { Some(st.app_version) } else { None },
        started_at: st.started_at,
        uptime_sec: st.uptime_sec,
        listen: { bind: st.bind, port: st.port, allow_lan: st.allow_lan, tls: st.tls },
        poll: { interval_sec: st.poll_interval_sec, last_at: opt(st.poll_last_at),
                next_at: opt(st.poll_next_at) },
        sse_clients: st.sse_clients,
        accounts: { total: st.accounts_total, ok: st.accounts_ok, stale: st.accounts_stale,
                    unknown: st.accounts_unknown, error: st.accounts_error,
                    hidden: st.accounts_hidden },
        login_dirs: st.login_dirs,
        storage: {
            config_path: shown_path(st.disclosure, st.config_path),
            db_path: shown_path(st.disclosure, st.db_path),
            db_size_bytes: st.db_size_bytes,
            schema_version: st.schema_version,
            history_days: st.history_days,
            encrypted: st.encrypted,
            key_store: st.key_store,
        },
        widget: { enabled: st.widget_enabled, running: st.widget_running },
        config_error: opt(st.config_error),
    }
}

// Hoisted and param-captured for the [M-16] reason named in `routes.nv`.
fn run(src HealthSource, ctx Ctx) -> ServerResponse {
    ro body = render_health(src())
    ServerResponse.bytes(200, "application/json; charset=utf-8", body.bytes())
}

export fn health_handler(src HealthSource) -> ApiHandler {
    ro inner = src
    fn(ctx Ctx) -> ServerResponse => run(inner, ctx)
}
