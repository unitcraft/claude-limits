// Tests for handlers/history.nv — task T2.15, the ANSWER of `/api/history` and the
// two routes. The ask itself is in `history_test.nv`.
//
//   ./nova.sh test src/server/handlers/history_answer_test.nv
//
// The rows are a day of two accounts, every number below derived by hand from them:
//
//   main  session `i % 60` every five minutes, a 429 from now-9h to now-8h (twelve
//         samples missing) -> 276 points, peak 59, average 29.5.
//   work  session 50 %, 100 % and locked inside two locks: now-5h..now-4h (closed) and
//         now-1h..now (open) -> peak 100 reached twice, 7200 locked seconds, average
//         15600 / 288 = 54.2.

module handlers.history_answer_test

import history.{HistoryAsk, HistoryAskOr, HistoryState, HistoryLoad, HistoryEnv, HistPace}
import history.{parse_history_query, parse_history_search, history_by_account, history_handler, history_search_handler}
import claude_limits.storage.history_rows.{HistSample, HistLock, HistPoll, HistWindow, HistAccount, HistRows, HistRollup}
import claude_limits.server.routes.{HttpMethod, on, route, route_q, build}
import polaris.{Router, serve_once}
import std.time.civil.{TimeZone}

// 2026-09-06T16:47:00Z, a Sunday.
const NOW int = 1788713220000
const H int = 3600000
const M5 int = 300000
const MAIN str = "0192a7f0-0000-7000-8000-000000000001"
const WORK str = "0192a7f0-0000-7000-8000-000000000002"

fn main_window() -> HistWindow {
    ro from = NOW - 24 * H
    mut s []HistSample = []
    mut i = 0
    while i < 288 {
        if i < 180 || i >= 192 {
            s.push(HistSample{ at_ms: from + i * M5, percent: i % 60, resets_at_ms: 0, locked: false })
        }
        i += 1
    }
    HistWindow{ account_id: MAIN, kind: "session", model: "", samples: s, locks: [], rollups: [] }
}

fn work_window() -> HistWindow {
    ro from = NOW - 24 * H
    mut s []HistSample = []
    mut i = 0
    while i < 288 {
        ro at = from + i * M5
        ro locked = (at >= NOW - 5 * H && at < NOW - 4 * H) || at >= NOW - H
        s.push(HistSample{ at_ms: at, percent: if locked { 100 } else { 50 }, resets_at_ms: 0, locked })
        i += 1
    }
    ro locks = [
        HistLock{ from_ms: NOW - 5 * H, to_ms: NOW - 4 * H, reason: "server", server_reason: "session_limit" },
        HistLock{ from_ms: NOW - H, to_ms: 0, reason: "percent_100", server_reason: "" },
    ]
    HistWindow{ account_id: WORK, kind: "session", model: "", samples: s, locks, rollups: [] }
}

fn polls(gap bool) -> []HistPoll {
    ro from = NOW - 24 * H
    mut out []HistPoll = []
    mut i = 0
    while i < 288 {
        ro at = from + i * M5
        ro bad = gap && at >= NOW - 9 * H && at < NOW - 8 * H
        out.push(HistPoll{ at_ms: at, outcome: if bad { "http_429" } else { "ok" } })
        i += 1
    }
    out
}

fn rows() -> HistRows => {
    accounts: [
        HistAccount{ id: MAIN, email: "main@example.com", color_slot: 0, polls: polls(true) },
        HistAccount{ id: WORK, email: "work@example.org", color_slot: 1, polls: polls(false) },
    ],
    windows: [main_window(), work_window()],
}

fn paces() -> []HistPace => [
    HistPace{ account_id: MAIN, kind: "weekly_scoped", model: "Fable", rate_per_hour_milli: 2060,
              runs_out_at: "2026-09-08T12:30:00Z", label: "Fable ends Tue ~12:30, 30 m before reset" },
    HistPace{ account_id: WORK, kind: "session", model: "", rate_per_hour_milli: 900, runs_out_at: "", label: "" },
]

fn state() -> HistoryState => { rows: rows(), paces: paces(), zone: TimeZone.Utc }

fn day_ask() -> HistoryAsk {
    match parse_history_query("/api/history?range=24h", NOW, 30) {
        HistoryAskOr.Asked(a) => a
        HistoryAskOr.Refused(e) => panic("refused: ${e.detail}")
    }
}

fn has(hay str, needle str) -> bool {
    if hay.contains(needle) { return true }
    panic("missing [${needle}]")
}

fn count_of(hay str, needle str) -> int {
    mut n = 0
    mut rest = hay
    loop {
        match rest.find(needle) {
            None => break
            Some(i) => {
                n += 1
                rest = rest[i + needle.byte_len()..]
            }
        }
    }
    n
}

// ── the body ────────────────────────────────────────────────────────────────

test "the range echoes the ask" {
    ro b = history_by_account(day_ask(), state())
    assert(has(b, "\"range\":{\"from\":\"2026-09-05T16:47:00"))
    assert(has(b, "\"step_sec\":300}"))
}

test "a series per window, a point per sample, none across the outage" {
    ro b = history_by_account(day_ask(), state())
    assert(count_of(b, "\"kind\":\"session\"") == 2)
    // 276 + 288 points; each carries exactly one `"percent":`.
    assert(count_of(b, "\"percent\":") - 2 == 276 + 288)
    assert(has(b, "\"model\":null"))
}

test "the 429 is a gap of main, with its edges and cause" {
    ro b = history_by_account(day_ask(), state())
    assert(has(b, "\"gaps\":[{\"from\":\"2026-09-06T07:47:00"))
    assert(has(b, "\"cause\":\"http_429\""))
    assert(count_of(b, "\"cause\":") == 1)
}

test "locks keep their reasons, the open one has to null" {
    ro b = history_by_account(day_ask(), state())
    assert(has(b, "\"reason\":\"server\",\"server_reason\":\"session_limit\""))
    assert(has(b, "\"to\":null,\"reason\":\"percent_100\",\"server_reason\":null"))
}

test "the summaries are derived from the points" {
    ro b = history_by_account(day_ask(), state())
    assert(has(b, "\"summary\":{\"peak_session\":59,\"avg_session\":29.5,\"locked_sec\":0,\"pace_per_hour\":2.06,\"runs_out_at\":\"2026-09-08T12:30:00Z\"}"))
    assert(has(b, "\"summary\":{\"peak_session\":100,\"avg_session\":54.2,\"locked_sec\":7200,\"pace_per_hour\":0.9,\"runs_out_at\":null}"))
}

test "the tiles name who, how much and when" {
    ro b = history_by_account(day_ask(), state())
    assert(has(b, "\"locked\":{\"seconds\":7200,\"account_id\":\"${WORK}\",\"email\":\"work@example.org\",\"when\":[\"Sun 11:47–12:47\",\"Sun 15:47–now\"]}"))
    assert(has(b, "\"peak_session\":{\"percent\":100,\"account_id\":\"${WORK}\",\"email\":\"work@example.org\",\"times\":2}"))
    assert(has(b, "\"avg_session\":{\"percent\":42,\"accounts\":2}"))
    assert(has(b, "\"pace\":{\"rate_per_hour\":2.06,\"account_id\":\"${MAIN}\",\"email\":\"main@example.com\",\"model\":\"Fable\""))
}

test "no rows is an answer with empty lists and tiles naming nobody" {
    ro empty = HistoryState{ rows: { accounts: [], windows: [] }, paces: [], zone: TimeZone.Utc }
    ro b = history_by_account(day_ask(), empty)
    assert(has(b, "\"accounts\":[],\"series\":[]"))
    assert(has(b, "\"locked\":{\"seconds\":0,\"account_id\":null"))
    assert(has(b, "\"pace\":null"))
}

// ── the routes ──────────────────────────────────────────────────────────────

/// The source does what the database does with an account filter: keeps only the
/// accounts named, and an unknown id simply matches nothing.
fn filtered(a HistoryAsk) -> HistoryLoad {
    if a.accounts.len() == 0 { return HistoryLoad.Loaded(state()) }
    ro all = rows()
    mut acc []HistAccount = []
    mut win []HistWindow = []
    for x in all.accounts {
        for id in a.accounts { if id == x.id { acc.push(x) } }
    }
    for w in all.windows {
        for id in a.accounts { if id == w.account_id { win.push(w) } }
    }
    HistoryLoad.Loaded({ rows: { accounts: acc, windows: win }, paces: paces(), zone: TimeZone.Utc })
}

fn fixed_env() -> HistoryEnv => { now_ms: NOW, keep_days: 30 }

fn app() -> Router =>
    build([
        route_q("/api/history", [on(HttpMethod.Get, history_handler(fn() -> HistoryEnv => fixed_env(), fn(a HistoryAsk) -> HistoryLoad => filtered(a)))],
                ["range", "from", "to", "by", "step", "login_dir_id"]),
        route("/api/history/search", [on(HttpMethod.Post, history_search_handler(fn() -> HistoryEnv => fixed_env(), fn(a HistoryAsk) -> HistoryLoad => filtered(a)))]),
    ])!!

fn wire_str(wire []u8) -> str => unsafe { wire.to_str_unchecked() }

fn get(target str) Time Random -> str =>
    wire_str(serve_once(app(), "GET ${target} HTTP/1.1\r\nHost: x\r\n\r\n".bytes()))

fn post(body str) Time Random -> str =>
    wire_str(serve_once(app(), "POST /api/history/search HTTP/1.1\r\nHost: x\r\nContent-Type: application/json\r\nContent-Length: ${body.byte_len()}\r\n\r\n${body}".bytes()))

fn status_of(s str) -> str {
    match s.find("\r\n") { Some(i) => s[..i], None => s }
}

fn body_of(s str) -> str {
    match s.find("\r\n\r\n") { Some(i) => s[i + 4..], None => "" }
}

test "GET answers 200 with the account shape" {
    ro r = get("/api/history?range=24h")
    assert(status_of(r).contains(" 200 "))
    assert(has(body_of(r), "\"tiles\":"))
}

test "an account id in the query is 400" {
    ro r = get("/api/history?account_id=${MAIN}")
    assert(status_of(r).contains(" 400 "))
    assert(has(body_of(r), "invalid_parameter"))
}

// ONE SERVE PER TEST, and "search equals GET" goes through a common reference rather
// than two serves side by side: on a compiler older than nova 8d4a24967 the SECOND
// `serve_once` of a body of 5 KB or more inside one test dies with 0xC0000005
// (measured 2026-10-01: integ 8900d9a61 red, main f0c5dbdd3 green, a plain-text
// handler is enough to show it). CI pins a compiler older than that fix.

test "GET is exactly the account answer" {
    assert(body_of(get("/api/history?range=24h")) == history_by_account(day_ask(), state()))
}

test "search without a filter is exactly the same answer" {
    assert(body_of(post("{\"range\":\"24h\"}")) == history_by_account(day_ask(), state()))
}

test "search with one account keeps only that account" {
    ro b = body_of(post("{\"range\":\"24h\",\"account_id\":[\"${WORK}\"]}"))
    assert(count_of(b, "\"account_id\":\"${MAIN}\"") == 0)
    assert(count_of(b, "\"kind\":\"session\"") == 1)
}

test "an unknown account in search is empty series, not an error" {
    ro r = post("{\"range\":\"24h\",\"account_id\":[\"0192a7f0-0000-7000-8000-00000000dead\"]}")
    assert(status_of(r).contains(" 200 "))
    assert(has(body_of(r), "\"series\":[]"))
}

test "a string where an array belongs is 422" {
    ro r = post("{\"range\":\"24h\",\"account_id\":\"${WORK}\"}")
    assert(status_of(r).contains(" 422 "))
    assert(has(body_of(r), "not_an_array"))
}

test "an unknown field in search is 422 extra_forbidden" {
    ro r = post("{\"range\":\"24h\",\"email\":\"main@example.com\"}")
    assert(status_of(r).contains(" 422 "))
    assert(has(body_of(r), "extra_forbidden"))
}

test "search takes step as a number too" {
    match parse_history_search("{\"range\":\"30d\",\"step\":3600}", NOW, 30) {
        HistoryAskOr.Asked(a) => assert(a.step_sec == 3600)
        HistoryAskOr.Refused(e) => panic("refused: ${e.detail}")
    }
}

// ── step=day ────────────────────────────────────────────────────────────────
//
// Five days, 2026-09-02 .. 2026-09-06, read at UTC. 09-02 and 09-03 are known only to
// the rollup; 09-04 has BOTH a rollup row and samples, and the samples must win; 09-05
// holds a one-hour lock; 09-06 is cut by `to` at 16:47.
//
//   day    source   peak  avg (hundredths)          locked_sec
//   09-02  rollup    40   2050                       600
//   09-03  rollup    70   3000                         0
//   09-04  samples   10   1000                         0
//   09-05  samples  100   (100 + 23*20)/24 = 2333   3600
//   09-06  samples   30   3000                         0

const D0904 int = 1788480000000

fn day_window() -> HistWindow {
    mut s []HistSample = []
    mut at = D0904
    while at < NOW {
        ro locked = at == D0904 + 34 * H
        ro pct = if at < D0904 + 24 * H { 10 } else if at < D0904 + 48 * H { if locked { 100 } else { 20 } } else { 30 }
        s.push(HistSample{ at_ms: at, percent: pct, resets_at_ms: at + 5 * H, locked })
        at += H
    }
    ro locks = [
        HistLock{ from_ms: D0904 - 2 * 24 * H + 5 * H, to_ms: D0904 - 2 * 24 * H + 5 * H + 600000, reason: "server", server_reason: "" },
        HistLock{ from_ms: D0904 + 34 * H, to_ms: D0904 + 35 * H, reason: "percent_100", server_reason: "" },
    ]
    ro rollups = [
        HistRollup{ day: 20698, peak: 40, avg_hundredths: 2050, locked_sec: 600 },
        HistRollup{ day: 20699, peak: 70, avg_hundredths: 3000, locked_sec: 0 },
        HistRollup{ day: 20700, peak: 99, avg_hundredths: 9900, locked_sec: 0 },
    ]
    HistWindow{ account_id: WORK, kind: "session", model: "", samples: s, locks, rollups }
}

fn day_state() -> HistoryState => {
    rows: { accounts: [HistAccount{ id: WORK, email: "work@example.org", color_slot: 1, polls: [] }], windows: [day_window()] },
    paces: [],
    zone: TimeZone.Utc,
}

fn day_answer() -> str {
    match history_ask_of_day() {
        HistoryAskOr.Asked(a) => history_by_account(a, day_state())
        HistoryAskOr.Refused(e) => panic("refused: ${e.detail}")
    }
}

fn history_ask_of_day() -> HistoryAskOr =>
    parse_history_query("/api/history?from=2026-09-01T16:47:00Z&to=2026-09-06T16:47:00Z&step=day", NOW, 30)

test "a day point is drawn at noon with its peak, average and locked seconds" {
    ro b = day_answer()
    assert(has(b, "{\"at\":\"2026-09-02T12:00:00"))
    assert(has(b, "\"percent\":40,\"peak\":40,\"avg\":21,\"locked_sec\":600,\"resets_at\":null,\"locked\":false}"))
    assert(has(b, "\"percent\":70,\"peak\":70,\"avg\":30,\"locked_sec\":0,"))
    assert(has(b, "\"percent\":100,\"peak\":100,\"avg\":23,\"locked_sec\":3600,"))
    assert(has(b, "\"step_sec\":86400"))
}

test "five days, one point each, the samples winning over the rollup of their day" {
    ro b = day_answer()
    assert(count_of(b, "\"peak\":") == 5)
    assert(has(b, "\"percent\":10,\"peak\":10,\"avg\":10,"))
    // The rollup row of 09-04 said 99: had it been drawn, this would be there.
    assert(count_of(b, "\"peak\":99") == 0)
}

test "the summary of a day answer reads the days" {
    ro b = day_answer()
    // Peak 100; the mean of the five averages (11383 / 5 hundredths) is 22.8; the
    // two locks are 600 + 3600 seconds.
    assert(has(b, "\"summary\":{\"peak_session\":100,\"avg_session\":22.8,\"locked_sec\":4200,"))
}

test "a sample point carries no day fields at all" {
    ro b = history_by_account(day_ask(), state())
    assert(count_of(b, "\"peak\":") == 0)
    assert(count_of(b, "\"avg\":") == 0)
}
