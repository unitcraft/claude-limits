// Tests for feed.nv -- the accounts `--serve` finds, and one round of asking.
//
//   ./nova.sh test src/server/ --filter feed_test
//
// Everything the round touches is a handler here: a folder tree in memory, two
// credentials files (one live, one expired), and an endpoint that counts what it is
// asked. Helper names avoid the module names of the unit (registry 221.1 #1400).

module server.feed_test

import std.time.civil.{TimeZone}
import http.{Http, HttpError}
import claude_limits.accounts.discover.{Dirs}
import claude_limits.accounts.login.{Creds, TokenState}
import claude_limits.usage.poller.{PollLog, Reading}
import claude_limits.model.live.{Known, view_of}
import claude_limits.model.snapshot.{SeverityBounds}
import claude_limits.model.snapshot.{AccountState}
import feed.{Found, stable_id, found_in, poll_round, expiry_text}
import feed.{Rounds, RoundLog, Settled, Renew, store_and_poll, renew_expired, ping_every}
import claude_limits.model.store_fiber.{Envelope, Store, ConfNow, StoreAsk, Follower, Followed}
import claude_limits.model.store.{Event}
import std.time.duration
import claude_limits.usage.parse.{moment_iso}
import claude_limits.server.dto.{SnapshotView}
import std.concurrency.nvchan.{Chan}
import std.testing.handlers.{fixed_ms}
import claude_limits.config.{Refresh, Config}

// 2026-09-30 09:00:00 UTC; the live token expires a day later, the dead one a day ago.
const NOW_MS = 1790758800000
const DAY_MS = 86400000

const EOL = "\r\n"

// ── the tree ────────────────────────────────────────────────────────────────

fn dirs_here() -> []str => ["/acc", "/acc/work", "/acc/home", "/acc/old"]

fn files_here() -> []str => [
    "/acc/work/.credentials.json", "/acc/work/.claude.json",
    "/acc/home/.credentials.json", "/acc/home/.claude.json",
    "/acc/old/.credentials.json", "/acc/old/.claude.json",
]

fn kids_of(path str) -> []str {
    if path == "/acc" { return ["work", "home", "old"] }
    []
}

fn ident_of(email str) -> str => "{\"oauthAccount\":{\"emailAddress\":\"${email}\",\"organizationName\":\"Example Inc\"}}"

fn creds_until(ms int) -> str => "{\"claudeAiOauth\":{\"accessToken\":\"sk-ant-fixture-SECRET\",\"expiresAt\":${ms}}}"

fn file_text(path str) -> str {
    // `work` and `home` are ONE account in two directories; `old` has an expired token.
    if path == "/acc/work/.claude.json" { return ident_of("main@example.org") }
    if path == "/acc/home/.claude.json" { return ident_of("main@example.org") }
    if path == "/acc/old/.claude.json" { return ident_of("old@example.org") }
    if path == "/acc/old/.credentials.json" { return creds_until(NOW_MS - DAY_MS) }
    if path.ends_with(".credentials.json") { return creds_until(NOW_MS + DAY_MS) }
    ""
}

fn on_disk[T](body fn() Dirs Creds -> T) -> T =>
    with Dirs = effect Dirs {
        list(path) -> []str { kids_of(path) }
        exists(path) -> bool { dirs_here().contains(path) || files_here().contains(path) }
        is_dir(path) -> bool { dirs_here().contains(path) }
    } {
        with Creds = effect Creds {
            read(path) -> str { file_text(path) }
        } {
            body()
        }
    }

// ── the endpoint ────────────────────────────────────────────────────────────

type Asked {
    mut n int
}

fn Asked.new() -> Asked => { n: 0 }

fn reply_ok() -> str =>
    "HTTP/1.1 200 OK${EOL}Content-Type: application/json${EOL}${EOL}{\"five_hour\":{\"utilization\":12.0,\"resets_at\":\"2026-09-30T13:29:00Z\"},\"seven_day\":{\"utilization\":18.0,\"resets_at\":\"2026-10-03T21:00:00Z\"}}"

fn reply_429() -> str => "HTTP/1.1 429 Too Many Requests${EOL}Retry-After: 120${EOL}${EOL}slow down"

fn endpoint[T](mut a Asked, raw str, body fn() Http PollLog Creds -> T) -> T =>
    with Http = effect Http {
        send(host, port, secure, request) -> Result[str, HttpError] {
            a.n += 1
            Ok(raw)
        }
    } {
        with PollLog = effect PollLog {
            record(email str, state str, message str, at_ms int) -> () {}
            reading(r Reading) -> () {}
        } {
            with Creds = effect Creds {
                read(path) -> str { file_text(path) }
            } {
                body()
            }
        }
    }

// Constants go through locals before a lambda: a module const read inside one does not
// build (registry 221.1 #1399).
fn found_now() -> []Found {
    ro now = NOW_MS
    on_disk(fn() Dirs Creds -> []Found => found_in(["/acc"], now))
}

fn same(label str, want str, got str) -> bool {
    if want == got { return true }
    panic("${label}: want ${want}, got ${got}")
}

// ── ids ─────────────────────────────────────────────────────────────────────

test "an id is a stable UUID of version 8, different per key and per kind" {
    ro a = stable_id("account", "main@example.org")
    assert(same("stable", a, stable_id("account", "main@example.org")))
    assert(a != stable_id("account", "old@example.org"))
    assert(a != stable_id("dir", "main@example.org"))
    ro parts = a.split("-").collect()
    assert(parts.len() == 5)
    assert(parts[0].byte_len() == 8 && parts[4].byte_len() == 12)
    assert(parts[2].starts_with("8"))
    assert(parts[3].starts_with("8"))
}

// ── the folders ─────────────────────────────────────────────────────────────

test "one e-mail in two directories is ONE account with both, paths and names paired" {
    ro f = found_now()
    assert(f.len() == 2)
    assert(same("first", "main@example.org", f[0].email))
    assert(f[0].dirs.len() == 2)
    assert(same("name 0", "work", f[0].dirs[0].name))
    assert(same("path 0", "/acc/work", f[0].dirs[0].path))
    assert(same("name 1", "home", f[0].dirs[1].name))
    assert(same("path 1", "/acc/home", f[0].dirs[1].path))
    assert(same("creds", "/acc/work/.credentials.json", f[0].cred_path))
    assert(same("org", "Example Inc", f[0].org))
}

// ── Codex homes (plan 01.7) ──────────────────────────────────────────────────

const CX_ID = "eyJhbGciOiJub25lIn0.eyJlbWFpbCI6Ik1lQEV4YW1wbGUuY29tIn0.sig"
const CX_LIVE = "eyJhbGciOiJub25lIn0.eyJleHAiOjE3OTMwMDAwMDB9.sig"
const CX_DEAD = "eyJhbGciOiJub25lIn0.eyJleHAiOjE3OTAwMDAwMDB9.sig"

fn cx_auth(access str) -> str =>
    "{\"tokens\":{\"id_token\":\"${CX_ID}\",\"access_token\":\"${access}\",\"refresh_token\":\"rt\",\"account_id\":\"acct-1\"}}"

fn cx_text(path str) -> str {
    if path == "/cx/live/auth.json" { return cx_auth(CX_LIVE) }
    if path == "/cx/dead/auth.json" { return cx_auth(CX_DEAD) }
    ""
}

fn cx_disk[T](body fn() Dirs Creds -> T) -> T =>
    with Dirs = effect Dirs {
        list(path) -> []str { [] }
        exists(path) -> bool { path == "/cx/live/auth.json" || path == "/cx/dead/auth.json" }
        is_dir(path) -> bool { path.starts_with("/cx") }
    } {
        with Creds = effect Creds {
            read(path) -> str { cx_text(path) }
        } {
            body()
        }
    }

fn cx_endpoint[T](mut a Asked, raw str, body fn() Http PollLog Creds -> T) -> T =>
    with Http = effect Http {
        send(host, port, secure, request) -> Result[str, HttpError] {
            a.n += 1
            Ok(raw)
        }
    } {
        with PollLog = effect PollLog {
            record(email str, state str, message str, at_ms int) -> () {}
            reading(r Reading) -> () {}
        } {
            with Creds = effect Creds {
                read(path) -> str { cx_text(path) }
            } {
                body()
            }
        }
    }

fn cx_reply() -> str =>
    "HTTP/1.1 200 OK${EOL}Content-Type: application/json${EOL}${EOL}{\"rate_limit\":{\"primary_window\":{\"used_percent\":12,\"limit_window_seconds\":2592000,\"reset_at\":1793000000},\"secondary_window\":null}}"

fn cx_found(folder str) -> []Found {
    ro now = NOW_MS
    ro f = folder
    cx_disk(fn() Dirs Creds -> []Found => found_in([f], now))
}

test "a Codex home is an account keyed codex:<e-mail>, named by the address, which is not an e-mail field" {
    ro f = cx_found("/cx/live")
    assert(f.len() == 1)
    assert(same("key", "codex:me@example.com", f[0].email))
    assert(same("name", "me@example.com", f[0].display_name))
    assert(f[0].codex && !f[0].kimi)
    assert(same("account", "acct-1", f[0].account_id))
    assert(same("state", "ok", if f[0].state == TokenState.Ok { "ok" } else { "other" }))
}

test "a live Codex token is asked once and its month arrives under provider codex; the address stays out of email" {
    mut a = Asked.new()
    ro f = cx_found("/cx/live")
    ro now = NOW_MS
    ro k = cx_endpoint(a, cx_reply(), fn() Http PollLog Creds -> []Known => poll_round(f, [], now, now + 300000, TimeZone.Utc))
    assert(a.n == 1)
    assert(same("state", "ok", k[0].state.to_str()))
    assert(k[0].windows.len() == 1)
    assert(same("kind", "monthly", k[0].windows[0].kind))
    assert(same("provider", "codex", k[0].provider))
    assert(same("email", "", k[0].email))
    assert(same("name", "me@example.com", k[0].display_name))
}

test "a dead Codex token is NOT asked and is NOT renewed; the text says what to do" {
    mut a = Asked.new()
    ro f = cx_found("/cx/dead")
    ro now = NOW_MS
    assert(f[0].state == TokenState.Stale)
    ro k = cx_endpoint(a, cx_reply(), fn() Http PollLog Creds -> []Known => poll_round(f, [], now, now + 300000, TimeZone.Utc))
    assert(a.n == 0)
    assert(same("state", "stale", k[0].state.to_str()))
    assert(same("message", "token expired · start Codex under this login", k[0].message))
    mut renewals = 0
    ro refresh = refresh_cfg(true)
    ro renewed = with Renew = effect Renew {
        kimi(path str, name str, cooldown_sec int) -> bool {
            renewals += 1
            false
        }
        claude(path str, name str, model str, timeout_sec int, cooldown_sec int) -> bool {
            renewals += 1
            false
        }
    } {
        renew_expired(f, refresh)
    }
    assert(!renewed)
    assert(renewals == 0)
}

// ── one round ────────────────────────────────────────────────────────────────

test "a live token is asked once, and its rows arrive; a dead one is NOT asked" {
    mut a = Asked.new()
    ro f = found_now()
    ro now = NOW_MS
    ro k = endpoint(a, reply_ok(), fn() Http PollLog Creds -> []Known => poll_round(f, [], now, now + 300000, TimeZone.Utc))
    // One request for two accounts: the expired one is refused BEFORE the network.
    assert(a.n == 1)
    assert(same("live state", "ok", k[0].state.to_str()))
    assert(k[0].windows.len() == 2)
    assert(k[0].polled_at_ms == NOW_MS)
    assert(same("dead state", "stale", k[1].state.to_str()))
    assert(k[1].message.starts_with("token expired 29 Sep 09:00"))
    assert(k[1].windows.len() == 0)
}

test "a refused round keeps the last good rows and their moment, and says why" {
    mut a = Asked.new()
    ro f = found_now()
    ro now = NOW_MS
    ro first = endpoint(a, reply_ok(), fn() Http PollLog Creds -> []Known => poll_round(f, [], now, now + 300000, TimeZone.Utc))
    ro later = NOW_MS + 300000
    ro second = endpoint(a, reply_429(), fn() Http PollLog Creds -> []Known => poll_round(f, first, later, later + 300000, TimeZone.Utc))
    assert(same("state", "unknown", second[0].state.to_str()))
    // The rows and the moment are the FIRST round's: `unknown` shows them dimmed.
    assert(second[0].windows.len() == 2)
    assert(second[0].polled_at_ms == NOW_MS)
    // 01.1 §3.2's badge: retry = now + Retry-After (09:05 + 120 s), data = the rows' moment.
    assert(same("badge", "429 · retry 09:07 · data 09:00", second[0].message))
}

test "the stale text names the moment in the zone it is given" {
    assert(same("utc", "29 Sep 09:00", expiry_text(NOW_MS - DAY_MS, TimeZone.Utc)))
    assert(same("none", "at an unknown time", expiry_text(0, TimeZone.Utc)))
}

// A settings file with NO [[folders]] is a legal first start (the page's settings
// panel adds them). `--serve` on such a file crashed with 0xC0000005 before it
// listened -- measured 2026-09-30 18:0x; an EMPTY folder did not. This is the round
// with nothing to find, end to end short of the socket.
test "no folders at all: an empty round and an empty body, not a crash" {
    mut a = Asked.new()
    ro now = NOW_MS
    ro found = on_disk(fn() Dirs Creds -> []Found => found_in([], now))
    assert(found.len() == 0)
    ro known = endpoint(a, reply_ok(), fn() Http PollLog Creds -> []Known => poll_round(found, [], now, now + 300000, TimeZone.Utc))
    assert(known.len() == 0)
    assert(a.n == 0)
    ro view = view_of(known, SeverityBounds.new(70, 90), now, now + 300000, "+00:00", TimeZone.Utc)
    assert(view.accounts.len() == 0)
}

// ── the repeating loop (T2.27, 2026-10-01) ───────────────────────────────────

/// What the loop said through `RoundLog`.
type Said {
    mut rounds int
    mut accounts int
    mut looked int
    mut renewed int
}

fn Said.new() -> Said => { rounds: 0, accounts: 0, looked: 0, renewed: 0 }

/// `[refresh]` as the start reads it from the file.
fn refresh_cfg(enabled bool) -> Refresh =>
    { enabled, all_expired: false, claude_model: "m", timeout_sec: 120, cooldown_sec: 3600 }

/// The loop over a store whose channel holds ONE `Tick` and is then closed: the first
/// round runs at once, the tick runs a second, and the closed channel ends the loop --
/// so `store_and_poll` returns and the count can be read.
fn loop_with_one_tick() -> Said => loop_with_refresh(refresh_cfg(true))

fn loop_with_refresh(start Refresh) -> Said {
    mut said = Said.new()
    mut a = Asked.new()
    ro pair = Chan[Envelope].new(4)
    ro store = Store.new(pair.tx)
    assert(store.tick())
    pair.tx.close()
    ro rounds = Rounds.new(["/acc"], 300, SeverityBounds.new(70, 90), TimeZone.Utc, "+00:00", start)
    ro now = NOW_MS
    with Time = fixed_ms(now as u64), Renew = effect Renew {
        kimi(path str, name str, cooldown_sec int) -> bool { false }
        claude(path str, name str, model str, timeout_sec int, cooldown_sec int) -> bool {
            said.renewed += 1
            false
        }
    }, RoundLog = effect RoundLog {
        done(view SnapshotView, conf ConfNow) -> SnapshotView {
            said.rounds += 1
            said.accounts = view.accounts.len()
            view
        }
        settings(held ConfNow, view SnapshotView) -> Settled {
            said.looked += 1
            Settled.new(held, "")
        }
    } {
        on_disk(fn() Dirs Creds -> () => endpoint(a, reply_ok(), fn() Http PollLog Creds -> () => store_and_poll(pair.rx, rounds)))
    }
    said
}

test "the loop runs a round at once and one per tick, saying each through RoundLog" {
    ro said = loop_with_one_tick()
    // Two: the first round (the page must not wait a whole interval for accounts) and
    // the tick's. A loop that forgot `RoundLog.done` after either would write that
    // round to nobody -- the database would miss every second round, or the first.
    assert(said.rounds == 2)
    assert(said.accounts > 0)
}

test "the FIRST round obeys the start's [refresh], before the settings reach the store" {
    // `/acc/old` holds an expired token. With renewal switched off in the file, no round
    // may start Claude Code -- the first one read the store's empty settings, the
    // defaults, and renewed anyway (the stand, 2026-10-02).
    assert(loop_with_refresh(refresh_cfg(false)).renewed == 0)
    // The control: switched on, the expired login is renewed.
    assert(loop_with_refresh(refresh_cfg(true)).renewed > 0)
}

test "after every round the loop looks at the settings file, the first round included" {
    // 01.2 section 2.2: a hand edit is picked up on the next tick. A loop that looked
    // only on ticks would leave the first interval blind; one that never looked would
    // keep a hand-edited file unseen until the first save collided with it.
    ro said = loop_with_one_tick()
    assert(said.looked == said.rounds)
}

/// Three rounds over the loop, the settings changing its folder list between them: what
/// each round's snapshot held. `lists` is what `RoundLog.settings` hands the store after
/// round 1, 2, ...; the start's own list is `["/acc/old"]`.
type Counted {
    mut accounts []int
    mut calls int
}

fn loop_with_folders(lists [][]str) -> []int {
    mut said = Counted{ accounts: [], calls: 0 }
    mut a = Asked.new()
    ro pair = Chan[Envelope].new(4)
    ro store = Store.new(pair.tx)
    assert(store.tick())
    assert(store.tick())
    pair.tx.close()
    ro rounds = Rounds.new(["/acc/old"], 300, SeverityBounds.new(70, 90), TimeZone.Utc, "+00:00", refresh_cfg(false))
    ro now = NOW_MS
    ro plan = lists
    with Time = fixed_ms(now as u64), Renew = effect Renew {
        kimi(path str, name str, cooldown_sec int) -> bool { false }
        claude(path str, name str, model str, timeout_sec int, cooldown_sec int) -> bool { false }
    }, RoundLog = effect RoundLog {
        done(view SnapshotView, conf ConfNow) -> SnapshotView {
            said.accounts.push(view.accounts.len())
            view
        }
        settings(held ConfNow, view SnapshotView) -> Settled {
            ro i = said.calls
            said.calls += 1
            if i >= plan.len() { return Settled.new(held, "") }
            mut c = Config.defaults()
            c.folders = plan[i]
            Settled.new(ConfNow.new(c, "t${i}", held.loaded), "")
        }
    } {
        on_disk(fn() Dirs Creds -> () => endpoint(a, reply_ok(), fn() Http PollLog Creds -> () => store_and_poll(pair.rx, rounds)))
    }
    said.accounts
}

test "a folder saved between rounds gives its account on the next round, and one removed takes its logins away" {
    // Round 1: the start's list, one login. The settings then add `/acc/work` (one more
    // account, `main`); then drop `/acc/old`. A loop that kept the start's list would
    // say 1, 1, 1 -- the stand's "restart to see the folder" (2026-10-02).
    ro got = loop_with_folders([["/acc/old", "/acc/work"], ["/acc/work"]])
    assert(got.len() == 3)
    assert(got[0] == 1)
    assert(got[1] == 2)
    assert(got[2] == 1)
}

test "with the settings unchanged the folder list stays the start's" {
    ro got = loop_with_folders([])
    assert(got.len() == 3 && got[0] == 1 && got[1] == 1 && got[2] == 1)
}

// ── the live stream between rounds (task 7) ──────────────────────────────────

/// A stream that followed the store after its first round, then one tick: what the
/// stream's channel holds once the loop has ended.
fn followed_through_a_round() -> []Event {
    mut a = Asked.new()
    ro pair = Chan[Envelope].new(4)
    ro store = Store.new(pair.tx)
    ro stream = Chan[Event].new(128)
    ro reply = Chan[Followed].new(1)
    // The page opens `/api/events`: the store registers its channel. Queued BEFORE the
    // tick, so the stream is open when that round ends.
    assert(pair.tx.send(Envelope.new(StoreAsk.Follow(-1, Follower.unregistered(stream.tx, stream.rx), reply.tx))))
    assert(store.tick())
    pair.tx.close()
    ro rounds = Rounds.new(["/acc"], 300, SeverityBounds.new(70, 90), TimeZone.Utc, "+00:00", refresh_cfg(false))
    with Time = fixed_ms(NOW_MS as u64), Renew = effect Renew {
        kimi(path str, name str, cooldown_sec int) -> bool { false }
        claude(path str, name str, model str, timeout_sec int, cooldown_sec int) -> bool { false }
    }, RoundLog = effect RoundLog {
        done(view SnapshotView, conf ConfNow) -> SnapshotView { view }
        settings(held ConfNow, view SnapshotView) -> Settled { Settled.new(held, "") }
    } {
        on_disk(fn() Dirs Creds -> () => endpoint(a, reply_ok(), fn() Http PollLog Creds -> () => store_and_poll(pair.rx, rounds)))
    }
    match reply.rx.try_recv() {
        Some(f) => assert(f.id > 0 && f.fresh)
        None => panic("the store never answered the follow")
    }
    mut out []Event = []
    mut more = true
    while more {
        match stream.rx.try_recv() {
            Some(e) => out.push(e)
            None => { more = false }
        }
    }
    out
}

test "an open stream gets the round's snapshot without asking: the event, not a poll" {
    // 01.3 section 3.4: `snapshot` "после каждого опроса". The page shows `live` and
    // stops polling, so a round that told no stream would freeze it on the old numbers.
    ro got = followed_through_a_round()
    assert(got.len() == 1)
    assert(got[0].name == "snapshot")
    // The body is `GET /api/snapshot`'s: the account the round polled is in it.
    assert(got[0].data.contains("\"accounts\":["))
    assert(got[0].data.contains("@example"))
    assert(got[0].id > 0)
}

/// What the ping timer did: the moments it sent, and the waits it asked for.
type Pinged {
    mut ats []str
    mut slept_ms []int
}

test "the keep-alive timer asks the store for a ping every 30 s, and stops when the store is gone" {
    ro pair = Chan[Envelope].new(8)
    ro store = Store.new(pair.tx)
    mut seen = Pinged{ ats: [], slept_ms: [] }
    mut clock_ms = NOW_MS
    with Time = effect Time {
        sleep(d Duration) -> () {
            seen.slept_ms.push(d.millis())
            clock_ms += d.millis()
            // The store goes away during the third wait: the ping after it is refused,
            // and the timer must end rather than spin.
            if seen.slept_ms.len() == 3 { pair.tx.close() }
        }
        now() -> Timestamp => clock_ms.to_unix_millis()
        now_monotonic() -> Monotonic => (clock_ms * 1_000_000).to_monotonic_nanos()
        local_offset_sec() -> int => 0
    } {
        ping_every(store, 30)
    }
    mut more = true
    while more {
        match pair.rx.recv() {
            Some(env) => match env.req {
                StoreAsk.Ping(at) => seen.ats.push(at)
                _ => ()
            }
            None => { more = false }
        }
    }
    assert(seen.slept_ms.len() == 3)
    for ms in seen.slept_ms { assert(ms == 30000) }
    // Two pings, thirty seconds apart, each stamped with the moment it went out.
    assert(seen.ats.len() == 2)
    assert(seen.ats[0] == moment_iso(NOW_MS + 30000))
    assert(seen.ats[1] == moment_iso(NOW_MS + 60000))
}
