// server/start.nv -- what `--serve` decides before it listens (task T2.27).
//
//   ./nova.sh test src/server/ --filter start_test
//
// Source: 01.2 §1 (where the settings live), §2.2 (a missing file is a first start,
// a bad one is reported), 01.3 §1 (loopback only before phase 6), §3.2 (`health`).
//
// ── WHAT IS HERE, AND WHY PRINTING IS NOT ────────────────────────────────────
//
// Every decision of the start is a function here and returns a VALUE: go or refuse,
// with the lines to say. The entry point prints them -- `println` works only in the
// entry module (registry 221.1 #1017, see `version.nv`), and a refusal that is a value
// is also a refusal a test can read.
//
// The environment is read in ONE function, `real_paths_input`, and everything after
// it is pure: which file, which address, whether the settings allow a start at all.
//
// ── NOT HERE YET, AND NAMED ──────────────────────────────────────────────────
//
// * The live snapshot: the store fiber and the pollers are wired in the next step;
//   until then `/api/snapshot` answers an empty picture honestly.
// * History: the database IS opened with its key at the start (storage.startup, since
//   2026-09-30), and `health` reports its schema and `encrypted: true`; no tick is
//   written yet, so `history_days` stays 0 -- what is true of this process.
//   (Since 2026-10-08 `health` is read live: uptime, the last round, the account
//   counts, the login directories and the days in the database -- `health_at`.)
// * Stopping on a signal with `bye` to SSE subscribers: std has no OS signal hook to
//   stop on. Ctrl+C ends the process; the page's live connection reconnects.

module server.start

import std.os.{env, home_dir}
import std.time.duration.{Timestamp}
import std.fs.{try_exists}
import claude_limits.config.{Config, ConfigError, validate, repair_for_start}
import claude_limits.storage.paths.{PathsInput, Paths, join, dir_of}
import claude_limits.storage.config_file.{Loaded}
import claude_limits.server.app.{Sources}
import claude_limits.server.handlers.health.{HealthState}
import claude_limits.server.handlers.snapshot.{SnapshotState, arrange}
import claude_limits.server.handlers.refresh.{RefreshState, RefreshTarget, Kick}
import claude_limits.usage.parse.{moment_ms}
import claude_limits.server.handlers.events.{EventsState, Follow}
import claude_limits.server.handlers.config.{ConfigState, ConfigCommit, FolderView, LoginDirView, AccountFound, tag_of}
import claude_limits.model.store_fiber.{ConfNow}
import claude_limits.server.handlers.folders.{ProbeState, Look}
import claude_limits.server.handlers.token.{TokenEndpointState}
import claude_limits.server.handlers.exporter.{ExportState}
import claude_limits.server.handlers.history.{HistoryAsk, HistoryLoad, HistoryEnv}
import claude_limits.server.dto.{Disclosure, SnapshotView, render_snapshot, is_listed}
import claude_limits.model.store.{Registry}
import claude_limits.config.{render}
import claude_limits.version.{version}

#cfg(target_os = "windows")
fn on_windows() -> bool => true

#cfg(!target_os = "windows")
fn on_windows() -> bool => false

fn env_or(key str) Os -> str => env(key) ?? ""

/// The environment as 01.2 §1 reads it -- the one effectful function of the start.
///
/// `exe` is the program's own path as the system handed it over (`args()[0]`): a
/// `claude-limits.toml` beside it makes the install portable.
export fn real_paths_input(exe str, config_override str) Os Fs -> PathsInput {
    ro win = on_windows()
    ro exe_dir = if exe == "" { "" } else { dir_of(exe, win) }
    ro home = match home_dir() {
        Some(p) => p.display()
        None => ""
    }
    ro beside = join(exe_dir, "claude-limits.toml", win)
    ro portable = exe_dir != "" && (try_exists(beside.to_path()) ?? false)
    ro cfg_override = if config_override != "" { config_override } else { env_or("CLAUDE_LIMITS_CONFIG") }
    {
        windows: win, exe_dir, home,
        appdata: env_or("APPDATA"), local_appdata: env_or("LOCALAPPDATA"),
        xdg_config: env_or("XDG_CONFIG_HOME"), xdg_data: env_or("XDG_DATA_HOME"),
        xdg_state: env_or("XDG_STATE_HOME"),
        portable,
        config_override: cfg_override,
        data_override: env_or("CLAUDE_LIMITS_DATA"),
        log_override: "",
        key_override: env_or("CLAUDE_LIMITS_DB_KEY_FILE"),
    }
}

/// What the start does with the settings it read.
export type Start enum
    /// Serve with these settings; the lines are the repairs made on the way (01.2 §2.2).
    | Go(Config, []str)
    /// Do not start; one line per reason. The exit code is the configuration one.
    | Refuse([]str)

fn line_of(e ConfigError) -> str {
    if e.field == "" { return e.message }
    "${e.field}: ${e.message}"
}

/// Go or refuse, from what `config_file.load` found.
///
/// A MISSING FILE STARTS ON THE DEFAULTS (01.2 §2.2: a first start has no file). A file
/// that does not PARSE refuses: the person wrote something, and serving on defaults
/// would silently ignore it. A file that parses but fails validation refuses too --
/// this is where 01.3 §1 bites: `allow_lan = true`, or a `bind` that is not loopback,
/// stops the start instead of opening a plain-HTTP listener to the network.
export fn decide_start(loaded Loaded) -> Start {
    if loaded.errors.len() > 0 {
        mut lines []str = []
        for e in loaded.errors { lines.push(line_of(e)) }
        return Start.Refuse(lines)
    }
    mut cfg = loaded.cfg
    ro repairs = repair_for_start(cfg)
    ro errs = validate(cfg)
    if errs.len() > 0 {
        mut lines []str = []
        for e in errs { lines.push(line_of(e)) }
        return Start.Refuse(lines)
    }
    Start.Go(cfg, repairs)
}

/// What the start did with the database, as `health` reports it.
export type DbAtStart value {
    ro schema_version int
    ro encrypted bool
    ro size_bytes int
}

/// No database in this process (the tests, and a start that has not opened one).
export fn DbAtStart.none() -> DbAtStart => { schema_version: 0, encrypted: false, size_bytes: 0 }

/// What `/api/health` reads fresh on every request, beside what the start fixed.
export type HealthLive value {
    ro now_ms int
    ro view SnapshotView
    /// `ui.hidden_accounts` as they stand now (the same list `/api/snapshot` applies).
    ro hidden []str
    /// Calendar days the database holds readings for.
    ro days int
}

/// Accounts of the view in `state`, the hidden ones apart: `total` is the sum of the
/// five counts, as the example of 01.3 §3.2 has it.
fn in_state(v SnapshotView, hidden []str, state str) -> int {
    mut n = 0
    for a in v.accounts {
        if a.state == state && !is_listed(hidden, a.order_key()) { n += 1 }
    }
    n
}

fn hidden_count(v SnapshotView, hidden []str) -> int {
    mut n = 0
    for a in v.accounts { if is_listed(hidden, a.order_key()) { n += 1 } }
    n
}

/// Login directories of every account, each counted once (two accounts never share one,
/// but one account may hold several).
fn dirs_in(v SnapshotView) -> int {
    mut seen []str = []
    for a in v.accounts {
        for d in a.dirs {
            ro key = path_key(d.path)
            mut known = false
            for s in seen { if s == key { known = true } }
            if !known { seen.push(key) }
        }
    }
    seen.len()
}

fn uptime_of(started_at str, now_ms int) -> int {
    ro began = moment_ms(started_at)
    if began <= 0 || now_ms < began { return 0 }
    (now_ms - began) / 1000
}

/// `/api/health` of this process (01.3 §3.2): what the start fixed (listener, paths,
/// the database it opened) from `cfg`, `paths` and `db`, and what changes from `live`
/// -- the clock, the store's last round, the settings' hidden list, the history.
export fn health_at(cfg Config, paths Paths, started_at str, db DbAtStart, live HealthLive) -> HealthState => {
    app_version: version(),
    started_at,
    uptime_sec: uptime_of(started_at, live.now_ms),
    bind: cfg.server.bind,
    port: cfg.server.port,
    allow_lan: cfg.server.allow_lan,
    tls: false,
    poll_interval_sec: cfg.poll.interval_sec,
    poll_last_at: live.view.fetched_at,
    poll_next_at: live.view.next_poll_at,
    sse_clients: 0,
    accounts_total: live.view.accounts.len(),
    accounts_ok: in_state(live.view, live.hidden, "ok"),
    accounts_stale: in_state(live.view, live.hidden, "stale"),
    accounts_unknown: in_state(live.view, live.hidden, "unknown"),
    accounts_error: in_state(live.view, live.hidden, "error"),
    accounts_hidden: hidden_count(live.view, live.hidden),
    login_dirs: dirs_in(live.view),
    config_path: paths.config_file,
    db_path: paths.db_file,
    db_size_bytes: db.size_bytes,
    schema_version: db.schema_version,
    history_days: live.days,
    encrypted: db.encrypted,
    key_store: "file",
    widget_enabled: false,
    widget_running: false,
    config_error: "",
    disclosure: Disclosure.Loopback,
}

fn live_of(now_ms int, view SnapshotView, hidden []str, days int) -> HealthLive => { now_ms, view, hidden, days }

/// The clock and the history are read here, per request, for the reason
/// `history_env_now` gives; the view and the hidden list are the store's.
fn health_now(cfg Config, paths Paths, started_at str, db DbAtStart, v SnapshotView, c ConfNow, days fn() -> int) Time -> HealthState {
    ro now_ms = Time.now().unix_millis() as int
    health_at(cfg, paths, started_at, db, live_of(now_ms, v, c.cfg.ui.hidden_accounts, days()))
}

// ── the sources of the first release's router ───────────────────────────────
//
// Each literal lives in a named function and the lambdas only call them: a record
// literal inside a closure is typed as the ENCLOSING literal's type (registry 221.1
// #1392).

/// The snapshot handler's state around a body: the person's order and hidden list from
/// the settings (01.3 §3.3 applies them per request, in `snapshot.arrange`).
fn snapshot_around(v SnapshotView, cfg Config, tag str) -> SnapshotState => {
    view: v, order: cfg.ui.accounts_order, hidden: cfg.ui.hidden_accounts, config_etag: tag,
    disclosure: Disclosure.Loopback,
}

fn refresh_target(id str, email str, state str, last_poll_ms int) -> RefreshTarget => { id, email, state, last_poll_ms }

/// What the refresh button may ask for: every account of the snapshot as it stands,
/// with the moment it was last polled. It was an EMPTY list until 2026-10-02, and the
/// button answered `429 too_soon` to every press.
/// The clock is read here, per request, for the reason `history_env_now` gives.
fn refresh_now(cfg Config, v SnapshotView) Time -> RefreshState {
    ro now_ms = Time.now().unix_millis() as int
    mut targets []RefreshTarget = []
    for a in v.accounts {
        ro last = if a.polled_at == "" { 0 } else { moment_ms(a.polled_at) }
        targets.push(refresh_target(a.id, a.email, a.state, last))
    }
    refresh_state(now_ms, cfg.poll.min_interval_sec, targets)
}

fn refresh_state(now_ms int, floor_sec int, targets []RefreshTarget) -> RefreshState => { now_ms, floor_sec, targets }

/// `/api/events` opens with the body `GET /api/snapshot` gives (01.3 §3.4: "тело §3.3
/// целиком"), arranged by the same settings.
///
/// IT SENT `{}` UNTIL 2026-10-02, and the page took it at its word: every open of the
/// stream replaced the accounts with an empty list ("no logins found") until the next
/// poll, ten seconds later -- on load, and again on every reconnect. The stream still
/// ends after this first event (the channel loop is T2.13's), so the page then polls,
/// and says `polling`; what it shows is now the truth.
fn events_now(s SnapshotState, follow Follow) -> EventsState =>
    { reg: Registry.new(), snapshot_body: render_snapshot(arrange(s.view, s.order, s.hidden, false), s.disclosure), rest: [], follow }

/// The snapshot's order and hidden list come from the settings AS THEY STAND: a saved
/// `ui` change is live at once (01.3 §3.8), and a page that kept the start's order
/// after a `200` would contradict the reply it just got.
fn snapshot_now(v SnapshotView, c ConfNow) -> SnapshotState => snapshot_around(v, c.cfg, c.tag)

export fn config_now(c ConfNow, paths Paths, v SnapshotView) -> ConfigState => {
    cfg: c.cfg, etag: c.tag, path: paths.config_file, portable: paths.portable,
    folders: folders_seen(c.cfg, v), accounts_found: accounts_seen(c.cfg, v),
    disclosure: Disclosure.Loopback,
}

/// A path for COMPARING, never for showing: one separator, no trailing one.
fn path_key(p str) -> str {
    mut s = p.replace("\\", "/")
    while s.byte_len() > 1 && s.ends_with("/") { s = s[..s.byte_len() - 1] }
    s
}

fn parent_key(p str) -> str =>
    match path_key(p).rsplit_once("/") {
        Some(pair) => pair.0
        None => ""
    }

fn login_dir(id str, name str) -> LoginDirView => { id, name }

fn folder_view(path str, kind str, dirs []LoginDirView, problem str) -> FolderView =>
    { id: "", path, kind, source: "config", login_dirs: dirs, problem }

/// The configured folders as 01.3 §3.7 shows them, from what the last round found.
///
/// `single` -- a login IS the folder; `parent` -- logins one level down; `empty` --
/// none. The `id` is empty ON PURPOSE: folder ids come from the database (01.2 §3.1)
/// and `PUT` refuses a reference by id for now, so the page must refer to a folder by
/// its path, which it does when there is no id.
///
/// Before the first round there is nothing to judge by, and a folder is then shown
/// without the "nothing here" warning: the warning would be a claim nobody checked.
export fn folders_seen(cfg Config, v SnapshotView) -> []FolderView {
    ro looked = v.fetched_at != ""
    mut out []FolderView = []
    for f in cfg.folders {
        ro key = path_key(f)
        mut dirs []LoginDirView = []
        mut single = false
        for a in v.accounts {
            for d in a.dirs {
                if path_key(d.path) == key {
                    single = true
                    dirs.push(login_dir(d.id, d.name))
                } else if parent_key(d.path) == key {
                    dirs.push(login_dir(d.id, d.name))
                }
            }
        }
        ro kind = if single { "single" } else if dirs.len() > 0 { "parent" } else { "empty" }
        ro problem = if looked && dirs.len() == 0 { "no .credentials.json here" } else { "" }
        out.push(folder_view(f, kind, dirs, problem))
    }
    out
}

fn found_account(id str, email str, org str, dirs []LoginDirView, hidden bool) -> AccountFound =>
    { id, email, org, dirs, hidden }

/// Every account the last round found (01.3 §3.7 `accounts_found`), hidden ones too:
/// the panel is where a person un-hides them.
export fn accounts_seen(cfg Config, v SnapshotView) -> []AccountFound {
    mut out []AccountFound = []
    for a in v.accounts {
        mut dirs []LoginDirView = []
        for d in a.dirs { dirs.push(login_dir(d.id, d.name)) }
        mut hidden = false
        for h in cfg.ui.hidden_accounts {
            if h.to_ascii_lower() == a.email.to_ascii_lower() { hidden = true }
        }
        out.push(found_account(a.id, a.email, a.org, dirs, hidden))
    }
    out
}

/// The settings a start hands the store: what `decide_start` let through, tagged the
/// way `GET /api/config` tags them, with the file they were read from -- the next save
/// compares its `mtime_ns` and keeps its text.
export fn conf_at_start(cfg Config, loaded Loaded) -> ConfNow => ConfNow.new(cfg, tag_of(render(cfg)), loaded)

fn token_now(c ConfNow) -> TokenEndpointState => token_at_start(c.cfg, c.tag)

fn probe_at_start(now_ms int) -> ProbeState => { now_ms, listed: [], known: [], disclosure: Disclosure.Loopback }

fn token_at_start(cfg Config, tag str) -> TokenEndpointState => { cfg, etag: tag, disclosure: Disclosure.Loopback }

fn export_at_start() -> ExportState => { from_day: "", to_day: "", rows: [], disclosure: Disclosure.Loopback }

/// The clock and the bound the history ask is judged against -- read PER REQUEST.
///
/// It was the START until 2026-10-01, on the reasoning that nothing newer than the
/// start was in the database. That was wrong the moment the round wrote anything: the
/// round runs AFTER the start moment is taken, so its ticks and its discovery are all
/// newer than it, and a range ending at the start excluded every row the first round
/// wrote. The smoke caught it: the directory was in the database, its journal row was
/// not in the answer.
///
/// `Time` is declared here and the route's lambda only calls this function; the
/// module imports `std.time.duration` for it -- without that import `Time.now()`
/// panics in codegen (`E_CODEGEN_TYPE_UNKNOWN ... method=now`) instead of naming
/// what is missing (registry 221.1 #1537, `probes/time-now-without-import/`).
fn history_env_now(keep_days int) Time -> HistoryEnv => { now_ms: Time.now().unix_millis() as int, keep_days }

/// Everything the router reads.
///
/// `current` hands over the snapshot body as it stands -- in the binary, the store's
/// (`store.view()`, computed by the poller at the moment of its round); in a test,
/// whatever body the test wants the page to get.
///
/// TWO KINDS OF SETTINGS, ON PURPOSE. `conf` is the settings as they stand -- in the
/// binary, the store's, which a saved `PUT /api/config` replaces -- and every reader of
/// the person's choices reads it per request: the settings, the snapshot's order, the
/// token endpoint's tag. `cfg` is what this process STARTED on, and `health` and the
/// refresh floor keep it: a new port or poll interval is in force from the next start
/// (the reply said `restart_required`), and `health` reporting the new port would
/// describe a listener that does not exist.
export fn sources_at_start(cfg Config, paths Paths, started_at str, now_ms int, db DbAtStart, current fn() -> SnapshotView,
                           history fn(HistoryAsk) -> HistoryLoad, conf fn() -> ConfNow, commit ConfigCommit,
                           follow Follow, look Look, kick Kick, days fn() -> int) -> Sources {
    ro keep = cfg.history.keep_days
    Sources.new(
        fn() -> HealthState => health_now(cfg, paths, started_at, db, current(), conf(), days),
        fn() -> SnapshotState => snapshot_now(current(), conf()),
        fn() -> RefreshState => refresh_now(cfg, current()),
        kick,
        fn() -> EventsState => events_now(snapshot_now(current(), conf()), follow),
        fn() -> ConfigState => config_now(conf(), paths, current()),
        commit,
        fn() -> ProbeState => probe_at_start(now_ms),
        look,
        fn() -> TokenEndpointState => token_now(conf()),
        fn() -> ExportState => export_at_start(),
        history,
        fn() -> HistoryEnv => history_env_now(keep),
    )
}
