/// The endpoint (README §Endpoint; the header it needs is in `usage.fetch`).
export fn usage_host() -> str => "api.anthropic.com"
export fn usage_path() -> str => "/api/oauth/usage"

/// Kimi Code's quota endpoint (the reference's `KIMI_USAGE_URL`).
export fn kimi_host() -> str => "api.kimi.com"
export fn kimi_path() -> str => "/coding/v1/usages"

// ── ids ──────────────────────────────────────────────────────────────────────

fn hex16(h u64) -> str {
    ro digits = "0123456789abcdef"
    mut out = ""
    mut shift = 60
    while shift >= 0 {
        ro nib = ((h >> (shift as u64)) & 0xf) as int
        out = "${out}${digits[nib..nib + 1]}"
        shift -= 4
    }
    out
}

fn fnv_of(text str) -> u64 {
    mut st = Fnv64.new()
    st.update(text.bytes())
    st.finalize()
}

/// A stable UUID (version 8, variant 10) for `key` in the namespace `kind`.
export fn stable_id(kind str, key str) -> str {
    ro a = hex16(fnv_of("${kind}/a/${key}"))
    ro b = hex16(fnv_of("${kind}/b/${key}"))
    // Version nibble 8 at position 12; variant `8` (binary 10xx) at position 16.
    "${a[..8]}-${a[8..12]}-8${a[13..16]}-8${b[1..4]}-${b[4..16]}"
}

// ── what the folders hold ───────────────────────────────────────────────────

/// One account as the folders describe it.
export type Found value {
    ro email str
    ro org str
    ro dirs []DirView
    ro state TokenState
    ro expires_at_ms int
    /// The credentials file to ask with; "" when none of its directories has one.
    ro cred_path str
    /// Directories whose token is dead, named beside a live account.
    ro expired_dirs []str
    ro display_name str
    /// A Kimi Code login: `email` is then the key `kimi:<name>`, not an address.
    ro kimi bool
    /// A Codex login: `email` is then the key `codex:<address>`, not an address.
    ro codex bool
    /// The ChatGPT account a Codex login is asked about; "" for the others.
    ro account_id str
    /// A ZCode login: `email` is then the key `zcode:<address>`, not an address (plan 01.8).
    ro zcode bool
    /// A Qoder login: `email` is then the key `qoder:<address>`, not an address (task 035).
    ro qoder bool
    /// The machine id a Qoder store is keyed by; "" for the others. The poll's
    /// cipher key comes from it (task 035).
    ro machine_id str
    /// Why the Qoder or ZCode store would not open; "" when it did or for the
    /// others. Shown instead of numbers: a wrong key must be visible.
    ro broken str
    /// The ZCode store's secret, resolved once at discovery (the environment is not an
    /// effect of the poll); "" for the others.
    ro store_secret str
    /// The plan's burn, read from the app's own log at discovery (`zcode_home`):
    /// the real meter, when the running app has logged one. The polled MCP meter
    /// stays 0 on a start plan, and the balance endpoint needs a jwt only the app
    /// holds fresh -- the log is the honest local source (plan 01.8).
    ro burn bool
    ro burn_pct int
    ro burn_reset_ms int
    ro burn_plan_name str
    ro burn_plan_ends_ms int
    ro burn_span_sec int
}

/// A Kimi or Codex token a minute from expiry is already stale, as a Claude one is.
const KIMI_GUARD_MS = 60_000

fn expiry_state(has_token bool, expires_at_ms int, now_ms int) -> TokenState {
    if !has_token { return TokenState.NoToken }
    if expires_at_ms != 0 && expires_at_ms <= now_ms + KIMI_GUARD_MS { return TokenState.Stale }
    TokenState.Ok
}

fn kimi_found(k KimiLogin, now_ms int) -> Found => {
    email: "kimi:${k.name}", org: "", dirs: [DirView { id: stable_id("dir", k.home), path: k.home, name: leaf(k.home) }],
    state: expiry_state(k.has_token, k.expires_at_ms, now_ms), expires_at_ms: k.expires_at_ms, cred_path: k.path, expired_dirs: [],
    display_name: k.name, kimi: true, codex: false, account_id: "", zcode: false, qoder: false, machine_id: "", broken: "", store_secret: "", burn: false, burn_pct: 0, burn_reset_ms: 0, burn_plan_name: "", burn_plan_ends_ms: 0, burn_span_sec: 0,
}

fn codex_found(c CodexLogin, now_ms int) -> Found => {
    email: "codex:${c.name}", org: "", dirs: [DirView { id: stable_id("dir", c.home), path: c.home, name: leaf(c.home) }],
    state: expiry_state(c.has_token, c.expires_at_ms, now_ms), expires_at_ms: c.expires_at_ms, cred_path: c.path, expired_dirs: [],
    display_name: c.name, kimi: false, codex: true, account_id: c.account_id, zcode: false, qoder: false, machine_id: "", broken: "", store_secret: "", burn: false, burn_pct: 0, burn_reset_ms: 0, burn_plan_name: "", burn_plan_ends_ms: 0, burn_span_sec: 0,
}

fn zcode_found(z ZcodeLogin, zsec str) -> Found => {
    email: "zcode:${z.name}", org: "", dirs: [DirView { id: stable_id("dir", z.home), path: z.home, name: leaf(z.home) }],
    // No expiry is knowable: the store's jwt carries no `exp` (plan 01.8). A home
    // that will not open is a login with a message, not a missing account.
    state: if z.has_token { TokenState.Ok } else { TokenState.NoToken }, expires_at_ms: 0, cred_path: z.path, expired_dirs: [],
    display_name: z.name, kimi: false, codex: false, account_id: "", zcode: true, qoder: false, machine_id: "", broken: z.broken, store_secret: zsec, burn: z.burn, burn_pct: z.burn_pct, burn_reset_ms: z.burn_reset_ms, burn_plan_name: z.burn_plan_name, burn_plan_ends_ms: z.burn_plan_ends_ms, burn_span_sec: z.burn_span_sec,
}

/// A Qoder home (task 035): `cred_path` is the encrypted `.auth/user` (the
/// marker is only the identity), and the machine id rides along -- the poll's
/// cipher key is the home's own, there is no secret to resolve.
fn qoder_found(q QoderLogin) -> Found => {
    email: "qoder:${q.name}", org: "", dirs: [DirView { id: stable_id("dir", q.home), path: q.home, name: leaf(q.home) }],
    // No expiry is knowable: the store carries none, like ZCode's. A home that
    // will not open is a login with a message, not a missing account.
    state: if q.has_token { TokenState.Ok } else { TokenState.NoToken }, expires_at_ms: 0, cred_path: qoder_store_path(q.home), expired_dirs: [],
    display_name: q.name, kimi: false, codex: false, account_id: "", zcode: false, qoder: true, machine_id: q.machine_id, broken: q.broken, store_secret: "", burn: false, burn_pct: 0, burn_reset_ms: 0, burn_plan_name: "", burn_plan_ends_ms: 0, burn_span_sec: 0,
}

/// Codex's usage endpoint (the reference's `CODEX_USAGE_URL`).
export fn codex_host() -> str => "chatgpt.com"
export fn codex_path() -> str => "/backend-api/wham/usage"

/// ZCode's endpoints (plan 01.8, amendment 2026-10-31). The PAID plan's windows
/// (5 hours, weekly) live on api.z.ai and take ONE bearer -- the OAuth access
/// token the credentials file holds. The promo plan's burn and name come from the
/// app's log, without a request.
export fn zcode_host() -> str => "api.z.ai"
export fn zcode_path() -> str => "/api/monitor/usage/quota/limit"

/// Qoder's endpoint (task 035): openapi.qoder.sh, the reference's default
/// `QODER_BASE_URL`. The reference also honours the env override; the feed's
/// round is Os-free by its red test, so the host here is the constant one (the
/// divergence is recorded in the task's plan).
export fn qoder_host() -> str => "openapi.qoder.sh"

/// The line under an account that is asked with one directory's token while others
/// have expired -- the reference's "(4px, MGTS: token expired on disk)". Nothing to
/// fix urgently: Claude Code renews a token when that login is next used.
export fn expired_note(names []str) -> str =>
    if names.len() == 0 { "" } else { "${names.join(", ")}: token expired on disk" }

fn cred_of(dirs []LoginDir, path str) -> str {
    for d in dirs {
        if d.path == path && d.credentials != "" { return d.credentials }
    }
    ""
}

/// Every account in the configured folders, grouped by e-mail (plan 01 §0).
/// `zsec` is the ZCode store's secret, resolved by the caller (`zcode_store_secret`,
/// plan 01.8); "" disables the ZCode homes.
export fn found_in(folders []str, now_ms int, zsec str) Dirs Creds -> []Found {
    mut seen []LoginDir = []
    mut logins []Login = []
    for f in folders {
        for d in scan(f).logins {
            seen.push(d)
            logins.push(read_login(d.path, short_name(d.path, d.name), d.identity, d.credentials))
        }
    }
    mut out []Found = []
    for acc in group(logins, now_ms) {
        mut dirs []DirView = []
        // The LIVE directory's credentials first: the first directory found may hold an
        // expired token, and asking with it is the 401 the rules forbid.
        mut cred = if acc.live_path != "" { cred_of(seen, acc.live_path) } else { "" }
        mut i = 0
        while i < acc.dirs.len() {
            ro path = acc.paths[i]
            dirs.push(DirView { id: stable_id("dir", path), path, name: acc.dirs[i] })
            if cred == "" { cred = cred_of(seen, path) }
            i += 1
        }
        out.push(Found { email: acc.email, org: acc.org, dirs, state: acc.state, expires_at_ms: acc.expires_at_ms, cred_path: cred,
                         expired_dirs: acc.expired_dirs, display_name: acc.display_name, kimi: false, codex: false, account_id: "", zcode: false, qoder: false, machine_id: "", broken: "", store_secret: "", burn: false, burn_pct: 0, burn_reset_ms: 0, burn_plan_name: "", burn_plan_ends_ms: 0, burn_span_sec: 0 })
    }
    // Kimi Code homes in the same folders (plan 01.6, П3): one account per credentials
    // file. A file reached through two folders is one account, not two.
    for f in folders {
        for k in kimi_logins_at(f) {
            mut dup = false
            for o in out { if o.email == "kimi:${k.name}" { dup = true } }
            if !dup { out.push(kimi_found(k, now_ms)) }
        }
    }
    // Codex homes likewise (plan 01.7): one account per `auth.json`, keyed by its e-mail.
    for f in folders {
        for c in codex_logins_at(f) {
            mut dup = false
            for o in out { if o.email == "codex:${c.name}" { dup = true } }
            if !dup { out.push(codex_found(c, now_ms)) }
        }
    }
    // ZCode homes likewise (plan 01.8): one account per `v2/credentials.json`, keyed by
    // its e-mail. The secret arrives resolved; without it the homes are not read.
    if zsec != "" {
        for f in folders {
            for z in zcode_logins_at(f, zsec) {
                mut dup = false
                for o in out { if o.email == "zcode:${z.name}" { dup = true } }
                if !dup { out.push(zcode_found(z, zsec)) }
            }
        }
    }
    // Qoder homes likewise (task 035): one account per home with the status marker,
    // keyed by its e-mail. No secret to resolve -- the key material is the home's own.
    for f in folders {
        for q in qoder_logins_at(f) {
            mut dup = false
            for o in out { if o.email == "qoder:${q.name}" { dup = true } }
            if !dup { out.push(qoder_found(q)) }
        }
    }
    out
}

// ── one round ────────────────────────────────────────────────────────────────

fn two(n int) -> str => if n < 10 { "0${n}" } else { "${n}" }

/// `5 Sep 18:02` -- the moment of 01.1 §3.2's stale text, in `zone`.
export fn expiry_text(at_ms int, zone TimeZone) -> str {
    if at_ms == 0 { return "at an unknown time" }
    ro dt = at_ms.to_unix_millis().to_zoned(zone).datetime()
    ro t = dt.time()
    "${dt.day()} ${dt.month()} ${two(t.hour())}:${two(t.minute())}"
}

fn hhmm(ms int, zone TimeZone) -> str {
    ro t = ms.to_unix_millis().to_zoned(zone).datetime().time()
    "${two(t.hour())}:${two(t.minute())}"
}


/// The badge of an `unknown` account (01.1 §3.2), built from the reply's status: a 429
/// and a dead network are one state and two sentences. `data` is the moment of the
/// rows still shown -- the last good reading.
export fn unknown_message(o Outcome, now_ms int, data_ms int, zone TimeZone) -> str {
    if o.message != "" { return o.message }
    ro retry = hhmm(now_ms + o.retry_after_sec * 1000, zone)
    if o.status == 429 {
        ro data = if data_ms == 0 { "-" } else { hhmm(data_ms, zone) }
        return rate_limited_badge(retry, data)
    }
    if o.status == 0 { return network_badge(retry) }
    "HTTP ${o.status} · retry ${retry}"
}

fn previous(before []Known, id str) -> Option[Known] {
    for k in before {
        if k.id == id { return Some(k) }
    }
    None
}

fn prev_windows(p Option[Known]) -> []Window =>
    match p {
        Some(k) => k.windows
        None => []
    }

fn prev_polled(p Option[Known]) -> int =>
    match p {
        Some(k) => k.polled_at_ms
        None => 0
    }

fn prev_plan(p Option[Known]) -> Option[ZcodePlan] =>
    match p {
        Some(k) => k.plan
        None => None
    }

/// What one round needs besides the moment.
export type Rounds value {
    ro folders []str
    ro interval_sec int
    ro bounds SeverityBounds
    ro zone TimeZone
    ro tz str
    ro refresh Refresh
    /// The ZCode store's secret, resolved once at the start (plan 01.8); "" when the
    /// environment would not give one.
    ro zcode_secret str
}

export fn Rounds.new(folders []str, interval_sec int, bounds SeverityBounds, zone TimeZone, tz str, refresh Refresh, zcode_secret str) -> Rounds =>
    { folders, interval_sec, bounds, zone, tz, refresh, zcode_secret }

/// One round: find the accounts, ask about them, and put the snapshot body -- computed
/// AT THIS MOMENT -- into the store's state. The folders are found again every round:
/// a login added while the server runs appears without a restart.
/// The folders a round looks in: the settings AS THEY STAND, once the start has handed
/// them over; the start's own list before that.
///
/// 01.3 §3.8: "Смена `folders` запускает обнаружение немедленно". A round reading the
/// start's list made a saved folder invisible until a restart -- the owner's stand
/// showed the folder saved and "no .credentials.json here" under it (2026-10-02).
fn folders_now(st StoreState, r Rounds) -> []str =>
    if st.conf.tag == "" { r.folders } else { st.conf.cfg.folders }

/// `[refresh]` by the same rule. The FIRST round runs before the start's settings
/// reach the store, and read the store's empty settings -- the defaults: on the stand
/// `all_expired = true` worked from the second round only (2026-10-02).
fn refresh_now(st StoreState, r Rounds) -> Refresh =>
    if st.conf.tag == "" { r.refresh } else { st.conf.cfg.refresh }

/// Renewing a login's token before the round asks with it (plan 01.6, П4).
export type Renew effect {
    // A Kimi Code login whose token expired: `true` when its file now holds a usable
    // one (renewed, or rotated by another Kimi tool). `cooldown_sec` runs from a failure.
    kimi(path str, name str, cooldown_sec int) -> bool
    // A Claude login directory: run Claude Code there so IT renews the token (П5);
    // `true` when the credentials file was rewritten. `cooldown_sec` runs from any
    // attempt, as the reference's Refresher does.
    claude(path str, name str, model str, timeout_sec int, cooldown_sec int) -> bool
}

/// Renew what `[refresh]` allows; `true` when a file changed and the folders are worth
/// reading again.
///
/// CLAUDE, BY DEFAULT, ONLY WHERE NOTHING CAN BE READ: an account with no live token in
/// any directory. One that still reports through another directory is left alone --
/// silencing its "token expired on disk" note would spend a request on limits that are
/// in nobody's way (the reference's `targets`). `all_expired` takes the other choice.
export fn renew_expired(found []Found, r Refresh) Renew -> bool {
    if !r.enabled { return false }
    mut any = false
    for f in found {
        // Codex's refresh token is single-use: a renewal that missed `auth.json` would sign
        // the Codex CLI out, so a dead Codex login is only reported (plan 01.7). ZCode's
        // store holds no refresh token at all -- reported, never renewed (plan 01.8).
        // Qoder's store likewise (task 035): reported, never renewed.
        if f.codex || f.zcode || f.qoder { continue }
        if f.kimi {
            if f.state == TokenState.Stale && f.cred_path != "" {
                if Renew.kimi(f.cred_path, f.display_name, r.cooldown_sec) { any = true }
            }
            continue
        }
        for d in f.dirs {
            mut expired = f.state == TokenState.Stale
            if !expired && r.all_expired {
                for n in f.expired_dirs { if n == d.name { expired = true } }
            }
            if expired {
                if Renew.claude(d.path, d.name, r.claude_model, r.timeout_sec, r.cooldown_sec) { any = true }
            }
        }
    }
    any
}

fn round(mut st StoreState, before []Known, r Rounds) Http PollLog Creds Dirs Time Renew -> []Known {
    ro now = Time.now().unix_millis()
    ro next = now + r.interval_sec * 1000
    ro first = found_in(folders_now(st, r), now, r.zcode_secret)
    // Read again only when a token was renewed: the state of that login has changed.
    ro found = if renew_expired(first, refresh_now(st, r)) { found_in(folders_now(st, r), now, r.zcode_secret) } else { first }
    ro known = poll_round(found, before, now, next, r.zone)
    st.view = view_of(known, r.bounds, now, next, r.tz, r.zone)
    known
}

/// One round with no store around it: what `--serve` shows until the rounds repeat.
///
/// THE INTERIM SHAPE, AND WHY (2026-09-30). The repeating loop below builds and passes
/// its tests, and in the binary it does not run: a request from a polaris connection
/// fiber to the store in the main fiber never gets its answer (`/api/snapshot` hangs,
/// even with a plain store `run` and no poller), and the timer fiber dies at start
/// ("fiber stack overflow in slot 2", at 4 MB and at 64 MB alike). Both are handed to
/// the compiler registry. Until then `--serve` runs ONE round before it listens and
/// serves that body: the accounts, their token states, and what the endpoint said.
export fn one_round(r Rounds) Http PollLog Creds Dirs Time Renew -> SnapshotView {
    mut st = StoreState.new(Snapshot.empty())
    ro _ = round(st, [], r)
    st.view
}

/// What a round leaves behind, said once the store holds it: `--serve` writes the
/// round's readings and what discovery found to the database here (01.2 section 4:
/// one transaction per tick, written after the round, not during it -- the database is
/// not held open across a network round).
export type RoundLog effect {
    // The round is over: write it down, and hand back the snapshot to keep -- the
    // binary fills the forecasts from the history it has just written (plan 01.6, П1).
    // `conf` is the settings the store holds: the folders and `[forecast]` as they stand.
    done(view SnapshotView, conf ConfNow) -> SnapshotView
    // Between rounds: the settings as they should stand, given what the store holds
    // (01.2 §2.2, "при каждом тике опроса: если `mtime` файла изменился --
    // перечитать"). The answer goes straight into the store's state.
    //
    // AN OPERATION OF THE LOOP, NOT A REQUEST TO THE STORE: the loop IS the store, and
    // a request it sent itself would wait for a reply only it could give. (Plain
    // comments: the parser takes no doc comment on an effect operation.) With the
    // settings comes the `config` event's body when they changed, "" when not:
    // rendering it needs the folders view, which lives a layer up.
    settings(held ConfNow, view SnapshotView) -> Settled
}

/// The settings after a look at the file, and the `config` event to publish ("" for none).
export type Settled value {
    ro conf ConfNow
    ro config_body str
}

export fn Settled.new(conf ConfNow, config_body str) -> Settled => { conf, config_body }

/// The body of a `snapshot` event: `GET /api/snapshot`'s, ordered by the settings the
/// store holds (01.3 §3.4: "тело §3.3 целиком").
fn snapshot_body(st StoreState) -> str =>
    render_snapshot(arrange(st.view, st.conf.cfg.ui.accounts_order, st.conf.cfg.ui.hidden_accounts, false, st.conf.cfg.ui.hide_stale), Disclosure.Loopback)

/// What follows every round: write it, look at the settings file, tell the streams.
fn after_round(mut st StoreState) RoundLog -> () {
    st.view = RoundLog.done(st.view, st.conf)
    ro s = RoundLog.settings(st.conf, st.view)
    st.conf = s.conf
    // nova:allow W_RESULT_DISCARDED -- the event's id matters to the streams, not here
    ro _ = announce(st, "snapshot", snapshot_body(st))
    if s.config_body != "" {
        // nova:allow W_RESULT_DISCARDED -- as above
        ro _c = announce(st, "config", s.config_body)
    }
}

/// The ping timer (01.3 §3.4: "раз в 30 с"): a `Ping` to the store every `every_sec`,
/// until the store is gone. The store sends it to every stream and drops the streams
/// nobody reads any more.
export fn ping_every(store Store, every_sec int) Time -> () {
    loop {
        Time.sleep(every_sec.max(1).to_seconds())
        if !store.ping(moment_iso(Time.now().unix_millis())) { break }
    }
}

/// The timer fiber: a `Tick` every `interval_sec`, until the store is gone.
///
/// Its own fiber because the store loop is busy answering requests between rounds; a
/// `recv` with a timeout would tie the poll interval to the arrival of requests.
export fn tick_every(store Store, interval_sec int) Time -> () {
    ro every = interval_sec.max(1)
    loop {
        Time.sleep(every.to_seconds())
        if !store.tick() { break }
    }
}

/// The store's loop, WITH the poller: `--serve` runs it in its main fiber.
///
/// WHY ONE LOOP AND NOT A POLLER FIBER BESIDE THE STORE. The checker refuses the poll in
/// a `spawn`: D446 traces `poll_round` down to a std string function it counts as a
/// mutation (`str.to_ascii_lower` -> `[]u8.into_str_unchecked`), and the store's own
/// `run` mutates too. So both live here; a timer fiber sends `Tick`, and every other
/// request goes to the store's `step` -- one home for what each request does. A round
/// holds the store for its few requests; the server's readers wait that long.
///
/// The first round runs at once: a page opened right after the start shows accounts,
/// not "nothing yet" for a whole interval.
export fn store_and_poll(rx ChanRx[Envelope], r Rounds) Http PollLog RoundLog Creds Dirs Time Renew -> () {
    mut st = StoreState.new(Snapshot.empty())
    mut before = round(st, [], r)
    after_round(st)
    mut going = true
    while going {
        match rx.recv() {
            None => { going = false }
            Some(env) => match env.req {
                StoreAsk.Tick => {
                    before = round(st, before, r)
                    after_round(st)
                }
                _ => step(st, env.req)
            }
        }
    }
}

/// Ask about every account whose token allows it, and say what is known of the rest.
///
/// A DEAD TOKEN IS NEVER ASKED (plan 01 §0): its account is `stale` with the text that
/// tells a person what to do, and keeps nothing to show. A LIVE one is asked once; a
/// reply that parsed replaces the rows, and anything else keeps the last good rows and
/// their moment -- `unknown` shows them dimmed (01.3 §3.3).
export fn poll_round(found []Found, before []Known, now_ms int, next_ms int, zone TimeZone) Http PollLog Creds -> []Known {
    mut out []Known = []
    for f in found {
        ro id = stable_id("account", f.email)
        ro p = previous(before, id)
        if f.state != TokenState.Ok || f.cred_path == "" {
            ro msg = if f.codex {
                "token expired · start Codex under this login"
            } else if f.zcode {
                // The store holds no refresh token: reported, never renewed (plan 01.8).
                // A store that would not open says so in its own words.
                if f.broken != "" { f.broken } else { "no token · start ZCode under this login" }
            } else if f.qoder {
                // The same shape as ZCode's (task 035): a store that would not
                // decrypt -- another machine's key -- says so in its own words.
                if f.broken != "" { f.broken } else { "no token · start Qoder under this login" }
            } else if f.kimi {
                // No self-refresh yet (plan 01.6, П4): the advice is the reference's
                // with auto-refresh off.
                "token expired · start Kimi Code under this login"
            } else if f.state == TokenState.Stale {
                stale_message(expiry_text(f.expires_at_ms, zone))
            } else {
                "no token · start Claude Code under this login"
            }
            // A ZCode login keeps the plan of its last good reading, as it keeps its
            // rows: the last good shape of the card (plan 01.8). A Qoder one keeps
            // it the same way (task 035).
            mut plan = if f.zcode || f.qoder { prev_plan(p) } else { None }
            // A store that will not open (enc:v2) still shows the burn the app's own
            // log gave at discovery: those numbers are this machine's knowledge, not
            // the store's (task 036) -- the same rescue a failed poll gets, below.
            mut rows []Window = []
            if f.zcode && f.burn {
                mut w = Window.new("plan", "", f.burn_pct, f.burn_reset_ms, "")
                if f.burn_span_sec > 0 { w = w.with_span(f.burn_span_sec) }
                rows = [w]
                plan = Some(ZcodePlan { name: f.burn_plan_name, ends_at_ms: f.burn_plan_ends_ms })
            }
            out.push(shown(f, Known.new(id, address_of(f), f.org, f.dirs, AccountState.Stale, msg, prev_polled(p), 0, rows).with_plan(plan)))
            continue
        }
        ro got = if f.codex { read_codex_token(f.cred_path) } else if f.zcode { read_zcode_jwt(f.cred_path, f.store_secret) } else if f.qoder {
            // The store decrypts with the home's own machine id (task 035); the
            // bearer is wrapped like the others' so the arm below is shared.
            match read_qoder_access(f.cred_path, f.machine_id) {
                Some(t) => Some(Secret.new(t))
                None => None
            }
        } else if f.kimi { read_kimi_token(f.cred_path) } else { read_token(f.cred_path) }
        match got {
            None => {
                ro none_msg = if f.codex { "no token · start Codex under this login" } else if f.zcode { "no token · start ZCode under this login" } else if f.qoder { "no token · start Qoder under this login" } else { "no token · start Claude Code under this login" }
                ro plan = if f.zcode || f.qoder { prev_plan(p) } else { None }
                out.push(shown(f, Known.new(id, address_of(f), f.org, f.dirs, AccountState.Stale, none_msg, prev_polled(p), 0, []).with_plan(plan)))
            }
            Some(consume secret) => {
                ro token = secret.into_secret()
                // ZCode's second bearer is read the same way, from the same store (plan 01.8).
                ro access = if f.zcode {
                    match read_zcode_access(f.cred_path, f.store_secret) {
                        Some(consume s) => s.into_secret()
                        None => ""
                    }
                } else { "" }
                ro target = if f.codex { PollTarget.for_codex(f.email, codex_host(), codex_path(), token, f.account_id) } else if f.zcode { PollTarget.for_zcode(f.email, zcode_host(), zcode_path(), token, access) } else if f.qoder { PollTarget.for_qoder(f.email, qoder_host(), QODER_USAGE_PATH, token) } else if f.kimi { PollTarget.for_kimi(f.email, kimi_host(), kimi_path(), token) } else { PollTarget.new(f.email, usage_host(), 443, true, usage_path(), token) }
                ro r = poll_once(target, now_ms)
                ro fresh = r.outcome.state == AccountState.Ok && r.usage.outcome == PollOutcome.Parsed
                // The polled windows are the PAID plan's (session, weekly_all). The
                // PROMO plan's row and name ride from the app's log when it has one:
                // its meter needs a fresh jwt only the app holds (plan 01.8, amendment).
                // The Qoder plan rides from the poll itself: its best-effort second
                // request already filled `r.usage.plan` (task 035).
                mut windows = r.usage.windows
                mut plan Option[ZcodePlan] = None
                if f.qoder {
                    plan = r.usage.plan
                } else if f.zcode {
                    if f.burn {
                        mut w = Window.new("plan", "", f.burn_pct, f.burn_reset_ms, "")
                        if f.burn_span_sec > 0 { w = w.with_span(f.burn_span_sec) }
                        windows = windows + [w]
                        plan = Some(ZcodePlan { name: f.burn_plan_name, ends_at_ms: f.burn_plan_ends_ms })
                    }
                }
                if fresh {
                    out.push(shown(f, Known.new(id, address_of(f), f.org, f.dirs, AccountState.Ok, expired_note(f.expired_dirs), now_ms, next_ms, windows).with_extra(r.usage.extra).with_plan(plan)))
                } else {
                    ro kept = prev_polled(p)
                    ro kept_plan = if plan.is_some() { plan } else { prev_plan(p) }
                    ro msg = if r.outcome.state == AccountState.Unknown { unknown_message(r.outcome, now_ms, kept, zone) } else { r.outcome.message }
                    // A logged burn is knowledge from THIS machine, not from the failed
                    // request: it stands even when the poll did not (plan 01.8).
                    mut kept_windows = prev_windows(p)
                    if f.zcode && f.burn {
                        mut w = Window.new("plan", "", f.burn_pct, f.burn_reset_ms, "")
                        if f.burn_span_sec > 0 { w = w.with_span(f.burn_span_sec) }
                        kept_windows = kept_windows + [w]
                    }
                    // A Qoder plan that arrived with a failed quota keeps nothing of
                    // itself -- the failed round already falls back to the previous
                    // plan (`kept_plan`), and the fresh one is not shown dimmed (task 035).
                    out.push(shown(f, Known.new(id, address_of(f), f.org, f.dirs, r.outcome.state, msg, kept, next_ms, kept_windows).with_plan(kept_plan)))
                }
            }
        }
    }
    out
}

/// The e-mail a person reads: none for Kimi, Codex, ZCode and Qoder, whose `email`
/// field is only a key.
fn address_of(f Found) -> str => if f.kimi || f.codex || f.zcode || f.qoder { "" } else { f.email }

/// The account as it is shown: its name, and its service.
fn shown(f Found, k Known) -> Known {
    ro named = k.with_name(f.display_name)
    if f.codex { return named.with_provider("codex") }
    if f.zcode { return named.with_provider("zcode") }
    if f.qoder { return named.with_provider("qoder") }
    if f.kimi { named.with_provider("kimi") } else { named }
}
