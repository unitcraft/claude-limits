// T2.29: does std serde write the SAME BYTES the hand writer wrote?
//
// The card's first acceptance line is "bodies before and after are byte-identical",
// and the existing handler tests cannot measure it: they check FRAGMENTS
// (`body.contains(...)`), so a reordered key or a changed spacing would stay green.
// This file keeps the retired hand-written writers as REFERENCES and compares whole
// bodies. A reference is deleted only together with the writer it guards -- never
// before, or the comparison silently becomes serde against serde.
//
// ONE HANDLER PER COMPILATION UNIT: the refresh, token and export references live
// in those handlers' own tests. Importing two handlers here put two private
// `parse_ask` into one CU and the C refused them (registry 221.1 #1097).

module server.serde_parity_test

import std.encoding.serde.{json_encode, Serialize, Serializer, SerError}
import claude_limits.server.json.{quote, field_str, field_str_or_null, field_int, field_bool, field_int_or_null, field_fixed2, field_raw, object, array, array_str}
import claude_limits.server.errors.{ApiError, FieldError, to_json, type_uri}
import claude_limits.server.dto.{Disclosure, render_snapshot, SnapshotView, AccountView, DirView, LimitView, ForecastView, WorstView}
import claude_limits.server.handlers.health.{HealthState, render_health}
import claude_limits.server.routes.{API_VERSION}

// ── problem+json: the retired hand writer, kept verbatim as the reference ──────

fn reference_problem(e ApiError, request_id str, instance str) -> str {
    mut fields = [
        field_str("type", type_uri(e.code)),
        field_str("title", e.title),
        field_int("status", e.status),
        field_str_or_null("detail", e.detail),
        field_str("instance", instance),
        field_str("code", e.code),
        field_str("request_id", request_id),
        field_int_or_null("retry_after", e.retry_after),
    ]
    if e.fields.len() > 0 {
        mut items = []str.new()
        for f in e.fields {
            items.push(object([
                field_str("field", f.field),
                field_str("code", f.code),
                field_str("message", f.message),
            ]))
        }
        fields.push(field_raw("errors", array(items)))
    }
    object(fields)
}

fn every_refusal() -> []ApiError {
    ro two = [
        FieldError.new("poll.interval_sec", "less_than_min", "minimum is 60 s"),
        FieldError.new("a \"quoted\"\\path", "code\n", "tab\there \u{1} é"),
    ]
    [
        ApiError.invalid_body("expected \"poll\"\nand \\ more"),
        ApiError.invalid_parameter("from"),
        ApiError.range_too_large("400 days"),
        ApiError.unauthenticated(),
        ApiError.loopback_only(),
        ApiError.origin_required(),
        ApiError.not_found(),
        ApiError.account_not_found(),
        ApiError.account_stale(),
        ApiError.precondition_failed(),
        ApiError.body_too_large(),
        ApiError.unsupported_media_type(),
        ApiError.precondition_required(),
        ApiError.method_not_allowed("GET, PUT"),
        ApiError.too_soon(60),
        ApiError.too_many_auth_failures(0),
        ApiError.store_busy(),
        ApiError.too_many_subscribers(),
        ApiError.starting(),
        ApiError.internal(),
        ApiError.config_readonly(),
        ApiError.invalid_config(two),
        ApiError.extra_forbidden(two),
        ApiError.invalid_request([]),
    ]
}

test "problem+json: every refusal, byte for byte against the retired hand writer" {
    mut n = 0
    for e in every_refusal() {
        ro rid = "req-${n}"
        assert(show("problem ${e.code}", reference_problem(e, rid, "/api/x?q=\"1\""), to_json(e, rid, "/api/x?q=\"1\"")))
        n += 1
    }
    assert(n == 24)   // the denominator: a list that silently shrank would pass
}

#impl(Serialize)
type Plain value {
    ro name str
    ro count int
    ro on bool
    ro maybe Option[int]
    ro tags []str
}

#impl(Serialize)
type Rate value {
    ro rate_per_hour f64
}

fn show(label str, hand str, serde str) -> bool {
    if hand == serde { return true }
    panic("${label} HAND=${hand} SERDE=${serde}")
}

test "plain fields: strings, ints, bools, null, a list" {
    ro p = Plain{ name: "a \"q\" \\ \n \u{1} é", count: 300, on: true, maybe: None, tags: ["x", ""] }
    ro hand = object([
        field_str("name", p.name),
        field_int("count", p.count),
        field_bool("on", p.on),
        field_int_or_null("maybe", p.maybe),
        field_raw("tags", array_str(p.tags)),
    ])
    ro via = json_encode(p) ?? "<serde error>"
    assert(show("plain", hand, via))
}

fn rate(milli int) -> str => json_encode(Rate{ rate_per_hour: (milli as f64) / 1000.0 }) ?? "<serde error>"

test "fixed-precision numbers come out as the SHORTEST decimal, never float noise" {
    // 01.3 section 0: shares are JSON numbers at 2-3 digits, and its own examples
    // write 2.3 and 2.06 -- trailing zeros are the hand writer's, not the contract's.
    assert(show("2.300", "{\"rate_per_hour\":2.3}", rate(2300)))
    assert(show("2.060", "{\"rate_per_hour\":2.06}", rate(2060)))
    assert(show("0.005", "{\"rate_per_hour\":0.005}", rate(5)))
    assert(show("0.790", "{\"rate_per_hour\":0.79}", rate(790)))
    assert(show("0.070", "{\"rate_per_hour\":0.07}", rate(70)))
    assert(show("1.000", "{\"rate_per_hour\":1}", rate(1000)))
    assert(show("123.450", "{\"rate_per_hour\":123.45}", rate(123450)))
    assert(show("-0.790", "{\"rate_per_hour\":-0.79}", rate(0 - 790)))
    assert(show("0.001", "{\"rate_per_hour\":0.001}", rate(1)))
    assert(show("0.333", "{\"rate_per_hour\":0.333}", rate(333)))
}

// `rename_all` is refused on sums (E_SERDE_ATTRIBUTE_ON_SUM_UNSUPPORTED), so a
// unit-only enum writes its wire name by hand -- one method, the name table
// the hand writer already has.
type Basis enum
    | Clock
    | WorkingHours

fn Basis @serialize[S Serializer](mut s S) -> Result[(), SerError] =>
    s.serialize_str(match @ { Clock => "clock", WorkingHours => "working_hours" })

#impl(Serialize)
type WithBasis value {
    ro basis Basis
}

test "a unit-only enum: how does it land on the wire?" {
    ro via = json_encode(WithBasis{ basis: WorkingHours }) ?? "<serde error>"
    assert(show("enum", "{\"basis\":\"working_hours\"}", via))
}

// ── GET /api/snapshot: the retired hand renderer, kept as the reference ────────
//
// Verbatim but for ONE deliberate change: the two fixed-precision shares go
// through `shortest`, not `field_fixed2`/`field_fixed3`. Section 0 makes them JSON
// numbers and writes them `2.3`/`2.06` in its own examples; `2.300` was the hand
// writer's spelling. The reference says so here, in the one place the difference
// is allowed, so that any OTHER difference still reddens the test.

/// `n` scaled by 10^digits as the SHORTEST decimal: 2300,3 -> "2.3"; 1000,3 -> "1".
fn shortest(n int, digits int) -> str {
    mut scale = 1
    for _ in 0..digits { scale *= 10 }
    ro neg = n < 0
    ro abs = if neg { 0 - n } else { n }
    mut frac = abs % scale
    mut width = digits
    while width > 0 && frac % 10 == 0 {
        frac /= 10
        width -= 1
    }
    ro sign = if neg { "-" } else { "" }
    if width == 0 { return "${sign}${abs / scale}" }
    mut text = "${frac}"
    while text.byte_len() < width { text = "0${text}" }
    "${sign}${abs / scale}.${text}"
}

/// The retired `dto.pii_path`, verbatim: the references below need it, and the
/// module no longer carries it (T2.29).
fn pii_path(d Disclosure, name str, value str) -> str {
    match d {
        Disclosure.Loopback => field_str_or_null(name, value)
        Disclosure.Lan => "${quote(name)}:null"
        Disclosure.Anonymous => "${quote(name)}:null"
    }
}

fn ref_dir(d Disclosure, v DirView) -> str =>
    object([field_str("id", v.id), pii_path(d, "path", v.path), field_str("name", v.name)])

fn ref_account(d Disclosure, a AccountView) -> str {
    mut dirs = []str.new()
    for x in a.dirs { dirs.push(ref_dir(d, x)) }
    object([
        field_str("id", a.id),
        field_str("email", a.email),
        field_str("org", a.org),
        field_str_or_null("display_name", a.display_name),
        field_raw("dirs", array(dirs)),
        field_str("state", a.state),
        field_str_or_null("message", a.message),
        field_str_or_null("polled_at", a.polled_at),
        field_str_or_null("next_poll_at", a.next_poll_at),
        field_bool("locked", a.locked),
        field_bool("at_100", a.at_100),
    ])
}

fn ref_forecast(f ForecastView) -> str =>
    object([
        field_int("percent_at_reset", f.percent_at_reset),
        field_str_or_null("runs_out_at", f.runs_out_at),
        field_raw("rate_per_hour", shortest(f.rate_per_hour_milli, 3)),
        field_str("basis", f.basis),
        field_int("sample_minutes", f.sample_minutes),
        field_str("label", f.label),
        field_bool("warning", f.warning),
    ])

fn ref_limit(l LimitView) -> str {
    ro fc = match l.forecast {
        Some(f) => field_raw("forecast", ref_forecast(f))
        None    => field_raw("forecast", "null")
    }
    object([
        field_str("account_id", l.account_id),
        field_str("kind", l.kind),
        field_str_or_null("model", l.model),
        field_str("label", l.label),
        field_int("percent", l.percent),
        field_str("severity", l.severity),
        field_str("server_severity", l.server_severity),
        field_bool("locked", l.locked),
        field_str_or_null("locked_reason", l.locked_reason),
        field_bool("active", l.active),
        field_str("resets_at", l.resets_at),
        field_int("seconds_left", l.seconds_left),
        field_str("reset_label", l.reset_label),
        field_int("window_sec", l.window_sec),
        field_raw("elapsed_share", shortest(l.elapsed_share_hundredths, 2)),
        fc,
    ])
}

fn ref_snapshot(v SnapshotView, d Disclosure) -> str {
    mut accounts = []str.new()
    for a in v.accounts { accounts.push(ref_account(d, a)) }
    mut limits = []str.new()
    for l in v.limits { limits.push(ref_limit(l)) }
    ro worst = match v.worst {
        Some(w) => field_raw("worst", object([
            field_str("account_id", w.account_id),
            field_str("kind", w.kind),
            field_int("percent", w.percent),
            field_str("severity", w.severity),
        ]))
        None    => field_raw("worst", "null")
    }
    object([
        field_str("fetched_at", v.fetched_at),
        field_str_or_null("next_poll_at", v.next_poll_at),
        field_str("tz", v.tz),
        field_bool("restored", v.restored),
        worst,
        field_raw("accounts", array(accounts)),
        field_raw("limits", array(limits)),
    ])
}

test "the reference's own number spelling is what section 0 writes" {
    assert(shortest(2300, 3) == "2.3")
    assert(shortest(2060, 3) == "2.06")
    assert(shortest(5, 3) == "0.005")
    assert(shortest(1000, 3) == "1")
    assert(shortest(79, 2) == "0.79")
    assert(shortest(7, 2) == "0.07")
    assert(shortest(0, 2) == "0")
    assert(shortest(0 - 79, 2) == "-0.79")
}

fn sample_snapshot() -> SnapshotView {
    ro fc = ForecastView{ percent_at_reset: 103, runs_out_at: "2026-09-09T09:30:00Z",
        rate_per_hour_milli: 2060, basis: "working_hours", sample_minutes: 2160,
        label: "ends Tue ~12:30 (2d 17h)", warning: true }
    ro calm = ForecastView{ percent_at_reset: 11, runs_out_at: "", rate_per_hour_milli: 2300,
        basis: "clock", sample_minutes: 60, label: "\u{2192} 11% at reset", warning: false }
    {
        fetched_at: "2026-09-06T18:10:00Z", next_poll_at: "", tz: "Europe/Moscow",
        restored: true,
        worst: Some(WorstView{ account_id: "a1", kind: "weekly_all", percent: 74, severity: "warning" }),
        accounts: [
            AccountView{ id: "a1", email: "main@example.com", org: "Tech \"Center\"",
                dirs: [DirView{ id: "d1", path: "C:\\Users\\me\\.claude", name: ".claude" },
                       DirView{ id: "d2", path: "", name: "empty" }],
                state: "ok", message: "", polled_at: "2026-09-06T18:09:00Z",
                next_poll_at: "2026-09-06T18:14:00Z", locked: false, display_name: "", at_100: false },
            AccountView{ id: "a2", email: "work@example.org", org: "",
                dirs: [], state: "error", message: "HTTP 401: token\nrejected",
                polled_at: "", next_poll_at: "", locked: true, display_name: "", at_100: true },
        ],
        limits: [
            LimitView{ account_id: "a1", kind: "session", model: "", label: "session 5h",
                percent: 12, severity: "ok", server_severity: "", locked: false,
                locked_reason: "", active: true, resets_at: "2026-09-06T20:50:00Z",
                seconds_left: 9600, reset_label: "20:50 (2h 40m)", window_sec: 18000,
                elapsed_share_hundredths: 79, forecast: Some(calm) },
            LimitView{ account_id: "a1", kind: "weekly_scoped", model: "Fable", label: "Fable 7d",
                percent: 74, severity: "warning", server_severity: "warning", locked: false,
                locked_reason: "", active: false, resets_at: "2026-09-09T10:00:00Z",
                seconds_left: 230000, reset_label: "Tue 13:00 (2d 16h)", window_sec: 604800,
                elapsed_share_hundredths: 7, forecast: Some(fc) },
            LimitView{ account_id: "a2", kind: "weekly_all", model: "", label: "week 7d",
                percent: 100, severity: "critical", server_severity: "critical", locked: true,
                locked_reason: "usage_limit_reached", active: false, resets_at: "2026-09-10T00:00:00Z",
                seconds_left: 0, reset_label: "now", window_sec: 604800,
                elapsed_share_hundredths: 100, forecast: None },
        ],
    }
}

test "GET /api/snapshot: whole body, every disclosure level, against the reference" {
    ro v = sample_snapshot()
    ro empty SnapshotView = { fetched_at: "", next_poll_at: "", tz: "", restored: false,
        worst: None, accounts: [], limits: [] }
    mut n = 0
    // Annotated: `for d in [Disclosure.Loopback, ...]` inline passes `check` and the
    // codegen types the literal as unit ("cannot resolve iterator type ... 'nova_unit'").
    ro levels []Disclosure = [Disclosure.Loopback, Disclosure.Lan, Disclosure.Anonymous]
    for d in levels {
        assert(show("snapshot", ref_snapshot(v, d), render_snapshot(v, d)))
        assert(show("empty snapshot", ref_snapshot(empty, d), render_snapshot(empty, d)))
        n += 1
    }
    assert(n == 3)
}

// -- GET /api/health: the retired hand renderer, kept verbatim as the reference --

fn ref_health(st HealthState) -> str {
    match st.disclosure {
        Disclosure.Anonymous => object([field_bool("ok", true), field_int("api_version", API_VERSION)])
        _ => ref_health_full(st)
    }
}

fn ref_health_full(st HealthState) -> str {
    ro lan = match st.disclosure {
        Disclosure.Lan => true
        _ => false
    }
    ro app_version = if lan { "${"\"app_version\""}:null" } else { field_str("app_version", st.app_version) }
    object([
        field_bool("ok", true),
        field_int("api_version", API_VERSION),
        app_version,
        field_str("started_at", st.started_at),
        field_int("uptime_sec", st.uptime_sec),
        field_raw("listen", object([
            field_str("bind", st.bind),
            field_int("port", st.port),
            field_bool("allow_lan", st.allow_lan),
            field_bool("tls", st.tls),
        ])),
        field_raw("poll", object([
            field_int("interval_sec", st.poll_interval_sec),
            field_str_or_null("last_at", st.poll_last_at),
            field_str_or_null("next_at", st.poll_next_at),
        ])),
        field_int("sse_clients", st.sse_clients),
        field_raw("accounts", object([
            field_int("total", st.accounts_total),
            field_int("ok", st.accounts_ok),
            field_int("stale", st.accounts_stale),
            field_int("unknown", st.accounts_unknown),
            field_int("error", st.accounts_error),
            field_int("hidden", st.accounts_hidden),
        ])),
        field_int("login_dirs", st.login_dirs),
        field_raw("storage", object([
            pii_path(st.disclosure, "config_path", st.config_path),
            pii_path(st.disclosure, "db_path", st.db_path),
            field_int("db_size_bytes", st.db_size_bytes),
            field_int("schema_version", st.schema_version),
            field_int("history_days", st.history_days),
            field_bool("encrypted", st.encrypted),
            field_str("key_store", st.key_store),
        ])),
        field_raw("widget", object([
            field_bool("enabled", st.widget_enabled),
            field_bool("running", st.widget_running),
        ])),
        field_str_or_null("config_error", st.config_error),
    ])
}

fn health_at(d Disclosure, filled bool) -> HealthState => {
    app_version: if filled { "0.1.0-dev" } else { "" },
    started_at: "2026-09-06T18:00:00Z", uptime_sec: 600,
    bind: "127.0.0.1", port: 7391, allow_lan: false, tls: false,
    poll_interval_sec: 300,
    poll_last_at: if filled { "2026-09-06T18:05:00Z" } else { "" },
    poll_next_at: if filled { "2026-09-06T18:10:00Z" } else { "" },
    sse_clients: 2,
    accounts_total: 3, accounts_ok: 1, accounts_stale: 1, accounts_unknown: 0,
    accounts_error: 1, accounts_hidden: 0, login_dirs: 4,
    config_path: if filled { "C:\\Users\\me\\claude-limits.toml" } else { "" },
    db_path: if filled { "C:\\Users\\me\\data\\\"db\".duckdb" } else { "" },
    db_size_bytes: 1048576, schema_version: 1, history_days: 30,
    encrypted: true, key_store: "file",
    widget_enabled: false, widget_running: false,
    config_error: if filled { "[poll] interval_sec must be a number\nline 3" } else { "" },
    disclosure: d,
}

test "GET /api/health: whole body, every level, filled and empty, against the reference" {
    ro levels []Disclosure = [Disclosure.Loopback, Disclosure.Lan, Disclosure.Anonymous]
    mut n = 0
    for d in levels {
        for filled in [true, false] {
            ro st = health_at(d, filled)
            assert(show("health", ref_health(st), render_health(st)))
            n += 1
        }
    }
    assert(n == 6)
}

