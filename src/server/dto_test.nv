// Tests for server/dto.nv -- the value rules every serde-written body shares.
//
//   ./nova.sh test src/server/ --filter dto
//
// T2.29 retired the hand-written field helpers (pii_path, pii_path_list, labelled,
// labelled_str, body); nothing in the server called them any more. The PROPERTIES
// their tests guarded did not retire with them -- they now live in `shown_path` and
// `opt`, which every handler uses, and are pinned here.

module server.dto_test

import dto.{Disclosure, shown_path, opt}
import std.encoding.serde.{json_encode, Serialize}

#impl(Serialize)
type OnePath value {
    ro path Option[str]
}

fn wire(d Disclosure, p str) -> str => json_encode(OnePath{ path: shown_path(d, p) }) ?? "<serde error>"

test "a path is hidden from a LAN client and shown on loopback" {
    // 01.2 section 10 puts a filesystem path in class `pii-path`: on every
    // platform this runs on it carries the operating system user's name.
    ro home = "C:\\Users\\evgeniy\\.claude"
    assert(wire(Disclosure.Loopback, home) == "{\"path\":\"C:\\\\Users\\\\evgeniy\\\\.claude\"}")
    assert(wire(Disclosure.Lan, home) == "{\"path\":null}")
    assert(wire(Disclosure.Anonymous, home) == "{\"path\":null}")
}

test "hidden is null, not an empty string, and an empty path is null too" {
    // The page must tell "hidden from you" apart from "there is no path" -- and
    // neither of them may arrive as "".
    assert(wire(Disclosure.Lan, "") == "{\"path\":null}")
    assert(wire(Disclosure.Loopback, "") == "{\"path\":null}")
    assert(wire(Disclosure.Loopback, "/x") == "{\"path\":\"/x\"}")
}

test "empty is null on the wire, anything else is the value" {
    assert(opt("") == None)
    assert(opt("x") == Some("x"))
    assert(opt(" ") == Some(" "))      // only the EMPTY string is absent, not a blank one
}

test "a quote and a backslash in a path do not break the body" {
    ro odd = "/home/o\"brien/c:\\x/.claude"
    assert(wire(Disclosure.Loopback, odd) == "{\"path\":\"/home/o\\\"brien/c:\\\\x/.claude\"}")
}
