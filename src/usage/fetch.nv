// fetch.nv — one poll of the usage endpoint (tasks T1.5, T2.10).
//
// The piece that ties the three that were already here: `parse.nv` reads a body,
// `outcome.nv` decides what a status means, `schedule.nv` decides when to ask again.
// This one asks.
//
// WHY IT EXISTS NOW, when the card said it was blocked. `usage/fetch.nv` was recorded
// as standing behind registry #1033 -- the shim that will not link -- and that was
// measured wrong. `nova-http` declares `Http` as an EFFECT: a probe importing
// `http.client.mock_http` inside this package builds, links and passes. #1033 holds
// `real_http` over Net/TLS and nothing above it, so everything here is writable and
// testable today; only a live request is not.
//
// EVERYTHING EXCEPT `fetch` IS PURE, and that is deliberate rather than tidy. The
// `Http` effect hands over a raw request string and hands back a raw response string,
// so reading a status line, finding a header and separating a body are decisions about
// text. Keeping them out of the effectful function is what lets a malformed reply be a
// test rather than an incident.
//
// THE TOKEN IS BUILT INTO THE REQUEST AND NEVER ANYWHERE ELSE. It is not returned, not
// logged, not placed in an error message. `request_for` takes it and the string it
// builds goes straight to `Http.send`; no other function in this file sees it.

module usage.fetch

import claude_limits.usage.kimi.{parse_kimi}
import http.{Http, HttpError}
import claude_limits.usage.outcome.{Outcome, of_status, bad_body, transport_failed}
import claude_limits.usage.parse.{Usage, PollOutcome}
// `parse` through the module name: three free `parse` of one arity live in the binary
// (cli.args, usage.parse, config), and a bare call is refused as ambiguous (#1390).
import claude_limits.usage.parse as usage_reply

/// CRLF, spelled once. Written as an escape rather than a literal because a literal
/// carriage return in a source file is invisible and survives a copy-paste into
/// something that strips it.
// PRIVATE on purpose while the defect stands: an `export const` is emitted without a
// module prefix, so any other module declaring `CRLF` collides
// (`probes/exported-const-loses-module-prefix/`). Private keeps the prefix.
const CRLF = "\r\n"

/// What one request came back with: how it went, and what the body said.
///
/// NAMED `Reply` RATHER THAN `Poll` because `schedule.Poll` already holds that name
/// for the state of polling between ticks. Both were right in their own file and the
/// emitted C has one namespace: a compilation unit using both died with
/// `redefinition of NovaValue_Poll` (registry 221.1 row 154). This one moved because
/// `Reply` describes it better anyway.
export type Reply value {
    ro outcome Outcome
    ro usage Usage
}

export fn Reply.new(outcome Outcome, usage Usage) -> Reply => { outcome, usage }

/// The request, serialised.
///
/// `Connection: close` because the effect is one hop by contract -- `nova-http` says so
/// in its own header, and keep-alive decisions belong to a client this package does not
/// have.
export fn request_for(host str, path str, token str) -> str {
    mut r = "GET ${path} HTTP/1.1${CRLF}"
    r = "${r}Host: ${host}${CRLF}"
    r = "${r}Authorization: Bearer ${token}${CRLF}"
    // The OAuth usage endpoint answers only with this header (the reference sends it,
    // scripts/claude_limits.py:79). Missing until 2026-09-30: no test here had ever
    // spoken to the real endpoint.
    r = "${r}anthropic-beta: oauth-2025-04-20${CRLF}"
    r = "${r}Accept: application/json${CRLF}"
    r = "${r}Connection: close${CRLF}${CRLF}"
    r
}

/// A form POST (`application/x-www-form-urlencoded`), serialised -- the Kimi token grant
/// (`kimi_refresh.grant_request`). Here, beside the two GETs, so the requests have one
/// home and `CRLF` one spelling (`check-duplicate-limits.py` refused a second copy).
export fn request_form(host str, path str, body str) -> str {
    mut r = "POST ${path} HTTP/1.1${CRLF}"
    r = "${r}Host: ${host}${CRLF}"
    r = "${r}Accept: application/json${CRLF}"
    r = "${r}Content-Type: application/x-www-form-urlencoded${CRLF}"
    r = "${r}Content-Length: ${body.byte_len()}${CRLF}"
    r = "${r}Connection: close${CRLF}${CRLF}"
    "${r}${body}"
}

/// The Kimi Code request: the same shape without Anthropic's beta header, which a
/// foreign endpoint has no use for (the reference's `fetch_kimi_usage` sends exactly
/// `Authorization` and `Accept`).
export fn request_kimi(host str, path str, token str) -> str {
    mut r = "GET ${path} HTTP/1.1${CRLF}"
    r = "${r}Host: ${host}${CRLF}"
    r = "${r}Authorization: Bearer ${token}${CRLF}"
    r = "${r}Accept: application/json${CRLF}"
    r = "${r}Connection: close${CRLF}${CRLF}"
    r
}

/// The status code of a raw response, or 0 when the first line is not a status line.
///
/// ZERO MEANS "COULD NOT READ IT", and the caller must not treat it as a status: a
/// reply whose first line is unreadable is a transport failure, not an HTTP one.
export fn status_of(raw str) -> int {
    ro line = match raw.split_once(CRLF) {
        Some((first, _)) => first
        None => raw
    }
    // `HTTP/1.1 429 Too Many Requests` -- the code is the second word.
    ro after_version = match line.split_once(" ") {
        Some((_, rest)) => rest
        None => return 0
    }
    ro code_text = match after_version.split_once(" ") {
        Some((code, _)) => code
        None => after_version
    }
    code_text.trim_ascii().to_int() ?? 0
}

/// The value of one header, case-insensitively, or "" when absent.
///
/// CASE-INSENSITIVE BECAUSE HTTP SAYS SO, and because the one header this package
/// actually depends on -- `Retry-After` -- has been seen spelled `retry-after` by real
/// servers. Matching exactly would read a present header as absent, and an absent
/// `Retry-After` means "use our floor", which is the more aggressive of the two.
export fn header_of(raw str, name str) -> str {
    ro want = name.to_ascii_lower()
    for line in raw.split(CRLF) {
        if line == "" { return "" }        // end of headers
        match line.split_once(":") {
            Some((k, v)) => {
                if k.trim_ascii().to_ascii_lower() == want { return v.trim_ascii() }
            }
            None => { }
        }
    }
    ""
}

/// Everything after the blank line, or "" when there is no blank line -- joined back
/// when the reply says `Transfer-Encoding: chunked`.
///
/// THE REAL ENDPOINT CHUNKS (measured 2026-09-30, the first live poll): its body began
/// `9fc` + CRLF, and the parser refused it as bad JSON. Every test here had used
/// whole bodies, which a mock hands over and a server need not.
export fn body_of(raw str) -> str {
    ro sep = "${CRLF}${CRLF}"
    ro body = match raw.split_once(sep) {
        Some((_, b)) => b
        None => return ""
    }
    if header_of(raw, "Transfer-Encoding").to_ascii_lower().contains("chunked") { return dechunk(body) }
    body
}

fn hex_digit(c u8) -> int {
    ro n = c as int
    if n >= 48 && n <= 57 { return n - 48 }
    if n >= 97 && n <= 102 { return n - 87 }
    if n >= 65 && n <= 70 { return n - 55 }
    -1
}

/// A chunked body joined back (RFC 9112 §7.1). Sizes are hexadecimal BYTE counts, and
/// an extension after `;` is ignored. A size that does not read ends the body where
/// it stands: what follows is refused by the JSON parser, loudly, rather than guessed
/// at here.
export fn dechunk(body str) -> str {
    ro b = body.bytes()
    mut out []u8 = []
    mut i = 0
    while i < b.len() {
        mut size = 0
        mut digits = 0
        mut in_ext = false
        while i < b.len() && (b[i] as int) != 13 {
            if (b[i] as int) == 59 { in_ext = true }
            if !in_ext {
                ro d = hex_digit(b[i])
                if d < 0 { return out.to_str_lossy() }
                size = size * 16 + d
                digits += 1
            }
            i += 1
        }
        // CRLF after the size line.
        i += 2
        if digits == 0 || size == 0 { return out.to_str_lossy() }
        // A short last chunk takes what is there; the parser judges the rest.
        ro end = (i + size).min(b.len())
        out.append(b[i..end])
        // CRLF after the data.
        i = end + 2
    }
    out.to_str_lossy()
}

/// `Retry-After` in seconds, or 0 when absent or unreadable.
///
/// ZERO MEANS ABSENT, not "immediately" -- `outcome.of_status` is written to that
/// convention, and the two readings are opposite instructions. A header carrying an
/// HTTP-date rather than a count also lands here as 0: we do not parse dates, and
/// guessing would be worse than falling back to the floor.
export fn retry_after_of(raw str) -> int {
    ro v = header_of(raw, "Retry-After")
    if v == "" { return 0 }
    (v.to_int() ?? 0).max(0)
}

/// One poll. The only effectful function here.
export fn fetch(host str, port int, secure bool, path str, token str) Http -> Reply =>
    fetch_with(host, port, secure, path, token, false)

/// One poll of either service: `kimi` picks the request and the reader of the reply.
export fn fetch_with(host str, port int, secure bool, path str, token str, kimi bool) Http -> Reply {
    ro request = if kimi { request_kimi(host, path, token) } else { request_for(host, path, token) }
    match Http.send(host, port, secure, request) {
        // The request never arrived. `unknown`, and the last good reading stays.
        Err(_) => Reply.new(transport_failed(), Usage.empty())
        Ok(raw) => {
            ro status = status_of(raw)
            // A first line we cannot read is not an HTTP outcome at all.
            if status == 0 { return Reply.new(transport_failed(), Usage.empty()) }

            ro out = of_status(status, retry_after_of(raw))
            if !out.body_usable { return Reply.new(out, Usage.empty()) }

            ro usage = if kimi { parse_kimi(body_of(raw)) } else { usage_reply.parse(body_of(raw)) }
            // A 200 whose body will not parse is `error`, per 01.1 §3.2 -- see the
            // note in `outcome_test` about the fixture that says `unknown` instead.
            if usage.outcome == PollOutcome.BadJson {
                return Reply.new(bad_body(), usage)
            }
            Reply.new(out, usage)
        }
    }
}
