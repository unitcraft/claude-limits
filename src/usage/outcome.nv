// outcome.nv — what one poll of the endpoint turned out to be (tasks T1.5, T2.10).
//
// PURE, AND THAT IS THE POINT. The transport fixtures in `fixtures/transport/` describe
// whole HTTP outcomes -- status, headers, body -- and every rule the plan states about
// them is a decision about those three values and nothing else. Keeping the decision
// apart from the fetching means the rules are exercised without a network, without a
// token, and without the real client, which cannot link here at all (registry #1033).
//
// WHY THIS EXISTS NOW, when the card that needs it was marked blocked. The block was
// measured wrong: `nova-http` declares `Http` as an EFFECT with a `mock_http()` handler,
// and a probe importing it inside this package builds and passes. #1033 holds the REAL
// handler over Net/TLS, and nothing above it. So the classification, the poller and
// their tests are writable today; only a live request is not.
//
// THE STATE TABLE IS 01.1 §3.2, AND IT IS THE AUTHORITY:
//
//   ok        the poll succeeded
//   stale     the token expired by `expiresAt` -- NO REQUEST WAS MADE
//   unknown   network trouble or 429: the last good reading stays, dimmed
//   error     401 on a token that still looked live, or a reply that would not parse
//
// One trap read out of that table rather than guessed: `fixtures/transport/
// unauthorized.json` says "state=stale with the reason 'token rejected'", and the code
// says 401 is `error`. They do not disagree -- 01.1 renders `error` LIKE `stale`, and
// the fixture's prose describes the rendering. Checked before writing, because picking
// one of two documents without reading the third is how a contradiction gets settled by
// whoever happened to be typing.

module usage.outcome

import claude_limits.model.snapshot.{AccountState, error_401_message, error_parse_message}

/// The floor between polls, in seconds (01.3 §3.5). A server that names a longer wait
/// wins; one that names a shorter one does not, and neither does our own impatience.
export const POLL_FLOOR_SEC = 60

/// What a single poll produced: the state to show, the reason to show with it, and
/// when the next poll may happen at the earliest.
export type Outcome value {
    ro state AccountState
    ro message str          // "" when there is nothing to say
    ro retry_after_sec int  // seconds to wait before the next poll
    ro body_usable bool     // true only when the body is worth parsing
}

export fn Outcome.new(state AccountState, message str, retry_after_sec int,
                     body_usable bool) -> Outcome =>
    { state, message, retry_after_sec, body_usable }

/// Classify one HTTP reply.
///
/// `retry_after_sec` is what the `Retry-After` header said, or 0 when it said nothing
/// -- ZERO MEANS ABSENT, not "immediately". The two are opposite instructions and a
/// header that failed to parse must never read as the more aggressive one.
export fn of_status(status int, retry_after_sec int) -> Outcome {
    // 429 FIRST, because it is the case this whole discipline exists for: on
    // 2026-09-07 this machine earned one, and the rule is the server's number when it
    // gives one, our floor when it does not.
    if status == 429 {
        ro wait = if retry_after_sec > 0 { retry_after_sec } else { POLL_FLOOR_SEC }
        return Outcome.new(AccountState.Unknown, "", wait, false)
    }

    if status == 401 {
        // The account keeps its place; the next cycle must NOT come sooner than the
        // floor. A rejected token retried in a loop is how one 401 becomes a 429 for
        // the whole machine -- the fixture says so, and it is not hypothetical here.
        return Outcome.new(AccountState.Error, error_401_message(), POLL_FLOOR_SEC,
                          false)
    }

    if status >= 500 {
        // NEVER `error`, and this is a rule rather than a preference: the fault is the
        // server's and the person has nothing to fix. Showing it as a broken account
        // asks them to act on something they cannot touch.
        return Outcome.new(AccountState.Unknown, "", POLL_FLOOR_SEC, false)
    }

    if status == 200 {
        return Outcome.new(AccountState.Ok, "", POLL_FLOOR_SEC, true)
    }

    // Anything else -- 3xx, 4xx that is not 401, a status we have never seen. Unknown
    // rather than error: we do not know what happened, and saying `error` would claim
    // we did.
    return Outcome.new(AccountState.Unknown, "", POLL_FLOOR_SEC, false)
}

/// The reply arrived and the body would not parse (01.1 §3.2: `error`, "невалидный
/// JSON"). Separate from `of_status` because it is decided AFTER parsing, and folding
/// it in would make `of_status` take an argument it cannot have yet.
export fn bad_body() -> Outcome =>
    Outcome.new(AccountState.Error, error_parse_message(), POLL_FLOOR_SEC, false)

/// The request never reached anyone -- connection refused, DNS, TLS.
///
/// `unknown`, like 429: the last good reading stays and dims. The badge text belongs to
/// the page (`network_badge`) and is not built here: this module decides the state, and
/// two places composing the same sentence drift apart on the first edit.
export fn transport_failed() -> Outcome =>
    Outcome.new(AccountState.Unknown, "", POLL_FLOOR_SEC, false)
