// Tests for schedule.nv — the four arithmetic conditions of T2.10.
//
//   ./nova.sh test src/usage/ --filter schedule
//
// A SCHEDULER IS ALL BOUNDARIES, so every rule is checked on BOTH SIDES of its moment:
// one millisecond before the window opens and exactly at it. "Not due early" alone
// passes for a scheduler that is never due; "due at the moment" alone passes for one
// that is always due. Neither half is a test by itself.
//
// No clock is read. Every moment is a number chosen here, which is why the instant
// before a window can be asked about at all.

module usage.schedule_test

import schedule.{Interval, Poll, due, polled, refresh_allowed}
import claude_limits.usage.outcome.{POLL_FLOOR_SEC}

const MIN = 60 * 1000

test "a configured interval below the floor is RAISED, not refused and not honoured" {
    // The card's own wording: `interval_sec = 10` is raised to 60. Someone asking for
    // ten seconds is asking for a 429.
    assert(Interval.new(10).seconds == POLL_FLOOR_SEC)
    assert(Interval.new(1).seconds == POLL_FLOOR_SEC)
    assert(Interval.new(59).seconds == POLL_FLOOR_SEC)
}

test "zero and negative land on the floor, not on 'as fast as possible'" {
    // A missing setting or a typo. Reading either as "no delay" is the one
    // interpretation that costs a rate limit.
    assert(Interval.new(0).seconds == POLL_FLOOR_SEC)
    assert(Interval.new(0 - 30).seconds == POLL_FLOOR_SEC)
}

test "an interval above the floor is left alone" {
    // The other direction: a floor that clamped everything would pass the tests above
    // and quietly ignore what the person asked for.
    assert(Interval.new(300).seconds == 300)
    assert(Interval.new(POLL_FLOOR_SEC + 1).seconds == POLL_FLOOR_SEC + 1)
}

test "an account never polled is due at once" {
    // Otherwise the page shows nothing until a whole interval has gone by, and the
    // first thing a person sees after starting the app is emptiness.
    assert(due(Poll.new(), Interval.new(300), 0))
    assert(due(Poll.new(), Interval.new(300), 1_000_000))
}

test "one request per tick: not due a millisecond early, due exactly on time" {
    ro iv = Interval.new(300)
    ro p = polled(Poll.new(), 1_000_000, POLL_FLOOR_SEC)
    // 300 s after the poll is the moment. Both sides of it.
    assert(!due(p, iv, 1_000_000 + 300 * 1000 - 1))
    assert(due(p, iv, 1_000_000 + 300 * 1000))
}

test "after a 429 the wait is the server's, even past the interval" {
    // `Retry-After: 600` against a configured 60: the server wins. A scheduler taking
    // the interval alone would poll nine times inside the window it was told to wait.
    ro iv = Interval.new(60)
    ro p = polled(Poll.new(), 0, 600)
    assert(!due(p, iv, 599 * 1000))
    assert(due(p, iv, 600 * 1000))
}

test "the interval still applies when the server asked for LESS" {
    // The other direction of the same rule, and the one a single test would miss: a
    // `Retry-After: 10` does not licence polling every ten seconds when the person
    // configured five minutes. `due` requires BOTH conditions.
    ro iv = Interval.new(300)
    ro p = polled(Poll.new(), 0, 10)
    assert(!due(p, iv, 11 * 1000))          // the server's window has passed
    assert(!due(p, iv, 299 * 1000))         // the interval has not
    assert(due(p, iv, 300 * 1000))
}

test "a refresh inside the floor is refused, and allowed exactly at it" {
    ro p = polled(Poll.new(), 1_000_000, POLL_FLOOR_SEC)
    assert(!refresh_allowed(p, 1_000_000 + POLL_FLOOR_SEC * 1000 - 1))
    assert(refresh_allowed(p, 1_000_000 + POLL_FLOOR_SEC * 1000))
}

test "a refresh obeys a 429 window longer than the floor" {
    // The floor is not the only gate. After `Retry-After: 600`, a refresh at 61 s is
    // still a request inside a window the server closed -- and the person clicking
    // cannot see that they are the cause.
    ro p = polled(Poll.new(), 0, 600)
    assert(!refresh_allowed(p, 61 * 1000))
    assert(!refresh_allowed(p, 599 * 1000))
    assert(refresh_allowed(p, 600 * 1000))
}

test "a refresh before the first poll is allowed" {
    // Nothing has been asked yet, so nothing is being asked too often.
    assert(refresh_allowed(Poll.new(), 0))
}
