// Tests for usage/poller.nv — task T2.10.
//
//   ./nova.sh test src/usage/ --filter poller
//
// The card's acceptance, line by line, and each line has its own test:
//
//   * one request per account per tick;
//   * after a 429 the next poll comes no sooner than `Retry-After`;
//   * a `refresh` inside 60 s is refused;
//   * `interval_sec = 10` is raised to 60;
//   * every outcome is written to `poll`.
//
// BOTH HANDLERS COUNT. `Http` counts requests and `PollLog` counts records, because
// four of the five lines are claims about HOW MANY -- and a test that only inspects
// the returned value cannot tell one request from two. The fifth (the interval) is a
// claim about a number, and is pinned as a number.

module usage.poller_test

import http.{Http, HttpError}
import claude_limits.usage.poller.{Account, PollLog, poll_once, tick, refresh, wait_after}
import claude_limits.usage.schedule.{Interval, Poll, due}
import claude_limits.usage.outcome.{of_status, POLL_FLOOR_SEC}

const EOL = "\r\n"

/// What the two fake handlers remember between calls.
type Spy {
    mut requests int
    mut records int
    mut last_email str
    mut last_state str
    mut last_message str
    mut last_at int
    mut saw_token bool
}

fn Spy.new() -> Spy =>
    { requests: 0, records: 0, last_email: "", last_state: "", last_message: "",
      last_at: 0, saw_token: false }

fn Spy mut @asked(request str) -> () {
    @requests += 1
    // The token must reach the endpoint and nothing else. This is the only place a
    // test can see the raw request, so it is the only place that can check.
    if request.contains("secret-token") { @saw_token = true }
}

fn Spy mut @wrote(email str, state str, message str, at_ms int) -> () {
    @records += 1
    @last_email = email
    @last_state = state
    @last_message = message
    @last_at = at_ms
}

fn reply(status_line str, headers str, body str) -> str {
    if headers == "" { return "${status_line}${EOL}${EOL}${body}" }
    "${status_line}${EOL}${headers}${EOL}${EOL}${body}"
}

fn ok_body() -> str =>
    reply("HTTP/1.1 200 OK", "Content-Type: application/json", "{\"five_hour\":{}}")

fn rate_limited() -> str =>
    reply("HTTP/1.1 429 Too Many Requests", "Retry-After: 120", "slow down")

fn acct() -> Account =>
    Account.of("a@example.com", "api.example.com", 443, true, "/v1/usage", "secret-token")

/// Runs `body` with both effects spied on. One helper, so no test can forget one of
/// the two counters and then assert about the one it has.
fn spied[T](mut s Spy, raw str, body fn() Http PollLog -> T) -> T =>
    with Http = effect Http {
        send(host, port, secure, request) -> Result[str, HttpError] {
            s.asked(request)
            Ok(raw)
        }
    } {
        with PollLog = effect PollLog {
            record(email str, state str, message str, at_ms int) -> () {
                s.wrote(email, state, message, at_ms)
            }
        } {
            body()
        }
    }

// ── one request per account per tick ─────────────────────────────────────────

test "a due account is asked exactly once" {
    mut s = Spy.new()
    ro (_, polled_now) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), Poll.new(), Interval.of(60), 1000))
    assert(polled_now)
    assert(s.requests == 1)
}

test "an account that is NOT due is not asked at all" {
    // The other direction, and the one that matters: a poller that asks every tick
    // and throws the answer away would pass the test above.
    mut s = Spy.new()
    ro after = Poll.new()
    ro (p1, first) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), after, Interval.of(60), 1000))
    assert(first)
    assert(s.requests == 1)
    // One second later: the interval has not passed.
    ro (_, second) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), p1, Interval.of(60), 2000))
    assert(!second)
    assert(s.requests == 1)
}

test "a skipped tick leaves the schedule untouched" {
    // If a skip moved `last_poll_ms` forward, an account would never become due --
    // the rhythm would chase its own tail and the page would never update.
    mut s = Spy.new()
    ro (p1, _) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), Poll.new(), Interval.of(60), 1000))
    ro (p2, ran) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), p1, Interval.of(60), 2000))
    assert(!ran)
    assert(p2.last_poll_ms == p1.last_poll_ms)
    assert(p2.next_allowed_ms == p1.next_allowed_ms)
}

// ── after a 429, not before Retry-After ──────────────────────────────────────

test "a 429 pushes the next poll out by the server's own number" {
    mut s = Spy.new()
    ro (p1, _) = spied(s, rate_limited(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), Poll.new(), Interval.of(60), 1000))
    // Retry-After: 120 -- so 119 seconds later is still too early, and it is too
    // early even though the 60 s interval has long passed.
    assert(!due(p1, Interval.of(60), 1000 + 119 * 1000))
    assert(due(p1, Interval.of(60), 1000 + 120 * 1000))
}

test "a 429 with no Retry-After still waits the floor" {
    // Zero means ABSENT, not "immediately" -- the two are opposite instructions and
    // the more aggressive reading is the one that earns the next 429.
    mut s = Spy.new()
    ro raw = reply("HTTP/1.1 429 Too Many Requests", "", "slow down")
    ro (p1, _) = spied(s, raw,
        fn() Http PollLog -> (Poll, bool) => tick(acct(), Poll.new(), Interval.of(60), 1000))
    assert(!due(p1, Interval.of(60), 1000 + 59 * 1000))
    assert(due(p1, Interval.of(60), 1000 + POLL_FLOOR_SEC * 1000))
}

test "the wait comes from the outcome, floor when it says nothing" {
    assert(wait_after(of_status(429, 120)) == 120)
    assert(wait_after(of_status(429, 0)) == POLL_FLOOR_SEC)
    assert(wait_after(of_status(200, 0)) == POLL_FLOOR_SEC)
}

// ── refresh inside the floor is refused ──────────────────────────────────────

test "a refresh right after a poll is refused, and asks nothing" {
    mut s = Spy.new()
    ro (p1, _) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), Poll.new(), Interval.of(60), 1000))
    assert(s.requests == 1)
    ro (p2, ran) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => refresh(acct(), p1, 1000 + 30 * 1000))
    assert(!ran)
    // The refusal must not cost a request. A refresh button that fires anyway is a
    // rate limit waiting to be earned, and the person cannot see they are the cause.
    assert(s.requests == 1)
    assert(p2.last_poll_ms == p1.last_poll_ms)
}

test "a refresh after the floor runs" {
    mut s = Spy.new()
    ro (p1, _) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), Poll.new(), Interval.of(60), 1000))
    ro (_, ran) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => refresh(acct(), p1, 1000 + POLL_FLOOR_SEC * 1000))
    assert(ran)
    assert(s.requests == 2)
}

test "the very first refresh is allowed: nothing has been asked yet" {
    mut s = Spy.new()
    ro (_, ran) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => refresh(acct(), Poll.new(), 0))
    assert(ran)
    assert(s.requests == 1)
}

// ── the interval floor ───────────────────────────────────────────────────────

test "interval_sec = 10 is raised to 60" {
    assert(Interval.of(10).seconds == 60)
    assert(Interval.of(10).seconds == POLL_FLOOR_SEC)
    // And a configured value ABOVE the floor is left alone -- without this the test
    // would pass on an implementation that returns 60 unconditionally.
    assert(Interval.of(300).seconds == 300)
}

test "a floored interval really governs the rhythm, not just the number" {
    // The number could be right and unused. Ask the schedule.
    mut s = Spy.new()
    ro (p1, _) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), Poll.new(), Interval.of(10), 0))
    assert(!due(p1, Interval.of(10), 59 * 1000))
    assert(due(p1, Interval.of(10), 60 * 1000))
}

// ── every outcome is written down ────────────────────────────────────────────

test "a successful poll writes exactly one record" {
    mut s = Spy.new()
    spied(s, ok_body(), fn() Http PollLog -> Reading => poll_once(acct(), 4242))
    assert(s.records == 1)
    assert(s.last_email == "a@example.com")
    assert(s.last_at == 4242)
}

test "a 429 is written down too -- especially a 429" {
    // The outcome nobody wants to look at is the one that has to be there: a 429
    // absent from `poll` is a 429 nobody can explain the next morning.
    mut s = Spy.new()
    spied(s, rate_limited(), fn() Http PollLog -> Reading => poll_once(acct(), 7))
    assert(s.records == 1)
    assert(s.last_state == "unknown")
}

test "a malformed reply is written down as well" {
    mut s = Spy.new()
    ro raw = "this is not http at all"
    spied(s, raw, fn() Http PollLog -> Reading => poll_once(acct(), 9))
    assert(s.records == 1)
}

test "one poll, one record: a tick never writes twice" {
    mut s = Spy.new()
    spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), Poll.new(), Interval.of(60), 1000))
    assert(s.requests == 1)
    assert(s.records == 1)
}

test "a refused tick writes NOTHING" {
    // `poll` holds what the endpoint said. Nothing was asked, so there is nothing to
    // record -- a refusal in the table would later read as a failed poll.
    mut s = Spy.new()
    ro (p1, _) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), Poll.new(), Interval.of(60), 1000))
    assert(s.records == 1)
    ro (_, ran) = spied(s, ok_body(),
        fn() Http PollLog -> (Poll, bool) => tick(acct(), p1, Interval.of(60), 2000))
    assert(!ran)
    assert(s.records == 1)
}

// ── the token ────────────────────────────────────────────────────────────────

test "the token reaches the request and nothing else" {
    mut s = Spy.new()
    spied(s, ok_body(), fn() Http PollLog -> Reading => poll_once(acct(), 1))
    assert(s.saw_token)
    // And not the log. `record` has no parameter that could carry it, which is the
    // real guarantee -- this assertion only pins that the three it does have stayed
    // free of it.
    assert(!s.last_email.contains("secret-token"))
    assert(!s.last_state.contains("secret-token"))
    assert(!s.last_message.contains("secret-token"))
}
