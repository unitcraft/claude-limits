// Tests for codex.nv -- plan 01.7, stage 2: the Codex reply against the REFERENCE.
//
//   ./nova.sh test src/usage/codex_test.nv
//
// The replies below were run through the reference's own `codex_rows_of`
// (`scripts/claude_limits.py`, 2026-10-08), which printed:
//
//   paid  5h limit 12 (12.5)       reset 1790920800
//         weekly limit 46 (46.37)  reset 1791406800
//   free  month limit 12 (12)      reset 1793000000   (fixtures/usage/codex.json)
//   odd   month limit 14 (13.5)    reset 1793491200   (a 31-day month)
//         1h limit 5               reset 1790920800   (no kind: left out)
//
// The reference's "5h / weekly / month limit" are the contract's `session`, `weekly_all`,
// `monthly` (plan 01.7).

module usage.codex_test

import codex.{parse_codex, kind_of_seconds}
import claude_limits.usage.parse.{PollOutcome}
import claude_limits.usage.fetch.{request_codex}
import claude_limits.window.{Window}

const PAID = "{\"rate_limit\": {\"primary_window\": {\"used_percent\": 12.5, \"limit_window_seconds\": 18000, \"reset_at\": 1790920800}, \"secondary_window\": {\"used_percent\": 46.37, \"limit_window_seconds\": 604800, \"reset_at\": 1791406800}}}"

const FREE = "{\"rate_limit\": {\"primary_window\": {\"used_percent\": 12, \"limit_window_seconds\": 2592000, \"reset_after_seconds\": 2000000, \"reset_at\": 1793000000}, \"secondary_window\": null}}"

const ODD = "{\"rate_limit\": {\"primary_window\": {\"used_percent\": 13.5, \"limit_window_seconds\": 2678400, \"reset_at\": 1793491200}, \"secondary_window\": {\"used_percent\": 5, \"limit_window_seconds\": 3600, \"reset_at\": 1790920800}}}"

fn row(w Window) -> str => "${w.kind}|${w.model}|${w.percent}|${w.resets_at_ms}"

fn rows_of(body str) -> str {
    ro u = parse_codex(body)
    mut out = ""
    for w in u.windows { out = if out == "" { row(w) } else { "${out} ; ${row(w)}" } }
    out
}

fn same(label str, want str, got str) -> bool {
    if want == got { return true }
    panic("${label}: want [${want}], got [${got}]")
}

test "a paid plan: the 5-hour window and the week, a half rounding to even" {
    assert(same("paid", "session||12|1790920800000 ; weekly_all||46|1791406800000", rows_of(PAID)))
}

test "a free plan: one window of 30 days, the secondary null" {
    assert(same("free", "monthly||12|1793000000000", rows_of(FREE)))
}

test "a 31-day month is a month, 13.5 rounds to 14; a one-hour window has no kind and is left out" {
    assert(same("odd", "monthly||14|1793491200000", rows_of(ODD)))
}

test "the length names the kind" {
    assert(kind_of_seconds(18000) == "session")
    assert(kind_of_seconds(604800) == "weekly_all")
    assert(kind_of_seconds(2592000) == "monthly")
    assert(kind_of_seconds(2419200) == "monthly")
    assert(kind_of_seconds(3600) == "")
    assert(kind_of_seconds(0) == "")
}

test "not JSON is BadJson; JSON with no window is NoWindows" {
    assert(parse_codex("not json").outcome == PollOutcome.BadJson)
    assert(parse_codex("{\"rate_limit\": null}").outcome == PollOutcome.NoWindows)
    assert(parse_codex("{\"rate_limit\": {\"primary_window\": {\"limit_window_seconds\": 18000}}}").outcome == PollOutcome.NoWindows)
    assert(parse_codex(FREE).outcome == PollOutcome.Parsed)
}

test "the request names the ChatGPT account and the product, and carries no Anthropic header" {
    ro r = request_codex("chatgpt.com", "/backend-api/wham/usage", "TOKEN", "acct-1")
    assert(r.starts_with("GET /backend-api/wham/usage HTTP/1.1\r\n"))
    assert(r.contains("Host: chatgpt.com\r\n"))
    assert(r.contains("Authorization: Bearer TOKEN\r\n"))
    assert(r.contains("chatgpt-account-id: acct-1\r\n"))
    assert(r.contains("User-Agent: codex_cli_rs/claude-limits\r\n"))
    assert(!r.contains("anthropic-beta"))
}
