/// x * 2 in GF(2^8), as in `zcode_cipher.nv`.
fn xtime(a int) -> int =>
    if a >= 128 { ((a * 2) - 256) ^ 0x1B } else { a * 2 }

/// x * 4 and x * 8, the halves the inverse MixColumns multipliers share.
fn mul4(a int) -> int => xtime(xtime(a))

fn mul8(a int) -> int => xtime(mul4(a))

/// The AES-128 key schedule: 16 bytes -> 176, flat (word = 4 bytes). The ZCode
/// schedule (`zcode_cipher.expand_key`) is the 32-byte shape of the same loop.
fn expand_key128(key []int) -> []int {
    mut w []int = []
    for b in key { w.push(b) }
    mut rcon = 1
    mut i = 16
    while i < 176 {
        mut t []int = []
        for j in 0..4 { t.push(w[i - 4 + j]) }
        if i % 16 == 0 {
            // RotWord, SubWord, Rcon -- on the flat word.
            mut s []int = []
            for j in 1..4 { s.push(SBOX[t[j]]) }
            s.push(SBOX[t[0]])
            s[0] = s[0] ^ rcon
            rcon = xtime(rcon)
            t = s
        }
        for j in 0..4 { w.push(w[i - 16 + j] ^ t[j]) }
        i += 4
    }
    w
}

fn add_round_key(mut s []int, w []int, rnd int) -> () {
    ro base = rnd * 16
    for k in 0..16 { s[k] = s[k] ^ w[base + k] }
}

/// ShiftRows over the column-major flat state: byte r of column c at s[4c + r].
fn shift_rows(s []int) -> []int {
    mut out []int = []
    for c in 0..4 {
        for r in 0..4 {
            out.push(s[4 * ((c + r) % 4) + r])
        }
    }
    out
}

fn inv_shift_rows(s []int) -> []int {
    mut out []int = []
    for c in 0..4 {
        for r in 0..4 {
            out.push(s[4 * ((c - r + 4) % 4) + r])
        }
    }
    out
}

fn mix_columns(mut s []int) -> () {
    for c in 0..4 {
        ro a0 = s[4 * c]
        ro a1 = s[4 * c + 1]
        ro a2 = s[4 * c + 2]
        ro a3 = s[4 * c + 3]
        s[4 * c] = xtime(a0) ^ (xtime(a1) ^ a1) ^ a2 ^ a3
        s[4 * c + 1] = a0 ^ xtime(a1) ^ (xtime(a2) ^ a2) ^ a3
        s[4 * c + 2] = a0 ^ a1 ^ xtime(a2) ^ (xtime(a3) ^ a3)
        s[4 * c + 3] = (xtime(a0) ^ a0) ^ a1 ^ a2 ^ xtime(a3)
    }
}

/// The inverse MixColumns multipliers: 9 = 8+1, 11 = 8+2+1, 13 = 8+4+1,
/// 14 = 8+4+2 over GF(2^8).
fn m9(a int) -> int => mul8(a) ^ a

fn m11(a int) -> int => mul8(a) ^ xtime(a) ^ a

fn m13(a int) -> int => mul8(a) ^ mul4(a) ^ a

fn m14(a int) -> int => mul8(a) ^ mul4(a) ^ xtime(a)

/// The inverse MixColumns: rows carry 14/11/13/9, stepped one column over each row.
fn inv_mix_columns(mut s []int) -> () {
    for c in 0..4 {
        ro a0 = s[4 * c]
        ro a1 = s[4 * c + 1]
        ro a2 = s[4 * c + 2]
        ro a3 = s[4 * c + 3]
        s[4 * c] = m14(a0) ^ m11(a1) ^ m13(a2) ^ m9(a3)
        s[4 * c + 1] = m9(a0) ^ m14(a1) ^ m11(a2) ^ m13(a3)
        s[4 * c + 2] = m13(a0) ^ m9(a1) ^ m14(a2) ^ m11(a3)
        s[4 * c + 3] = m11(a0) ^ m13(a1) ^ m9(a2) ^ m14(a3)
    }
}

/// The forward cipher, ten rounds; the encrypt half of the round trip. Exported
/// for the published vectors, as `zcode_cipher.aes256_block` is for GCM's.
export fn aes128_block(key []int, block []int) -> []int {
    ro w = expand_key128(key)
    aes128_block_with(w, block)
}

fn aes128_block_with(w []int, block []int) -> []int {
    mut s []int = []
    for b in block { s.push(b) }
    add_round_key(s, w, 0)
    mut rnd = 1
    while rnd < 10 {
        for k in 0..16 { s[k] = SBOX[s[k]] }
        s = shift_rows(s)
        mix_columns(s)
        add_round_key(s, w, rnd)
        rnd += 1
    }
    for k in 0..16 { s[k] = SBOX[s[k]] }
    s = shift_rows(s)
    add_round_key(s, w, 10)
    s
}

/// The inverse cipher, ten rounds (FIPS-197 §5.3); only CBC needs it.
export fn aes128_inv_block(key []int, block []int) -> []int {
    aes128_inv_block_with(expand_key128(key), block)
}

fn aes128_inv_block_with(w []int, block []int) -> []int {
    mut s []int = []
    for b in block { s.push(b) }
    add_round_key(s, w, 10)
    mut rnd = 9
    while rnd > 0 {
        s = inv_shift_rows(s)
        for k in 0..16 { s[k] = INV_SBOX[s[k]] }
        add_round_key(s, w, rnd)
        inv_mix_columns(s)
        rnd -= 1
    }
    s = inv_shift_rows(s)
    for k in 0..16 { s[k] = INV_SBOX[s[k]] }
    add_round_key(s, w, 0)
    s
}

fn xor16(a []int, b []int) -> []int {
    mut out []int = []
    for k in 0..16 { out.push(a[k] ^ b[k]) }
    out
}

fn key_bytes(key str) -> []int {
    mut out []int = []
    for b in key.bytes() { out.push(b as int) }
    out
}

/// The key the WASM is handed: the first 16 CHARACTERS of the machine id, as the
/// app's own wrapper cuts it (`t.slice(0, 16)`); the id is an ascii UUID, so bytes
/// and characters are the same. A shorter id gives a shorter string, and the cipher
/// refuses it at the Shape check.
export fn qoder_key(machine_id str) -> str {
    ro n = machine_id.byte_len().min(16)
    return machine_id[..n]
}

fn cbc_encrypt(w []int, data []int, iv []int) -> []int {
    mut out []int = []
    mut prev []int = []
    for b in iv { prev.push(b) }
    mut i = 0
    while i < data.len() {
        mut xored []int = []
        for k in 0..16 { xored.push(data[i + k] ^ prev[k]) }
        prev = aes128_block_with(w, xored)
        for b in prev { out.push(b) }
        i += 16
    }
    out
}

fn cbc_decrypt(w []int, raw []int, iv []int) -> []int {
    mut out []int = []
    mut prev []int = []
    for b in iv { prev.push(b) }
    mut i = 0
    while i < raw.len() {
        ro blk = raw[i..i + 16]
        ro dec = aes128_inv_block_with(w, blk)
        for b in xor16(dec, prev) { out.push(b) }
        mut nxt []int = []
        for k in 0..16 { nxt.push(blk[k]) }
        prev = nxt
        i += 16
    }
    out
}

/// The store's text opened: base64 (standard alphabet) -> CBC -> the padding
/// checked and stripped -> the login JSON as text. Any failure is an Err; the
/// caller shows a broken login, never a traceback.
export fn qoder_decrypt(blob str, key str) -> Result[str, QoderCipherFail] {
    ro kb = key_bytes(qoder_key(key))
    if kb.len() != 16 { return Err(QoderCipherFail.Shape) }
    ro raw = match Base64.decode(blob) {
        Err(_) => return Err(QoderCipherFail.Shape)
        Ok(bytes) => {
            mut out []int = []
            for b in bytes { out.push(b as int) }
            out
        }
    }
    if raw.len() == 0 || raw.len() % 16 != 0 { return Err(QoderCipherFail.Shape) }
    ro plain = cbc_decrypt(expand_key128(kb), raw, kb)
    // PKCS7: the last byte names the pad, and all the pad bytes carry it. A wrong
    // machine id surfaces HERE, exactly where the WASM says "Invalid PKCS5 padding".
    ro pad = plain[plain.len() - 1]
    if pad < 1 || pad > 16 { return Err(QoderCipherFail.Padding) }
    mut n = plain.len() - pad
    while n < plain.len() {
        if plain[n] != pad { return Err(QoderCipherFail.Padding) }
        n += 1
    }
    mut kept []u8 = []
    for k in 0..plain.len() - pad { kept.push(plain[k] as u8) }
    Ok(kept.to_str_lossy())
}

/// The same scheme in reverse, for the tests' round trips and the fixture:
/// PKCS7 -> CBC -> base64. Production only decrypts.
export fn qoder_encrypt(plain str, key str) -> Result[str, QoderCipherFail] {
    ro kb = key_bytes(qoder_key(key))
    if kb.len() != 16 { return Err(QoderCipherFail.Shape) }
    mut data []int = []
    for b in plain.bytes() { data.push(b as int) }
    ro pad = 16 - data.len() % 16
    mut n = 0
    while n < pad { data.push(pad); n += 1 }
    ro raw = cbc_encrypt(expand_key128(kb), data, kb)
    mut bytes []u8 = []
    for b in raw { bytes.push(b as u8) }
    Ok(Base64.encode(bytes))
}
