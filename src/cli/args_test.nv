// Tests for args.nv — the command line of claude-limits (task T1.7, subplan 01.5).
//
//   ./nova.sh test src/cli/
//
// BOTH DIRECTIONS, and here that is not a slogan. A parser is the place where a test
// that only checks the interesting branch passes just as happily when the condition is
// inverted: "--config took its value" is true of a parser that swallows the next
// argument unconditionally, and "an unknown flag is refused" is true of one that
// refuses everything. So each flag is checked for what it sets AND for what it leaves
// alone, and each refusal is paired with an acceptance one character away.
//
// Nothing is touched but values: no environment, no disk, no clock.

module cli.args_test

import args.{parse_args, Mode, EXIT_CONFIG}

test "no arguments at all: one table, and every option left alone" {
    ro r = parse_args(Vec[str].new())
    assert(r.is_ok())
    ro a = r!!
    assert(a.mode == Mode.Once)
    assert(a.config == "")
    assert(a.offline == "")
    assert(a.parent == "")
    assert(a.color == "auto")
    assert(a.dirs.len() == 0)
}

test "--serve is its own mode, and keeps --config beside it" {
    ro a = parse_args(["--serve", "--config", "C:/x/claude-limits.toml"])!!
    assert(a.mode == Mode.Serve)
    assert(a.config == "C:/x/claude-limits.toml")
    // And the flag is not read as a directory.
    assert(a.dirs.len() == 0)
}

test "--config takes the NEXT argument, and does not eat the one after it" {
    ro r = parse_args(["--config", "cl.toml", "dirA"])
    assert(r.is_ok())
    ro a = r!!
    assert(a.config == "cl.toml")
    assert(a.dirs.len() == 1)
    assert(a.dirs[0] == "dirA")
}

test "--config at the very end is a refusal, not an empty value" {
    ro r = parse_args(["--config"])
    assert(r.is_err())
    ro c = r.err()!!
    assert(c.code == EXIT_CONFIG)
    assert(c.message == "--config needs a value")
}

test "--offline and --parent each take their own value" {
    ro r = parse_args(["--offline", "fixtures/usage", "--parent", "fixtures/dirs"])
    assert(r.is_ok())
    ro a = r!!
    assert(a.offline == "fixtures/usage")
    assert(a.parent == "fixtures/dirs")
    assert(a.dirs.len() == 0)
}

test "positional directories accumulate in order" {
    ro r = parse_args(["one", "two", "three"])
    assert(r.is_ok())
    ro a = r!!
    assert(a.dirs.len() == 3)
    assert(a.dirs[0] == "one")
    assert(a.dirs[2] == "three")
}

test "--color takes its three words" {
    for word in ["auto", "always", "never"] {
        ro r = parse_args(["--color", word])
        assert(r.is_ok())
        assert(r!!.color == word)
    }
}

test "a misspelled --color is refused, not quietly defaulted" {
    ro r = parse_args(["--color", "alwyas"])
    assert(r.is_err())
    ro c = r.err()!!
    assert(c.code == EXIT_CONFIG)
    // The message quotes the offending word back: a refusal that does not say what it
    // refused sends the reader to the manual to guess.
    assert(c.message.contains("alwyas"))
}

test "an unknown flag is refused, while a bare word beside it is a directory" {
    ro bad = parse_args(["--quiet"])
    assert(bad.is_err())
    assert(bad.err()!!.code == EXIT_CONFIG)

    ro good = parse_args(["quiet"])
    assert(good.is_ok())
    assert(good!!.dirs.len() == 1)
}

test "--help and --version each win over the default mode" {
    assert(parse_args(["--help"])!!.mode == Mode.Help)
    assert(parse_args(["-h"])!!.mode == Mode.Help)
    assert(parse_args(["--version"])!!.mode == Mode.Version)
    assert(parse_args(["--once"])!!.mode == Mode.Once)
}

test "the last mode flag wins, rather than the first" {
    ro r = parse_args(["--version", "--help"])
    assert(r!!.mode == Mode.Help)
}

test "--bar-style takes its two words, and defaults to the reference's default" {
    assert(parse_args([])!!.bar_style == "ascii")
    assert(parse_args(["--bar-style", "blocks"])!!.bar_style == "blocks")
    assert(parse_args(["--bar-style", "ascii"])!!.bar_style == "ascii")
}

test "a misspelled --bar-style is refused, like a misspelled --color" {
    ro r = parse_args(["--bar-style", "blokcs"])
    assert(r.is_err())
    assert(r.err()!!.code == EXIT_CONFIG)
    assert(r.err()!!.message.contains("blokcs"))
}

test "the flags the differential passes are all accepted together" {
    // scripts/diff_with_probe.py invokes both programs with exactly these. This test
    // exists because the differential found them missing: it reported CANNOT COMPARE,
    // which is the right answer and an easy one to mistake for a difference.
    ro r = parse_args(["--color", "never", "--bar-style", "ascii", "--offline", "fixtures/usage", "fixtures/dirs/no-login"])
    assert(r.is_ok())
    ro a = r!!
    assert(a.color == "never")
    assert(a.bar_style == "ascii")
    assert(a.offline == "fixtures/usage")
    assert(a.dirs.len() == 1)
}

// ── the autostart verbs (task T4.2) ──────────────────────────────────────────

test "--install-autostart is a verb, and it takes no value" {
    ro r = parse_args(["--install-autostart"])
    assert(r.is_ok())
    ro a = r!!
    assert(a.mode.to_str() == "install-autostart")
    // The other direction: it must not have swallowed anything, the way a
    // value-taking flag would.
    assert(a.dirs.len() == 0)
    assert(a.config == "")
}

test "--uninstall-autostart is the other verb, not a flag on the first" {
    ro r = parse_args(["--uninstall-autostart"])
    assert(r.is_ok())
    assert(r!!.mode.to_str() == "uninstall-autostart")
}

test "a directory after the verb is still a directory, not a value" {
    // The failure this pins: a verb accidentally written to consume `argv[i+1]`
    // would eat the path and the program would install with no argument and no
    // complaint.
    ro r = parse_args(["--install-autostart", "fixtures/dirs/no-login"])
    assert(r.is_ok())
    ro a = r!!
    assert(a.mode.to_str() == "install-autostart")
    assert(a.dirs.len() == 1)
    assert(a.dirs[0] == "fixtures/dirs/no-login")
}

test "the two verbs cannot both hold: the last one wins" {
    // WHY A VARIANT RATHER THAN TWO BOOLEANS. A boolean pair lets both be set, and
    // the program then has to decide which of two contradictory orders it was given
    // -- a rule nobody would have written down. A variant cannot hold both, so the
    // contradiction resolves the way every other verb in this parser already does.
    ro a = parse_args(["--install-autostart", "--uninstall-autostart"])!!
    assert(a.mode.to_str() == "uninstall-autostart")
    ro b = parse_args(["--uninstall-autostart", "--install-autostart"])!!
    assert(b.mode.to_str() == "install-autostart")
}

test "a misspelled autostart verb is refused, like every other unknown flag" {
    ro r = parse_args(["--install-autostrat"])
    assert(r.is_err())
    assert(r.err()!!.code == EXIT_CONFIG)
    assert(r.err()!!.message.contains("install-autostrat"))
}
