// Tests for claude_refresh.nv -- plan 01.6, П5: what is started to renew a Claude
// login, and what the outcome is called. Nothing is started here.
//
//   ./nova.sh test src/accounts/claude_refresh_test.nv

module accounts.claude_refresh_test

import claude_refresh.{refresh_run, wsl_parts, verdict_of, RefreshVerdict}

test "a Windows directory runs claude.cmd under its CLAUDE_CONFIG_DIR, bounded by the wrapper" {
    ro r = refresh_run("D:/Sources/.claude-accounts/MGTS", "claude-haiku-4-5-20251001", 120)
    assert(r.program == "powershell.exe")
    assert(r.config_dir == "D:/Sources/.claude-accounts/MGTS")
    ro script = r.args[r.args.len() - 1]
    assert(script.contains("Start-Process -FilePath 'claude.cmd'"))
    assert(script.contains("'--model','claude-haiku-4-5-20251001'"))
    // The limit and the kill of the whole tree: claude.cmd starts node under cmd.
    assert(script.contains("WaitForExit(120000)"))
    assert(script.contains("taskkill /T /F"))
}

test "a WSL directory runs claude INSIDE the distro, as the user the path names" {
    // The default WSL user would renew a different login and report success.
    ro r = refresh_run("\\\\wsl.localhost\\MGTS-KARKAS\\home\\karkas\\.claude", "m", 60)
    assert(r.program == "wsl.exe")
    assert(r.config_dir == "")
    assert(r.args[0] == "-d" && r.args[1] == "MGTS-KARKAS")
    assert(r.args[2] == "-u" && r.args[3] == "karkas")
    assert(r.args[5] == "timeout" && r.args[6] == "60")
    assert(r.args[r.args.len() - 1].contains("CLAUDE_CONFIG_DIR='/home/karkas/.claude'"))
}

test "wsl$ is a WSL path too; a path not under /home is not one we can run" {
    assert(wsl_parts("\\\\wsl$\\Ubuntu\\home\\me\\.claude").is_some())
    assert(wsl_parts("\\\\wsl.localhost\\Ubuntu\\root\\.claude").is_none())
    assert(wsl_parts("C:/Users/me/.claude").is_none())
}

test "the verdict is the file's mtime, not the exit code" {
    assert(verdict_of(1000, 2000, 0).to_str() == "refreshed")
    // A run that answered on a token still valid rewrote nothing.
    assert(verdict_of(1000, 1000, 0).to_str() == "unchanged")
    assert(verdict_of(1000, 1000, 124).to_str() == "failed -- timed out")
    assert(verdict_of(1000, 1000, 1).to_str() == "failed -- exit 1")
    assert(verdict_of(0, 0, 0).to_str().contains("never logged in"))
    // A rewritten file is a renewal even when the process then exited badly.
    assert(verdict_of(1000, 2000, 1).to_str() == "refreshed")
}
