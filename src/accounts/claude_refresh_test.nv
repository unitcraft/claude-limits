// Tests for claude_refresh.nv -- plan 01.6, П5: what is started to renew a Claude
// login. Nothing is started here.
//
//   ./nova.sh test src/accounts/claude_refresh_test.nv

module accounts.claude_refresh_test

import std.fs.{mock_fs, MemFs, write_text}
import claude_refresh.{refresh_run, refresh_script, launcher_script, wsl_parts, launch_verdict, launch_note, unchanged_note, renewed_note, claude_on_path, Verdict}

test "a Windows directory runs claude.cmd under its CLAUDE_CONFIG_DIR, bounded by the script" {
    ro s = refresh_script("D:/Sources/.claude-accounts/MGTS", "claude-haiku-4-5-20251001", 120)
    assert(s.starts_with("$env:CLAUDE_CONFIG_DIR = 'D:/Sources/.claude-accounts/MGTS';"))
    assert(s.contains("Start-Process -FilePath 'claude.cmd'"))
    assert(s.contains("'--model','claude-haiku-4-5-20251001'"))
    // The limit and the kill of the whole tree: claude.cmd starts node under cmd.
    assert(s.contains("WaitForExit(120000)"))
    assert(s.contains("taskkill /T /F"))
}

test "a WSL directory runs claude INSIDE the distro, as the user the path names" {
    // The default WSL user would renew a different login and report success.
    ro s = refresh_script("\\\\wsl.localhost\\MGTS-KARKAS\\home\\karkas\\.claude", "m", 60)
    assert(s.starts_with("& wsl.exe -d 'MGTS-KARKAS' -u 'karkas' -- timeout 60 bash -lc "))
    // The inner shell's own quotes are doubled for PowerShell.
    assert(s.contains("CLAUDE_CONFIG_DIR=''/home/karkas/.claude''"))
}

test "wsl$ is a WSL path too; a path not under /home is not one we can run" {
    assert(wsl_parts("\\\\wsl$\\Ubuntu\\home\\me\\.claude").is_some())
    assert(wsl_parts("\\\\wsl.localhost\\Ubuntu\\root\\.claude").is_none())
    assert(wsl_parts("C:/Users/me/.claude").is_none())
}

test "the launcher returns at once: an outer PowerShell starts the inner one through .NET" {
    // The round runs in the store's fiber: a launcher that waited for claude held every
    // reader of the snapshot (CI's smoke, 2026-10-02).
    ro inner = refresh_script("C:/Users/Евгений/.claude", "m", 120)
    ro r = refresh_run("C:/Users/Евгений/.claude", "m", 120)
    assert(r.program == "powershell.exe")
    assert(r.args[r.args.len() - 2] == "-Command")
    ro outer = r.args[r.args.len() - 1]
    assert(outer == launcher_script(inner))
    assert(outer.contains("[System.Diagnostics.Process]::Start($i)"))
    // No cmdlet in the outer script -- the inner's own Start-Process is only inside it.
    assert(outer.starts_with("$i = [System.Diagnostics.ProcessStartInfo]::new('powershell.exe', "))
    // The inner script, its single quotes doubled, in double quotes.
    assert(outer.contains("-Command \"${inner.replace("'", "''")}\"'"))
    assert(!inner.contains("\""))
}

test "no -EncodedCommand anywhere: the owner's antivirus flags it (event 4662, 2026-10-02)" {
    ro r = refresh_run("C:/x/.claude", "m", 60)
    for a in r.args { assert(!a.contains("EncodedCommand")) }
    ro w = refresh_run("\\\\wsl.localhost\\U\\home\\me\\.claude", "m", 60)
    for a in w.args { assert(!a.contains("EncodedCommand")) }
}

// ── what became of a launch ─────────────────────────────────────────────────

const T0 = 1_000_000

test "exit 0 with the file untouched is Unchanged once the limit has passed, Waiting before" {
    // A claude that exits 0 having written nothing, one that exited 1, and one the
    // wrapper killed leave the same trace: the mtime did not move.
    assert(launch_verdict(500, 500, T0, T0 + 10_000, 120) == Verdict.Waiting)
    assert(launch_verdict(500, 500, T0, T0 + (120 + 15) * 1000, 120) == Verdict.Unchanged)
    assert(launch_verdict(500, 500, T0, T0 + 3_600_000, 120) == Verdict.Unchanged)
}

test "a moved mtime is Renewed at once, whatever the time" {
    assert(launch_verdict(500, 900, T0, T0 + 1000, 120) == Verdict.Renewed)
    assert(launch_verdict(500, 900, T0, T0 + 3_600_000, 120) == Verdict.Renewed)
}

test "every outcome of a launch has its own log line" {
    assert(launch_note("a", 0, true).contains("started"))
    assert(launch_note("a", 1, true).contains("exit 1"))
    assert(launch_note("a", -1, true).contains("did not run"))
    assert(launch_note("a", 0, false).contains("not on PATH"))
    assert(unchanged_note("a", 120).contains("did not change within 120 s"))
    assert(renewed_note("a").contains("rewritten"))
    // No token and no path of the user leaks through these: they carry the name only.
    assert(!launch_note("a", 0, false).contains("sk-ant"))
}

test "claude.cmd is found in a PATH directory, and not found when no entry holds it" {
    mut fs = MemFs.new()
    with Fs = mock_fs(fs) {
        ro _ = write_text("C:\\bin\\claude.cmd".to_path(), "@exit /b 0")
        assert(claude_on_path("C:\\Windows;C:\\bin"))
        assert(claude_on_path("C:\\bin\\"))
        assert(!claude_on_path("C:\\Windows;C:\\other"))
        assert(!claude_on_path(""))
    }
}
