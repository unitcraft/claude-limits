// group.nv — logins to accounts (task T1.4). Pure: no effects, no clock, no I/O.
//
// One e-mail is one account, however many directories it lives in (plan 01 §0). The
// endpoint counts per LOGIN, so two directories sharing an e-mail must be asked ONCE:
// asking twice doubles the request rate for no new information, and this project has
// already been rate-limited for exactly that.

module accounts.group

// QUALIFIED, not the bare `import login.{...}` it used to be. A bare peer import
// resolves relative to the ENTRY file, not to the importing module: it passes when
// this module is checked or tested inside its own folder, and fails the moment
// anything with a `fn main` pulls it in. Nothing did until T1.7 gave the package an
// entry point, so this module had been unreachable from a binary since it was written
// and every test of it was green.
import claude_limits.accounts.login.{Login, GroupedAccount, TokenState, state_of}

fn GroupedAccount.new(email str, org str, dirs []str, paths []str, state TokenState, expires_at_ms int,
                      live_path str, expired_dirs []str, display_name str) -> GroupedAccount =>
    { email, org, dirs, paths, state, expires_at_ms, live_path, expired_dirs, display_name }

fn index_of(accounts []GroupedAccount, email str) -> int {
    mut i = 0
    while i < accounts.len() {
        if accounts[i].email == email { return i }
        i += 1
    }
    -1
}

/// The account's state from two of its directories': ONE live token makes it `ok`;
/// among dead ones, `no_token` beats `stale`.
///
/// AS THE REFERENCE DOES IT (`scripts/claude_limits.py`, `accounts_of`: the account
/// takes the first live token, and the expired directories are named beside it), and
/// it was the opposite here until 2026-10-02: the WORST state won, a `stale` account is
/// never asked, and an account with a live token in one directory and an expired one in
/// another showed no limits at all -- the owner's three directories of one login did
/// exactly that on the first stand. The expired directories are not hidden: they ride
/// in `expired_dirs` and the page names them.
fn combined(a TokenState, b TokenState) -> TokenState {
    if a == TokenState.Ok || b == TokenState.Ok { return TokenState.Ok }
    if rank(a) >= rank(b) { a } else { b }
}

fn rank(s TokenState) -> int =>
    match s {
        Ok => 0
        Stale => 1
        NoToken => 2
    }

/// Group logins by e-mail, preserving discovery order for both accounts and their
/// directories. Stable on purpose: a list that reorders itself between polls is
/// unreadable, and the page's own order (01.1 §4.2) is applied on top of this one.
export fn group(logins []Login, now_ms int) -> []GroupedAccount {
    mut out []GroupedAccount = []
    for l in logins {
        // A login with no e-mail cannot be grouped: it would merge every nameless
        // directory into one phantom account. They are dropped here and reported by
        // the discovery layer, which knows the path.
        if l.email == "" { continue }

        ro st = state_of(l, now_ms)
        ro live = st == TokenState.Ok
        ro at = index_of(out, l.email)
        if at < 0 {
            out.push(GroupedAccount.new(l.email, l.org, [l.name], [l.dir], st, l.expires_at_ms,
                                        if live { l.dir } else { "" }, if live { []str.new() } else { [l.name] },
                                        l.display_name))
            continue
        }

        mut acc = out[at]
        acc.dirs.push(l.name)
        acc.paths.push(l.dir)
        acc.state = combined(acc.state, st)
        if live && acc.live_path == "" { acc.live_path = l.dir }
        if !live { acc.expired_dirs.push(l.name) }
        // The EARLIEST expiry, because that is the one that will bite first. A zero
        // means "unknown" and must not win a minimum against a real timestamp.
        if l.expires_at_ms != 0 {
            if acc.expires_at_ms == 0 || l.expires_at_ms < acc.expires_at_ms {
                acc.expires_at_ms = l.expires_at_ms
            }
        }
        // An organisation name may be missing in one directory and present in
        // another; keep the one that says something.
        if acc.org == "" && l.org != "" { acc.org = l.org }
        if acc.display_name == "" && l.display_name != "" { acc.display_name = l.display_name }
        out[at] = acc
    }
    out
}
