// claude_refresh.nv — making Claude Code renew a login's token (plan 01.6, П5).
//
// Source: the reference, `scripts/refresh_token.py`. Enabled by the owner 2026-10-02.
//
// THIS FILE NEVER WRITES `.credentials.json`, AND NEVER READS A VALUE FROM IT. It reads
// the file's MODIFICATION TIME and nothing else. The `refreshToken` belongs to Claude
// Code; a second refresher racing it would be a second writer of one file. Claude Code
// is started with its config directory pointed at the login and asked for one tiny
// answer -- IT rewrites the file.
//
// Two kinds of directory, by the path, because the renewal must happen inside the
// system that owns the login:
//
//   Windows  `claude.cmd` on this machine, `CLAUDE_CONFIG_DIR` set;
//   WSL      `\\wsl.localhost\<distro>\home\<user>\...` (also `\\wsl$\...`): `claude`
//            INSIDE that distro, AS THAT USER -- the default user would renew a
//            different login and report success.
//
// THE ROUND DOES NOT WAIT FOR IT (correction 2026-10-02, after CI). The round runs in
// the store's fiber, and every reader of the snapshot waits for the round; a renewal
// that waited for `claude` held the page, the history and the settings for as long as
// Claude Code took -- up to the timeout. CI's smoke went red on it: its fixture's token
// is expired, and `/api/snapshot` stopped answering. So the renewal is LAUNCHED and
// left: an outer PowerShell starts the inner one through .NET `Process.Start` and
// exits; the inner one does the waiting, and the next round reads the file -- the
// token is fresh, or it is not.
//
// WHY .NET IN THE OUTER SCRIPT: a cmdlet there (`Start-Process`) loads its module, and
// in a fresh `LOCALAPPDATA` (CI, the smoke) PowerShell builds its module cache first --
// many seconds of a stalled round. With `Process.Start` alone the outer returned in
// 1.5 s on a cold cache (measured 2026-10-02).
//
// NEVER `-EncodedCommand` (measured the same day, the hard way). A program that starts
// a hidden PowerShell with an encoded script is what malware does, and the owner's
// antivirus treats it so: Kaspersky logged a detection (event 4662, `avp`) on EVERY
// start of the build that did it -- from its first run, 07:17 -- and the processes it
// held could not be stopped any more; `cmd /c start` in front of such a line never
// returned. The `-Command` form that renewed MGTS live at 05:44 drew no detection. So
// both scripts travel as plain `-Command`: the outer one as one argument, the inner
// one in double quotes inside the outer's single-quoted string -- it holds no double
// quote of its own (`ps_quote` makes single-quoted literals), so neither layer needs
// an escape beyond doubling `'`.
//
// THE TIMEOUT IS THE WRAPPER'S. `supervised(timeout:)` does not interrupt
// `Command.run` (registry 221.1 #1615, `probes/command-run-ignores-timeout/`): the hidden
// PowerShell waits with a limit and kills the process TREE (`claude.cmd` starts node
// under cmd); inside WSL, coreutils `timeout`.
//
// Every renewal spends one small request on that account's own limits.

module accounts.claude_refresh

import claude_limits.accounts.discover.{normalise}

/// What to start for one directory: a launcher that returns at once.
export type RefreshRun value {
    ro program str
    ro args []str
}

/// The WSL distro, user and POSIX path of a `\\wsl.localhost\...` / `\\wsl$\...` path;
/// `None` for anything else, and for a WSL path not under `/home/<user>`.
export fn wsl_parts(dir str) -> Option[WslDir] {
    ro p = normalise(dir)
    ro rest = if p.starts_with("//wsl.localhost/") {
        p["//wsl.localhost/".byte_len()..]
    } else if p.starts_with("//wsl$/") {
        p["//wsl$/".byte_len()..]
    } else {
        return None
    }
    ro (distro, path) = rest.split_once("/")?
    ro posix = "/${path}"
    if !posix.starts_with("/home/") { return None }
    ro after_home = posix["/home/".byte_len()..]
    ro user = match after_home.split_once("/") {
        Some((u, _)) => u
        None => after_home
    }
    if user == "" { return None }
    Some(wsl_dir(distro, user, posix))
}

export type WslDir value {
    ro distro str
    ro user str
    ro posix str
}

fn wsl_dir(distro str, user str, posix str) -> WslDir => { distro, user, posix }

/// A single-quoted shell word: `'` closes, an escaped quote, and opens again.
fn sh_quote(s str) -> str => "'${s.replace("'", "'\\''")}'"

/// A single-quoted PowerShell string: a quote is doubled.
fn ps_quote(s str) -> str => "'${s.replace("'", "''")}'"

/// The PowerShell script that renews `dir`, bounded by `timeout_sec`. It runs hidden and
/// on its own; nothing waits for it.
export fn refresh_script(dir str, model str, timeout_sec int) -> str {
    match wsl_parts(dir) {
        Some(w) => {
            ro inner = "cd ~ && CLAUDE_CONFIG_DIR=${sh_quote(w.posix)} claude -p ok --model ${sh_quote(model)}"
            "& wsl.exe -d ${ps_quote(w.distro)} -u ${ps_quote(w.user)} -- timeout ${timeout_sec} bash -lc ${ps_quote(inner)}"
        }
        None => {
            // `claude.cmd`, not `claude`: on Windows the bare name resolves to the
            // PowerShell shim, which cannot be started as a process (the reference).
            // The variable is set HERE, in the hidden PowerShell's own environment: the
            // server's is never touched, and it may itself run under a CLAUDE_CONFIG_DIR.
            ro env = "$env:CLAUDE_CONFIG_DIR = ${ps_quote(dir)}"
            ro start = "$p = Start-Process -FilePath 'claude.cmd' -ArgumentList '-p','ok','--model',${ps_quote(model)} -PassThru -WindowStyle Hidden"
            ro wait = "if (-not $p.WaitForExit(${timeout_sec * 1000})) { taskkill /T /F /PID $p.Id | Out-Null }"
            "${env}; ${start}; ${wait}"
        }
    }
}

/// The outer script: start the hidden inner PowerShell and return. .NET only -- no
/// cmdlet, so no module is loaded on the way (see the header). The inner script goes
/// in double quotes; it has none of its own.
export fn launcher_script(inner_script str) -> str {
    ro args = "-NoProfile -NonInteractive -WindowStyle Hidden -Command \"${inner_script}\""
    "$i = [System.Diagnostics.ProcessStartInfo]::new('powershell.exe', ${ps_quote(args)}); $i.UseShellExecute = $false; $i.CreateNoWindow = $true; [void][System.Diagnostics.Process]::Start($i)"
}

/// What to start for `dir`: the outer PowerShell, which returns once the inner one runs.
export fn refresh_run(dir str, model str, timeout_sec int) -> RefreshRun {
    {
        program: "powershell.exe",
        args: ["-NoProfile", "-NonInteractive", "-WindowStyle", "Hidden",
               "-Command", launcher_script(refresh_script(dir, model, timeout_sec))],
    }
}
