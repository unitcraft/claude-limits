# nova build output (T0.0). nova.lock.toml is NOT ignored: it pins the
# dependency versions and belongs in the repository.
target/

# Built binaries. `nova build <file>` drops <name>.exe BESIDE the source, while the
# package rule says built artefacts live in target/ -- so the stray one is ignored
# rather than moved: moving it would mean wrapping every build command.
*.exe

# Codegen leaves a <name>.c beside every <name>.nv it compiles. Hand-written
# shims live under native/ and stay tracked.
*.c
!**/native/*.c

# python
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
*.egg-info/

# local configuration and logs (they name accounts; never committed)
claude-limits.toml
*.local.*
*.log

# editors
.idea/
.vscode/
*.swp

# design canvas build output (~3 MB, rebuilt from docs/design/**/*.dc.html)
docs/design/**/claude-limits-browser-page.html

# Session handoffs written by /stop. Personal to a window, never shared: they name
# hashes, dirty files and half-finished edits, which are true for minutes. The /stop
# command assumes this directory is already ignored -- it was not, so the first handoff
# ever written showed up as untracked dirt in the tree it was meant to leave clean.
docs/.sessions/

# D420 local development override: names a machine-specific path, so it is
# never committed. Here it points `duckdb` at the sibling working copy, whose
# `native/lib` is built; the tag itself carries source only.
nova.override.toml
