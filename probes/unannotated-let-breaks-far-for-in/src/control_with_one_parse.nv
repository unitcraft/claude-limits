module probe_far_for_in.control_with_one_parse

import std.os.{args, real_os}
import probe_far_for_in.lib.{parse}

fn main() Io {
    ro all = with Os = real_os() { args() }
    ro v = if all.len() == 0 { all } else { all[1..] }
    match parse(v) {
        Err(e) => println(e)
        Ok(a) => {
            mut n = 0
            for d in a.dirs { if d != "" { n += 1 } }
            println("${n}")
        }
    }
}
