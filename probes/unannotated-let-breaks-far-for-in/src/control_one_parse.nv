module probe_far_for_in.control_one_parse

import probe_far_for_in.lib.{parse}

fn main() Io {
    ro all = ["prog", "a", "b"]
    ro v = if all.len() == 0 { all } else { all[1..] }
    match parse(v) {
        Err(e) => println(e)
        Ok(a) => {
            mut n = 0
            for d in a.dirs { if d != "" { n += 1 } }
            println("${n}")
        }
    }
}
