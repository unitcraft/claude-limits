module probe_far_for_in.control_xmod_literal

import probe_far_for_in.lib.{parse}

fn main() Io {
    ro all = ["prog", "a"]
    match parse(all) {
        Err(e) => println(e)
        Ok(a) => {
            mut n = 0
            for d in a.dirs { if d != "" { n += 1 } }
            println("${n}")
        }
    }
}
