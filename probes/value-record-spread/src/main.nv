// Spread-update of a `value` record.
//
// The whole probe is the middle line. Comment it out and the file builds and runs;
// leave it in and clang refuses the generated C:
//
//   error: assigning to 'NovaValue_Box' from incompatible type 'NovaValue_Box *';
//          dereference with *
//
// The front end accepts it, so this is codegen, not a rule I misread. Field
// assignment on a `mut` local (the last two lines) is the working form and is what
// src/storage/paths.nv uses.

module probe_value_record_spread.main

type Box value {
    a str
    b int
}

fn one() -> Box => { a: "one", b: 1 }
fn two() -> Box => { a: "two", b: 10 }

fn main() Io -> () {
    mut x = one()

    // THE PROBE: comment this line out and everything below compiles and runs.
    x = { ...x, b: 2 }

    println("spread: a=${x.a} b=${x.b}")

    mut y = two()
    y.b = 20
    println("field assignment: a=${y.a} b=${y.b}")
}
