{
  "openapi": "3.1.0",
  "x-what-this-is": "GAP: two error responses that are not RFC 9457 bodies. One says the word 'Problem' in its description, the other spells it inside a schema title.",
  "info": {
    "title": "claude-limits",
    "version": "1"
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457. The only error shape this API has.",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "x-data-class": "none"
          },
          "retry_after": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ValidationProblem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Problem"
          },
          {
            "type": "object",
            "properties": {
              "errors": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                }
              }
            }
          }
        ]
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "x-data-class": "none"
          },
          "email": {
            "type": "string",
            "x-data-class": "pii"
          },
          "state": {
            "type": "string"
          },
          "dirs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoginDir"
            }
          }
        }
      },
      "LoginDir": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "x-data-class": "none"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "x-data-class": "pii"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "fetched_at": {
            "type": "string"
          },
          "interval_sec": {
            "type": "integer"
          },
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "limits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Limit"
            }
          }
        }
      },
      "Limit": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "x-data-class": "none"
          },
          "kind": {
            "type": "string"
          },
          "percent": {
            "type": "integer"
          },
          "resets_at": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "api_version": {
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Config": {
        "type": "object",
        "properties": {
          "etag": {
            "type": "string",
            "x-data-class": "none"
          },
          "config": {
            "type": "object"
          },
          "accounts_found": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "History": {
        "type": "object",
        "properties": {
          "step_sec": {
            "type": "integer"
          },
          "series": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Series"
            }
          }
        }
      },
      "Series": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string",
            "x-data-class": "none"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "Probe": {
        "type": "object",
        "properties": {
          "found": {
            "type": "integer"
          },
          "logins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LoginDir"
            }
          }
        }
      },
      "Token": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "x-data-class": "secret"
          },
          "shown_once": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "problem+json",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Invalid": {
        "description": "validation problem+json",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationProblem"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "the page",
        "responses": {
          "200": {
            "description": "text/html",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/assets/{path}": {
      "get": {
        "summary": "fonts and the icon",
        "parameters": [
          {
            "name": "asset",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "by mime",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "liveness, versions, address, sizes",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Problem: the poller is down (this sentence is the only Problem here)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "ProblemLike",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/snapshot": {
      "get": {
        "summary": "the current state of every account",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "the event stream",
        "responses": {
          "200": {
            "description": "text/event-stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/snapshot/refresh": {
      "post": {
        "summary": "poll now",
        "responses": {
          "202": {
            "description": "queued"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/history": {
      "get": {
        "summary": "measurements over a period",
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/api/history/search": {
      "post": {
        "summary": "the same, filtered by account, in the body",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/History"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "summary": "the settings, without the secret",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "304": {
            "description": "not modified"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "put": {
        "summary": "change the settings",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          },
          "412": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          },
          "428": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/folders/probe": {
      "post": {
        "summary": "what a path would find, before adding it",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Probe"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/api/config/token": {
      "post": {
        "summary": "mint a new access token",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "412": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/export": {
      "get": {
        "summary": "export the history",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "csv or json",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Invalid"
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "this description",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  }
}
