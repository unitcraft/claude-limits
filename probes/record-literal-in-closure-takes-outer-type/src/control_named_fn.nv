module probe_lit_closure.control_named_fn

type Inner value {
    ro n int
}

type Outer value {
    ro label str
    ro inner Option[Inner]
}

fn wrap(x int) -> Inner => { n: x }

fn main() Io {
    ro x Option[int] = Some(7)
    ro o Outer = { label: "a", inner: x.map(fn(v int) -> Inner => wrap(v)) }
    match o.inner {
        Some(i) => println("${o.label} ${i.n}")
        None => println("none")
    }
}
